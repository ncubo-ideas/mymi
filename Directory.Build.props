<Project>

  <!-- La version del motor Puppeteer, en un solo lugar para todo el repo.

       El motor se consume por NuGet, no por ProjectReference. Eso importa: mientras se
       referenciaba el repo, el build dependia de QUE RAMA estuviera checkouteada en un
       repo que no es parte del entregable — y se rompio de verdad cuando alguien volvio a
       master. Con el paquete la version queda fijada aca y nadie la cambia por accidente.
 -->

  <PropertyGroup>
    <VersionDelMotor Condition="'$(VersionDelMotor)' == ''">3.0.0-beta.10029</VersionDelMotor>
  </PropertyGroup>

</Project>
