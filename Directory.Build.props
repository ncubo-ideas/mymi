<Project>

  <!-- La version del motor Puppeteer, en un solo lugar para todo el repo.

       El motor se consume por NuGet, no por ProjectReference. Eso importa: mientras se
       referenciaba el repo, el build dependia de QUE RAMA estuviera checkouteada en un
       repo que no es parte del entregable — y se rompio de verdad cuando alguien volvio a
       master. Con el paquete la version queda fijada aca y nadie la cambia por accidente.

       PENDIENTE CONOCIDO: 3.0.0-beta.10027 todavia NO trae el replay secuencial (medido:
       0 referencias a OperatingSystem.IsBrowser en su Puppeteer.dll). Todo COMPILA, pero
       la caratula wasm no va a arrancar en el browser hasta que se publique una version
       con esos commits: son tres, ec9177d / aa29edb / c9da4f0 de la rama wasm-replay, y
       ninguno esta en master. -->

  <PropertyGroup>
    <VersionDelMotor Condition="'$(VersionDelMotor)' == ''">3.0.0-beta.10027</VersionDelMotor>
  </PropertyGroup>

</Project>
