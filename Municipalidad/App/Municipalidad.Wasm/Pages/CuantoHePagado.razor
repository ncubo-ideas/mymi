@page "/cuanto-he-pagado"
@inject EstadoDeLaApp estado

<PageTitle>Cuánto he pagado · Mi cuenta municipal</PageTitle>

<h1>Cuánto he pagado</h1>
<p class="bajada">
    Lo que pagaste en un año, y la serie de comprobantes de cada rubro. El total trae la mora adentro,
    porque es lo que pagaste de verdad.
</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <section class="bloque" id="el-total">
        <h2>El total del año</h2>

        <article class="tarjeta">
            <div class="tarjeta__cabeza">
                <label for="el-anio">Año</label>
                <select id="el-anio" @bind="anioElegido" @bind:after="Releer">
                    @foreach (var anio in pagado.AniosQueSePuedenPedir)
                    {
                        <option value="@anio">@anio</option>
                    }
                </select>
            </div>

            <dl class="renglones">
                <dt>Pagado en @pagado.Anio</dt>
                <dd class="cifra">@Formato.Monto(pagado.TotalDelAnio)</dd>
            </dl>

            @if (!pagado.HayAlgunComprobante)
            {
                <p class="nota">
                    Esta app todavía no ha visto ningún comprobante tuyo, así que no hay serie que
                    mostrar y el total viene en cero. Llegan solos, con el resto de tus movimientos.
                </p>
            }
            else if (pagado.ElAnioPedidoNoTieneComprobantes)
            {
                <p class="nota">
                    De @pagado.Anio esta app no tiene ningún comprobante. Un total en cero no es un año
                    sin pagos: puede ser que los recibos de ese año todavía no hayan llegado aquí. Los
                    años de los que sí hay están en la lista de arriba.
                </p>
            }
        </article>

        <Aviso Tono="quieta" Id="el-total-trae-la-mora" Titulo="El total incluye la mora">
            <p>
                Es lo que pagaste de verdad, no el precio del servicio. Cada línea trae la mora en su
                propia columna si querés verlas aparte, y no hay que restar un total de otro.
            </p>
        </Aviso>
    </section>

    @foreach (var serie in pagado.Series)
    {
        <section class="bloque" id="@("serie-" + serie.Rubro)">
            <div class="tarjeta__cabeza">
                <LlaveDelRubro Rubro="@serie.Rubro" />
                <span class="periodo">@serie.Estado</span>
            </div>

            <Frase Dice="@serie.Dice" Apagada="@(serie.Lineas.Count == 0)" />

            @if (serie.Lineas.Count > 0)
            {
                <div class="tabla">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Período</th>
                                <th scope="col" class="tabla__cifra">Monto</th>
                                <th scope="col" class="tabla__cifra">Mora</th>
                                <th scope="col" class="tabla__cifra">Cubre</th>
                                <th scope="col" class="tabla__cifra">Por período</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in serie.Lineas)
                            {
                                <tr>
                                    <td>
                                        @linea.Periodo
                                        @if (linea.Inferido)
                                        {
                                            <span class="sello sello--inferido">inferido</span>
                                        }
                                    </td>
                                    <td class="tabla__cifra">@Formato.Monto(linea.Monto)</td>
                                    <td class="tabla__cifra">@Formato.Monto(linea.Mora)</td>
                                    <td class="tabla__cifra">@linea.Cubre</td>
                                    <td class="tabla__cifra">@Formato.Monto(linea.PorPeriodo)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (HayAlgunaLineaInferida())
    {
        <Aviso Tono="tibia" Id="lo-que-se-infirio" Titulo="Las líneas marcadas «inferido» las dedujo esta app">
            <p>
                Cuando una línea es la primera de un rubro no hay una anterior con que saber cuántos
                períodos cubre, así que esta app supone uno. Es una suposición suya y no un dato de tu
                recibo.
            </p>
        </Aviso>
    }

    <p class="nota">
        Una línea puede cubrir varios períodos, así que comparar montos de líneas distintas no compara
        nada: para eso está la columna <strong>por período</strong>. Las series vienen enteras y el año
        no las recorta, para que se vea de qué años sí hay comprobantes.
    </p>
}

@code {
	private LoQuePagueEnUnAnio pagado;

	private int anioElegido;

	protected override void OnInitialized()
	{
		if (!estado.EstaArriba) return;

		pagado = estado.LeerLoQuePague(0);
		anioElegido = pagado.Anio;
	}

	/// <summary>La unica pasada de lectura de esta pantalla, con el anio que la persona tenga puesto.</summary>
	private void Releer()
	{
		if (estado.EstaArriba) pagado = estado.LeerLoQuePague(anioElegido);
	}

	private bool HayAlgunaLineaInferida()
	{
		foreach (var serie in pagado.Series)
			foreach (var linea in serie.Lineas)
				if (linea.Inferido) return true;

		return false;
	}
}
