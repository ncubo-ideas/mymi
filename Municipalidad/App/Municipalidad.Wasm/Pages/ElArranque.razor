@page "/"
@inject EstadoDeLaApp estado
@inject Textos textos

<PageTitle>@Textos.TituloDelModulo</PageTitle>

<header class="portada">
    <h1>@Textos.TituloDelModulo</h1>
    <p class="bajada">@textos["arranque.bajada"]</p>
</header>

@if (estado.NoSeEstaGuardando.HayQueDecirlo)
{
    <div class="parte mala" role="alert" id="no-se-guarda">
        <h3>@textos["arranque.noSeGuarda"]</h3>
        <p>@textos.Diga(estado.NoSeEstaGuardando)</p>
    </div>
}

@if (falla.Length > 0)
{
    <div class="parte mala" role="alert" id="falla">
        <h3>@(estado.EstaArriba ? textos["arranque.pasoFallido"] : textos["arranque.noAbrio"])</h3>
        <p>@textos.Diga(elPasoQueFallo)</p>
        <p class="mono">@falla</p>
    </div>
}

@if (estado.NoSeAlcanzaLaInstitucion.HayQueDecirlo)
{
    <div class="parte tibia" id="sin-institucion">
        <h3>@textos["arranque.sinInstitucion"]</h3>
        <p>@textos.Diga(estado.NoSeAlcanzaLaInstitucion) @textos["arranque.sinInstitucionCuerpo"]</p>
    </div>
}

@if (elNavegadorDijoQueNo.HayQueDecirlo)
{
    <div class="parte tibia" id="navegador-dijo-no">
        <h3>@textos["arranque.navegadorDijoNo.titulo"]</h3>
        <p>@textos.Diga(elNavegadorDijoQueNo)</p>
    </div>
}

@if (!estado.EstaArriba && !estado.Hospedada)
{
    @if (sinAlmacenamiento == "inseguro")
    {
        <div class="parte tibia" id="sin-almacenamiento-inseguro">
            <h3>@textos["arranque.sinHttps"]</h3>
            <p>@((MarkupString)textos["arranque.sinHttpsCuerpo"])</p>
        </div>
    }
    else if (sinAlmacenamiento == "navegador")
    {
        <div class="parte tibia" id="sin-almacenamiento-navegador">
            <h3>@textos["arranque.navegadorSinAlmacenamiento"]</h3>
            <p>@textos["arranque.navegadorSinAlmacenamientoCuerpo"]</p>
        </div>
    }

    <div class="tarjeta">
        <h2>@textos["arranque.dondeGuardar"]</h2>

        @if (estado.FaltaReotorgarPermiso)
        {
            <p>@((MarkupString)textos.Con("arranque.reotorgar", ("carpeta", estado.NombreDeLaCarpeta)))</p>
            <div class="botones">
                <button type="button" id="reotorgar" @onclick="ReotorgarElPermiso">
                    @textos.Con("arranque.darPermiso", ("carpeta", estado.NombreDeLaCarpeta))
                </button>
                <button class="suave" type="button" id="elegir-carpeta" @onclick="ConectarCarpetaAsync"
                        disabled="@(haySelector == false)">
                    @textos["arranque.elegirOtraCarpeta"]
                </button>
                <button class="suave" type="button" id="olvidar-carpeta" @onclick="OlvidarCarpetaAsync">
                    @textos["arranque.olvidarCarpeta"]
                </button>
            </div>
        }
        else
        {
            <div class="botones">
                @if (haySelector == true)
                {
                    <button type="button" id="elegir-carpeta" @onclick="ConectarCarpetaAsync">
                        @textos["arranque.elegirCarpeta"]
                    </button>
                }
                @if (hayNavegador == true)
                {
                    <button class="suave" type="button" id="usar-navegador" @onclick="UsarElNavegadorAsync">
                        @(instalada ? textos["arranque.guardarEnLaApp"] : textos["arranque.guardarEnElNavegador"])
                    </button>
                }
                <button class="suave" type="button" id="abrir-sin-guardar" @onclick="AbrirAsync">
                    @textos["arranque.abrirSinGuardar"]
                </button>
            </div>
            <p class="nota">@textos["arranque.notaDeLaCarpeta"]</p>
        }
    </div>
}
else
{
    <div class="botones">
        <button type="button" id="refrescar" @onclick="RefrescarAsync" disabled="@refrescando">
            @(refrescando ? textos["arranque.trayendo"] : textos["arranque.traer"])
        </button>
    </div>

    <nav class="preguntas" id="las-preguntas">
        <a href="por-que-pago-mas">
            <strong>@textos["porQuePagoMas.titulo"]</strong>
            <span>@textos["arranque.enlace.porQuePagoMas"]</span>
        </a>
        <a href="que-se-me-vence">
            <strong>@textos["queSeMeVence.titulo"]</strong>
            <span>@textos["arranque.enlace.queSeMeVence"]</span>
        </a>
        <a href="cuanto-apartar">
            <strong>@textos["cuantoApartar.titulo"]</strong>
            <span>@textos["arranque.enlace.cuantoApartar"]</span>
        </a>
        <a href="sin-comprobante">
            <strong>@textos["sinComprobante.titulo"]</strong>
            <span>@textos["arranque.enlace.sinComprobante"]</span>
        </a>
        <a href="cuanto-he-pagado">
            <strong>@textos["cuantoHePagado.titulo"]</strong>
            <span>@textos["arranque.enlace.cuantoHePagado"]</span>
        </a>
        <a href="que-tan-al-dia-esta">
            <strong>@textos["queTanAlDia.titulo"]</strong>
            <span>@textos["arranque.enlace.queTanAlDia"]</span>
        </a>
    </nav>

    <p class="nota">@textos["arranque.loQueContestaElPortal"]</p>

    <details class="plomeria">
        <summary>@textos["arranque.plomeria"]</summary>

    <div class="tarjeta">
        <h2>@textos["arranque.dondeVive"]</h2>
        <dl class="renglones">
            <dt>@textos["arranque.modo"]</dt>
            <dd>@ElModoDicho()</dd>
            @if (estado.EnCarpetaPropia)
            {
                <dt>@textos["arranque.carpeta"]</dt>
                <dd>@estado.NombreDeLaCarpeta</dd>
            }
            <dt>@textos["arranque.permiso"]</dt>
            <dd class="mono">@permiso</dd>
            <dt>@textos["arranque.enMemfs"]</dt>
            <dd>@textos.Con(archivos == 1 ? "arranque.memfs.uno" : "arranque.memfs.varios", ("archivos", archivos.ToString()), ("bytes", bytes.ToString()))</dd>
        </dl>
    </div>

    <div class="tarjeta">
        <h2>@textos["arranque.queDiceElJournal"]</h2>
        <dl class="renglones">
            <dt>@textos["arranque.entradas"]</dt>
            <dd>@entradas</dd>
            <dt>@textos["arranque.ultimoEvento"]</dt>
            <dd>@ultimoEvento</dd>
            <dt>@textos["arranque.estaInstalacion"]</dt>
            <dd class="mono">@(dispositivo.Length > 0 ? dispositivo : textos["arranque.sinRegistrar"])</dd>
            <dt>@textos["arranque.credencial"]</dt>
            <dd>@(hayCredencial ? textos["arranque.credencialSi"] : textos["arranque.credencialNo"])</dd>
        </dl>
    </div>

    <div class="tarjeta">
        <h2>@textos["arranque.aQuienSeLePide"]</h2>
        <dl class="renglones">
            <dt>@textos["arranque.feed"]</dt>
            <dd class="mono">@estado.DondeEstaElFeed@estado.Recurso/@estado.Id/events</dd>
        </dl>
        <p class="nota">@((MarkupString)textos["arranque.deDondeSale"])</p>
    </div>

    @if (estado.Apunte.HayQueDecirlo)
    {
        <p class="nota">@textos.Diga(estado.Apunte)</p>
    }

    @if (estado.ApunteDelFeed.HayQueDecirlo)
    {
        <p class="nota">@textos.Diga(estado.ApunteDelFeed)</p>
    }

    <p class="nota">@textos["arranque.ventanaDeEscritura"]</p>
    </details>
}

@code {
	private bool? haySelector;
	private bool? hayNavegador;
	private bool instalada;
	private string sinAlmacenamiento = "";
	private bool refrescando;

	private string falla = "";
	private Apunte elPasoQueFallo = Apunte.Ninguno;
	private Apunte elNavegadorDijoQueNo = Apunte.Ninguno;

	private string permiso = "";
	private int archivos;
	private long bytes;
	private long entradas;
	private long ultimoEvento;
	private string dispositivo = "";
	private bool hayCredencial;

	protected override async Task OnInitializedAsync()
	{
		if (estado.Hospedada) { await AbrirAsync(); return; }

		haySelector = await estado.HaySelectorDeCarpetasAsync();
		hayNavegador = await estado.HayAlmacenamientoDelNavegadorAsync();
		instalada = await estado.CorreComoAppInstaladaAsync();
		sinAlmacenamiento = await estado.MotivoSinAlmacenamientoAsync();

		if (estado.EstaArriba) { await Releer(); return; }

		if (await estado.ModoRecordadoAsync() == "opfs" && hayNavegador == true)
		{
			if ((await estado.UsarElNavegadorAsync()).Ok) { await AbrirAsync(); return; }
		}

		if (haySelector != true) return;

		ResultadoDeCarpeta recuperada = await estado.RecuperarCarpetaAsync();

		if (recuperada.Ok) await AbrirAsync();
	}

	private Task ConectarCarpetaAsync() => Intentar("elegirCarpeta", async () =>
		await AbrirODecir(await estado.ConectarCarpetaAsync(), "elegirCarpeta"));

	private Task ReotorgarElPermiso() => Intentar("darPermiso", async () =>
		await AbrirODecir(await estado.PedirPermisoAsync(), "darPermiso"));

	private Task UsarElNavegadorAsync() => Intentar("usarNavegador", async () =>
		await AbrirODecir(await estado.UsarElNavegadorAsync(), "usarNavegador"));

	private Task OlvidarCarpetaAsync() => Intentar("olvidarCarpeta", async () =>
	{
		await estado.OlvidarLaCarpetaAsync();
		elNavegadorDijoQueNo = Apunte.Ninguno;
	});

	private Task AbrirAsync() => Intentar("abrirLaApp", async () =>
	{
		await estado.AbrirAsync();
		await Releer();
	});

	private Task RefrescarAsync() => Intentar("traerDeLaInstitucion", async () =>
	{
		refrescando = true;
		try { await estado.RefrescarAsync(); }
		finally { refrescando = false; await Releer(); }
	});

	/// <summary>
	/// Abre, o dice que el navegador no dejo. Las dos negativas son frases enteras y distintas: una es
	/// un permiso bloqueado, que la persona puede destrabar, y la otra es cualquier otro no.
	/// </summary>
	private async Task AbrirODecir(ResultadoDeCarpeta resultado, string queEstabaIntentando)
	{
		if (resultado.Ok)
		{
			elNavegadorDijoQueNo = Apunte.Ninguno;
			await estado.AbrirAsync();
			await Releer();
			return;
		}

		elNavegadorDijoQueNo = resultado.Permiso == "denied"
			? Apunte.De("arranque.navegadorDijoNo.denegado." + queEstabaIntentando)
			: Apunte.De("arranque.navegadorDijoNo.otro." + queEstabaIntentando,
				("motivo", resultado.Motivo.Length > 0 ? resultado.Motivo : resultado.Permiso));
	}

	/// <summary>La unica pasada de lectura de esta pantalla: todo lo que muestra sale de aca.</summary>
	private async Task Releer()
	{
		permiso = await estado.PermisoActualAsync();

		(archivos, bytes) = estado.EstadoDeMemfs();

		entradas = estado.EntradasDelJournal();
		ultimoEvento = estado.UltimoEventoAplicado();
		dispositivo = estado.ClaveDeDispositivo();
		hayCredencial = estado.HayCredencial();
	}

	private string ElModoDicho() => estado.EnCarpetaPropia
		? textos["arranque.modoCarpeta"]
		: estado.EnElNavegador ? textos["arranque.modoNavegador"] : textos["arranque.modoMemoria"];

	/// <summary>
	/// Corre un paso y, si falla, deja DOS cosas: la frase que dice cual paso fallo, en el idioma de la
	/// persona, y el detalle tecnico, que son nombres de tipos y no se traduce.
	/// </summary>
	private async Task Intentar(string paso, Func<Task> accion)
	{
		falla = "";
		elPasoQueFallo = Apunte.Ninguno;

		try
		{
			await accion();
		}
		catch (Exception ex)
		{
			elPasoQueFallo = Apunte.De("arranque.falla.paso." + paso);

			var detalle = new System.Text.StringBuilder($"{ex.GetType().FullName}: {ex.Message}");
			for (Exception adentro = ex.InnerException; adentro is not null; adentro = adentro.InnerException)
				detalle.Append($"\n  {adentro.GetType().FullName}: {adentro.Message}");
			falla = detalle.ToString();
		}
	}
}
