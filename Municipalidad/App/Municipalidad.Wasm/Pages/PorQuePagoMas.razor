@page "/por-que-pago-mas"
@inject EstadoDeLaApp estado
@inject Textos textos

<PageTitle>@textos["porQuePagoMas.titulo"] · @Textos.TituloDelModulo</PageTitle>

<h1>@textos["porQuePagoMas.titulo"]</h1>
<p class="bajada">@textos["porQuePagoMas.bajada"]</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <NumeroSinFirmar Dicho="@textos.Con("porQuePagoMas.umbrales",
        ("salto", Formato.Porcentaje(variacion.UmbralDeSalto, textos.Idioma)),
        ("ruido", Formato.Porcentaje(variacion.Ruido, textos.Idioma)))" />

    @foreach (var rubro in variacion.Rubros)
    {
        <article class="tarjeta" id="@("rubro-" + rubro.Rubro)">
            <div class="tarjeta__cabeza">
                <LlaveDelRubro Rubro="@rubro.Rubro" />
                @if (rubro.SePuedeVer)
                {
                    <span class="sello sello--@(rubro.EsSalto ? "salto" : "quieto")">
                        @textos.ComoSeDice(rubro.Explicacion)
                    </span>
                }
            </div>

            <Frase Dice="@rubro.Dice" Apagada="@(!rubro.SePuedeVer)" />

            @if (rubro.SePuedeVer)
            {
                <dl class="renglones">
                    <dt>@textos["porQuePagoMas.periodos"]</dt>
                    <dd>@rubro.Desde &rarr; @rubro.Hasta</dd>
                    <dt>@textos["porQuePagoMas.porPeriodo"]</dt>
                    <dd>@Formato.Monto(rubro.Antes, textos.Idioma) &rarr; @Formato.Monto(rubro.Ahora, textos.Idioma)</dd>
                    <dt>@textos["porQuePagoMas.elCambio"]</dt>
                    <dd>@Formato.Porcentaje(rubro.Proporcion, textos.Idioma)</dd>
                </dl>
            }
        </article>
    }

    @if (!variacion.AlgunoSePuedeVer)
    {
        <Aviso Tono="tibia" Id="ninguna-variacion" Titulo="@textos["porQuePagoMas.sinVariacion.titulo"]">
            <p>@textos["porQuePagoMas.sinVariacion.cuerpo"]</p>
        </Aviso>
    }

    @if (fincas.HayAlguna)
    {
        <section class="bloque" id="el-valor-de-mi-finca">
            <h2>@textos["porQuePagoMas.finca.titulo"]</h2>

            <p class="nota">@((MarkupString)textos["porQuePagoMas.finca.nota"])</p>

            @foreach (var finca in fincas.Fincas)
            {
                <article class="tarjeta">
                    <div class="tarjeta__cabeza">
                        <LlaveDelRubro Rubro="@finca.Numero" />
                        @if (finca.TieneAvaluo)
                        {
                            <span class="periodo">@textos.Con("porQuePagoMas.finca.avaluo",
                                ("monto", Formato.Monto(finca.Avaluo, textos.Idioma)))</span>
                        }
                        else
                        {
                            <span class="periodo">@textos["porQuePagoMas.finca.sinAvaluo"]</span>
                        }
                    </div>

                    @if (!finca.TieneAvaluo)
                    {
                        <p class="nota">@textos["porQuePagoMas.finca.sinAvaluoNota"]</p>
                    }
                </article>
            }
        </section>
    }

    <p class="nota">
        @textos["porQuePagoMas.pie"]
        <a href="que-se-me-vence">@textos["porQuePagoMas.pieEnlace"]</a>.
    </p>
}

@code {
	private LaVariacionDeCadaRubro variacion;
	private LasFincasQueTengo fincas;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla, y las dos partes del mismo momento.</summary>
	private void Releer()
	{
		if (!estado.EstaArriba) return;

		variacion = estado.LeerLaVariacionDeCadaRubro();
		fincas = estado.LeerLasFincas();
	}
}
