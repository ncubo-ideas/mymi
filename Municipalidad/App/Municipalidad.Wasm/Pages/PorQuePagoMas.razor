@page "/por-que-pago-mas"
@inject EstadoDeLaApp estado

<PageTitle>Por qué pago más · Mi cuenta municipal</PageTitle>

<h1>Por qué pago más</h1>
<p class="bajada">
    Entre los dos últimos comprobantes de cada rubro: de cuánto a cuánto cambió, y qué lo explica.
    Lo que explica un aumento depende de cómo se cobra ese rubro, y ésa es la mitad que el portal no
    contesta.
</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <NumeroSinFirmar Dicho="@($"Un cambio se llama salto cuando pasa el {Formato.Porcentaje(variacion.UmbralDeSalto)}, y por debajo del {Formato.Porcentaje(variacion.Ruido)} se considera ruido.")" />

    @foreach (var rubro in variacion.Rubros)
    {
        <article class="tarjeta" id="@("rubro-" + rubro.Rubro)">
            <div class="tarjeta__cabeza">
                <LlaveDelRubro Rubro="@rubro.Rubro" />
                @if (rubro.SePuedeVer)
                {
                    <span class="sello sello--@(rubro.EsSalto ? "salto" : "quieto")">
                        @rubro.Explicacion
                    </span>
                }
            </div>

            <Frase Dice="@rubro.Dice" Apagada="@(!rubro.SePuedeVer)" />

            @if (rubro.SePuedeVer)
            {
                <dl class="renglones">
                    <dt>Períodos</dt>
                    <dd>@rubro.Desde &rarr; @rubro.Hasta</dd>
                    <dt>Por período</dt>
                    <dd>@Formato.Monto(rubro.Antes) &rarr; @Formato.Monto(rubro.Ahora)</dd>
                    <dt>El cambio</dt>
                    <dd>@Formato.Porcentaje(rubro.Proporcion)</dd>
                </dl>
            }
        </article>
    }

    @if (!variacion.AlgunoSePuedeVer)
    {
        <Aviso Tono="tibia" Id="ninguna-variacion" Titulo="Todavía no hay ninguna variación que ver.">
            <p>
                Una variación necesita dos comprobantes del mismo rubro. Aparecen solas conforme tus
                pagos vayan llegando a esta app.
            </p>
        </Aviso>
    }

    @if (fincas.HayAlguna)
    {
        <section class="bloque" id="el-valor-de-mi-finca">
            <h2>El valor de tu finca</h2>

            <p class="nota">
                Tres de los cinco rubros se cobran sobre el valor de tu finca, y tu municipalidad no
                publica con cuál valor calculó cada período. El que sabés vos es tuyo y podés
                registrarlo aquí: queda en tu carpeta y tu asistente lo lee.
                <strong>Esta pantalla no lo va a usar para explicar un salto</strong> — para eso
                haría falta el valor con que cobró la municipalidad, y ése no llega.
            </p>

            @foreach (var finca in fincas.Fincas)
            {
                <article class="tarjeta">
                    <div class="tarjeta__cabeza">
                        <LlaveDelRubro Rubro="@finca.Numero" />
                        @if (finca.TieneValorDeclarado)
                        {
                            <span class="periodo">declarado: @Formato.Monto(finca.Valor)</span>
                        }
                        else
                        {
                            <span class="periodo">sin valor declarado</span>
                        }
                    </div>

                    <div class="aporte">
                        <label for="@("valor-" + finca.Numero)">Declarar su valor, en colones</label>
                        <div class="aporte__linea">
                            <input id="@("valor-" + finca.Numero)" type="number" min="1" step="1"
                                   inputmode="numeric" value="@ElValorEscritoDe(finca.Numero)"
                                   @oninput="@(e => Escribio(finca.Numero, e))"
                                   disabled="@(declarando == finca.Numero)" />
                            <button type="button" id="@("declarar-" + finca.Numero)"
                                    @onclick="@(() => DeclararAsync(finca.Numero))"
                                    disabled="@(declarando.Length > 0 || !EsUnValorQuePuedoMandar(finca.Numero))">
                                @(declarando == finca.Numero ? "Guardando…" : "Declarar")
                            </button>
                        </div>
                    </div>
                </article>
            }

            @if (loQuePaso is not null)
            {
                @if (loQuePaso.QuedoSinRespaldo)
                {
                    <Aviso Tono="mala" Id="aporte-sin-respaldo" Titulo="Quedó registrado y NO se guardó.">
                        <p>@loQuePaso.Dice</p>
                    </Aviso>
                }
                else if (loQuePaso.QuedoRegistrado)
                {
                    <Aviso Tono="quieta" Id="aporte-entro" Titulo="Listo, quedó tuyo.">
                        <p>El valor quedó registrado y guardado en tu carpeta.</p>
                    </Aviso>
                }
                else
                {
                    <Aviso Tono="tibia" Id="aporte-rechazado" Titulo="No se registró, y ésta es la razón.">
                        <p>@loQuePaso.Dice</p>
                    </Aviso>
                }
            }
        </section>
    }

    <p class="nota">
        Un aumento nunca apura: ya pasó. Lo que apura es lo que vence, y eso está en
        <a href="que-se-me-vence">qué se me vence</a>.
    </p>
}

@code {
	private LaVariacionDeCadaRubro variacion;
	private LasFincasQueTengo fincas;

	private readonly Dictionary<string, decimal> escrito = new Dictionary<string, decimal>();
	private string declarando = "";
	private LoQueDijoElAporte loQuePaso;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla, y las dos partes del mismo momento.</summary>
	private void Releer()
	{
		if (!estado.EstaArriba) return;

		variacion = estado.LeerLaVariacionDeCadaRubro();
		fincas = estado.LeerLasFincas();
	}

	private decimal ElValorEscritoDe(string finca) =>
		escrito.TryGetValue(finca, out decimal valor) ? valor : 0m;

	private void Escribio(string finca, ChangeEventArgs e) =>
		escrito[finca] = decimal.TryParse(
			e.Value?.ToString(), System.Globalization.NumberStyles.Number,
			System.Globalization.CultureInfo.InvariantCulture, out decimal valor) ? valor : 0m;

	/// <summary>
	/// Que el valor sea positivo lo decide esta pantalla: es un numero que la persona acaba de
	/// escribir aca, no un hecho del registro.
	/// </summary>
	private bool EsUnValorQuePuedoMandar(string finca) => ElValorEscritoDe(finca) > 0m;

	private async Task DeclararAsync(string finca)
	{
		if (!EsUnValorQuePuedoMandar(finca)) return;

		declarando = finca;
		try
		{
			loQuePaso = await estado.DeclararValorDeFincaAsync(finca, ElValorEscritoDe(finca));
		}
		finally
		{
			declarando = "";
			Releer();
		}
	}
}
