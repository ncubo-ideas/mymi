@page "/por-que-pago-mas"
@inject EstadoDeLaApp estado
@inject Textos textos
@using System.Linq

<PageTitle>Cambios en mis cobros · @Textos.TituloDelModulo</PageTitle>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <div class="fondo-noche">
        <div class="titulo-con-volver">
            <a class="volver" href="" aria-label="Volver a Inicio">&larr;</a>
            <h1>Cambios en mis cobros</h1>
        </div>
        <p class="subtitulo-pagina">Qué cambió entre tus comprobantes y qué puede explicarlo.</p>

        @if (variacion.AlgunoSePuedeVer)
        {
            <div class="tarjeta-estado" id="resumen-cambios">
                <span class="tarjeta-estado__icono"><IconoSprite Nombre="tendencia" /></span>
                <span class="tarjeta-estado__texto">
                    <span class="tarjeta-estado__estado">@ResumenTitulo()</span>
                    <span class="tarjeta-estado__detalle">@ResumenNota()</span>
                </span>
            </div>
        }
        else
        {
            <Aviso Tono="tibia" Id="ninguna-variacion" Titulo="@textos["porQuePagoMas.sinVariacion.titulo"]">
                <p>@textos["porQuePagoMas.sinVariacion.cuerpo"]</p>
            </Aviso>
        }

        @{ var conCambios = variacion.Rubros.Where(r => r.SePuedeVer).ToList(); }
        @if (conCambios.Count > 0)
        {
            <h2>Cobros con cambios</h2>
            <div class="rubros-cambio">
                @foreach (var rubro in conCambios)
                {
                    <details class="rubro-cambio" id="@("rubro-" + rubro.Rubro)">
                        <summary class="rubro-cambio__resumen">
                            <span class="rubro-cambio__icono"><IconoSprite Nombre="@NombreLegible.IconoDelRubro(rubro.Rubro)" /></span>
                            <span class="rubro-cambio__info">
                                <span class="rubro-cambio__cabeza">
                                    <span class="rubro-cambio__nombre"><LlaveDelRubro Rubro="@rubro.Rubro" /></span>
                                    <span class="sello sello--@(rubro.EsSalto ? "salto" : "quieto")">
                                        @textos.ComoSeDice(rubro.Explicacion)
                                    </span>
                                </span>
                                <span class="rubro-cambio__montos">
                                    @Colones.Formatear(textos, rubro.Antes) &rarr; @Colones.Formatear(textos, rubro.Ahora)
                                </span>
                                @if (rubro.EsSalto)
                                {
                                    <span class="rubro-cambio__cambio">
                                        <span class="rubro-cambio__flecha rubro-cambio__flecha--atencion">@Flecha(rubro.Proporcion)</span>
                                        <span class="rubro-cambio__porcentaje rubro-cambio__porcentaje--atencion">@textos.Porcentaje(Math.Abs(rubro.Proporcion))</span>
                                        <span class="rubro-cambio__nota" style="margin:0">por período</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="rubro-cambio__cambio-leve">
                                        @Signo(rubro.Proporcion)@textos.Porcentaje(Math.Abs(rubro.Proporcion)) por período
                                    </span>
                                }
                                <span class="rubro-cambio__periodo">@NombreLegible.Periodo(rubro.Desde) &rarr; @NombreLegible.Periodo(rubro.Hasta)</span>
                                <span class="rubro-cambio__toggle">
                                    <span class="rubro-cambio__toggle-abrir">Ver explicación</span>
                                    <span class="rubro-cambio__toggle-cerrar">Ocultar explicación</span>
                                    <span class="rubro-cambio__toggle-chevron" aria-hidden="true">&rsaquo;</span>
                                </span>
                            </span>
                        </summary>
                        <div class="rubro-cambio__detalle">
                            <p class="item__frase">@rubro.Dice</p>
                        </div>
                    </details>
                }
            </div>
        }

        @{ var sinDatos = variacion.Rubros.Where(r => !r.SePuedeVer).ToList(); }
        @if (sinDatos.Count > 0)
        {
            <section class="bloque" id="sin-datos-todavia">
                <h2>Aún no podemos comparar</h2>
                <div class="rubros-cambio">
                    @foreach (var rubro in sinDatos)
                    {
                        <details class="rubro-cambio">
                            <summary class="rubro-cambio__resumen">
                                <span class="rubro-cambio__icono"><IconoSprite Nombre="@NombreLegible.IconoDelRubro(rubro.Rubro)" /></span>
                                <span class="rubro-cambio__info">
                                    <span class="rubro-cambio__cabeza">
                                        <span class="rubro-cambio__nombre"><LlaveDelRubro Rubro="@rubro.Rubro" /></span>
                                        <span class="sello">Sin historial suficiente</span>
                                    </span>
                                    <span class="rubro-cambio__toggle">
                                        <span class="rubro-cambio__toggle-abrir">Ver explicación</span>
                                        <span class="rubro-cambio__toggle-cerrar">Ocultar explicación</span>
                                        <span class="rubro-cambio__toggle-chevron" aria-hidden="true">&rsaquo;</span>
                                    </span>
                                </span>
                            </summary>
                            <div class="rubro-cambio__detalle">
                                <p class="item__frase">@rubro.Dice</p>
                            </div>
                        </details>
                    }
                </div>
            </section>
        }

        @if (fincas.HayAlguna)
        {
            <section class="bloque" id="el-valor-de-mi-finca">
                <h2>@textos["porQuePagoMas.finca.titulo"]</h2>
                <p class="explicacion-menor">Este dato puede influir en algunos cobros municipales.</p>

                <details class="disclosure-secundaria">
                    <summary class="disclosure-secundaria__resumen">
                        <span class="disclosure-secundaria__icono" aria-hidden="true">ⓘ</span>
                        <span class="disclosure-secundaria__texto">Ver detalle de tus fincas</span>
                        <span class="disclosure-secundaria__chevron" aria-hidden="true">&rsaquo;</span>
                    </summary>
                    <div class="disclosure-secundaria__contenido">
                        <p class="item__frase">@((MarkupString)textos["porQuePagoMas.finca.nota"])</p>

                        @foreach (var finca in fincas.Fincas)
                        {
                            <p class="item__meta" style="display:block;margin-top:.625rem">
                                <LlaveDelRubro Rubro="@finca.Numero" /> —
                                <strong>@(finca.TieneAvaluo ? textos.Con("porQuePagoMas.finca.avaluo", ("monto", textos.Monto(finca.Avaluo))) : textos["porQuePagoMas.finca.sinAvaluo"])</strong>
                            </p>
                            @if (!finca.TieneAvaluo)
                            {
                                <p class="item__frase">@textos["porQuePagoMas.finca.sinAvaluoNota"]</p>
                            }
                        }
                    </div>
                </details>
            </section>
        }

        <p class="nota">
            @textos["porQuePagoMas.pie"]
            <a href="que-se-me-vence">pagos y vencimientos</a>.
        </p>

        <details class="plomeria">
            <summary>¿Cómo detectamos estos cambios?</summary>
            <NumeroSinFirmar Dicho="@textos.Con("porQuePagoMas.umbrales",
                ("salto", textos.Porcentaje(variacion.UmbralDeSalto)),
                ("ruido", textos.Porcentaje(variacion.Ruido)))" />
        </details>
    </div>
}

@code {
	private LaVariacionDeCadaRubro variacion;
	private LasFincasQueTengo fincas;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla, y las dos partes del mismo momento.</summary>
	private void Releer()
	{
		if (!estado.EstaArriba) return;

		variacion = estado.LeerLaVariacionDeCadaRubro();
		fincas = estado.LeerLasFincas();
	}

	private static string Flecha(decimal proporcion) => proporcion switch
	{
		> 0 => "↑",
		< 0 => "↓",
		_ => "→",
	};

	/// <summary>
	/// El color de la flecha/porcentaje lo decide si el CAMBIO ES SIGNIFICATIVO (EsSalto), no su
	/// signo: un aumento de 1,7% no debe verse tan alarmante como uno de 60%. "Atencion" es amarillo
	/// (destaca algo importante); "neutro" es el gris azulado de siempre.
	/// </summary>
	/// <summary>
	/// El signo para un cambio que el dominio NO considera salto: sigue siendo el numero real,
	/// solo que sin la flecha grande ni el color de atencion que se reservan para los saltos.
	/// </summary>
	private static string Signo(decimal proporcion) => proporcion switch
	{
		> 0 => "+",
		< 0 => "-",
		_ => "",
	};

	private string ResumenTitulo()
	{
		int n = variacion.Rubros.Count(r => r.SePuedeVer && r.EsSalto);
		if (n == 0) return "Ningún cobro tuvo cambios importantes";
		return n == 1 ? "1 cobro tuvo un cambio importante" : $"{n} cobros tuvieron cambios importantes";
	}

	private string ResumenNota()
	{
		int n = variacion.Rubros.Count(r => r.SePuedeVer && r.EsSalto);
		return n == 0 ? "Los cambios que vimos son pequeños." : "Te mostramos cuáles y qué los explica.";
	}
}
