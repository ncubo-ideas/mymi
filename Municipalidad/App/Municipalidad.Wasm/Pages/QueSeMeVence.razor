@page "/que-se-me-vence"
@inject EstadoDeLaApp estado
@inject Textos textos

<PageTitle>@textos["queSeMeVence.titulo"] · @Textos.TituloDelModulo</PageTitle>

<h1>@textos["queSeMeVence.titulo"]</h1>
<p class="bajada">@textos["queSeMeVence.bajada"]</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <NumeroSinFirmar Dicho="@textos.Con("queSeMeVence.umbrales", ("dias", Formato.Dias(vence.DiasDeAviso, textos.Idioma)), ("tasa", Formato.Porcentaje(vence.TasaConQueSeProyecto, textos.Idioma)))" />

    <section class="bloque" id="por-vencer">
        <h2>@textos["queSeMeVence.porVencer"]</h2>

        @if (vence.PorVencer.Count == 0)
        {
            <p class="nota">@textos.Con("queSeMeVence.nadaPorVencer",
                ("dia", vence.PreguntadoEl),
                ("dias", Formato.Dias(vence.DiasDeAviso, textos.Idioma)))</p>
        }

        @foreach (var periodo in vence.PorVencer)
        {
            <article class="tarjeta">
                <div class="tarjeta__cabeza">
                    <LlaveDelRubro Rubro="@periodo.Rubro" />
                    <span class="periodo">@periodo.Periodo</span>
                    <SelloDeUrgencia Urgencia="@periodo.Urgencia" />
                </div>

                <Frase Dice="@periodo.Dice" />

                <dl class="renglones">
                    <dt>@textos["queSeMeVence.vence"]</dt>
                    <dd>@periodo.Vence</dd>
                    <dt>@textos["queSeMeVence.faltan"]</dt>
                    <dd>@Formato.Dias(periodo.Faltan, textos.Idioma)</dd>
                    <dt>@textos["queSeMeVence.monto"]</dt>
                    <dd>@Formato.Monto(periodo.Monto, textos.Idioma)</dd>
                </dl>
            </article>
        }
    </section>

    <section class="bloque" id="vencidos">
        <h2>@textos["queSeMeVence.yaVencidos"]</h2>

        @if (vence.Vencidos.Count == 0)
        {
            <p class="nota">@textos["queSeMeVence.nadaVencido"]</p>
        }

        @foreach (var periodo in vence.Vencidos)
        {
            <article class="tarjeta">
                <div class="tarjeta__cabeza">
                    <LlaveDelRubro Rubro="@periodo.Rubro" />
                    <span class="periodo">@periodo.Periodo</span>
                    <SelloDeUrgencia Urgencia="@periodo.Urgencia" />
                </div>

                <Frase Dice="@periodo.Dice" />

                <dl class="renglones">
                    <dt>@textos["queSeMeVence.vencio"]</dt>
                    <dd>@periodo.Vencio</dd>
                    <dt>@textos["queSeMeVence.deAtraso"]</dt>
                    <dd>@Formato.Dias(periodo.Dias, textos.Idioma)</dd>
                    <dt>@textos["queSeMeVence.monto"]</dt>
                    <dd>@Formato.Monto(periodo.Monto, textos.Idioma)</dd>
                    <dt>@textos["queSeMeVence.proyeccionDeMora"]</dt>
                    <dd>@Formato.Monto(periodo.CostoProyectado, textos.Idioma)</dd>
                </dl>
            </article>
        }
    </section>

    <Aviso Tono="quieta" Id="las-dos-no-se-suman" Titulo="@textos["queSeMeVence.noSeSuman"]">
        <p>@textos["queSeMeVence.noSeSumanCuerpo"]</p>
    </Aviso>

    <p class="nota">@textos.Con("comun.contestadoAl", ("dia", vence.PreguntadoEl))</p>
}

@code {
	private LoQueSeVence vence;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla: las dos listas del mismo momento.</summary>
	private void Releer()
	{
		if (estado.EstaArriba) vence = estado.LeerLoQueSeVence();
	}
}
