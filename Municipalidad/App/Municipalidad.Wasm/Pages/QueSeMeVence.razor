@page "/que-se-me-vence"
@inject EstadoDeLaApp estado
@using System.Linq

<PageTitle>Pagos y vencimientos · Mi cuenta municipal</PageTitle>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <div class="fondo-noche">
        <h1>Pagos y vencimientos</h1>
        <p class="subtitulo-pagina">Lo que está por vencer y lo que ya venció.</p>

        <section class="bloque" id="por-vencer">
            <div class="seccion-cabeza">
                <div class="seccion-cabeza__titulo">
                    <h2>Por vencer</h2>
                    @if (vence.PorVencer.Count > 0)
                    {
                        <span class="seccion-cuenta">@Cuantos(vence.PorVencer.Count)</span>
                    }
                </div>
                @if (vence.PorVencer.Count > 0)
                {
                    <span class="seccion-total">Total: @Formato.Monto(vence.PorVencer.Sum(p => p.Monto))</span>
                }
            </div>

            @if (vence.PorVencer.Count == 0)
            {
                <p class="estado-vacio">
                    <span class="estado-vacio__marca">✓</span>
                    Nada vence en los próximos @Formato.Dias(vence.DiasDeAviso)
                </p>
                <p class="nota">
                    Eso no dice que no tengás nada que pagar más adelante: dice que nada cae dentro de esa
                    ventana, contado desde el @vence.PreguntadoEl.
                </p>
            }
            else
            {
                <div class="obligaciones">
                    @foreach (var periodo in vence.PorVencer)
                    {
                        <details class="obligacion">
                            <summary class="obligacion__resumen">
                                <IconoSprite Nombre="calendario-chico" />
                                <span class="obligacion__info">
                                    <span class="obligacion__rubro"><LlaveDelRubro Rubro="@periodo.Rubro" /></span>
                                    <span class="obligacion__fecha">Vence @periodo.Vence</span>
                                    <SelloDeUrgencia Urgencia="@periodo.Urgencia" />
                                </span>
                                <span class="obligacion__lado">
                                    <span class="obligacion__monto">@Formato.Monto(periodo.Monto)</span>
                                    <span class="obligacion__chevron" aria-hidden="true">&rsaquo;</span>
                                </span>
                            </summary>
                            <div class="obligacion__detalle">
                                <dl class="renglones">
                                    <dt>Período</dt>
                                    <dd>@periodo.Periodo</dd>
                                    <dt>Vence</dt>
                                    <dd>@periodo.Vence</dd>
                                    <dt>Faltan</dt>
                                    <dd>@Formato.Dias(periodo.Faltan)</dd>
                                    <dt>Monto</dt>
                                    <dd>@Formato.Monto(periodo.Monto)</dd>
                                </dl>
                                <p class="item__frase">@periodo.Dice</p>
                            </div>
                        </details>
                    }
                </div>
            }
        </section>

        <section class="bloque" id="vencidos">
            <div class="seccion-cabeza">
                <div class="seccion-cabeza__titulo">
                    <h2>Vencidos</h2>
                    @if (vence.Vencidos.Count > 0)
                    {
                        <span class="seccion-cuenta">@Cuantos(vence.Vencidos.Count)</span>
                    }
                </div>
                @if (vence.Vencidos.Count > 0)
                {
                    <span class="seccion-total">Total: @Formato.Monto(vence.Vencidos.Sum(p => p.Monto))</span>
                }
            </div>

            @if (vence.Vencidos.Count == 0)
            {
                <p class="estado-vacio">
                    <span class="estado-vacio__marca">✓</span>
                    No hay nada vencido sin pagar en lo que esta app ha visto
                </p>
                <p class="nota">
                    Eso no es una constancia de estar al día con la municipalidad: tu portal es la
                    autoridad sobre eso.
                </p>
            }
            else
            {
                <div class="obligaciones">
                    @foreach (var periodo in vence.Vencidos)
                    {
                        <details class="obligacion">
                            <summary class="obligacion__resumen">
                                <IconoSprite Nombre="calendario-chico" />
                                <span class="obligacion__info">
                                    <span class="obligacion__rubro"><LlaveDelRubro Rubro="@periodo.Rubro" /></span>
                                    <span class="obligacion__fecha">Venció @periodo.Vencio</span>
                                    <span class="badge-atraso">@Formato.Dias(periodo.Dias) de atraso</span>
                                </span>
                                <span class="obligacion__lado">
                                    <span class="obligacion__monto">@Formato.Monto(periodo.Monto)</span>
                                    <span class="obligacion__chevron" aria-hidden="true">&rsaquo;</span>
                                </span>
                            </summary>
                            <div class="obligacion__detalle">
                                <dl class="renglones">
                                    <dt>Período</dt>
                                    <dd>@periodo.Periodo</dd>
                                    <dt>Venció</dt>
                                    <dd>@periodo.Vencio</dd>
                                    <dt>De atraso</dt>
                                    <dd>@Formato.Dias(periodo.Dias)</dd>
                                    <dt>Monto</dt>
                                    <dd>@Formato.Monto(periodo.Monto)</dd>
                                    <dt>Proyección de mora</dt>
                                    <dd>@Formato.Monto(periodo.CostoProyectado)</dd>
                                </dl>
                                <p class="item__frase">@periodo.Dice</p>
                            </div>
                        </details>
                    }
                </div>
            }
        </section>

        <Aviso Tono="quieta" Id="las-dos-no-se-suman" Titulo="Las dos listas no se suman">
            <p>
                Un período por vencer y uno vencido son situaciones distintas, y un total que los mezcle
                no es un número que nadie haya calculado. Si querés saber cuánto debés en total, eso lo
                dice tu portal.
            </p>
        </Aviso>

        <details class="plomeria">
            <summary>ⓘ Sobre los vencimientos</summary>
            <NumeroSinFirmar Dicho="@($"Se avisa {Formato.Dias(vence.DiasDeAviso)} antes del vencimiento, y el costo de pagar tarde se proyecta a una tasa anual del {Formato.Porcentaje(vence.TasaConQueSeProyecto)}.")" />
        </details>

        <p class="nota">Contestado al @vence.PreguntadoEl.</p>
    </div>
}

@code {
	private LoQueSeVence vence;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla: las dos listas del mismo momento.</summary>
	private void Releer()
	{
		if (!estado.EstaArriba) return;

		vence = estado.LeerLoQueSeVence();
	}

	private static string Cuantos(int n) => n == 1 ? "1 pago" : $"{n} pagos";
}
