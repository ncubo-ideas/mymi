@page "/sin-comprobante"
@inject EstadoDeLaApp estado
@inject Textos textos

<PageTitle>@textos["sinComprobante.encabezado"] · @Textos.TituloDelModulo</PageTitle>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <div class="fondo-noche">
        <div class="titulo-con-volver">
            <a class="volver" href="" aria-label="@textos["nav.volverAInicio"]">&larr;</a>
            <h1>@textos["sinComprobante.encabezado"]</h1>
        </div>
        <p class="subtitulo-pagina">@textos["sinComprobante.subtitulo"]</p>

        @if (!cotejo.HayAlgunaConsulta)
        {
            <Aviso Tono="tibia" Id="sin-consulta" Titulo="@textos["sinComprobante.sinConsulta"]">
                <Frase Dice="@cotejo.Dice" Apagada="true" />
            </Aviso>

            <details class="disclosure-secundaria">
                <summary class="disclosure-secundaria__resumen">
                    <span class="disclosure-secundaria__icono" aria-hidden="true">ⓘ</span>
                    <span class="disclosure-secundaria__texto">@textos["sinComprobante.queSignificaNoPoderCotejar"]</span>
                    <span class="disclosure-secundaria__chevron" aria-hidden="true">&rsaquo;</span>
                </summary>
                <div class="disclosure-secundaria__contenido">
                    <p class="item__frase">@((MarkupString)textos["sinComprobante.sinConsultaCuerpo"])</p>
                </div>
            </details>
        }
        else if (cotejo.Periodos.Count == 0)
        {
            <div class="aviso-tranquilo">
                <p class="estado-vacio">
                    <span class="estado-vacio__marca">✓</span>
                    @textos["sinComprobante.ningunPagoSinComprobante"]
                </p>
                <p class="explicacion-menor">@cotejo.Dice</p>
            </div>

            <p class="nota">@textos["sinComprobante.cotejadoConElPortal"] @NombreLegible.Fecha(cotejo.DiaDeLaConsulta)</p>
        }
        else
        {
            <div class="tarjeta-estado tarjeta-estado--compacta" id="resumen-comprobantes">
                <span class="tarjeta-estado__icono"><IconoSprite Nombre="calendario-chico" /></span>
                <span class="tarjeta-estado__texto">
                    <span class="tarjeta-estado__estado">@ResumenTitulo()</span>
                    <span class="tarjeta-estado__detalle">@textos["sinComprobante.pagosApareceSaldados"]</span>
                </span>
            </div>

            <h2>@textos["sinComprobante.pagosEncontrados"]</h2>
            <div class="rubros-cambio">
                @foreach (var periodo in cotejo.Periodos)
                {
                    <details class="rubro-cambio rubro-cambio--compacta">
                        <summary class="rubro-cambio__resumen">
                            <span class="rubro-cambio__icono"><IconoSprite Nombre="@NombreLegible.IconoDelRubro(periodo.Rubro)" /></span>
                            <span class="rubro-cambio__info">
                                <span class="rubro-cambio__cabeza">
                                    <span class="rubro-cambio__nombre"><LlaveDelRubro Rubro="@periodo.Rubro" /></span>
                                    <span class="periodo" style="margin:0">@NombreLegible.Periodo(periodo.Periodo)</span>
                                </span>
                                <span class="comprobante-estados">
                                    <span class="comprobante-estado comprobante-estado--pagado">@textos["sinComprobante.pagadoSegunPortal"]</span>
                                    <span class="comprobante-estado comprobante-estado--pendiente">@textos["sinComprobante.comprobantePendiente"]</span>
                                </span>
                                <span class="rubro-cambio__toggle">
                                    <span class="rubro-cambio__toggle-abrir">@textos["sinComprobante.verDetalle"]</span>
                                    <span class="rubro-cambio__toggle-cerrar">@textos["sinComprobante.ocultarDetalle"]</span>
                                    <span class="rubro-cambio__toggle-chevron" aria-hidden="true">&rsaquo;</span>
                                </span>
                            </span>
                        </summary>
                        <div class="rubro-cambio__detalle">
                            <p class="item__frase">@periodo.Dice</p>
                        </div>
                    </details>
                }
            </div>

            <section class="bloque" id="pagos-aparecen-pagados">
                <h2>@textos["sinComprobante.estosPagosAparecen"]</h2>
                <p class="explicacion-menor">@textos["sinComprobante.explicacionPagados"]</p>

                <details class="disclosure-secundaria">
                    <summary class="disclosure-secundaria__resumen">
                        <span class="disclosure-secundaria__icono" aria-hidden="true">ⓘ</span>
                        <span class="disclosure-secundaria__texto">@textos["sinComprobante.porQuePuedePasar"]</span>
                        <span class="disclosure-secundaria__chevron" aria-hidden="true">&rsaquo;</span>
                    </summary>
                    <div class="disclosure-secundaria__contenido">
                        <p class="item__frase">@textos["sinComprobante.noEsDeudaCuerpo"]</p>
                    </div>
                </details>
            </section>

            <p class="nota">@textos["sinComprobante.cotejadoConElPortal"] @NombreLegible.Fecha(cotejo.DiaDeLaConsulta)</p>

            <details class="plomeria">
                <summary>@textos["sinComprobante.queSignificaEstaFecha"]</summary>
                <p class="item__frase">@textos.Con("sinComprobante.fotoConFecha", ("dia", cotejo.DiaDeLaConsulta))</p>
            </details>
        }
    </div>
}

@code {
	private LoSinComprobante cotejo;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla.
	private void Releer()
	{
		if (estado.EstaArriba) cotejo = estado.LeerLoSinComprobante();
	}

	private string ResumenTitulo()
	{
		int n = cotejo.Periodos.Count;
		return n == 1 ? "1 pago sin comprobante" : $"{n} pagos sin comprobante";
	}
}
