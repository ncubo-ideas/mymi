@page "/sin-comprobante"
@inject EstadoDeLaApp estado
@inject Textos textos

<PageTitle>@textos["sinComprobante.titulo"] · @Textos.TituloDelModulo</PageTitle>

<h1>@textos["sinComprobante.titulo"]</h1>
<p class="bajada">@textos["sinComprobante.bajada"]</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    @if (!cotejo.HayAlgunaConsulta)
    {
        <Aviso Tono="tibia" Id="sin-consulta" Titulo="@textos["sinComprobante.sinConsulta"]">
            <Frase Dice="@cotejo.Dice" Apagada="true" />
            <p>@((MarkupString)textos["sinComprobante.sinConsultaCuerpo"])</p>
        </Aviso>
    }
    else
    {
        <article class="tarjeta" id="el-estado">
            <div class="tarjeta__cabeza">
                <span class="sello sello--@cotejo.Estado">@textos.ComoSeDice(cotejo.Estado)</span>
                <span class="periodo">@textos.Con("sinComprobante.cotejadoContra", ("dia", cotejo.DiaDeLaConsulta))</span>
            </div>

            <Frase Dice="@cotejo.Dice" />
        </article>

        @foreach (var periodo in cotejo.Periodos)
        {
            <article class="tarjeta">
                <div class="tarjeta__cabeza">
                    <LlaveDelRubro Rubro="@periodo.Rubro" />
                    <span class="periodo">@periodo.Periodo</span>
                </div>

                <Frase Dice="@periodo.Dice" />
            </article>
        }

        @if (cotejo.Periodos.Count > 0)
        {
            <Aviso Tono="quieta" Id="no-es-una-deuda" Titulo="@textos["sinComprobante.noEsDeuda"]">
                <p>@textos["sinComprobante.noEsDeudaCuerpo"]</p>
            </Aviso>
        }

        <p class="nota">@textos.Con("sinComprobante.fotoConFecha", ("dia", cotejo.DiaDeLaConsulta))</p>
    }
}

@code {
	private LoSinComprobante cotejo;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla.</summary>
	private void Releer()
	{
		if (estado.EstaArriba) cotejo = estado.LeerLoSinComprobante();
	}
}
