@page "/cuanto-apartar"
@inject EstadoDeLaApp estado

<PageTitle>Cuánto apartar · Mi cuenta municipal</PageTitle>

<h1>Cuánto apartar</h1>
<p class="bajada">
    Dos cosas de dos dueños: lo que <strong>esta app propone</strong> a partir de lo que ya
    pagaste, y lo que <strong>vos adoptaste</strong>. Que no coincidan no es un error.
</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <section class="bloque" id="la-propuesta">
        <h2>Lo que esta app propone</h2>

        <article class="tarjeta">
            <Frase Dice="@reserva.DiceLaPropuesta" Apagada="@(!reserva.SePuedeProponer)" />

            @if (reserva.SePuedeProponer)
            {
                <dl class="renglones">
                    <dt>Proyección de @reserva.Anio</dt>
                    <dd>@Formato.Monto(reserva.ProyeccionDelAnio)</dd>
                    <dt>Por mes</dt>
                    <dd class="cifra">@Formato.Monto(reserva.PropuestoPorMes)</dd>
                </dl>
            }
        </article>
    </section>

    <section class="bloque" id="lo-adoptado">
        <h2>Lo que vos adoptaste</h2>

        <article class="tarjeta">
            <div class="tarjeta__cabeza">
                <SelloDeUrgencia Urgencia="@reserva.Urgencia" />
            </div>

            <Frase Dice="@reserva.DiceElFaltante" Apagada="@(!reserva.HayReservaAdoptada)" />

            @if (reserva.HayReservaAdoptada)
            {
                <dl class="renglones">
                    <dt>Adoptado por mes</dt>
                    <dd class="cifra">@Formato.Monto(reserva.AdoptadoPorMes)</dd>
                    <dt>Le falta</dt>
                    <dd>@Formato.Monto(reserva.Faltante) (@Formato.Porcentaje(reserva.ProporcionDelFaltante))</dd>
                    <dt>Vence este mes</dt>
                    <dd>@Formato.Monto(reserva.VenceEsteMes)</dd>
                </dl>
            }
        </article>

        <NumeroSinFirmar Firmado="true"
                         Dia="@Municipalidad.App.LosJuiciosSinFirmar.DiaEnQueSeFirmoElUmbralDeReserva"
                         Dicho="@($"Se te avisa cuando lo adoptado queda más de un {Formato.Porcentaje(reserva.UmbralConQueSeAvisa)} por debajo de lo propuesto.")" />

        <div class="aporte" id="adoptar">
            <label for="monto-a-apartar">Adoptar una reserva, en colones por mes</label>
            <div class="aporte__linea">
                <input id="monto-a-apartar" type="number" min="1" step="1" inputmode="numeric"
                       @bind="montoAAdoptar" @bind:event="oninput" disabled="@adoptando" />
                <button type="button" id="adoptar-reserva" @onclick="AdoptarAsync"
                        disabled="@(adoptando || !EsUnMontoQuePuedoMandar())">
                    @(adoptando ? "Guardando…" : "Adoptar")
                </button>
            </div>
            <p class="nota">
                Es tuyo y no de la municipalidad: nadie lo revisa y no cambia lo que te cobran. Se
                puede adoptar una vez por día, y el último que pongás es el que rige.
            </p>
        </div>

        @if (loQuePaso is not null)
        {
            @if (loQuePaso.QuedoSinRespaldo)
            {
                <Aviso Tono="mala" Id="aporte-sin-respaldo" Titulo="Quedó registrado y NO se guardó.">
                    <p>@loQuePaso.Dice</p>
                </Aviso>
            }
            else if (loQuePaso.QuedoRegistrado)
            {
                <Aviso Tono="quieta" Id="aporte-entro" Titulo="Listo, quedó tuyo.">
                    <p>Tu reserva quedó registrada y guardada en tu carpeta.</p>
                </Aviso>
            }
            else
            {
                <Aviso Tono="tibia" Id="aporte-rechazado" Titulo="No se registró, y ésta es la razón.">
                    <p>@loQuePaso.Dice</p>
                </Aviso>
            }
        }
    </section>

    <p class="nota">Contestado al @reserva.PreguntadoEl.</p>
}

@code {
	private LaReservaDeEsteAnio reserva;

	private decimal montoAAdoptar;
	private bool adoptando;
	private LoQueDijoElAporte loQuePaso;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla: las dos mitades del mismo momento.</summary>
	private void Releer()
	{
		if (estado.EstaArriba) reserva = estado.LeerLaReserva();
	}

	/// <summary>
	/// Que el monto sea positivo lo decide esta pantalla y no el dominio: es un numero que la persona
	/// acaba de escribir aca, asi que no hace falta gastar un rechazo del registro en el.
	/// </summary>
	private bool EsUnMontoQuePuedoMandar() => montoAAdoptar > 0m;

	private async Task AdoptarAsync()
	{
		if (!EsUnMontoQuePuedoMandar()) return;

		adoptando = true;
		try
		{
			loQuePaso = await estado.AdoptarReservaAsync(montoAAdoptar);
		}
		finally
		{
			adoptando = false;
			Releer();
		}
	}
}
