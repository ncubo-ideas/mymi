@page "/cuanto-apartar"
@inject EstadoDeLaApp estado
@inject Textos textos

<PageTitle>@textos["cuantoApartar.titulo"] · @Textos.TituloDelModulo</PageTitle>

<h1>@textos["cuantoApartar.titulo"]</h1>
<p class="bajada">@((MarkupString)textos["cuantoApartar.bajada"])</p>

@if (!estado.EstaArriba)
{
    <SinAbrir />
}
else
{
    <section class="bloque" id="la-propuesta">
        <h2>@textos["cuantoApartar.laPropuesta"]</h2>

        <article class="tarjeta">
            <Frase Dice="@reserva.DiceLaPropuesta" Apagada="@(!reserva.SePuedeProponer)" />

            @if (reserva.SePuedeProponer)
            {
                <dl class="renglones">
                    <dt>@textos.Con("cuantoApartar.proyeccionDe", ("anio", reserva.Anio.ToString()))</dt>
                    <dd>@Formato.Monto(reserva.ProyeccionDelAnio, textos.Idioma)</dd>
                    <dt>@textos["cuantoApartar.porMes"]</dt>
                    <dd class="cifra">@Formato.Monto(reserva.PropuestoPorMes, textos.Idioma)</dd>
                </dl>
            }
        </article>
    </section>

    <section class="bloque" id="lo-adoptado">
        <h2>@textos["cuantoApartar.loAdoptado"]</h2>

        <article class="tarjeta">
            <div class="tarjeta__cabeza">
                <SelloDeUrgencia Urgencia="@reserva.Urgencia" />
            </div>

            <Frase Dice="@reserva.DiceElFaltante" Apagada="@(!reserva.HayReservaAdoptada)" />

            @if (reserva.HayReservaAdoptada)
            {
                <dl class="renglones">
                    <dt>@textos["cuantoApartar.adoptadoPorMes"]</dt>
                    <dd class="cifra">@Formato.Monto(reserva.AdoptadoPorMes, textos.Idioma)</dd>
                    <dt>@textos["cuantoApartar.leFalta"]</dt>
                    <dd>@Formato.Monto(reserva.Faltante, textos.Idioma) (@Formato.Porcentaje(reserva.ProporcionDelFaltante, textos.Idioma))</dd>
                    <dt>@textos["cuantoApartar.venceEsteMes"]</dt>
                    <dd>@Formato.Monto(reserva.VenceEsteMes, textos.Idioma)</dd>
                </dl>
            }
        </article>

        <NumeroSinFirmar Firmado="true"
                         Dia="@Municipalidad.App.LosJuiciosSinFirmar.DiaEnQueSeFirmoElUmbralDeReserva"
                         Dicho="@textos.Con("cuantoApartar.umbral", ("umbral", Formato.Porcentaje(reserva.UmbralConQueSeAvisa, textos.Idioma)))" />

        <div class="aporte" id="adoptar">
            <label for="monto-a-apartar">@textos["cuantoApartar.etiquetaDelAporte"]</label>
            <div class="aporte__linea">
                <input id="monto-a-apartar" type="number" min="1" step="1" inputmode="numeric"
                       @bind="montoAAdoptar" @bind:event="oninput" disabled="@adoptando" />
                <button type="button" id="adoptar-reserva" @onclick="AdoptarAsync"
                        disabled="@(adoptando || !EsUnMontoQuePuedoMandar())">
                    @(adoptando ? textos["cuantoApartar.guardando"] : textos["cuantoApartar.adoptar"])
                </button>
            </div>
            <p class="nota">@textos["cuantoApartar.notaDelAporte"]</p>
        </div>

        @if (loQuePaso is not null)
        {
            @if (loQuePaso.QuedoSinRespaldo)
            {
                <Aviso Tono="mala" Id="aporte-sin-respaldo" Titulo="@textos["cuantoApartar.sinRespaldo"]">
                    <p>@textos.Diga(loQuePaso.Apunte)</p>
                </Aviso>
            }
            else if (loQuePaso.QuedoRegistrado)
            {
                <Aviso Tono="quieta" Id="aporte-entro" Titulo="@textos["cuantoApartar.entro"]">
                    <p>@textos["cuantoApartar.entroCuerpo"]</p>
                </Aviso>
            }
            else
            {
                <Aviso Tono="tibia" Id="aporte-rechazado" Titulo="@textos["cuantoApartar.rechazado"]">
                    <p>@(loQuePaso.Dice.Length > 0 ? loQuePaso.Dice : textos.Diga(loQuePaso.Apunte))</p>
                </Aviso>
            }
        }
    </section>

    <p class="nota">@textos.Con("comun.contestadoAl", ("dia", reserva.PreguntadoEl))</p>
}

@code {
	private LaReservaDeEsteAnio reserva;

	private decimal montoAAdoptar;
	private bool adoptando;
	private LoQueDijoElAporte loQuePaso;

	protected override void OnInitialized() => Releer();

	/// <summary>La unica pasada de lectura de esta pantalla: las dos mitades del mismo momento.</summary>
	private void Releer()
	{
		if (estado.EstaArriba) reserva = estado.LeerLaReserva();
	}

	/// <summary>
	/// Que el monto sea positivo lo decide esta pantalla y no el dominio: es un numero que la persona
	/// acaba de escribir aca, asi que no hace falta gastar un rechazo del registro en el.
	/// </summary>
	private bool EsUnMontoQuePuedoMandar() => montoAAdoptar > 0m;

	private async Task AdoptarAsync()
	{
		if (!EsUnMontoQuePuedoMandar()) return;

		adoptando = true;
		try
		{
			loQuePaso = await estado.AdoptarReservaAsync(montoAAdoptar);
		}
		finally
		{
			adoptando = false;
			Releer();
		}
	}
}
