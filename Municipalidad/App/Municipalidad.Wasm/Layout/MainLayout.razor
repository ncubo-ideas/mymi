@inherits LayoutComponentBase
@inject Textos textos

<header class="marco">
    <div class="marco__banda">
        <a class="marco__marca" href="">
            <img src="images/mi-muni-t.png" alt="" class="marco__logo" />
            <span class="marco__titulos">
                <span class="marco__nombre">@Textos.TituloDelModulo</span>
                <span class="marco__apunte">@textos["app.apunte"]</span>
            </span>
        </a>

        <nav class="marco__nav">
            <NavLink href="por-que-pago-mas">@textos["porQuePagoMas.encabezado"]</NavLink>
            <NavLink href="que-se-me-vence">@textos["queSeMeVence.encabezado"]</NavLink>
            <NavLink href="cuanto-apartar">@textos["cuantoApartar.encabezado"]</NavLink>
            <NavLink href="sin-comprobante">@textos["sinComprobante.encabezado"]</NavLink>
            <NavLink href="cuanto-he-pagado">@textos["cuantoHePagado.titulo"]</NavLink>
            <NavLink href="que-tan-al-dia-esta">@textos["queTanAlDia.tituloCorto"]</NavLink>
        </nav>
    </div>
</header>

<main class="hoja">
    @Body
</main>

<nav class="pie-nav" aria-label="@textos["nav.navegacionPrincipal"]">
    <NavLink href="" Match="NavLinkMatch.All">
        <span class="pie-nav__icono"><img src="images/mi-muni-t.png" alt="" class="pie-nav__logo" /></span>
        <span>@textos["nav.inicio"]</span>
    </NavLink>
    <NavLink href="que-se-me-vence">
        <span class="pie-nav__icono"><IconoSprite Nombre="calendario-chico" /></span>
        <span>@textos["nav.pagos"]</span>
    </NavLink>
    <NavLink href="cuanto-apartar">
        <span class="pie-nav__icono"><IconoSprite Nombre="presupuesto-chico" /></span>
        <span>@textos["cuantoApartar.encabezado"]</span>
    </NavLink>
</nav>
