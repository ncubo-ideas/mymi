@inherits LayoutComponentBase

<header class="marco">
    <div class="marco__banda">
        <a class="marco__marca" href="">
            <img src="images/mi-muni-t.png" alt="" class="marco__logo" />
            <span class="marco__titulos">
                <span class="marco__nombre">Mi cuenta municipal</span>
                <span class="marco__apunte">Tu ciudad, en tu mano</span>
            </span>
        </a>

        <nav class="marco__nav">
            <NavLink href="por-que-pago-mas">Cambios en mis cobros</NavLink>
            <NavLink href="que-se-me-vence">Pagos y vencimientos</NavLink>
            <NavLink href="cuanto-apartar">Mi presupuesto</NavLink>
            <NavLink href="sin-comprobante">Pagos sin comprobante</NavLink>
        </nav>
    </div>
</header>

<main class="hoja">
    @Body
</main>

<nav class="pie-nav" aria-label="Navegación principal">
    <NavLink href="" Match="NavLinkMatch.All">
        <span class="pie-nav__icono"><img src="images/mi-muni-t.png" alt="" class="pie-nav__logo" /></span>
        <span>Inicio</span>
    </NavLink>
    <NavLink href="que-se-me-vence">
        <span class="pie-nav__icono"><IconoSprite Nombre="calendario-chico" /></span>
        <span>Pagos</span>
    </NavLink>
    <NavLink href="cuanto-apartar">
        <span class="pie-nav__icono"><IconoSprite Nombre="presupuesto-chico" /></span>
        <span>Mi presupuesto</span>
    </NavLink>
</nav>
