<Project Sdk="Microsoft.NET.Sdk">

  <!-- La superficie intencional de la app: donde viven los PerformCmd y PerformQry.
       La UI, el servidor MCP y la consola llaman a FacturasAPI, nunca al actor crudo.
       Que la logica sea UNA es lo que hace que la IA y la persona vean lo mismo.

       El motor viene por NuGet; la version esta en Directory.Build.props (raiz) para no
       repetirla en cada proyecto. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Dominio\Facturas.Dominio.csproj" />
    <ProjectReference Include="..\..\..\Mecanismo\Puppets.Portador\Puppets.Portador.csproj" />

    <!-- The cargo contract, compiled against but NOT copied (the Host lends its copy at run
         time). Private=false keeps it out of the OTHER consumers' output too. -->
    <ProjectReference Include="..\..\..\..\Gnothi.Contract\Gnothi.Contract.csproj"
                      ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

  <!-- Solo el core. Los tres paquetes de adapters (Adapters, Adapters.Sql,
       Adapters.Sockets) no se usan aca: la app solo necesita PerformanceV2, que viene en
       este. MEDIDO que agregarlos no cambia el payload del browser en un byte — 46 MB y
       199 assemblies con los cuatro o con solo este — porque sus dependencias no son
       compatibles con browser-wasm y quedan afuera. Un host que de verdad use SQL o
       sockets los agrega el. -->
  <ItemGroup>
    <PackageReference Include="Ncubo.Puppeteer" Version="$(VersionDelMotor)" />
  </ItemGroup>

</Project>
