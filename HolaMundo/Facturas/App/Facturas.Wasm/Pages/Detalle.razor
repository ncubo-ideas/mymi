@page "/factura/{Numero}"
@using Facturas.App.Vistas
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion
@inject Textos textos

<PageTitle>@textos.Con("detalle.titulo", ("numero", Numero))</PageTitle>

<button class="btn btn-outline-secondary mb-3" @onclick="Volver">&larr; @textos["detalle.volver"]</button>

@if (!estado.EstaArriba)
{
    <div class="alert alert-warning">
        @((MarkupString)textos["detalle.sinAbrir"])
    </div>
}
else if (error.Length > 0)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <h1>@textos.Con("detalle.titulo", ("numero", detalle.Numero))</h1>
    <p class="text-muted">
        @textos.Instante(detalle.Fecha)
    </p>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>@textos["detalle.columna.sku"]</th><th>@textos["detalle.columna.descripcion"]</th>
                <th class="text-end">@textos["detalle.columna.cantidad"]</th>
                <th class="text-end">@textos["detalle.columna.costoUnitario"]</th>
                <th class="text-end">@textos["detalle.columna.total"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LineaDeFactura linea in detalle.Lineas)
            {
                <tr>
                    <td><code>@linea.Sku</code></td>
                    <td>@linea.Descripcion</td>
                    <td class="text-end">@textos.Cuenta(linea.Cantidad)</td>
                    <td class="text-end">@textos.Monto(linea.CostoUnitario)</td>
                    <td class="text-end">@textos.Monto(linea.TotalDeLinea)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4" class="text-end">@textos["detalle.columna.total"]</td>
                <td class="text-end">@textos.Monto(detalle.Total)</td>
            </tr>
        </tfoot>
    </table>
}

@code {
    [Parameter] public string Numero { get; set; } = "";

    private FacturaDetallada detalle = new();
    private string error = "";

    protected override void OnParametersSet()
    {
        error = "";
        if (!estado.EstaArriba) return;

        // El dominio tira KeyNotFoundException si el numero no existe; la pantalla lo
        // traduce a un mensaje en vez de dejar reventar la UI.
        try { detalle = estado.Detalle(Numero); }
        catch (KeyNotFoundException) { error = textos.Con("detalle.noExiste", ("numero", Numero)); }
        catch (Exception ex) { error = textos.Con("detalle.fallo", ("numero", Numero), ("detalle", ex.Message)); }
    }

    private void Volver() => navegacion.NavigateTo("");
}
