<Solution>

  <!-- Solo Examenes. El negocio de Facturas vive en HolaMundo/ y es el ejemplo de
       referencia: lo mantiene Jonathan y sus proyectos no se listan aca, para que un
       cambio nuestro no le pise las rutas.

       Nuestro dominio esta BASADO en ese ejemplo, pero no es parte de el. -->

  <Project Path="Examenes/App/Examenes.App/Examenes.App.csproj" />
  <Project Path="Examenes/App/Examenes.Consola/Examenes.Consola.csproj" />
  <!-- La frontera de entrada, en su propio csproj: es el unico ensamblado de produccion
       que ve el dominio por dentro, y separarlo es lo que mantiene a Examenes.App cercada
       por el compilador. Ver el InternalsVisibleTo de Examenes.Dominio. -->
  <Project Path="Examenes/App/Examenes.Eventos/Examenes.Eventos.csproj" />
  <Project Path="Examenes/App/Examenes.Mcp/Examenes.Mcp.csproj" />
  <Project Path="Examenes/App/Examenes.Wasm/Examenes.Wasm.csproj" />
  <Project Path="Examenes/Dominio/Examenes.Dominio.csproj" />
  <Project Path="Examenes/EndPointDeEventos/Examenes.EventosMock.csproj" />
  <Project Path="Examenes/InyectorDeEventosDemo/Examenes.InyectorDeEventosDemo.csproj" />
  <Project Path="Examenes/Mecanismo/Puppets.Portador/Puppets.Portador.csproj" />
  <Project Path="Gnothi.Contract/Gnothi.Contract.csproj" />
  <Project Path="Gnothi.Host/Gnothi.Host.csproj" />

  <!-- Gate 2: our own agent loop, in its own projects BECAUSE it is designed to be
       deleted. The day an external assistant reaches the Host directly, these three go
       away and Gnothi.Host does not change a line. Gnothi.Assistant.Tests is what keeps
       that true: it fails if the loop ever names something internal to the Host.

       The Android app is NOT listed here on purpose. It targets net9.0-android and
       would break the build for anyone without that workload installed. -->
  <Project Path="Cargas/App/Cargas.App/Cargas.App.csproj" />
  <Project Path="Cargas/App/Cargas.Consola/Cargas.Consola.csproj" />
  <Project Path="Cargas/App/Cargas.Mcp/Cargas.Mcp.csproj" />
  <Project Path="Cargas/App/Cargas.Wasm/Cargas.Wasm.csproj" />
  <Project Path="Cargas/Dominio/Cargas.Dominio.csproj" />
  <Project Path="Cargas/EndPointDeEventos/Cargas.EventosMock.csproj" />
  <Project Path="Cargas/InyectorDeEventosDemo/Cargas.InyectorDeEventosDemo.csproj" />
  <!-- El Puppets.Portador de Cargas no se lista: el slnx rechaza dos proyectos con el
       mismo nombre (el de Examenes ya esta) y se compila igual via ProjectReference,
       como en Concesionario. -->

  <Project Path="Concesionario/App/Concesionario.App/Concesionario.App.csproj" />
  <Project Path="Concesionario/App/Concesionario.Consola/Concesionario.Consola.csproj" />
  <!-- La puerta, en su propio csproj: es el unico ensamblado de produccion que ve el dominio
       por dentro, y separarla es lo que mantiene a Concesionario.App cercada por el
       compilador. Ver el AssemblyInfo de Concesionario.Dominio. -->
  <Project Path="Concesionario/App/Concesionario.Frontera/Concesionario.Frontera.csproj" />
  <Project Path="Concesionario/App/Concesionario.Mcp/Concesionario.Mcp.csproj" />
  <Project Path="Concesionario/App/Concesionario.Wasm/Concesionario.Wasm.csproj" />
  <Project Path="Concesionario/Dominio/Concesionario.Dominio.csproj" />
  <Project Path="Concesionario/EndPointDeEventos/Concesionario.EventosMock.csproj" />
  <Project Path="Concesionario/InyectorDeEventosDemo/Concesionario.InyectorDeEventosDemo.csproj" />
  <Project Path="Concesionario/Pruebas/Concesionario.Dominio.Pruebas/Concesionario.Dominio.Pruebas.csproj" />

  <Project Path="Gnothi.Assistant/Gnothi.Assistant.csproj" />
  <Project Path="Gnothi.Assistant.Measure/Gnothi.Assistant.Measure.csproj" />
  <Project Path="Gnothi.Assistant.Tests/Gnothi.Assistant.Tests.csproj" />

  <!-- The desktop window. It used to be left out for the same reason as the Android app
       (net9.0-windows). Since 2026-09-08 it is Photino.Blazor over plain net9.0, so it builds
       on Windows, macOS and Linux and the build catches it when it breaks. -->
  <Project Path="Gnothi.Desktop/Gnothi.Desktop.csproj" />
  <Project Path="Municipalidad/App/Municipalidad.App/Municipalidad.App.csproj" />
  <Project Path="Municipalidad/App/Municipalidad.Consola/Municipalidad.Consola.csproj" />
  <Project Path="Municipalidad/App/Municipalidad.Mcp/Municipalidad.Mcp.csproj" />
  <Project Path="Municipalidad/App/Municipalidad.Wasm/Municipalidad.Wasm.csproj" />
  <Project Path="Municipalidad/Dominio/Municipalidad.Dominio.csproj" />
  <Project Path="Municipalidad/EndPointDeEventos/Municipalidad.EventosMock.csproj" />
  <Project Path="Municipalidad/InyectorDeEventosDemo/Municipalidad.InyectorDeEventosDemo.csproj" />
  <Project Path="Municipalidad/Pruebas/Municipalidad.Dominio.Pruebas/Municipalidad.Dominio.Pruebas.csproj" />

</Solution>
