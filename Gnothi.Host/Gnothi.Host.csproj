<Project Sdk="Microsoft.NET.Sdk">

  <!-- EL HOST. Servidor MCP hacia el asistente (Puerta 1) y cliente MCP hacia cada
       modulo. Es un proxy que AGREGA: junta las tools de N modulos en una sola lista.

       Lo que este proyecto NO hace, a proposito:
         - no entiende de facturas, ni de examenes, ni de nada de dominio;
         - no toca ningun journal;
         - no transcodifica la salida del modulo: la reenvia tal cual.

       No referencia Puppeteer. El Host no necesita el motor para hacer de proxy, y no
       tenerlo es la forma de que el compilador garantice que no se metio semantica. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gnothi.Host</RootNamespace>
    <AssemblyName>Gnothi.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
