<?xml version="1.0" encoding="UTF-8"?>

<!-- ═══════════════════════════════════════════════════════════════════════════════════════
     INSTALADOR DE LA APP DEL LABORATORIO (Laboratorio Clinico Delfos) - MSI, per-usuario.

     Gemelo del de Super La Guaria: misma estructura, otra institucion. NO registra la maquina
     (no toca HKLM ni startup); su unica huella fuera de su carpeta es instalar el modulo DENTRO
     de Gnothi. El "a raya" vive en dos jaulas: el modulo, dentro de Gnothi (carpeta otorgada,
     solo lectura, sin motor propio); y el PWA, dentro del WebView2 del shell.

     QUE CONTIENE (todo en stage\examenes):
       - Comercio.Shell.exe + WebView2: la ventana que muestra el PWA (shell generico, reusado).
       - web\: el PWA del laboratorio (Blazor WASM), servido por host virtual examenes.local.
       - examenes.gmod: el modulo (manifest + view.json + dos DLLs) para Gnothi.
       - comercio.json: titulo/host que lee el shell.

     QUE HACE AL INSTALAR:
       1. DESCUBRE Gnothi leyendo HKCU\Software\Ncubo\Gnothi (HostExe y ModulesPath). Si no
          esta, se detiene y manda a instalar Gnothi primero.
       2. Copia todo a %LocalAppData%\Programs\Examenes.
       3. Corre install-module de Gnothi.Host sobre examenes.gmod para meter el modulo en Gnothi.
       4. Deja accesos directos que abren el shell (el PWA del laboratorio).
     ═══════════════════════════════════════════════════════════════════════════════════════ -->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Laboratorio Clínico Delfos"
      Manufacturer="Laboratorio Clínico Delfos"
      Version="0.1.0"
      UpgradeCode="27F5C7B3-F660-45E6-A0E0-D0392B9BEADD"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Ya hay una version mas nueva de Laboratorio Clinico Delfos instalada." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ═══ UI INTERACTIVA ═══ Mismo asistente que Gnothi/La Guaria: Bienvenida -> Licencia ->
         Carpeta (con "Examinar...") -> Confirmar -> Progreso -> Fin. La deteccion de Gnothi y el
         drop del modulo siguen automaticos por debajo. Requiere -ext WixToolset.UI.wixext. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- DESCUBRIR GNOTHI. RegistrySearch lee la marca que dejo el instalador de Gnothi. Type=raw
         devuelve el string tal cual (sin backslash final). -->
    <Property Id="GNOTHIHOSTEXE">
      <RegistrySearch Id="BuscarHostExe" Root="HKCU" Key="Software\Ncubo\Gnothi" Name="HostExe" Type="raw" />
    </Property>
    <Property Id="GNOTHIMODULES">
      <RegistrySearch Id="BuscarModules" Root="HKCU" Key="Software\Ncubo\Gnothi" Name="ModulesPath" Type="raw" />
    </Property>

    <!-- Si Gnothi no esta instalado en esta cuenta, no seguir. -->
    <Launch Condition="GNOTHIHOSTEXE AND GNOTHIMODULES"
            Message="Mymi no esta instalado en esta cuenta. Instala primero Mymi desde su pagina de descarga y vuelve a ejecutar este instalador del Laboratorio Clinico Delfos." />

    <!-- Per-usuario, sin admin. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Examenes" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="stage\examenes\**" />
    </ComponentGroup>

    <!-- METER EL MODULO EN GNOTHI, despues de que los archivos ya estan en disco. Tipo 50: el
         exe es la propiedad GNOTHIHOSTEXE y ExeCommand son los argumentos. Return=ignore para
         que un tropiezo del modulo no tumbe la instalacion del PWA. Condicion NOT Installed:
         solo al instalar. -->
    <CustomAction Id="InstalarModulo"
                  Property="GNOTHIHOSTEXE"
                  ExeCommand="--install-module &quot;[INSTALLFOLDER]examenes.gmod&quot; &quot;[GNOTHIMODULES]&quot;"
                  Execute="immediate"
                  Return="ignore" />

    <!-- AL DESINSTALAR, quitar el modulo que la custom action metio en Gnothi (el MSI no lo
         rastrea). Solo borra la carpeta del modulo; los DATOS de la persona en
         Documents\Gnothi\examenes se dejan. Condicion: desinstalacion REAL (REMOVE=ALL) que NO
         sea parte de un upgrade, y solo si Gnothi sigue presente. -->
    <CustomAction Id="LimpiarModulo" Directory="INSTALLFOLDER"
                  ExeCommand="[SystemFolder]cmd.exe /c rmdir /s /q &quot;[GNOTHIMODULES]\examenes&quot;"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstalarModulo" After="InstallFinalize" Condition="NOT Installed" />
      <Custom Action="LimpiarModulo" After="InstallInitialize"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND GNOTHIMODULES" />
    </InstallExecuteSequence>

    <!-- Accesos directos al shell del laboratorio. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartShortcut">
        <Shortcut Id="SmDelfos" Name="Laboratorio Clínico Delfos"
                  Description="Abrir Mis examenes - Laboratorio Clinico Delfos"
                  Target="[INSTALLFOLDER]Comercio.Shell.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Delfos" Name="startMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DeskShortcut">
        <Shortcut Id="DkDelfos" Name="Laboratorio Clínico Delfos"
                  Description="Abrir Mis examenes - Laboratorio Clinico Delfos"
                  Target="[INSTALLFOLDER]Comercio.Shell.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Delfos" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Laboratorio Clínico Delfos" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartShortcut" />
      <ComponentRef Id="DeskShortcut" />
    </Feature>

  </Package>
</Wix>
