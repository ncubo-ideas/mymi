<Project Sdk="Microsoft.NET.Sdk">

  <!-- Caratula de andamio para las fases 1 y 2. El MISMO actor y los MISMOS
       performs que va a usar el browser; lo unico que cambia es como llegan las
       entradas y donde va la salida. Sirve para medir el dominio y el bucle de
       refresh en disco real, sin el sandbox del browser encima. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Compras.Consola</RootNamespace>
    <AssemblyName>Compras.Consola</AssemblyName>

    <AssemblyTitle>Compras - caratula de consola</AssemblyTitle>
    <Description>El arnes del negocio: comprueba las reglas del dominio puro sin actor ni disco, mide los invariantes contra un diario real y ejercita el ciclo de refresh contra el servidor del supermercado.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compras.App\Compras.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EL MISMO guion.json QUE SIRVE EL MOCK, enlazado. Aca se mide el dominio sin
         levantar docker, y si el guion de medir difiere del que sirve el proveedor, uno de
         los dos veredictos miente. El build lo copia; nadie lo sincroniza a mano. -->
    <None Include="..\..\EndPointDeEventos\guion.json" Link="guion.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Compras.Wasm\wwwroot\texto\es-CR.json" Link="texto\es-CR.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Compras.Wasm\wwwroot\texto\en.json" Link="texto\en.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

