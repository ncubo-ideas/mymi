@page "/compra/{Numero}"
@using System.Globalization
@using Compras.App.Vistas
@using Compras.App
@using Microsoft.JSInterop
@inject Textos textos
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion
@inject Pantalla pantalla
@implements IDisposable

@* Hasta el titulo de la pestaña: decia "Compra T-90349". Si alguien guarda esto en
   favoritos, lo que tiene que reconocer es la fecha. *@
<PageTitle>@(compra is null || compra.Numero.Length == 0
    ? textos["detalle.unaCompra"] + " · " + Textos.TituloDelModulo
    : ElDiaLargo(compra.Fecha) + " · " + Textos.TituloDelModulo)</PageTitle>

@* Decia "← Mis compras" y navegaba a la PORTADA con destino fijo — pero a un recibo se
   llega desde recibos, desde la portada y desde la busqueda, y ese boton acertaba solo en
   uno de los tres. El componente vuelve a donde se estaba. *@
<Volver Respaldo="recibos" />

@if (!estado.EstaArriba)
{
    <div class="aviso">@textos["detalle.sinAbrir"]</div>
}
else if (compra is null || compra.Numero.Length == 0)
{
    <div class="aviso">@textos.Con("detalle.sinEsaCompra", ("numero", Numero))</div>
}
else
{
    @* LA FECHA ES EL TITULO, no el numero de ticket. Decia "Compra T-90349": ese numero es
       como el super identifica ese papel en SU sistema, y encabezar con el convierte la
       pantalla en una factura. Lo que ella recuerda de una compra es CUANDO fue. *@
    <p class="kicker mb-1">@textos["detalle.tuCompraDel"]</p>
    <h1 class="h3 mb-0">@ElDiaLargo(compra.Fecha).ToLower()</h1>
    <p class="text-body-secondary">
        @textos.Con("detalle.aLas", ("hora", Hora(compra.Fecha)))@(compra.Sucursal.Length > 0 ? " · " + compra.Sucursal : "")
    </p>

    @* EL RESUMEN ANTES DE LA LISTA, del mock de Fernanda: tres fotos de muestra y el total
       en grande. Es lo que se busca al abrir un recibo -"cuanto fue"- y estaba escondido en
       la linea de texto de arriba. *@
    <div class="detalle-resumen mb-4">
        <div class="detalle-muestras">
            <span class="fotitos" aria-hidden="true">
                @foreach (LineaDeCompra muestra in Muestras())
                {
                    <img src="@Foto(muestra.Sku)" alt="" />
                }
            </span>
            <div class="small text-body-secondary detalle-nombres">@Nombres()</div>
        </div>
        <div class="text-end">
            <div class="detalle-total">@Colones(compra.Total)</div>
            <div class="small text-body-secondary">
                @compra.Lineas.Count @(compra.Lineas.Count == 1 ? "producto" : "productos")
            </div>
        </div>
    </div>

    @* FILAS Y NO TABLA, del mock de Fernanda: Juan la vio y dijo que la tabla "no se ve
       user friendly". Cada linea es una fila con su foto, el nombre, y "4 × ₡890" debajo
       -que es como una persona lee lo que llevo, no como una columna-; el total de la linea
       va a la derecha. De paso se fue el @media que desarmaba la tabla en telefono: una
       fila asi cabe en 375 px sin apilarse.

       El precio unitario VUELVE aca -la tabla lo habia soltado- pero como parte de la
       frase "4 × ₡890", no como columna de factura. El departamento sigue afuera: es la
       taxonomia de pasillos del super, y el asistente lo tiene entero por sus tools. *@
    <div class="seccion-cabeza">
        <span class="seccion-icono" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M3.5 8h13l-1.4 7.5H4.9z"/><path d="M7 8l3-4.5L13 8"/>
            </svg>
        </span>
        <span class="kicker">@textos["detalle.estoLlevaste"]</span>
    </div>
    <div class="list-group lineas-compra">
        @foreach (LineaDeCompra linea in Visibles())
        {
            <div class="list-group-item linea-compra">
                @* EL SKU NO SE PINTA -la especificacion de marca lo prohibe con nombre
                   propio- pero es con lo que la fila pide su foto. *@
                <span class="proxima-foto @(Foto(linea.Sku).Length == 0 ? "proxima-foto--sin" : "")">
                    @if (Foto(linea.Sku).Length > 0)
                    {
                        <img src="@Foto(linea.Sku)" alt="" />
                    }
                </span>
                <span class="linea-que">
                    <span class="linea-nombre">
                        <strong>@linea.Descripcion</strong>
                        @if (linea.TieneGarantia)
                        {
                            <span class="etiqueta etiqueta-verde">@textos["detalle.conGarantia"]</span>
                        }
                    </span>
                    <span class="linea-precio">@linea.Cantidad &times; @Colones(linea.PrecioUnitario)</span>
                </span>
                <strong class="linea-total">@Colones(linea.Total)</strong>
            </div>
        }
    </div>

    @* DOS COMPORTAMIENTOS, uno por resolución, y es lo que Juan pidió.

       EN ESCRITORIO PAGINA: hay espacio para los controles y saltar a la página 3 es un
       gesto que ahí se entiende. EN TELÉFONO EXPANDE: los controles de página son objetivos
       chicos para un pulgar, y volver de la página 3 a la 1 en una pantalla angosta hace
       perder dónde estabas — abrir el resto en el lugar no.

       Es lo único de esta app donde la resolución cambia QUÉ SE RENDERIZA y no sólo cómo se
       ve, así que es lo único que necesita saber el ancho desde C#. Ver Pantalla.cs. *@
    @* LA BUENA NOTICIA AL PIE, del mock de Fernanda ("la leche que llevaste esta hoy
       ₡100 mas barata"): de lo que llevo en ESTA compra, lo que hoy cuesta menos. El
       "hoy" es el ultimo precio que ELLA pago -esta lectura no sabe de gondolas-, solo
       bajadas reales (el mismo umbral del 3% de la serie), y una sola: es una nota, no
       otra lista. *@
    @if (rebaja is not null && rebaja.Hay)
    {
        <div class="nota-rebaja d-flex align-items-center gap-2 mb-3">
            <span class="proxima-foto @(Foto(rebaja.Sku).Length == 0 ? "proxima-foto--sin" : "")">
                @if (Foto(rebaja.Sku).Length > 0)
                {
                    <img src="@Foto(rebaja.Sku)" alt="" />
                }
            </span>
            <span class="small">
                @((MarkupString)textos.Con("detalle.rebaja", ("producto", rebaja.Descripcion), ("monto", Colones(rebaja.CuantoMenos))))
            </span>
        </div>
    }

    @* EL NUMERO SIGUE ESTANDO, y abajo, dicho por lo que le sirve A ELLA. No es dato
       interno -es lo que le van a pedir en el mostrador si va a reclamar algo, y la tarjeta
       de garantias ya lo nombra-, pero encabezar con el es hablarle en el idioma del
       sistema. Abajo y con su para-que, es una herramienta suya. *@
    <p class="small text-body-secondary numero-de-compra">
        @((MarkupString)textos.Con("detalle.paraReclamar", ("numero", compra.Numero)))
    </p>

    @if (Paginas() > 1)
    {
        @if (angosta)
        {
            @if (!todas)
            {
                <button class="btn btn-link p-0" @onclick="() => todas = true">
                    @textos.Con("detalle.verRestantes", ("cuantas", (compra.Lineas.Count - LineasQueSeMuestran).ToString()))
                </button>
            }
            else
            {
                <button class="btn btn-link p-0" @onclick="() => todas = false">
                    @textos.Con("detalle.soloLasPrimeras", ("cuantas", LineasQueSeMuestran.ToString()))
                </button>
            }
        }
        else
        {
            <nav class="paginas" aria-label="@textos["detalle.paginas"]">
                <button class="pagina-salto" @onclick="Anterior" disabled="@(pagina == 0)"
                        aria-label="@textos["detalle.paginaAnterior"]">&lsaquo;</button>
                @for (int i = 0; i < Paginas(); i++)
                {
                    int destino = i;
                    <button class="pagina-numero @(i == pagina ? "pagina-actual" : "")"
                            @onclick="() => pagina = destino"
                            aria-current="@(i == pagina ? "page" : null)">@(i + 1)</button>
                }
                <button class="pagina-salto" @onclick="Siguiente" disabled="@(pagina >= Paginas() - 1)"
                        aria-label="@textos["detalle.paginaSiguiente"]">&rsaquo;</button>
                @* CUÁNTAS SON EN TOTAL, siempre. Un "3 de 3" con los números al lado suena
                   redundante hasta que el recibo tiene once páginas y los números no caben
                   todos en la fila. *@
                <span class="paginas-cuenta">
                    @textos.Con("detalle.deLineas", ("desde", Desde().ToString()), ("hasta", Hasta().ToString()), ("total", compra.Lineas.Count.ToString()))
                </span>
            </nav>
        }
    }
}

@code {
    // CUANTAS LINEAS SE PINTAN DE ENTRADA. Medido sobre las 87 compras del guion: la
    // mediana es 10 y la mas grande tiene 17, asi que con quince el 93 % de los recibos se
    // ve ENTERO y el boton solo aparece en los seis que de verdad son largos. Con doce
    // habria salido en un tercio de las compras, y un boton que aparece siempre es ruido.
    //
    // El tope existe por el telefono, no por el escritorio: apilada, una linea mide 109 px,
    // asi que un ticket de 45 son 5.221 px — SEIS PANTALLAS Y MEDIA de scroll. Un recibo
    // esta acotado por lo que cabe en un carrito, pero "acotado" no es lo mismo que "corto".
    private const int LineasQueSeMuestran = 15;

    [Parameter] public string Numero { get; set; } = "";

    private CompraDetallada? compra;
    private RebajaVista? rebaja;

    // EL ESTADO ES UNO POR MODO y no se comparte: en telefono "esta abierto o no", en
    // escritorio "en que pagina voy". Meter los dos en un solo campo obligaria a traducir
    // -pagina 0 = plegado?- y a decidir que pasa al rotar el telefono con la pagina 3
    // abierta. Separados, cruzar el corte deja cada uno como estaba.
    private bool todas;
    private int pagina;

    private bool angosta;
    private DotNetObjectReference<Detalle>? yo;

    protected override void OnParametersSet()
    {
        // El detalle sale de consultar al actor, como todo lo que se ve. Si la compra no
        // existe el DSL revienta con KeyNotFound; se muestra "no hay" en vez de un error.
        if (!estado.EstaArriba) return;

        // El desplegado se reinicia al cambiar de compra: si no, abrir un ticket largo y
        // despues uno corto dejaria el boton en un estado que no es de ese recibo.
        todas = false;
        pagina = 0;

        try { compra = estado.Detalle(Numero); }
        catch { compra = new CompraDetallada(); }

        try { rebaja = estado.Rebaja(Numero); }
        catch { rebaja = new RebajaVista(); }
    }

    // EL ANCHO SE PREGUNTA DESPUES DE PINTAR, porque antes no hay JS con quien hablar. El
    // primer render sale con angosta=false -o sea paginado- y se corrige en cuanto se sabe;
    // en un telefono eso es un parpadeo de un frame, y la alternativa seria no pintar nada
    // hasta saberlo, que se ve peor.
    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender) return;

        angosta = await pantalla.EsAngosta();
        yo = DotNetObjectReference.Create(this);
        await pantalla.Observar(yo);
        StateHasChanged();
    }

    [JSInvokable]
    public Task CambioElAncho(bool ahoraEsAngosta)
    {
        angosta = ahoraEsAngosta;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose() => yo?.Dispose();

    // ---------------------------------------------------------------- que se pinta

    private int Paginas()
    {
        if (compra is null || compra.Lineas.Count == 0) return 0;

        return (compra.Lineas.Count + LineasQueSeMuestran - 1) / LineasQueSeMuestran;
    }

    private int Desde() => pagina * LineasQueSeMuestran + 1;

    private int Hasta() =>
        Math.Min((pagina + 1) * LineasQueSeMuestran, compra?.Lineas.Count ?? 0);

    private void Anterior() { if (pagina > 0) pagina--; }

    private void Siguiente() { if (pagina < Paginas() - 1) pagina++; }

    private IReadOnlyList<LineaDeCompra> Visibles()
    {
        if (compra is null) return new List<LineaDeCompra>();
        if (compra.Lineas.Count <= LineasQueSeMuestran) return compra.Lineas;

        // Telefono: las primeras, o todas si esta desplegado.
        if (angosta)
        {
            if (todas) return compra.Lineas;

            var primeras = new List<LineaDeCompra>();
            for (int i = 0; i < LineasQueSeMuestran; i++) primeras.Add(compra.Lineas[i]);

            return primeras;
        }

        // Escritorio: la pagina en la que va. Se recorta contra el largo real porque la
        // ultima pagina casi nunca esta completa.
        var deLaPagina = new List<LineaDeCompra>();
        for (int i = Desde() - 1; i < Hasta(); i++) deLaPagina.Add(compra.Lineas[i]);

        return deLaPagina;
    }

    // EL DIA ENTERO EN UNA SOLA CLAVE, y no pegando dia + numero + mes: el orden de esas
    // tres partes es del idioma, y armarlo aca lo dejaria en espanol para siempre.
    private string ElDiaLargo(DateTime cuando) =>
        textos.Con("detalle.diaLargo",
            ("dia", textos["comun.diaLargo." + ElCodigoDelDia(cuando.DayOfWeek)]),
            ("numero", cuando.Day.ToString(CultureInfo.InvariantCulture)),
            ("mes", textos[$"comun.mesLargo.{cuando.Month}"]));

    private static string ElCodigoDelDia(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Monday => "lunes",
        DayOfWeek.Tuesday => "martes",
        DayOfWeek.Wednesday => "miercoles",
        DayOfWeek.Thursday => "jueves",
        DayOfWeek.Friday => "viernes",
        DayOfWeek.Saturday => "sabado",
        _ => "domingo",
    };

    // "7:30 p.m." y no "19:30": nadie dice que fue al super a las diecinueve treinta.
    private string Hora(DateTime cuando)
    {
        int hora = cuando.Hour % 12;
        if (hora == 0) hora = 12;

        return $"{hora}:{cuando.Minute:00} {textos[cuando.Hour < 12 ? "comun.am" : "comun.pm"]}";
    }

    // LA FOTO VIENE DEL MISMO MAPA de toda la app; sin foto, la fila dibuja su hueco.
    private static string Foto(string sku) => Compras.App.Vistas.Fotos.De(sku);

    // Las tres primeras lineas CON foto: son muestra, no indice, y un hueco punteado en la
    // cabecera no ensena nada.
    private IEnumerable<LineaDeCompra> Muestras()
    {
        int dadas = 0;
        foreach (LineaDeCompra linea in compra!.Lineas)
        {
            if (Foto(linea.Sku).Length == 0) continue;
            yield return linea;
            if (++dadas == 3) yield break;
        }
    }

    // Los nombres de muestra siguen a las fotos: las mismas lineas, con elipsis del CSS si
    // no caben.
    private string Nombres()
    {
        var nombres = new List<string>();
        foreach (LineaDeCompra muestra in Muestras()) nombres.Add(muestra.Descripcion);
        if (nombres.Count == 0 && compra!.Lineas.Count > 0) nombres.Add(compra.Lineas[0].Descripcion);

        return string.Join(" · ", nombres);
    }
    private string Colones(decimal monto) => textos.Monto(monto);
}
