@page "/compra/{Numero}"
@using System.Globalization
@using Compras.App.Vistas
@using Compras.Dominio
@using Microsoft.JSInterop
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion
@inject Pantalla pantalla
@implements IDisposable

@* Hasta el titulo de la pestaña: decia "Compra T-90349". Si alguien guarda esto en
   favoritos, lo que tiene que reconocer es la fecha. *@
<PageTitle>@(compra is null || compra.Numero.Length == 0
    ? "Una compra · La Guaria y vos"
    : $"{Dia(compra.Fecha)} {compra.Fecha.Day} de {MesLargo(compra.Fecha.Month)} · La Guaria y vos")</PageTitle>

<button class="btn btn-link p-0 mb-3" @onclick="Volver">&larr; Mis compras</button>

@if (!estado.EstaArriba)
{
    <div class="aviso">La app todavía no abrió. Volvé a la lista y abrila ahí.</div>
}
else if (compra is null || compra.Numero.Length == 0)
{
    <div class="aviso">No hay ninguna compra con número «@Numero».</div>
}
else
{
    @* LA FECHA ES EL TITULO, no el numero de ticket. Decia "Compra T-90349": ese numero es
       como el super identifica ese papel en SU sistema, y encabezar con el convierte la
       pantalla en una factura. Lo que ella recuerda de una compra es CUANDO fue. *@
    <h1 class="h4">@Dia(compra.Fecha) @compra.Fecha.Day de @MesLargo(compra.Fecha.Month)</h1>
    <p class="text-body-secondary">
        @compra.Lineas.Count @(compra.Lineas.Count == 1 ? "cosa" : "cosas") &middot;
        @Colones(compra.Total) &middot; a las @Hora(compra.Fecha)
    </p>

    @* LA TABLA SE VUELVE FILAS EN TELÉFONO, y no es cosmético: medida, su ancho mínimo es
       566 px, así que en una pantalla de 375 se salía 191 px y arrastraba la página entera
       con una barra de scroll horizontal. Nada la contenía. El CSS la apila debajo de 768;
       el markup es el mismo, y cada celda lleva su rótulo para que apilada se siga
       entendiendo sin el encabezado. *@
    <table class="table align-middle lineas">
        <thead>
            @* TRES COLUMNAS Y NO CINCO. Se fueron "Departamento" y "Precio" unitario, que
               son columnas de FACTURA: el departamento es la taxonomia de pasillos del
               super -util para sumar la canasta, no para recordar una compra- y el precio
               unitario tiene su propia lectura en "lo que cambio de precio".

               Queda lo que una persona recuerda de una compra: QUE llevo, CUANTO y QUE
               costo. Los otros dos siguen viajando en la vista y el asistente los tiene
               enteros por sus tools, que es donde el detalle no estorba. *@
            <tr>
                <th>Lo que llevaste</th>
                <th class="text-end">Cantidad</th><th class="text-end">Precio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LineaDeCompra linea in Visibles())
            {
                <tr>
                    <td>
                        @linea.Descripcion
                        @* EL SKU NO SE PINTA. La especificacion de marca lo prohibe con nombre
                           propio: "nada de «SKU», «ticket promedio» ni «categorias de consumo» en
                           lo que ve Sonia". Es la llave con la que el supermercado identifica un
                           producto en SU inventario, y no le dice nada a quien compro.

                           Sigue viva adentro -es la identidad del producto en el catalogo y lo
                           que cruza sus compras entre si- y sigue viajando en las vistas para
                           que la pantalla pueda pedir su foto. Lo que no hace es salir a
                           pantalla. *@
                        @if (linea.TieneGarantia)
                        {
                            <span class="etiqueta etiqueta-verde">con garantía</span>
                        }
                    </td>
                    <td class="text-end" data-rotulo="Cantidad">@linea.Cantidad</td>
                    <td class="text-end" data-rotulo="Precio">@Colones(linea.Total)</td>
                </tr>
            }
        </tbody>
    </table>

    @* DOS COMPORTAMIENTOS, uno por resolución, y es lo que Juan pidió.

       EN ESCRITORIO PAGINA: hay espacio para los controles y saltar a la página 3 es un
       gesto que ahí se entiende. EN TELÉFONO EXPANDE: los controles de página son objetivos
       chicos para un pulgar, y volver de la página 3 a la 1 en una pantalla angosta hace
       perder dónde estabas — abrir el resto en el lugar no.

       Es lo único de esta app donde la resolución cambia QUÉ SE RENDERIZA y no sólo cómo se
       ve, así que es lo único que necesita saber el ancho desde C#. Ver Pantalla.cs. *@
    @* EL NUMERO SIGUE ESTANDO, y abajo, dicho por lo que le sirve A ELLA. No es dato
       interno -es lo que le van a pedir en el mostrador si va a reclamar algo, y la tarjeta
       de garantias ya lo nombra-, pero encabezar con el es hablarle en el idioma del
       sistema. Abajo y con su para-que, es una herramienta suya. *@
    <p class="small text-body-secondary numero-de-compra">
        Si tenés que reclamar algo de esta compra, el número es <strong>@compra.Numero</strong>.
    </p>

    @if (Paginas() > 1)
    {
        @if (angosta)
        {
            @if (!todas)
            {
                <button class="btn btn-link p-0" @onclick="() => todas = true">
                    Ver las @(compra.Lineas.Count - LineasQueSeMuestran) líneas restantes
                </button>
            }
            else
            {
                <button class="btn btn-link p-0" @onclick="() => todas = false">
                    Mostrar solo las primeras @LineasQueSeMuestran
                </button>
            }
        }
        else
        {
            <nav class="paginas" aria-label="Páginas de esta compra">
                <button class="pagina-salto" @onclick="Anterior" disabled="@(pagina == 0)"
                        aria-label="Página anterior">&lsaquo;</button>
                @for (int i = 0; i < Paginas(); i++)
                {
                    int destino = i;
                    <button class="pagina-numero @(i == pagina ? "pagina-actual" : "")"
                            @onclick="() => pagina = destino"
                            aria-current="@(i == pagina ? "page" : null)">@(i + 1)</button>
                }
                <button class="pagina-salto" @onclick="Siguiente" disabled="@(pagina >= Paginas() - 1)"
                        aria-label="Página siguiente">&rsaquo;</button>
                @* CUÁNTAS SON EN TOTAL, siempre. Un "3 de 3" con los números al lado suena
                   redundante hasta que el recibo tiene once páginas y los números no caben
                   todos en la fila. *@
                <span class="paginas-cuenta">
                    @Desde()–@Hasta() de @compra.Lineas.Count líneas
                </span>
            </nav>
        }
    }
}

@code {
    // CUANTAS LINEAS SE PINTAN DE ENTRADA. Medido sobre las 87 compras del guion: la
    // mediana es 10 y la mas grande tiene 17, asi que con quince el 93 % de los recibos se
    // ve ENTERO y el boton solo aparece en los seis que de verdad son largos. Con doce
    // habria salido en un tercio de las compras, y un boton que aparece siempre es ruido.
    //
    // El tope existe por el telefono, no por el escritorio: apilada, una linea mide 109 px,
    // asi que un ticket de 45 son 5.221 px — SEIS PANTALLAS Y MEDIA de scroll. Un recibo
    // esta acotado por lo que cabe en un carrito, pero "acotado" no es lo mismo que "corto".
    private const int LineasQueSeMuestran = 15;

    [Parameter] public string Numero { get; set; } = "";

    private CompraDetallada? compra;

    // EL ESTADO ES UNO POR MODO y no se comparte: en telefono "esta abierto o no", en
    // escritorio "en que pagina voy". Meter los dos en un solo campo obligaria a traducir
    // -pagina 0 = plegado?- y a decidir que pasa al rotar el telefono con la pagina 3
    // abierta. Separados, cruzar el corte deja cada uno como estaba.
    private bool todas;
    private int pagina;

    private bool angosta;
    private DotNetObjectReference<Detalle>? yo;

    protected override void OnParametersSet()
    {
        // El detalle sale de consultar al actor, como todo lo que se ve. Si la compra no
        // existe el DSL revienta con KeyNotFound; se muestra "no hay" en vez de un error.
        if (!estado.EstaArriba) return;

        // El desplegado se reinicia al cambiar de compra: si no, abrir un ticket largo y
        // despues uno corto dejaria el boton en un estado que no es de ese recibo.
        todas = false;
        pagina = 0;

        try { compra = estado.Detalle(Numero); }
        catch { compra = new CompraDetallada(); }
    }

    // EL ANCHO SE PREGUNTA DESPUES DE PINTAR, porque antes no hay JS con quien hablar. El
    // primer render sale con angosta=false -o sea paginado- y se corrige en cuanto se sabe;
    // en un telefono eso es un parpadeo de un frame, y la alternativa seria no pintar nada
    // hasta saberlo, que se ve peor.
    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender) return;

        angosta = await pantalla.EsAngosta();
        yo = DotNetObjectReference.Create(this);
        await pantalla.Observar(yo);
        StateHasChanged();
    }

    [JSInvokable]
    public Task CambioElAncho(bool ahoraEsAngosta)
    {
        angosta = ahoraEsAngosta;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose() => yo?.Dispose();

    // ---------------------------------------------------------------- que se pinta

    private int Paginas()
    {
        if (compra is null || compra.Lineas.Count == 0) return 0;

        return (compra.Lineas.Count + LineasQueSeMuestran - 1) / LineasQueSeMuestran;
    }

    private int Desde() => pagina * LineasQueSeMuestran + 1;

    private int Hasta() =>
        Math.Min((pagina + 1) * LineasQueSeMuestran, compra?.Lineas.Count ?? 0);

    private void Anterior() { if (pagina > 0) pagina--; }

    private void Siguiente() { if (pagina < Paginas() - 1) pagina++; }

    private IReadOnlyList<LineaDeCompra> Visibles()
    {
        if (compra is null) return new List<LineaDeCompra>();
        if (compra.Lineas.Count <= LineasQueSeMuestran) return compra.Lineas;

        // Telefono: las primeras, o todas si esta desplegado.
        if (angosta)
        {
            if (todas) return compra.Lineas;

            var primeras = new List<LineaDeCompra>();
            for (int i = 0; i < LineasQueSeMuestran; i++) primeras.Add(compra.Lineas[i]);

            return primeras;
        }

        // Escritorio: la pagina en la que va. Se recorta contra el largo real porque la
        // ultima pagina casi nunca esta completa.
        var deLaPagina = new List<LineaDeCompra>();
        for (int i = Desde() - 1; i < Hasta(); i++) deLaPagina.Add(compra.Lineas[i]);

        return deLaPagina;
    }

    private void Volver() => navegacion.NavigateTo("");

    // Los nombres van a mano: en wasm la globalizacion viene recortada y pedirle a la
    // cultura los dias o los meses devuelve los ingleses o vacio.
    private static string Dia(DateTime cuando) => cuando.DayOfWeek switch
    {
        DayOfWeek.Monday => "Lunes",
        DayOfWeek.Tuesday => "Martes",
        DayOfWeek.Wednesday => "Miércoles",
        DayOfWeek.Thursday => "Jueves",
        DayOfWeek.Friday => "Viernes",
        DayOfWeek.Saturday => "Sábado",
        _ => "Domingo",
    };

    private static string MesLargo(int mes) => mes switch
    {
        1 => "enero", 2 => "febrero", 3 => "marzo", 4 => "abril", 5 => "mayo", 6 => "junio",
        7 => "julio", 8 => "agosto", 9 => "setiembre", 10 => "octubre", 11 => "noviembre",
        _ => "diciembre",
    };

    // "7:30 p.m." y no "19:30": nadie dice que fue al super a las diecinueve treinta.
    private static string Hora(DateTime cuando)
    {
        int hora = cuando.Hour % 12;
        if (hora == 0) hora = 12;

        return $"{hora}:{cuando.Minute:00} {(cuando.Hour < 12 ? "a.m." : "p.m.")}";
    }

    private static string Colones(decimal monto) =>
        Plata.Colones(monto);   @* la regla vive en el dominio, no en cada pantalla *@
}
