@page "/recibos"
@using System.Globalization
@using Compras.App.Vistas
@using Compras.Dominio
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

@* LA PESTAÑA DE COMPRAS: encontrar UN recibo, que es otra pregunta que la de la portada.
   La portada contesta "¿qué compro yo?"; acá se contesta "¿dónde está eso que llevé?".

   Sigue el diseño de la app: una búsqueda arriba y los recibos AGRUPADOS POR FECHA, con
   HOY separado del resto. Nadie recuerda el número de un ticket; recuerda cuándo fue. *@

<PageTitle>Tus compras · La Guaria y vos</PageTitle>

<h1>Encontrá eso que llevaste</h1>
<p class="text-body-secondary mb-4">
    Buscá un producto o recorré tus compras anteriores.
</p>

@if (!estado.EstaArriba)
{
    <div class="aviso">
        La app todavía no abrió en esta computadora.
        <a href="">Andá a Inicio</a> y elegí tu carpeta.
    </div>
}
else
{
    <div class="buscador mb-4">
        <span class="buscador-lupa" aria-hidden="true">&#8981;</span>
        <input class="form-control" type="search" placeholder="Buscar leche, arroz, galletas…"
               value="@termino" @oninput="Buscar" aria-label="Buscar en tus compras" />
    </div>

    @if (compras.Count == 0)
    {
        <p class="text-body-secondary">Todavía no hay compras. Apretá <em>Refresh</em> en Inicio.</p>
    }
    else if (Filas().Count == 0)
    {
        @* NO HAY RESULTADOS ES UNA RESPUESTA, no una pantalla vacía: la frase la escribe el
           dominio, que es el que sabe qué se buscó. *@
        <p class="text-body-secondary">
            @(hallazgo is null ? "" : hallazgo.ParaSonia)
            Probá con otro producto, o con un pasillo entero — <em>limpieza</em>, <em>proteinas</em>.
        </p>
    }
    else
    {
        @* QUÉ ENTENDIÓ LA APP. Buscar "queso" puede alcanzar a dos productos, y quien busca
           tiene derecho a saberlo ANTES de leer los totales — si no, un número que suma dos
           cosas se lee como si fuera de una. *@
        @if (hallazgo is not null && hallazgo.Existe)
        {
            <p class="hallazgo-dicho">
                <strong>@Junta(hallazgo.Productos)</strong>
                &middot; @hallazgo.CuantasCompras @(hallazgo.CuantasCompras == 1 ? "compra" : "compras")
                &middot; @hallazgo.TotalUnidades u
                &middot; @Colones(hallazgo.TotalGastado)
            </p>
        }

        @foreach (var grupo in PorFecha())
        {
            <div class="grupo-fecha">@grupo.Key</div>
            <div class="list-group mb-3">
                @foreach (Fila fila in grupo)
                {
                    <button class="list-group-item list-group-item-action recibo"
                            @onclick="() => VerDetalle(fila.Numero)">
                        <span class="recibo-dia">
                            <span class="recibo-numero-dia">@fila.Fecha.Day</span>
                            <span class="recibo-mes">@Mes(fila.Fecha.Month)</span>
                        </span>
                        <span class="recibo-que">
                            @* BUSCANDO, LA FILA DICE POR QUÉ APARECIÓ: cuánto de lo buscado
                               entró en esa compra. Sin eso el resultado es indistinguible de
                               la lista y no se entiende qué hizo la búsqueda. *@
                            @if (fila.EsHallazgo)
                            {
                                <strong>@fila.Unidades u &middot; @Colones(fila.Gasto)</strong>
                                <span class="small text-body-secondary">
                                    de @fila.Lineas @(fila.Lineas == 1 ? "producto" : "productos")
                                    &middot; @fila.Numero
                                </span>
                            }
                            else
                            {
                                <strong>@fila.Lineas @(fila.Lineas == 1 ? "producto" : "productos")</strong>
                                <span class="small text-body-secondary">
                                    @fila.Fecha.ToString("HH:mm", CultureInfo.InvariantCulture)
                                    &middot; @fila.Numero
                                </span>
                            }
                        </span>
                        <span class="recibo-total numero">@Colones(fila.Total)</span>
                        <span class="recibo-flecha" aria-hidden="true">&rsaquo;</span>
                    </button>
                }
            </div>
        }

        @if (termino.Length == 0 && compras.Count > RecibosQueSeMuestran)
        {
            <p class="small text-body-secondary">
                Las @RecibosQueSeMuestran más recientes de @compras.Count.
                Buscá arriba para encontrar una más vieja — y tu asistente las puede
                consultar todas.
            </p>
        }
        else if (hallazgo is not null && hallazgo.CuantasCompras > ResultadosQueSeMuestran)
        {
            <p class="small text-body-secondary">
                Las @ResultadosQueSeMuestran más recientes de @hallazgo.CuantasCompras.
                Los totales de arriba sí son de todas — y tu asistente las puede consultar una
                por una.
            </p>
        }
    }
}

@code {
    // CUANTOS SE PINTAN SIN BUSCAR. Con 87 compras la lista completa es una pared; doce son
    // unos tres meses de compras semanales, que es lo que alguien recorre buscando un
    // ticket reciente.
    private const int RecibosQueSeMuestran = 12;

    // Y CUANTOS BUSCANDO. Antes no habia tope -"quien busca quiere todo"- y eso solo era
    // cierto porque la busqueda no encontraba nada: miraba el numero del ticket. Ahora que
    // encuentra de verdad, "leche" devuelve LAS 87, porque es un habitual semanal y esta en
    // todas. Veinticinco es medio ano de compras semanales.
    //
    // EL TOPE ES SOLO DE LA LISTA: la cabecera de arriba cuenta TODAS, asi que el numero
    // que se lee nunca es el numero recortado.
    private const int ResultadosQueSeMuestran = 25;

    private IReadOnlyList<CompraEnLista> compras = new List<CompraEnLista>();
    private ComprasHalladas? hallazgo;
    private string termino = "";

    protected override void OnInitialized()
    {
        if (estado.EstaArriba) compras = estado.Compras();
    }

    // LA BUSQUEDA LA HACE EL DOMINIO, no esta pantalla, y ese es el arreglo de fondo. La
    // pantalla solo tiene la lista -numero, fecha, lineas, total-, SIN las lineas, asi que
    // lo unico que podia filtrar era el numero del ticket. Por eso el placeholder prometia
    // "leche, arroz, galletas" y escribir "leche" no devolvia nada, mientras "T-" devolvia
    // las 87: todos los numeros empiezan igual.
    private void Buscar(ChangeEventArgs e)
    {
        termino = (e.Value?.ToString() ?? "").Trim();
        hallazgo = termino.Length == 0 || !estado.EstaArriba ? null : estado.Halladas(termino);
    }

    // UNA SOLA FORMA DE FILA para los dos modos. Buscando trae ademas cuanto de lo buscado
    // entro en esa compra; sin buscar esos dos campos no se pintan. Que la fila sea una es
    // lo que hace que el resultado de una busqueda se lea como parte de la misma lista y no
    // como otra pantalla.
    private sealed record Fila(
        string Numero, DateTime Fecha, int Lineas, decimal Total,
        int Unidades, decimal Gasto, bool EsHallazgo);

    private IReadOnlyList<Fila> Filas()
    {
        if (hallazgo is not null)
        {
            var halladas = new List<Fila>();
            foreach (CompraHallada compra in hallazgo.Compras)
            {
                if (halladas.Count == ResultadosQueSeMuestran) break;

                halladas.Add(new Fila(compra.Numero, Fecha(compra.Fecha),
                    compra.LineasDeLaCompra, compra.TotalDeLaCompra,
                    compra.Unidades, compra.Gasto, true));
            }

            return halladas;
        }

        var recientes = new List<Fila>();
        for (int i = compras.Count - 1; i >= Math.Max(0, compras.Count - RecibosQueSeMuestran); i--)
            recientes.Add(new Fila(compras[i].Numero, compras[i].Fecha,
                compras[i].Lineas, compras[i].Total, 0, 0m, false));

        return recientes;
    }

    // AGRUPADAS POR MES, con HOY aparte. Nadie recuerda el numero de un ticket; recuerda
    // cuando fue, y "hoy" es la unica fecha que se busca por su nombre.
    private IEnumerable<IGrouping<string, Fila>> PorFecha() =>
        Filas().GroupBy(f =>
            f.Fecha.Date == DateTime.Now.Date
                ? "HOY"
                : $"{Mes(f.Fecha.Month).ToUpperInvariant()} {f.Fecha.Year}");

    private void VerDetalle(string numero) =>
        navegacion.NavigateTo($"compra/{Uri.EscapeDataString(numero)}");

    // El dominio manda la fecha como aaaa-mm-dd, que es la forma en que viaja. Aca se
    // vuelve DateTime para poder agrupar por mes con la misma cuenta que la otra rama.
    private static DateTime Fecha(string aaaaMmDd) =>
        DateTime.TryParse(aaaaMmDd, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime cuando)
            ? cuando
            : DateTime.MinValue;

    // Los productos que coincidieron, en una linea. Con uno solo se nombra; con varios se
    // nombran TODOS y no "3 productos": quien busca tiene que poder ver si la app junto
    // dos cosas que el no queria juntar.
    private static string Junta(IReadOnlyList<string> productos) =>
        string.Join(" · ", productos);

    private static string Mes(int mes) => mes switch
    {
        1 => "ene", 2 => "feb", 3 => "mar", 4 => "abr", 5 => "may", 6 => "jun",
        7 => "jul", 8 => "ago", 9 => "sep", 10 => "oct", 11 => "nov", _ => "dic",
    };

    private static string Colones(decimal monto) => Plata.Colones(monto);
}
