@page "/precios"
@using System.Globalization
@using Compras.App.Vistas
@using Compras.App
@inject Textos textos
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

@* TUS HABITUALES, la lista completa: la portada corta en tres -lo que cabe en una tarjeta
   de un vistazo-, aca estan todos los que cambiaron de precio, en el mismo orden que ya
   trae el dominio (el que mas se movio primero, via estado.Precios()). Misma fila, mismo
   criterio de color que la portada -reusa .infaltable-fila tal cual, ver Infaltables.razor-,
   solo que sin el limite de tres. *@

<PageTitle>@textos["precios.titulo"] · @Textos.TituloDelModulo</PageTitle>

<Volver Respaldo="" />

<h1>@textos["precios.titulo"]</h1>
<p class="text-body-secondary mb-4">
    @textos["precios.bajada"]
</p>

@if (!estado.EstaArriba)
{
    <div class="aviso">
        @textos["comun.sinAbrir"]
        <a href="">@textos["comun.sinAbrirEnlace"]</a> @textos["comun.sinAbrirCola"]
    </div>
}
else if (precios is null || precios.Count == 0)
{
    <p class="text-body-secondary">@textos["precios.sinCambios"]</p>
}
else
{
    <div class="list-group mb-4">
        @foreach (var precio in precios)
        {
            <button class="list-group-item list-group-item-action infaltable-fila"
                    @onclick="@(() => navegacion.NavigateTo($"producto/{Uri.EscapeDataString(precio.Descripcion)}"))">
                @{ string foto = Foto(precio.Sku); }
                @if (foto.Length > 0)
                {
                    <img class="infaltable-fila-foto" src="@foto" alt="" />
                }
                else
                {
                    <span class="infaltable-fila-foto infaltable-sinfoto" aria-hidden="true"></span>
                }
                <span class="infaltable-fila-que">
                    <strong>@precio.Descripcion</strong>
                    <span class="d-flex align-items-baseline gap-2 flex-wrap">
                        <span class="precio-antes">@Colones(precio.Antes)</span>
                        <span class="text-body-secondary">&rarr;</span>
                        <span class="precio-ahora">@Colones(precio.Ahora)</span>
                    </span>
                    @{ string contexto = ContextoDeHabitual(precio); }
                    @if (contexto.Length > 0)
                    {
                        <span class="ritmo-rotulo">@contexto</span>
                    }
                </span>
                <span class="etiqueta @(precio.Subio ? "etiqueta-cambio" : "etiqueta-verde")">
                    @(precio.Subio ? "▲" : "▼") @textos.Porcentaje(Math.Abs(precio.CambioEnProporcion))
                </span>
                <span class="recibo-flecha" aria-hidden="true">&rsaquo;</span>
            </button>
        }
    </div>
}

@code {
    private IReadOnlyList<PrecioQueCambio> precios = new List<PrecioQueCambio>();
    private FirmaDeLaSemana? firma;

    protected override void OnInitialized()
    {
        if (!estado.EstaArriba) return;

        precios = estado.Precios();
        firma = estado.Firma();
    }

    // LA LINEA DE CONTEXTO por fila: solo aparece si el producto tambien vive en la firma
    // -si sabemos que lo compra seguido-, nunca inventada. Misma frase que en Inicio.
    private string ContextoDeHabitual(PrecioQueCambio precio)
    {
        var habitual = firma?.Habituales.FirstOrDefault(h => h.Sku == precio.Sku);
        return habitual is null ? "" : Frecuencia(habitual);
    }

    private string Frecuencia(ProductoQueVuelve habitual) =>
        textos[habitual.EstaEnTodas ? "precios.loLlevasCadaVez" : "precios.loLlevasCasiCadaVez"];

    private static string Foto(string sku) => Compras.App.Vistas.Fotos.De(sku);
    private string Colones(decimal monto) => textos.Monto(monto);
}
