@page "/"
@using System.Globalization
@using Compras.App.Vistas
@using Compras.App
@using Puppets.Portador
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion
@inject ConfiguracionDeLaInstitucion institucion

<PageTitle>La Guaria y vos</PageTitle>

@* BLOQUE 1 -HEADER + HERO-, cuarta pasada: el HTML es la fuente de verdad visual y el
   demo es solo datos/logica. Este bloque se reescribe DESDE CERO con su propio prefijo
   -"lg-home-"-, sin heredar clases mk-* de intentos anteriores. Las llamadas al dominio
   (heroNovedad/heroOportunidad/heroPromo, Corto, Colones, Foto, Sucursales, Vigencia) son
   las mismas de siempre; lo unico que cambia es COMO se pintan.

   COMPOSICION, calcada del HTML: fondo degradado propio (no un token compartido con el
   resto de la app), una ilustracion de fondo que sangra por abajo-derecha -tenue, detras
   de un velo claro para que el texto se lea, igual que arma el mock-, arriba logo+marca y
   el boton de WhatsApp, debajo el saludo, y despues LA MISMA fila del mock: texto a la
   izquierda + foto del producto de la señal activa a la derecha, alineados al piso. Sin
   foto no se dibuja nada -nunca una caja vacia-, y en el estado neutro no hay foto de
   producto: la ilustracion de fondo ya cumple ese lugar, como en el mock. *@
<header class="lg-home-hero">
    <span class="lg-home-hero-mancha lg-home-hero-mancha--a" aria-hidden="true"></span>
    <span class="lg-home-hero-mancha lg-home-hero-mancha--b" aria-hidden="true"></span>
    <img class="lg-home-hero-ilustracion" src="assets/hero-canasta-3d.png" alt="" aria-hidden="true" />
    <span class="lg-home-hero-velo" aria-hidden="true"></span>
    <span class="lg-home-hero-piso" aria-hidden="true"></span>

    <div class="lg-home-hero-arriba">
        <span class="lg-home-hero-marca">
            <img src="assets/logo.png" alt="" />
            <span>La Guaria</span>
        </span>

        @* EL BOTON REDONDO no es una campana de notificaciones -esta app no tiene, y no
           inventa una-: es WhatsApp, si el súper lo configuró. Contacto real, no adorno. *@
        @if (institucion.HayWhatsApp)
        {
            <a class="lg-home-hero-ayuda" href="@institucion.EnlaceDeWhatsApp" target="_blank"
               rel="noopener noreferrer" aria-label="Escribinos por WhatsApp">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 3.4a6.6 6.6 0 0 0-5.7 9.9L3.4 16.6l3.4-.9A6.6 6.6 0 1 0 10 3.4z"/>
                    <path d="M7.6 7.3c.2-.5.5-.5.8-.5l.6 1.2c.1.2 0 .4-.1.5l-.4.5c.3.7 1 1.4 1.7 1.7l.5-.4c.1-.2.3-.2.5-.1l1.2.6c0 .3 0 .6-.5.8-1.9.7-4.9-2.3-4.3-4.3z"/>
                </svg>
            </a>
        }
    </div>

    <p class="lg-home-hero-saludo">¡Hola!</p>

    <div class="lg-home-hero-fila">
        <div class="lg-home-hero-texto">
            @if (heroNovedad is ProductoQueEntroVista novedad)
            {
                <span class="lg-home-hero-kicker">NUEVO</span>
                <h1>Llegó algo nuevo de tus @Corto(novedad.Descripcion).ToLowerInvariant()</h1>
                <a class="lg-home-hero-ver" href="producto/@Uri.EscapeDataString(novedad.Descripcion)">Verlo &rarr;</a>
            }
            else if (heroOportunidad is PrecioQueCambio oportunidad)
            {
                <span class="lg-home-hero-kicker">TU HABITUAL</span>
                <h1>Tu @Corto(oportunidad.Descripcion).ToLowerInvariant() habitual bajó de precio</h1>
                <span class="lg-home-hero-precio">
                    <span class="lg-home-hero-precio-antes">@Colones(oportunidad.Antes)</span>
                    <span aria-hidden="true">&rarr;</span>
                    <span class="lg-home-hero-precio-ahora">@Colones(oportunidad.Ahora)</span>
                </span>
                <a class="lg-home-hero-ver" href="producto/@Uri.EscapeDataString(oportunidad.Descripcion)">Verlo &rarr;</a>
            }
            else if (heroPromo is PromocionVista promo)
            {
                <span class="lg-home-hero-kicker">PUEDE INTERESARTE</span>
                <h1>@promo.Gancho</h1>
                <p class="lg-home-hero-bajada">@promo.Detalle &middot; @Vigencia(promo)</p>
            }
            else if (estado.EstaArriba && compras.Count > 0)
            {
                <h1>Así vienen tus compras</h1>
                @* Y LAS SUCURSALES EN LA MISMA LINEA, cuando se mueve: "desde enero en 3
                   sucursales" es el arco de Geannina en seis palabras, y Juan no lo
                   encontraba plegado alla abajo. Si compra siempre en la misma, no suma
                   nada: no es noticia. *@
                <p class="lg-home-hero-bajada">
                    @((ritmos.Count > 0
                        ? $"Casi todo habitual · {ritmos.Count} {(ritmos.Count == 1 ? "cambio" : "cambios")} de ritmo"
                        : "Todo como siempre por acá.") + Sucursales())
                </p>
            }
            else
            {
                <h1>Bienvenida a<br />La Guaria</h1>
                <p class="lg-home-hero-bajada">Descubrí lo que siempre vuelve y cómo cambia tu carrito.</p>
            }
        </div>

        @if (heroNovedad is ProductoQueEntroVista novedadImg && Foto(novedadImg.Sku).Length > 0)
        {
            <img class="lg-home-hero-foto" src="@Foto(novedadImg.Sku)" alt="" aria-hidden="true" />
        }
        else if (heroOportunidad is PrecioQueCambio oportunidadImg && Foto(oportunidadImg.Sku).Length > 0)
        {
            <img class="lg-home-hero-foto" src="@Foto(oportunidadImg.Sku)" alt="" aria-hidden="true" />
        }
        else if (heroPromo is PromocionVista promoImg && Foto(promoImg.Sku).Length > 0)
        {
            <img class="lg-home-hero-foto" src="@Foto(promoImg.Sku)" alt="" aria-hidden="true" />
        }
    </div>
</header>

@* UN solo lugar para los errores, y arriba (la leccion de la pantalla de Examenes). *@
@if (error.Length > 0)
{
    <div class="aviso-fuerte mb-3">
        <strong>@(estado.EstaArriba ? "No se pudo completar la operación." : "No se pudo abrir la app.")</strong>
        <pre class="mb-0 mt-2 small" style="white-space:pre-wrap">@error</pre>
    </div>
}

@if (!estado.EstaArriba)
{
    <div class="aviso mb-3">
        @if (estado.FaltaReotorgarPermiso)
        {
            <p class="mb-2">
                Tu carpeta es <strong>&laquo;@estado.NombreDeLaCarpeta&raquo;</strong>. El browser pide
                confirmar el permiso de escritura cada vez que volvés a abrir la app.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-aviso" @onclick="PedirPermiso">
                    Dar permiso a &laquo;@estado.NombreDeLaCarpeta&raquo;
                </button>
                <button class="btn btn-primary" @onclick="ConectarCarpeta"
                        disabled="@(soportado == false)">
                    Elegir carpeta
                </button>
            </div>
        }
        else
        {
            <p class="mb-2">
                Esta app guarda <strong>tus</strong> compras en una carpeta <strong>tuya</strong>.
                Elegí la carpeta y la app escribe su registro ahí; nadie más la lee.
            </p>

            @* DOS MODOS, Y SE DICE QUE DA CADA UNO. El briefing §6.2 pide que la app no
               falle donde no hay picker — y donde no lo hay es en Safari, en Firefox y en
               CUALQUIER teléfono, que es justo donde el diseño de Fernanda vive.

               No se ofrece el segundo como si fuera lo mismo: en el navegador el registro
               PERSISTE, pero vive en el sandbox del origen y el servidor MCP no lo ve. La
               mitad "tu IA lo consulta" no funciona ahí, y callarlo sería vender de más. *@
            <div class="modos">
                <div class="modo @(soportado == false ? "modo--nodisponible" : "")">
                    <div class="modo-que">Una carpeta tuya</div>
                    <div class="modo-da">
                        Queda en tu disco, y <strong>tu asistente la puede consultar</strong>.
                        @if (soportado == false)
                        {
                            <span class="modo-falta">Este navegador no tiene el selector de carpetas.</span>
                        }
                    </div>
                    <button class="btn btn-primary" @onclick="ConectarCarpeta" disabled="@(soportado == false)">
                        Elegir carpeta
                    </button>
                </div>

                <div class="modo @(opfs == false ? "modo--nodisponible" : "")">
                    <div class="modo-que">@(instalada == true ? "En esta app" : "En este navegador")</div>
                    <div class="modo-da">
                        También se guarda y sobrevive al cierre, pero lo administra el navegador:
                        <strong>tu asistente no lo puede leer</strong>.
                        @if (opfs == false)
                        {
                            <span class="modo-falta">No disponible acá.</span>
                        }
                    </div>
                    <button class="btn btn-secundario" @onclick="UsarNavegador" disabled="@(opfs == false)">
                        Guardar acá
                    </button>
                </div>
            </div>

            @* NO HAY NINGUNO: se dice POR QUÉ, que no es lo mismo que decir QUE no hay. Las
               dos APIs exigen contexto seguro, así que entrar por la IP de la máquina las
               apaga igual que un navegador viejo — y mandar a esa persona a buscar otro
               browser es culpar al equipo equivocado. *@
            @if (sinAlmacenamiento == "inseguro")
            {
                <p class="text-danger mt-3 mb-0">
                    Esta página no es un <strong>contexto seguro</strong>, y el navegador apaga las
                    dos formas de guardar. Entrá por <code>https</code> o por <code>localhost</code>
                    y aparecen las dos. No es tu navegador.
                </p>
            }
            else if (sinAlmacenamiento == "navegador")
            {
                <p class="text-danger mt-3 mb-0">
                    Este navegador no puede guardar nada de forma permanente. La app funciona igual,
                    pero el registro vive solo en memoria y se pierde al cerrar.
                </p>
            }
        }

        <div class="mt-3">
            <button class="btn btn-link p-0" @onclick="Arrancar">Abrir sin guardar nada</button>
        </div>
    </div>
}
else
{
    @* LA FRANJA DE ARRIBA YA NO DICE NUMEROS HISTORICOS -"87 compras · ₡3.222.336 en
       total"-: eso es la app hablando de si misma. "Buscar compras nuevas" tampoco es ya
       un boton grande a mitad del Home -el mock no tiene ninguno-: la actualizacion contra
       el proveedor SIGUE existiendo (Refrescar/refrescando, sin tocar), pero ahora vive en
       el icono chiquito junto a "Tus compras", ahi abajo. *@

    @if (!estado.HayCarpeta)
    {
        <div class="aviso d-flex align-items-center flex-wrap gap-2 mb-3">
            <div class="flex-grow-1">
                <strong>No se está guardando nada.</strong>
                Esta app está funcionando sin carpeta: lo que ves lo vuelve a pedir al proveedor
                cada vez que abrís, y no queda registro tuyo en disco.
            </div>
            <button class="btn btn-aviso" @onclick="ConectarCarpeta"
                    disabled="@(soportado == false)">Elegir carpeta</button>
            @if (opfs == true)
            {
                <button class="btn btn-aviso" @onclick="UsarNavegador">Guardar en este navegador</button>
            }
        </div>
    }
    @* GUARDANDO EN EL NAVEGADOR: persiste, pero el MCP no lo ve. Se dice SIEMPRE y no solo
       al elegirlo, porque es la mitad del producto que ahí no funciona y nadie se acuerda
       de una advertencia que vio una vez. *@
    else if (estado.EnAlmacenamientoDelNavegador)
    {
        @* A UNA LINEA: la advertencia importa -es la mitad del producto que aca no
           funciona- pero un parrafo permanente carga la portada. La frase corta dice lo
           mismo que hay que saber; el porque completo vive en la pantalla de eleccion. *@
        <div class="aviso aviso-linea d-flex align-items-center flex-wrap gap-2 mb-3">
            <div class="flex-grow-1 small">
                <strong>Guardado @(instalada == true ? "en esta app" : "en este navegador")</strong>
                &middot; tu asistente no lo puede consultar.
            </div>
            @if (soportado == true)
            {
                <button class="btn btn-aviso btn-sm" @onclick="ConectarCarpeta">Elegir carpeta</button>
            }
        </div>
    }
    else if (estado.GuardadoFallando.Length > 0)
    {
        <div class="aviso-fuerte d-flex align-items-center flex-wrap gap-2 mb-3">
            <div class="flex-grow-1">
                <strong>La carpeta rechazó la escritura.</strong>
                Lo que ves en pantalla no está guardado en &laquo;@estado.NombreDeLaCarpeta&raquo;.
                Suele ser el permiso, que caduca al reabrir.
                <div class="small mt-1">@estado.GuardadoFallando</div>
            </div>
            <button class="btn btn-aviso" @onclick="PedirPermiso">Volver a dar permiso</button>
        </div>
    }
    @* SIN "ELSE": cuando no hay ningun aviso que dar -el caso de todos los dias- no se
       pinta nada aca. "Se guarda en «carpeta» despues de cada cambio" era exactamente el
       texto tecnico -donde vive el dato- que Fernanda pidio sacar del primer viewport; el
       dato sigue ahi (estado.NombreDeLaCarpeta), solo que la portada ya no lo repite cuando
       no hay nada raro que avisar. *@

    @* LA PORTADA, y va antes que todo lo demás porque la especificación de marca lo pide
       así: "la pantalla abre con la firma de su semana y con el quiebre de enero. La lista
       de recibos existe, pero no es la portada."

       Son los dos estados de la marca: VERDE lo estable, ÁMBAR lo que cambió. Rojo nunca
       —"un carrito no tiene urgencias"—. Y el ámbar no es un regaño: señala y se calla. *@
    @* ============ LA PORTADA RESUME; EL DETALLE VIVE DETRAS DE UN "VER →" ============
       Es el rediseño de Fernanda que el equipo aprobo: cada carta cuenta UNA historia y el
       resto se abre ahi mismo o vive en su pantalla. Antes la portada desplegaba todo
       -diez secciones, cinco mil pixeles en telefono-; ahora es una pantalla y media. Nada
       se perdio: lo que ya no se pinta desplegado se abre con su enlace, y el asistente
       siempre tuvo el detalle entero por sus tools. *@

    @* "TUS COMPRAS · HAY N CAMBIOS RECIENTES →": el renglon compacto que reemplaza el
       boton grande y las cifras historicas de arriba. Es tambien el camino a Compras -la
       nav Inicio/Compras ya no vive dentro del hero como pastillas-, y lleva pegado el
       icono de actualizar -Refrescar()/refrescando, la misma logica de siempre-, chiquito
       y sin protagonismo. "N cambios" es ritmos.Count, el mismo dato que ya respalda la
       historia de "un cambio en tu rutina" bien abajo: no se inventa una cuenta aparte. *@
    <div class="lg-home-estado mb-3">
        <a class="lg-home-estado-link" href="recibos">
            <span class="lg-home-estado-fuerte">Tus compras</span>
            <span class="lg-home-estado-punto" aria-hidden="true">&middot;</span>
            @if (ritmos.Count > 0)
            {
                <span class="lg-home-estado-cambio">Hay @ritmos.Count @(ritmos.Count == 1 ? "cambio reciente" : "cambios recientes")</span>
            }
            else
            {
                <span class="lg-home-estado-cambio lg-home-estado-cambio--calmo">Todo como siempre</span>
            }
            <svg class="lg-home-estado-flecha" width="12" height="12" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M4 12h15M14 6l6 6-6 6"/>
            </svg>
        </a>
        <button class="lg-home-estado-refrescar" @onclick="Refrescar" disabled="@refrescando"
                aria-label="Buscar compras nuevas" title="Buscar compras nuevas">
            <svg class="@(refrescando ? "lg-home-girando" : "")" width="15" height="15" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 1 1-2.6-6.36"/>
                <path d="M21 3v6h-6"/>
            </svg>
        </button>
    </div>

    @* UN CAMBIO EN TU RUTINA: una sola historia -la mas notoria, que ya viene primera del
       dominio- con su antes/ahora y desde cuando. El resto de los cambios y los productos
       que entraron/salieron se abren aca mismo. *@
    @if (ritmos.Count > 0)
    {
        <div class="mk-cambio mb-3">
            @{ string cambioFoto = Foto(ritmos[0].Sku); }
            @if (cambioFoto.Length > 0)
            {
                <span class="mk-cambio-foto"><img src="@cambioFoto" alt="" /></span>
            }
            else
            {
                <span class="mk-cambio-foto" aria-hidden="true"></span>
            }
            <span class="mk-cambio-que">
                <span class="mk-cambio-nombre">
                    <strong>@ritmos[0].Descripcion</strong>
                    <span class="mk-cambio-pill">CAMBIÓ</span>
                </span>
                <span class="mk-cambio-linea">
                    <span>@ritmos[0].Antes</span>
                    <span aria-hidden="true">&rarr;</span>
                    <span>@ritmos[0].Ahora</span>
                </span>
                @if (cambio is not null && cambio.Corte.Length > 0)
                {
                    <span class="mk-cambio-desde">cambió desde @MesLegible(cambio.Corte)</span>
                }
                @if (!verCambios && (ritmos.Count > 1 || (cambio is not null && cambio.HayCambio)))
                {
                    <button class="mk-cambio-mas" @onclick="() => verCambios = true">
                        Ver los cambios &rarr;
                    </button>
                }
            </span>
        </div>
        @if (verCambios)
        {
            <div class="mk-cambio-detalle mb-3">
                @if (ritmos.Count > 1)
                {
                    <div class="mt-1">
                        @foreach (var r in ritmos.Skip(1))
                        {
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-1">
                                <span>@r.Descripcion</span>
                                <span class="d-inline-flex align-items-center gap-2">
                                    <span class="etiqueta etiqueta-neutra">@r.Antes</span>
                                    <span class="text-body-secondary">&rarr;</span>
                                    <span class="etiqueta @(r.EsMasSeguido ? "etiqueta-cambio" : "etiqueta-neutra")">@r.Ahora</span>
                                </span>
                            </div>
                        }
                    </div>
                }
                @if (cambio is not null && cambio.Entraron.Count > 0)
                {
                    <div class="mt-2">
                        <span class="small text-body-secondary me-2">entraron</span>
                        <span class="d-inline-flex flex-wrap gap-2 align-middle">
                            @foreach (var entro in cambio.Entraron)
                            {
                                <span class="etiqueta etiqueta-cambio">@entro.Descripcion <span class="opacity-75">&middot; @entro.Desde</span></span>
                            }
                        </span>
                    </div>
                }
                @if (cambio is not null && cambio.Salieron.Count > 0)
                {
                    <div class="mt-2">
                        <span class="small text-body-secondary me-2">dejó de aparecer</span>
                        <span class="d-inline-flex flex-wrap gap-2 align-middle">
                            @foreach (var salio in cambio.Salieron)
                            {
                                <span class="etiqueta etiqueta-neutra">@salio.Descripcion</span>
                            }
                        </span>
                    </div>
                }
                <button class="mk-cambio-mas" @onclick="() => verCambios = false">
                    Ver menos
                </button>
            </div>
        }
    }

    @* TU HABITUAL (la oportunidad de precio): la mejor bajada entre sus habituales, como
       mini-afiche propio y sin cabecera de seccion -el mock de Fernanda tampoco le pone
       una-, con el mismo kicker "TU HABITUAL" que trae el HTML. Va ANTES de "para tu
       proxima compra" porque es la oportunidad genuina mas cercana a lo que ya lleva, y
       sube desde donde vivia -adentro de la carta de precios, al fondo- a un lugar que se
       ve. *@
    @if (heroOportunidad is PrecioQueCambio oportunidadDeHoy)
    {
        <div class="mk-oportunidad mb-3">
            <span class="mk-oportunidad-blob-a" aria-hidden="true"></span>
            <span class="mk-oportunidad-blob-b" aria-hidden="true"></span>
            @{ string oportunidadFoto = Foto(oportunidadDeHoy.Sku); }
            @if (oportunidadFoto.Length > 0)
            {
                <span class="mk-oportunidad-foto"><img src="@oportunidadFoto" alt="" /></span>
            }
            <span class="mk-oportunidad-que">
                <span class="mk-oportunidad-kicker">TU HABITUAL</span>
                <strong>@oportunidadDeHoy.Descripcion</strong>
            </span>
            <span class="mk-oportunidad-precio">
                <span class="precio-antes">@Colones(oportunidadDeHoy.Antes)</span>
                <strong>@Colones(oportunidadDeHoy.Ahora)</strong>
                <span class="ritmo-rotulo">por @oportunidadDeHoy.Unidad</span>
            </span>
            <span class="mk-oportunidad-ahorro">
                @Colones(oportunidadDeHoy.Antes - oportunidadDeHoy.Ahora) menos
            </span>
            <span class="mk-oportunidad-badge">MEJOR PRECIO</span>
        </div>
    }

    @* PARA TU PROXIMA COMPRA. COMPACTA A PROPOSITO -uno o dos productos, nunca la lista
       entera- porque el equipo pidio que la portada no le adivine el carrito a nadie.
       Y SIN CERTEZA FALSA: antes decia "ya pasaron su tiempo", una afirmacion que la app no
       puede sostener -puede tener dos en la alacena y esta app no lo sabe-. Ahora dice
       "quiza ya te toque" y deja que la razon (cada cuanto vuelve, hace cuanto no entra) sea
       lo que decide, no la app. El detalle completo -la lista entera- lo da el asistente. *@
    @if (porCaer is not null && porCaer.CuantosTocan > 0)
    {
        <div class="mb-3">
            <span class="mk-proxima-kicker">Quizá ya te toque</span>

            @* LA LISTA, COMPACTA: la foto, el nombre y SU RAZON -cada cuanto vuelve y
               hace cuanto no entra-, nunca una afirmacion de que falta. *@
            <div class="mk-proxima-lista">
                @foreach (var producto in Faltantes())
                {
                    <div class="mk-proxima-fila">
                        @{ string foto = Foto(producto.Sku); }
                        @if (foto.Length > 0)
                        {
                            <span class="mk-proxima-foto"><img src="@foto" alt="" /></span>
                        }
                        else
                        {
                            <span class="mk-proxima-foto" aria-hidden="true"></span>
                        }
                        <span class="mk-proxima-que">
                            <strong>@producto.Descripcion</strong>
                            <span class="mk-proxima-razon">suele volver @producto.CadenciaCompacta</span>
                        </span>
                        <span class="mk-proxima-hace">hace @producto.DiasDesdeLaUltima días</span>
                    </div>
                }
            </div>

            @if (porCaer.CuantosTocan > FaltantesQueSeMuestran)
            {
                <div class="small text-body-secondary mt-1">
                    Y @(porCaer.CuantosTocan - FaltantesQueSeMuestran) más. Tu asistente te puede dar la lista completa.
                </div>
            }
        </div>
    }

    @* LOS QUE CASI NUNCA FALTAN: una fila compacta -tres fotitos y tres nombres- que lleva
       a la pantalla completa. Antes era una grilla de doce fichas EN la portada; la grilla
       vive en /infaltables, que siempre fue su pantalla. *@
    @if (firma is not null && firma.Existe)
    {
        <div class="list-group mb-3">
            <button class="list-group-item list-group-item-action firma-fila"
                    @onclick="@(() => navegacion.NavigateTo("infaltables"))">
                <span class="fotitos" aria-hidden="true">
                    @foreach (var h in firma.Habituales.Take(3))
                    {
                        @if (Foto(h.Sku).Length > 0)
                        {
                            <img src="@Foto(h.Sku)" alt="" />
                        }
                    }
                </span>
                <span class="firma-que">
                    <strong>Lo que casi nunca falta</strong>
                    <span class="ritmo-rotulo">
                        @string.Join(" · ", firma.Habituales.Take(3).Select(h => Corto(h.Descripcion)))@(firma.CuantosHabituales > 3 ? $" · y {firma.CuantosHabituales - 3} más" : "")
                    </span>
                </span>
                <span class="recibo-flecha" aria-hidden="true">&rsaquo;</span>
            </button>
        </div>
    }

    @* TU MES EN EL SUPER: una carta con las tres cifras del mes -cuantas compras, cada
       cuantos dias, y como viene contra el mes pasado- y el detalle detras de sus enlaces:
       el ritmo (dia y momento favoritos) y la comparacion del año, que es la respuesta a
       S14. Fusiona las tres cartas que antes iban sueltas. *@
    @if (mes is not null && mes.HayComparacion)
    {
        <h2 class="mk-titulo">Tu mes en el súper</h2>
        <div class="card mb-4">
            <div class="card-body">
                <div class="tiles-mes">
                    <div class="ritmo-cifra">
                        <span class="ritmo-numero">@ComprasDelMes().Count</span>
                        <span class="ritmo-rotulo">@(ComprasDelMes().Count == 1 ? "compra este mes" : "compras este mes")</span>
                    </div>
                    @if (ritmo is not null && ritmo.EsObservado)
                    {
                        <div class="ritmo-cifra">
                            <span class="ritmo-numero">@ritmo.DiasEntreCompras</span>
                            <span class="ritmo-rotulo">días entre una y otra</span>
                        </div>
                    }
                    <div class="ritmo-cifra">
                        <span class="ritmo-numero ritmo-numero-largo">@Colones(Math.Abs(mes.CambioEnElTotal))</span>
                        <span class="ritmo-rotulo">@(mes.CambioEnElTotal <= 0 ? "menos" : "más") que en @Mes(mes.MesAntes)</span>
                    </div>
                </div>

                @{ var delMes = ComprasDelMes(); }
                @* PLEGADA, como en el mock de Fernanda ("Ver la grafica" es un ENLACE ahi,
                   no un dibujo fijo): la forma del mes es curiosidad, no accion, y la
                   portada estaba cargando demasiado. *@
                @if (verGrafica && delMes.Count > 1)
                {
                    <svg class="serie-mes" viewBox="0 0 300 60" preserveAspectRatio="none"
                         role="img" aria-label="Las compras del mes, una por punto.">
                        <polyline points="@Puntos(delMes)" />
                        @* PUNTOS QUE NO SE DEFORMAN. Con preserveAspectRatio="none" un
                           <circle> se estira al ancho de la carta y sale OVALO. Un trazo de
                           largo cero con punta redonda dibuja el mismo punto, y con
                           non-scaling-stroke NO escala: queda circulo a cualquier ancho.
                           Van dos capas -el aro verde y el centro claro- porque una punta
                           de trazo no puede tener relleno y borde a la vez. *@
                        @for (int i = 0; i < delMes.Count; i++)
                        {
                            @* "M @(...)" con espacio: Razor no evalua un @ pegado a una
                               letra (lo lee como email), y "M@Equis" salia LITERAL al svg. *@
                            <path class="punto-serie punto-serie--aro"
                                  d="M @Equis(i, delMes.Count) @Ye(delMes[i].Total, delMes) h0.01" />
                            <path class="punto-serie punto-serie--centro"
                                  d="M @Equis(i, delMes.Count) @Ye(delMes[i].Total, delMes) h0.01" />
                        }
                    </svg>
                }

                <div class="d-flex flex-wrap gap-3 mt-2">
                    @if (!verGrafica && ComprasDelMes().Count > 1)
                    {
                        <button class="btn btn-link p-0 ver-todos" @onclick="() => verGrafica = true">Ver la gráfica &rarr;</button>
                    }
                    @* "VER TU RITMO" YA NO DESPLIEGA ACA: lleva a /ritmo, su propia
                       pantalla -el mismo patron que /infaltables para la firma-, porque el
                       detalle del ritmo (dia y momento favoritos, los tres momentos del
                       dia) es una historia completa y no un parrafo mas de esta carta. *@
                    @if (ritmo is not null && ritmo.EsObservado)
                    {
                        <a class="btn btn-link p-0 ver-todos" href="ritmo">Ver tu ritmo &rarr;</a>
                    }
                    @if (comparacion is not null && comparacion.HayComparacion && !verComparacion)
                    {
                        <button class="btn btn-link p-0 ver-todos" @onclick="() => verComparacion = true">Comparar con el año pasado &rarr;</button>
                    }
                </div>

                @if (verComparacion && comparacion is not null && comparacion.HayComparacion)
                {
                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div class="ritmo-rotulo">
                                @Mes(comparacion.MesAntes)/@comparacion.AnioAntes vs @Mes(comparacion.MesDespues)/@comparacion.AnioDespues
                            </div>
                            <div class="text-end">
                                <div>@Colones(comparacion.GastoAntes) &rarr; @Colones(comparacion.GastoDespues)</div>
                                <div class="small text-body-secondary">@(comparacion.CambioEnElTotal >= 0 ? "+" : "")@Colones(comparacion.CambioEnElTotal)</div>
                            </div>
                        </div>
                        <div class="small mt-2">@Tuteada(comparacion.ParaElAsistente)</div>
                        @foreach (var diferencia in comparacion.Diferencias)
                        {
                            if (!diferencia.ExplicaElCambio) { continue; }
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-1 small">
                                <span>
                                    @diferencia.Titulo
                                    @if (diferencia.EsNuevo) { <span class="etiqueta etiqueta-cambio ms-1">entró este año</span> }
                                    @if (diferencia.Desaparecio) { <span class="etiqueta etiqueta-neutra ms-1">dejó de aparecer</span> }
                                </span>
                                <span>@Colones(diferencia.MontoAntes) &rarr; @Colones(diferencia.MontoDespues)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* TUS HABITUALES CAMBIARON DE PRECIO: el que mas se movio -que ya viene primero del
       dominio- y el resto detras del enlace. Colones tachados, como en el rediseño. *@
    @if (precios is not null && precios.Count > 0)
    {
        <h2 class="mk-titulo">Tus habituales cambiaron de precio</h2>
        <div class="list-group mb-4">
            @* LA CIFRA DEL MOCK DE FERNANDA: "+₡1.150 vs. hace 3 meses". Es OTRA ventana
               que las filas de abajo -ellas cuentan la serie entera, esta el pasado
               cercano- y el rotulo la lleva puesta para que no se lean como una sola. En
               cero no se pinta: "cuesta lo mismo" no encabeza nada. *@
            @if (frente is not null && frente.HayConQueComparar && frente.Cambio != 0)
            {
                <div class="list-group-item frente-al-pasado">
                    <span class="frente-cifra @(frente.Cambio > 0 ? "frente-cifra--sube" : "frente-cifra--baja")">@(frente.Cambio > 0 ? "+" : "−")@Colones(Math.Abs(frente.Cambio))</span>
                    <span class="ritmo-rotulo">vs. hace @frente.MesesDeVentana meses, una pieza de cada habitual</span>
                </div>
            }
            @foreach (var precio in (verPrecios ? precios : precios.Take(1)))
            {
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>@precio.Descripcion</strong>
                    <span class="d-inline-flex align-items-center gap-2 flex-wrap">
                        <span class="precio-antes">@Colones(precio.Antes)</span>
                        <span class="text-body-secondary">&rarr;</span>
                        <span class="precio-ahora">@Colones(precio.Ahora)</span>
                        <span class="ritmo-rotulo">por @precio.Unidad</span>
                        <span class="etiqueta @(precio.Subio ? "etiqueta-cambio" : "etiqueta-verde")">
                            @(precio.Subio ? "▲" : "▼") @Porcentaje(precio.CambioEnProporcion)
                        </span>
                    </span>
                </div>
            }
            @* "PUEDE INTERESARTE" YA NO VIVE ACA: subio a su propio bloque, arriba de
               "para tu proxima compra", porque es una oportunidad y no un detalle de esta
               lista de precios. Sigue siendo la misma llamada -Oportunidad()-, calculada
               una sola vez en Releer() como heroOportunidad. *@
            @if (precios.Count > 1)
            {
                <button class="list-group-item list-group-item-action ver-todos text-start"
                        @onclick="() => verPrecios = !verPrecios">
                    @(verPrecios ? "Ver menos" : $"Ver {precios.Count - 1} más →")
                </button>
            }
        </div>
    }

    @* TU ULTIMA COMPRA: el acceso rapido que el rediseño agrega. La fecha grande es lo que
       se reconoce; el chevron lleva al detalle. *@
    @if (compras.Count > 0)
    {
        var ultima = compras[compras.Count - 1];
        <h2 class="mk-titulo">Tu última compra</h2>
        <div class="list-group mb-4">
            <button class="list-group-item list-group-item-action recibo ultima-compra"
                    @onclick="@(() => navegacion.NavigateTo($"compra/{Uri.EscapeDataString(ultima.Numero)}"))">
                <span class="recibo-dia">
                    <span class="recibo-numero-dia">@ultima.Fecha.Day</span>
                    <span class="recibo-mes">@Mes(ultima.Fecha.Month)</span>
                </span>
                <span class="recibo-que">
                    <strong>@ultima.Lineas @(ultima.Lineas == 1 ? "producto" : "productos")</strong>
                    <span class="small text-body-secondary">@DiaSemana(ultima.Fecha), @HoraCorta(ultima.Fecha)@(ultima.Sucursal.Length > 0 ? " · " + ultima.Sucursal : "")</span>
                </span>
                <span class="recibo-total numero">@Colones(ultima.Total)</span>
                <span class="recibo-flecha" aria-hidden="true">&rsaquo;</span>
            </button>
        </div>
    }

    @* LO QUE NO ESTA, plegado a una fila: es la lectura mas "del asistente" de todas -la
       tool que_dejaste_de_comprar la da entera- y en pantalla basta el titular. El detalle
       se abre aca mismo. *@
    @* LAS TRES FILAS SECUNDARIAS -lo que dejo de entrar, donde compra, garantias- comparten
       un mismo bloque liviano de filas divididas (.mk-secundario) en vez de tres cartas
       sueltas con sombra: son informacion de consulta, no protagonistas de la portada. Cada
       una conserva su propio booleano de apertura y su detalle exacto de antes. *@
    @if (pendientes.Count > 0 || (recorrido is not null && recorrido.HayDatos) || garantias.Count > 0)
    {
        <div class="mk-secundario">
            @if (pendientes.Count > 0)
            {
                <button class="mk-secundario-fila" @onclick="() => verHueco = !verHueco">
                    <span class="firma-que">
                        <strong>Lo que dejó de entrar</strong>
                        <span class="ritmo-rotulo">
                            @pendientes[0].Titulo@(pendientes.Count > 1 ? $" · y {pendientes.Count - 1} más" : "") hace más de lo habitual
                        </span>
                    </span>
                    <span class="recibo-flecha" aria-hidden="true">@(verHueco ? "⌄" : "›")</span>
                </button>
                @if (verHueco)
                {
                    <div class="mk-secundario-detalle">
                        @foreach (AbastecimientoEnEspera p in pendientes)
                        {
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <strong>@p.Titulo</strong>
                                    <div class="small text-body-secondary">@p.ParaElAsistente</div>
                                </div>
                                <span class="etiqueta @(p.Severidad == "informativo" ? "etiqueta-neutra" : "etiqueta-tierra")">
                                    @p.DiasDesdeLaUltima días
                                </span>
                            </div>
                        }
                    </div>
                }
            }

            @* DONDE COMPRA: la lectura que propuso Geannina -"antes compraba siempre en la
               misma; desde enero aparece en tres"-. Solo se pinta cuando algun tiquete trae
               sucursal: los journals viejos callan y la fila no inventa nada. *@
            @if (recorrido is not null && recorrido.HayDatos)
            {
                <button class="mk-secundario-fila" @onclick="() => verSucursales = !verSucursales">
                    <span class="firma-que">
                        <strong>Dónde comprás</strong>
                        <span class="ritmo-rotulo">
                            @if (recorrido.SeMueve)
                            {
                                <text>sobre todo en @recorrido.Sucursales[0].Nombre · desde el @Fecha(DesdeCuandoSeMueve()) también en @SucursalesNuevas()</text>
                            }
                            else
                            {
                                <text>siempre en @recorrido.Sucursales[0].Nombre</text>
                            }
                        </span>
                    </span>
                    <span class="recibo-flecha" aria-hidden="true">@(verSucursales ? "⌄" : "›")</span>
                </button>
                @if (verSucursales)
                {
                    <div class="mk-secundario-detalle">
                        @foreach (SucursalVista s in recorrido.Sucursales)
                        {
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <strong>@s.Nombre</strong>
                                    <div class="small text-body-secondary">
                                        la primera vez el @Fecha(s.PrimeraVez) &middot; la última el @Fecha(s.UltimaVez)
                                    </div>
                                </div>
                                <span class="etiqueta etiqueta-neutra">
                                    @s.Compras @(s.Compras == 1 ? "compra" : "compras")
                                </span>
                            </div>
                        }
                        @if (recorrido.ComprasSinSucursal > 0)
                        {
                            <div class="small text-body-secondary">
                                @recorrido.ComprasSinSucursal @(recorrido.ComprasSinSucursal == 1 ? "compra más vieja no dice" : "compras más viejas no dicen") en qué sucursal fueron.
                            </div>
                        }
                    </div>
                }
            }

            @* LAS GARANTIAS: importan EL DIA que hay que reclamar, no todos los dias. *@
            @if (garantias.Count > 0)
            {
                <button class="mk-secundario-fila" @onclick="() => verGarantias = !verGarantias">
                    <span class="firma-que">
                        <strong>Tus garantías</strong>
                        <span class="ritmo-rotulo">
                            @garantias[0].Descripcion te cubre hasta el @Fecha(garantias[0].VenceEl)@(garantias.Count > 1 ? $" · y {garantias.Count - 1} más" : "")
                        </span>
                    </span>
                    <span class="recibo-flecha" aria-hidden="true">@(verGarantias ? "⌄" : "›")</span>
                </button>
                @if (verGarantias)
                {
                    <div class="mk-secundario-detalle">
                        @foreach (GarantiaDeProducto g in garantias)
                        {
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <strong>@g.Descripcion</strong>
                                    <div class="small text-body-secondary">
                                        la compraste el @Fecha(g.FechaDeCompra) &middot;
                                        @g.MesesDeCobertura meses de garantía
                                    </div>
                                    @if (g.QueHacer.Length > 0)
                                    {
                                        <div class="small mt-1">
                                            <strong>@g.QueHacer</strong> &middot;
                                            el número para el reclamo es @g.NumeroDeCompra
                                        </div>
                                    }
                                </div>
                                <span class="etiqueta @(g.QueHacer.Length > 0 ? "etiqueta-tierra" : "etiqueta-verde")">
                                    te cubre hasta el @Fecha(g.VenceEl)
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    @* LOS RECIBOS VIVEN EN SU PROPIA PESTAÑA, y no es solo orden: la especificación dice
       que "la lista de recibos existe, pero no es la portada", y con 87 compras cualquier
       forma de ponerla en la misma pantalla la vuelve la portada por tamaño. En una
       pestaña aparte deja de competir, y quien la busca la encuentra donde espera.

       Y COMO EL LAYOUT YA NO PINTA SU PIE CORPORATIVO EN INICIO -MainLayout lo suprime en
       esta ruta-, esta franja liviana toma su lugar: el enlace a Compras, y el contacto con
       La Guaria (WhatsApp/sitio) solo si la institucion los tiene configurados. Nunca
       protagonista, siempre al final. *@
    <div class="mk-ayuda">
        <a href="recibos">Ver todos tus recibos</a>
        @if (institucion.HayWhatsApp)
        {
            <a href="@institucion.EnlaceDeWhatsApp" target="_blank" rel="noopener">Escribir por WhatsApp</a>
        }
        @if (institucion.HaySitio)
        {
            <a href="@institucion.Sitio" target="_blank" rel="noopener">Sitio de La Guaria</a>
        }
        @if (!estado.HayCarpeta)
        {
            <span>Sin carpeta: el registro vive solo en memoria y se pierde al cerrar.</span>
        }
    </div>
}

@code {
    // CUANTOS SE NOMBRAN EN LA PORTADA. La app resume; el MCP detalla. Con compras
    // semanales el dia de ir al super "tocan" casi todos los habituales -medido: 16 de 22-,
    // y una carta con dieciseis nombres deja de ser un resumen.
    // DOS Y NO CUATRO: el rediseño de Fernanda pide "para tu próxima compra" compacta -uno
    // o dos productos, nunca la lista entera-, para que la portada no le adivine el
    // carrito a nadie. La fila del pie sigue diciendo cuantas mas hay, y el asistente da
    // la lista entera.
    private const int FaltantesQueSeMuestran = 2;

    // DESDE CUANDO COMPRA ACA, en palabras. "87 compras" solo es un numero; "87 compras
    // desde enero de 2025" es su historia con este super, que es lo que ella reconoce.
    private string desdeCuando = "";

    private IReadOnlyList<PromocionVista> promociones = new List<PromocionVista>();
    // Los desplegables del patron teaser: la portada resume y cada "Ver ->" abre su
    // detalle aca mismo, sin navegar. Se reinician en cada carga, que es lo esperado de
    // un resumen.
    private bool verCambios;
    private bool verComparacion;
    private bool verPrecios;
    private bool verGrafica;
    private bool verHueco;
    private bool verGarantias;

    private ListaDeLaProximaCompra? porCaer;
    private bool? soportado;
    private bool? opfs;
    private bool? instalada;
    private string sinAlmacenamiento = "";
    private bool refrescando;

    private IReadOnlyList<CompraEnLista> compras = new List<CompraEnLista>();
    private IReadOnlyList<GarantiaDeProducto> garantias = new List<GarantiaDeProducto>();
    private IReadOnlyList<AbastecimientoEnEspera> pendientes = new List<AbastecimientoEnEspera>();
    private CanastasComparadas? comparacion;
    private FirmaDeLaSemana? firma;
    private CambioDeLaCanasta? cambio;
    private IReadOnlyList<RitmoQueCambio> ritmos = new List<RitmoQueCambio>();
    private RitmoDelSuperVista? ritmo;
    private CanastasComparadas? mes;
    private IReadOnlyList<PrecioQueCambio> precios = new List<PrecioQueCambio>();
    private CanastaFrenteAlPasadoVista? frente;
    private RecorridoDeSucursalesVista? recorrido;
    private bool verSucursales;

    // EL HERO PERSONALIZADO. Se calculan UNA VEZ en Releer() -no en el markup- porque las
    // vistas del hero (novedad, oportunidad, promo) leen datos que ya usan otras tarjetas
    // -Oportunidad() es la misma de "Puede interesarte"-: dos calculos separados podrian,
    // en teoria, desincronizarse.
    //
    // NOVEDAD GUARDA EL PRODUCTO ENTERO y no solo el nombre: la foto que sangra en el hero
    // necesita su sku, y pedirlo aparte hubiera sido una segunda lectura del mismo dato.
    private ProductoQueEntroVista? heroNovedad;
    private PrecioQueCambio? heroOportunidad;
    private PromocionVista? heroPromo;

    private int cantidad;
    private decimal total;
    private long ultimoEvento;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        if (estado.EstaArriba) { Releer(); return; }

        // SE PREGUNTA TODO ANTES DE DECIDIR NADA. Antes esto hacia
        // `if (soportado != true) return;` y se iba: en un telefono -donde no hay picker-
        // la pantalla no averiguaba ni si habia OPFS, asi que no podia ofrecerlo.
        soportado = await estado.EstaSoportado();
        opfs = await estado.OpfsSoportado();
        sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
        instalada = await estado.EstaInstalada();

        // SE REENGANCHA AL MODO DE LA VEZ PASADA, y sin gesto. Es lo que hace que en un
        // telefono la app se abra sola con sus datos en vez de pedir el boton cada vez.
        if (await estado.ReengancharModo())
        {
            await Arrancar();
            return;
        }

        if (soportado != true) return;

        // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI.
        ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();

        // Con permiso ya otorgado se abre solo: el usuario no tiene que apretar nada
        // para ver sus propias compras.
        if (recuperada.Ok) await Arrancar();
    }

    private Task ConectarCarpeta() => Intentar("elegir carpeta", async () =>
    {
        if ((await estado.ConectarCarpeta()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    // GUARDAR EN EL NAVEGADOR. No pide gesto al browser -el origen es dueño de su propio
    // almacenamiento- pero SI sale de un click: es una decision de la persona sobre donde
    // van sus datos, y esas no se toman solas.
    private Task UsarNavegador() => Intentar("guardar en este navegador", async () =>
    {
        if ((await estado.UsarAlmacenamientoDelNavegador()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task PedirPermiso() => Intentar("dar permiso a la carpeta", async () =>
    {
        if ((await estado.PedirPermiso()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task Arrancar() => Intentar("abrir la app", async () =>
    {
        await estado.Arrancar();
        Releer();
    });

    private Task Refrescar() => Intentar("refrescar contra el proveedor", async () =>
    {
        refrescando = true;
        try { await estado.Refrescar(); }
        finally { refrescando = false; Releer(); }
    });

    // Una app que no puede abrir tiene que DECIR por que, y en que paso.
    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder($"Paso: {paso}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE: casi todo lo que decide esta pantalla vive en
            // EstadoDeLaApp (servicio inyectado) y Blazor no observa objetos ajenos.
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload del proveedor nunca llega
    // hasta aca: solo entra como argumento de un comando, dentro del bucle de refresh.
    private void Releer()
    {
        compras = estado.Compras();
        cantidad = estado.Cantidad();
        total = estado.Total();
        ultimoEvento = estado.UltimoEvento();
        garantias = estado.GarantiasVigentes();
        // Si alguna garantia ya pide moverse, SU fila arranca abierta: esa si es noticia.
        foreach (GarantiaDeProducto g in garantias)
            if (g.QueHacer.Length > 0) { verGarantias = true; break; }
        pendientes = estado.AbastecimientosPendientes();

        // Qué dos meses se comparan lo elige el DOMINIO, que conoce su propio rango.
        // Antes lo decidía esta pantalla mirando la última fila de la tabla.
        comparacion = estado.ComparacionPorDefecto();

        // La portada: lo estable y lo que cambió.
        desdeCuando = DesdeCuando(estado.Rango());
        promociones = estado.Promociones();
        porCaer = estado.Lista();
        firma = estado.Firma();
        cambio = estado.CambioDelUltimoAnio();
        ritmos = estado.RitmosQueCambiaron();
        ritmo = estado.Ritmo();
        mes = estado.ComparacionConElMesAnterior();
        precios = estado.Precios();
        frente = estado.FrenteAlPasado();
        recorrido = estado.Recorrido();

        // EL HERO, al final, porque lee cambio, precios, firma y promociones, y los cuatro
        // ya estan releidos aca.
        //
        // LA NOVEDAD SOLO CUENTA SI ES RECIENTE. cambio.Entraron es el quiebre que encontro
        // el dominio, y ese quiebre no se mueve solo hasta que entra algo nuevo de verdad —
        // asi que sin este filtro el hero seguiria diciendo "llego algo nuevo" ocho meses
        // despues de que dejo de serlo.
        heroOportunidad = Oportunidad();
        heroNovedad = cambio is not null && cambio.Entraron.Count > 0
                      && EsRecienteElMes(cambio.Entraron[0].Desde)
            ? cambio.Entraron[0]
            : null;

        // LA PROMO SOLO CUENTA SI ES DE ALGO QUE ELLA COMPRA DE VERDAD -su sku aparece
        // entre sus habituales o entre lo que tiene precio seguido-, nunca la primera que
        // llegue: "no forzar promociones" fue instruccion explicita, y una promo generica
        // en el hero es exactamente eso.
        heroPromo = promociones.FirstOrDefault(p =>
            p.Sku.Length > 0
            && ((firma is not null && firma.Habituales.Any(h => h.Sku == p.Sku))
                || precios.Any(pr => pr.Sku == p.Sku)));
    }

    // "RECIENTE" es este mes, el pasado o el anterior a ese: tres meses de ventana, ni un
    // quiebre de anteayer ni uno del año pasado disfrazado de noticia.
    private static bool EsRecienteElMes(string aaaaMm)
    {
        string[] partes = aaaaMm.Split('-');
        if (partes.Length < 2 || !int.TryParse(partes[0], out int anio)
                               || !int.TryParse(partes[1], out int mes)) return false;

        int mesesDeDiferencia = (DateTime.Now.Year - anio) * 12 + (DateTime.Now.Month - mes);
        return mesesDeDiferencia is >= 0 and <= 2;
    }

    private void VerDetalle(string numero) =>
        navegacion.NavigateTo($"compra/{Uri.EscapeDataString(numero)}");

    private static string Mes(int mes) =>
        CultureInfo.GetCultureInfo("es").DateTimeFormat.GetAbbreviatedMonthName(mes);

    // SIN SIGNO, a proposito: los dos lugares que lo usan ponen una flecha al lado, y un
    // "-8%" junto a un ▼ dice la misma cosa dos veces.
    private static string Porcentaje(decimal proporcion) =>
        Math.Abs(proporcion * 100m).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    // Formato explicito SIEMPRE (la escala del decimal no sobrevive el journal).
    // CUANTOS RECIBOS SE PINTAN. Con 87 compras semanales la tabla volcaba las 87 filas, y
    // la especificacion es explicita en que "la lista de recibos existe, pero no es la
    // portada": una pared de 87 filas la vuelve la portada por tamaño, aunque este al
    // final. Doce son unos tres meses de compras semanales, que es lo que alguien recorre
    // buscando un ticket que hizo hace poco.
    //
    // No se ESCONDE nada, y la linea de abajo lo dice: las demas siguen en su carpeta y su
    // asistente las consulta todas. Acotar la pantalla no es acotar el dato.
    private const int RecibosQueSeMuestran = 12;

    private IEnumerable<CompraEnLista> Recientes()
    {
        int desde = Math.Max(0, compras.Count - RecibosQueSeMuestran);
        for (int i = compras.Count - 1; i >= desde; i--) yield return compras[i];
    }

    // LAS COMPRAS DEL MES QUE LA TARJETA MUESTRA. Se filtra la lista que ya esta en
    // memoria: pedirle al dominio una consulta nueva para esto seria pagar una
    // rehidratacion por un filtro de calendario.
    private IReadOnlyList<CompraEnLista> ComprasDelMes()
    {
        if (mes is null) return new List<CompraEnLista>();

        var delMes = new List<CompraEnLista>();
        foreach (CompraEnLista compra in compras)
            if (compra.Fecha.Year == mes.AnioDespues && compra.Fecha.Month == mes.MesDespues)
                delMes.Add(compra);

        return delMes;
    }

    // EL SPARKLINE, a escala de SU propio mes y no de una escala fija: lo que la linea
    // cuenta es la FORMA del mes -si arranco fuerte, si hubo un pico-, no como se compara
    // con otro. Por eso el minimo y el maximo son los del mes.
    //
    // Con una sola compra no se dibuja: una linea de un punto no es una linea, y la
    // pantalla ya lo pregunta antes de llamar aca.
    private static string Puntos(IReadOnlyList<CompraEnLista> delMes)
    {
        var partes = new List<string>();
        for (int i = 0; i < delMes.Count; i++)
            partes.Add($"{Equis(i, delMes.Count)},{Ye(delMes[i].Total, delMes)}");

        return string.Join(" ", partes);
    }

    private static string Equis(int i, int cuantos) =>
        (cuantos <= 1 ? 150m : 6m + i * (288m / (cuantos - 1)))
            .ToString("0.#", CultureInfo.InvariantCulture);

    private static string Ye(decimal total, IReadOnlyList<CompraEnLista> delMes)
    {
        decimal menor = delMes[0].Total, mayor = delMes[0].Total;
        foreach (CompraEnLista c in delMes)
        {
            if (c.Total < menor) menor = c.Total;
            if (c.Total > mayor) mayor = c.Total;
        }

        // Todas iguales: la linea va al medio en vez de dividir por cero.
        if (mayor == menor) return "30";

        decimal alto = 6m + (1m - (total - menor) / (mayor - menor)) * 48m;
        return alto.ToString("0.#", CultureInfo.InvariantCulture);
    }

    // LA FOTO DE UN PRODUCTO. El mapa se fue a Fotos.cs cuando paso de trece entradas a
    // treinta y tres: estaba COPIADO aca y en Infaltables, y una tabla de ese tamaño
    // duplicada se desincroniza sola. Sigue siendo decision de PANTALLA -el dominio no sabe
    // que existe una carpeta de assets- pero ahora de una sola pantalla imaginaria.
    //
    // TOTAL: un sku sin foto devuelve vacio y la ficha dibuja un hueco del mismo alto, que
    // es lo que mantiene la rejilla derecha. Con las veinte nuevas ya casi no queda hueco:
    // de los 29 productos del catalogo, 28 tienen imagen.
    private static string Foto(string sku) => Compras.Wasm.Fotos.De(sku);

    // El remate de la bajada del hero: vacio si no se mueve, o nada que decir todavia.
    private string Sucursales() =>
        recorrido is not null && recorrido.HayDatos && recorrido.SeMueve
            ? $" · desde {MesCorto(DesdeCuandoSeMueve())} en {recorrido.CuantasDistintas} sucursales"
            : "";

    private static string MesCorto(DateTime cuando) => cuando.Month switch
    {
        1 => "enero", 2 => "febrero", 3 => "marzo", 4 => "abril", 5 => "mayo", 6 => "junio",
        7 => "julio", 8 => "agosto", 9 => "setiembre", 10 => "octubre", 11 => "noviembre",
        _ => "diciembre",
    };

    // La primera compra fuera de la de siempre: la fecha desde la que "se mueve".
    private DateTime DesdeCuandoSeMueve()
    {
        DateTime primera = DateTime.MaxValue;
        for (int i = 1; i < recorrido!.Sucursales.Count; i++)
            if (recorrido.Sucursales[i].PrimeraVez < primera) primera = recorrido.Sucursales[i].PrimeraVez;
        return primera;
    }

    private string SucursalesNuevas()
    {
        var nombres = new List<string>();
        for (int i = 1; i < recorrido!.Sucursales.Count; i++) nombres.Add(recorrido.Sucursales[i].Nombre);
        return string.Join(" y ", nombres);
    }

    // LA OPORTUNIDAD: la mayor bajada de la serie (vienen ordenadas por cuanto se
    // movieron), saltando la fila estrella, que ya se ve sola.
    private PrecioQueCambio? Oportunidad()
    {
        for (int i = 1; i < precios.Count; i++)
            if (!precios[i].Subio) return precios[i];

        return null;
    }

    // EL NOMBRE CORTO PARA LA FICHA. "Leche semidescremada 1L" en una ficha de 6,5 rem se
    // parte en tres lineas y desalinea la rejilla; el diseño de Fernanda usa "Leche".
    //
    // Se corta por la PRIMERA palabra y no se inventa un diccionario de nombres cortos: un
    // diccionario se desincroniza con el catalogo, y la primera palabra de la descripcion
    // del supermercado es justamente lo que el producto ES. El nombre completo sigue en el
    // detalle de la compra, donde hay espacio.
    private static string Corto(string descripcion)
    {
        int espacio = descripcion.IndexOf(' ');
        return espacio > 2 ? descripcion[..espacio] : descripcion;
    }

    // La frecuencia dicha como se dice, no la fraccion del mecanismo. La cuenta exacta la
    // da la tool la_firma_de_mi_canasta, que es quien la necesita.
    private static string Frecuencia(ProductoQueVuelve habitual) =>
        habitual.EstaEnTodas
            ? "lo llevás cada vez que vas"
            : "lo llevás casi cada vez que vas";

    // LOS QUE SE PINTAN: solo los atrasados, y unos pocos. El dia de ir al super casi todos
    // los habituales "tocan" -medido con los datos reales: 16 de 22-, y una carta con
    // dieciseis nombres deja de ser el resumen que la app tiene que dar.
    //
    // Se corta en el PRIMERO QUE NO TOCA y no se filtra la lista entera: viene ordenada del
    // mas atrasado al que menos falta, asi que despues del primero que no toca no hay
    // ninguno que si.
    private IReadOnlyList<ProductoPorCaer> Faltantes()
    {
        if (porCaer is null) return new List<ProductoPorCaer>();

        var pocos = new List<ProductoPorCaer>();
        foreach (ProductoPorCaer producto in porCaer.Productos)
        {
            if (!producto.Toca || pocos.Count == FaltantesQueSeMuestran) break;

            pocos.Add(producto);
        }

        return pocos;
    }

    // TUTEAR UNA FRASE ESCRITA PARA EL ASISTENTE. Es un parche honesto y acotado: el
    // dominio escribe "su canasta", "compro", "lleva" porque esas lineas las lee la IA
    // hablando DE ella; en pantalla hay que hablarle A ella.
    //
    // Solo se usa donde la frase aporta algo que las cifras de al lado no dicen. Donde no
    // aporta, la pantalla escribe la suya y listo — que es lo que se hizo en las otras tres.
    // "9 de mayo de 2026": la fecha como se dice. Los meses van a mano por la globalizacion
    // recortada de wasm, igual que en todas las pantallas.
    private static string Fecha(DateTime cuando)
    {
        string[] meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio",
            "julio", "agosto", "setiembre", "octubre", "noviembre", "diciembre" };

        return $"{cuando.Day} de {meses[cuando.Month - 1]} de {cuando.Year}";
    }

    // "enero de 2025" desde el aaaa-mm que devuelve el dominio. El formato con guion es
    // como la fecha VIAJA -y asi la da la tool del MCP, que es lo correcto para una
    // maquina-; en pantalla se lee.
    private static string DesdeCuando(RangoDelHistorialVista rango)
    {
        if (rango is null || rango.PrimerMes.Length < 7) return "";

        string[] partes = rango.PrimerMes.Split('-');
        if (partes.Length < 2 || !int.TryParse(partes[1], out int mes) || mes < 1 || mes > 12) return "";

        string[] meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio",
            "julio", "agosto", "setiembre", "octubre", "noviembre", "diciembre" };

        return $"{meses[mes - 1]} de {partes[0]}";
    }

    // "enero" desde el aaaa-mm del corte, para decir "cambio desde enero" como el rediseño.
    private static string MesLegible(string aaaaMm)
    {
        string[] partes = aaaaMm.Split('-');
        if (partes.Length < 2 || !int.TryParse(partes[1], out int mes) || mes < 1 || mes > 12) return aaaaMm;

        string[] meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio",
            "julio", "agosto", "setiembre", "octubre", "noviembre", "diciembre" };
        return meses[mes - 1];
    }

    private static string DiaSemana(DateTime cuando) => cuando.DayOfWeek switch
    {
        DayOfWeek.Monday => "lunes", DayOfWeek.Tuesday => "martes",
        DayOfWeek.Wednesday => "miércoles", DayOfWeek.Thursday => "jueves",
        DayOfWeek.Friday => "viernes", DayOfWeek.Saturday => "sábado", _ => "domingo",
    };

    private static string HoraCorta(DateTime cuando)
    {
        int hora = cuando.Hour % 12;
        if (hora == 0) hora = 12;
        return $"{hora}:{cuando.Minute:00} {(cuando.Hour < 12 ? "a.m." : "p.m.")}";
    }

    private static string Tuteada(string frase)
    {
        if (frase.Length == 0) return frase;

        string tuya = frase
            .Replace("su canasta", "tu canasta")
            .Replace("Su canasta", "Tu canasta")
            .Replace("su semana", "tu semana")
            .Replace(" compro ", " compraste ")
            .Replace(" lleva ", " llevás ");

        return char.ToUpperInvariant(tuya[0]) + tuya.Substring(1);
    }

    // Los tres tintes de la paleta rotan por posicion: no hay semantica que los distinga
    // -todas son promociones- y la rotacion es lo que hace la tira variada sin decidir nada.
    private static string Tinte(int posicion) =>
        (posicion % 3) switch { 0 => "promo--verde", 1 => "promo--crema", _ => "promo--morado" };

    // "valida hasta el viernes 5" cuando quedan dias; "ultimo dia" cuando es hoy. La fecha
    // del evento viaja como aaaa-mm-dd y aca se dice como se dice.
    private string Vigencia(PromocionVista promo)
    {
        if (promo.DiasQueQuedan == 0) return "último día";

        if (DateTime.TryParse(promo.ValidaHasta, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out DateTime hasta))
            return $"válida hasta el {DiaCorto(hasta)} {hasta.Day}";

        return $"quedan {promo.DiasQueQuedan} días";
    }

    private static string DiaCorto(DateTime cuando) => cuando.DayOfWeek switch
    {
        DayOfWeek.Monday => "lunes", DayOfWeek.Tuesday => "martes",
        DayOfWeek.Wednesday => "miércoles", DayOfWeek.Thursday => "jueves",
        DayOfWeek.Friday => "viernes", DayOfWeek.Saturday => "sábado", _ => "domingo",
    };

    private static string Colones(decimal monto) =>
        Plata.Colones(monto);   @* la regla vive en el dominio, no en cada pantalla *@
