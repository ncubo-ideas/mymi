<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.19" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- La caratula referencia Compras.App DIRECTO: la misma logica que usan el servidor
       MCP y la consola. Por eso la IA y la persona ven exactamente lo mismo.

       NO poner InvariantGlobalization ni recortar los datos de globalizacion: MEDIDO en
       Examenes que el ctor estatico del Parser de Puppeteer pide la cultura en-us y tira
       CultureNotFoundException si no esta. Es justo el flag que uno agrega para bajar el
       payload, asi que es facil de reintroducir sin querer. -->
  <ItemGroup>
    <ProjectReference Include="..\Compras.App\Compras.App.csproj" />
  </ItemGroup>

</Project>
