<Project Sdk="Microsoft.NET.Sdk">

  <!-- La superficie MCP: un proceso local, SOLO LECTURA, sobre la misma carpeta de
       journal que escribe la app instalada.
       No le habla al browser ni el browser le habla a el. Los dos comparten la carpeta,
       y el journal YA es el protocolo: no hay que inventar uno.
       Una pagina en el browser no puede hospedar un servidor MCP (no puede escuchar
       conexiones entrantes), asi que este proceso es inevitable. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Compras.Mcp</RootNamespace>
    <AssemblyName>Compras.Mcp</AssemblyName>

    <AssemblyTitle>Compras - la superficie que ve la IA</AssemblyTitle>
    <Description>Servidor MCP de solo lectura sobre el diario de compras de la persona. Ocho consultas intencionales; las cuatro que importan miran lo que ninguna pantalla puede mostrar: lo que dejo de comprar, las garantias cuya ventana se cierra, la serie de un consumo mes a mes y su propia inflacion por unidad de medida. No escribe: nunca un comando, y ni siquiera la semilla.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />

    <!-- El host generico (Host.CreateApplicationBuilder). Se declara ACA a proposito:
         quien usa un host generico lo declara, en vez de heredarlo de una dependencia
         que no tiene nada que ver (la leccion que Examenes documento al pasar el motor
         a NuGet). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compras.App\Compras.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README-para-la-IA.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

