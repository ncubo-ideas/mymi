<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Mock del servidor del proveedor (URL2). Happy path, estado en memoria, cero
       dependencias externas.

       No pretende ser el server de verdad. Su unico trabajo es hacer FALSABLES los
       invariantes del MVP: que la app solo pueda leer su propia narrativa y que el
       token no le sirva para nada mas. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EventosMock</RootNamespace>
    <AssemblyName>EventosMock</AssemblyName>

    <!-- Este NO es el modulo: es el sistema del supermercado, del otro lado del HTTP. Se
         distingue en el Product para que nadie lo confunda con la app de la persona. -->
    <Product>La Guaria - sistemas internos</Product>
    <AssemblyTitle>La Guaria - endpoint de eventos (mock)</AssemblyTitle>
    <Description>Mock del servidor del supermercado: publica los eventos de compra del cliente, emite el token del device y lo rota, y expone el senuelo que devuelve 403 con el token valido de la app. Happy path, estado en memoria.</Description>
  </PropertyGroup>

</Project>

