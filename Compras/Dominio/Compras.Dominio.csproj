<Project Sdk="Microsoft.NET.Sdk">

  <!-- El puppet. CERO dependencias: ni Puppeteer, ni HTTP, ni wasm, ni MCP.
       Que este csproj no tenga un solo PackageReference ni ProjectReference es
       la prueba de que el dominio no cambia al cruzar a wasm. Si algun dia
       necesita una, eso es el hallazgo. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Lo que el Host puede mostrar de ESTE dll sin arrancarlo. La compania y la version
         vienen del props del negocio; lo que cambia por proyecto es que ES cada uno. -->
    <AssemblyTitle>Compras - dominio</AssemblyTitle>
    <Description>El dominio de las compras de la persona: sus tickets, la canasta del mes departamento por departamento, la firma de lo que no falla, el mes en que la canasta cambio, las garantias con su respaldo, el precio que ella pago por unidad de medida y el ritmo con que repone cada pasillo. Cero dependencias: ni motor, ni HTTP, ni wasm.</Description>
  </PropertyGroup>

</Project>

