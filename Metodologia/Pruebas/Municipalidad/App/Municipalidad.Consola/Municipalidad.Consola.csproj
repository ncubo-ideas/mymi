<Project Sdk="Microsoft.NET.Sdk">

  <!-- La caratula de consola. Es el arnes con el que se trabaja: mide el dominio sin el
       sandbox del browser encima, y por eso es donde se valida primero.

       `comprobar` corre las comprobaciones del dominio PURO: sin actor, sin journal y
       sin disco. `medir <carpeta>` corre el ciclo completo contra un journal real, y se
       corre DOS veces sobre la misma carpeta: la segunda tiene que rechazar todo. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Municipalidad.Consola</RootNamespace>
    <AssemblyName>Municipalidad.Consola</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Dominio\Municipalidad.Dominio.csproj" />
    <ProjectReference Include="..\Municipalidad.App\Municipalidad.App.csproj" />
  </ItemGroup>

</Project>
