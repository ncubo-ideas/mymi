<Project Sdk="Microsoft.NET.Sdk">

  <!-- LA SUPERFICIE INTENCIONAL. Aca viven los PerformCommand y los PerformQuery.

       NO REFERENCIA AL DOMINIO, y es a proposito: el dominio es enteramente internal y
       este nodo no nombra ni un tipo suyo en C#. Los nombres viajan DENTRO de los
       scripts y los resuelve el motor por reflexion, que no tiene frontera de assembly.

       Es tambien donde los dos alfabetos de `Periodo` se resuelven: el texto "2026.04"
       se parte en anio y numero ACA, y el dominio recibe los dos enteros. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ncubo.Puppeteer" Version="$(VersionDelMotor)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Dominio\Municipalidad.Dominio.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
