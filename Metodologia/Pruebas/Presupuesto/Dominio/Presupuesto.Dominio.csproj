<Project Sdk="Microsoft.NET.Sdk">

  <!-- El puppet. CERO dependencias: ni Puppeteer, ni HTTP, ni wasm, ni MCP.
       Que este csproj no tenga un solo PackageReference ni ProjectReference es
       la prueba de que el dominio no cambia al cruzar a wasm.

       Este dominio es el SUJETO DE PRUEBA de la Metodologia: se construyo unicamente
       con Preguntas.md en la mano, sin volver a preguntarle nada a nadie. Lo que el
       archivo no alcanzo a decidir esta marcado con HUECO y listado en HUECOS.md. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- LA UNICA EXCEPCION LEGITIMA. El fixture instancia el modelo directo, sin pasar por
       scripts, y es el unico codigo C# fuera del dominio que nombra tipos del dominio.
       Un grant NOMINAL: explicito, auditable, y se le puede pedir cuentas a quien agregue
       el segundo. `public` no le pide permiso a nadie ni deja rastro.
       Sin PublicKey porque nada de este ecosistema esta firmado. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Presupuesto.Consola" />
  </ItemGroup>

</Project>
