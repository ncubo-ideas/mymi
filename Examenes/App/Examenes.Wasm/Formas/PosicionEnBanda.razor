@using System.Globalization
@using System.Linq
@using Examenes.App.Vistas

@*  LA FORMA DE LA HEMOGLOBINA: dónde caés dentro de una banda con piso Y techo.

    RONDA 13: la pista pasa de dos rectángulos plano gris/verde a la MISMA pista continua
    verde→amarillo→rojo que el resto de la app ya usa para "rango de referencia", pero con
    sus tramos calculados desde EL PISO Y EL TECHO REALES -nunca un degradé fijo por
    porcentaje-: el verde cubre EXACTAMENTE el tramo [piso, techo] que el dominio marca
    como esperado, y el amarillo/rojo sólo aparecen FUERA de esa banda (más rojo cuanto
    más lejos). Así un valor real adentro de la banda SIEMPRE cae en zona verde -nunca en
    una franja amarilla decorativa que no le corresponde-, y si no hay banda que dibujar
    (Piso o Techo ausentes) no hay "afuera" que marcar: la pista entera queda verde en vez
    de inventar un degradé sin base real.

    Es el único analito del demo al que le conviene quedarse quieto: alejarse es peor en
    las dos direcciones. Por eso su dibujo no es una flecha ni un progreso — es una
    posición.                                                                            *@

<div class="forma forma--banda">
    <p class="detalle-rango-rotulo">Rango de referencia</p>
    <div class="detalle-rango-pista" style="background:@Gradiente">
        <div class="detalle-rango-marca @(Dentro ? "detalle-rango-marca--dentro" : "detalle-rango-marca--fuera")"
             style="left:@(Marca)%"></div>
    </div>

    <div class="forma-pie forma-pie--extremos">
        <span class="forma-nota">@Numero(Piso?.Valor ?? 0) @Unidad</span>
        <span class="forma-nota forma-nota--centro"><b>@Numero(Actual) @Unidad</b></span>
        <span class="forma-nota forma-nota--der">@Numero(Techo?.Valor ?? 0) @Unidad</span>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<PuntoDeSerie> Puntos { get; set; } = new List<PuntoDeSerie>();
    [Parameter] public IReadOnlyList<LineaDeReferencia> Referencias { get; set; } = new List<LineaDeReferencia>();
    [Parameter] public string Descripcion { get; set; } = "";

    private LineaDeReferencia? Piso => Referencias.FirstOrDefault(r => r.Nombre == "piso");
    private LineaDeReferencia? Techo => Referencias.FirstOrDefault(r => r.Nombre == "techo");

    private decimal Actual => Puntos.Count == 0 ? 0m : Puntos[^1].Valor;
    private string Unidad => Puntos.Count > 0 ? Puntos[0].Unidad : "";

    private bool Dentro => Piso is not null && Techo is not null
        && Actual >= Piso.Valor && Actual <= Techo.Valor;

    // El eje muestra la banda con aire a los lados, para que un valor por fuera se vea
    // FUERA y no pegado al borde. Mismo criterio que antes de esta ronda.
    private decimal Minimo => (Piso?.Valor ?? Actual) - Aire;
    private decimal Maximo => (Techo?.Valor ?? Actual) + Aire;
    private decimal Aire => Piso is null || Techo is null ? 1m : (Techo.Valor - Piso.Valor) * 0.35m;

    private double PosPiso => Posicion(Piso?.Valor ?? Minimo);
    private double PosTecho => Posicion(Techo?.Valor ?? Maximo);
    private string Marca => Posicion(Actual).ToString("0.#", CultureInfo.InvariantCulture);

    private double Posicion(decimal valor)
    {
        decimal recorrido = Maximo - Minimo;
        if (recorrido == 0m) return 50;

        double p = (double)((valor - Minimo) / recorrido);
        p = p < 0 ? 0 : p > 1 ? 1 : p;
        return p * 100;
    }

    // EL DEGRADE: calculado desde piso/techo reales, nunca porcentajes clínicos
    // inventados. Verde cubre [PosPiso, PosTecho] tal cual caen esos dos puntos reales
    // en la pista; afuera de ahí, ámbar y después rojo, a mitad de camino hacia cada
    // borde. Sin banda real (Piso o Techo null) no hay "afuera" que dibujar: todo verde.
    private string Gradiente
    {
        get
        {
            if (Piso is null || Techo is null) return "var(--bien)";

            string N(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
            double mitadIzquierda = PosPiso / 2;
            double mitadDerecha = PosTecho + (100 - PosTecho) / 2;
            return "linear-gradient(90deg, "
                 + $"var(--rojo) 0%, var(--ambar) {N(mitadIzquierda)}%, "
                 + $"var(--bien) {N(PosPiso)}%, var(--bien) {N(PosTecho)}%, "
                 + $"var(--ambar) {N(mitadDerecha)}%, var(--rojo) 100%)";
        }
    }

    private static string Numero(decimal valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
}
