    private IReadOnlyList<CeldaEnCuadro> celdas = new List<CeldaEnCuadro>();

    private sealed class FilaDelCuadro
    {
        public string Analito { get; init; } = "";
        public string ParaMostrar { get; init; } = "";
        public string[] Celdas { get; init; } = new string[0];
    }

    // Las columnas salen de las celdas: el dominio manda la fecha en cada una, ya
    // colapsada por dia, asi que reconstruirlas es juntar las distintas en orden. No es
    // una decision, es un desarmado.
    private List<DateTime> ColumnasDelCuadro()
    {
        var fechas = new List<DateTime>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            while (fechas.Count <= celda.Columna) fechas.Add(default);
            fechas[celda.Columna] = celda.Fecha;
        }
        return fechas;
    }

    private List<FilaDelCuadro> FilasDelCuadro()
    {
        int columnas = ColumnasDelCuadro().Count;
        var porFila = new Dictionary<int, FilaDelCuadro>();

        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFila.TryGetValue(celda.Fila, out FilaDelCuadro fila))
            {
                fila = new FilaDelCuadro
                {
                    Analito = celda.Analito,
                    ParaMostrar = celda.ParaMostrar,
                    // Vacias por defecto: lo que el dominio no mando, no se midio.
                    Celdas = new string[columnas],
                };
                for (int i = 0; i < columnas; i++) fila.Celdas[i] = "";
                porFila[celda.Fila] = fila;
            }
            fila.Celdas[celda.Columna] = celda.Expresado;
        }

        var ordenadas = new List<FilaDelCuadro>();
        for (int i = 0; i < porFila.Count; i++)
            if (porFila.TryGetValue(i, out FilaDelCuadro fila)) ordenadas.Add(fila);
        return ordenadas;
    }

    // El indicador del final de la fila. Lo provee el DOMINIO: es la severidad que decidió
    // el analito, pedida a su Interpretación.
    //
    // Había acá una rama para las filas que no forman serie —los colores— que leía la
    // severidad de la celda. Se fue con ellas: todas las filas tienen serie, así que todas
    // se preguntan igual, y la pantalla dejó de tener dos fuentes para la misma respuesta.
    private string Marca(FilaDelCuadro fila)
    {
        InterpretacionDeAnalito lectura = Lectura(fila.Analito);
        if (lectura.SugiereRepetirElExamen) return "↻";
        return lectura.PideAlgo ? "⚠" : "·";
    }

    // El nombre de la forma tal como lo dice el dominio. La pantalla hace un switch sobre
    // esto y ese switch SÍ es presentación legítima: traduce una forma del dominio a
    // píxeles. Lo que no puede es decidirla.
    private const string FormaDePresencia = "presencia en el tiempo";
    private const string FormaDeCategoria = "categoria en el tiempo";

    private List<PresenciaDeAnalito> presencias = new();
    private Dictionary<string, IReadOnlyList<PruebaEnSerie>> pruebas = new();

    private IReadOnlyList<PruebaEnSerie> Tira(string analito) =>
        pruebas.TryGetValue(analito, out var p) ? p : new List<PruebaEnSerie>();

    private Dictionary<string, IReadOnlyList<ObservacionEnSerie>> observaciones = new();

    private IReadOnlyList<ObservacionEnSerie> Categorias(string analito) =>
        observaciones.TryGetValue(analito, out var o) ? o : new List<ObservacionEnSerie>();

    private Dictionary<string, IReadOnlyList<PuntoDeSerie>> puntos = new();
    private Dictionary<string, IReadOnlyList<LineaDeReferencia>> lineas = new();

    private IReadOnlyList<PuntoDeSerie> Serie(string analito) =>
        puntos.TryGetValue(analito, out var p) ? p : new List<PuntoDeSerie>();

    private IReadOnlyList<LineaDeReferencia> Lineas(string analito) =>
        lineas.TryGetValue(analito, out var l) ? l : new List<LineaDeReferencia>();

    private static readonly CultureInfo Cultura = new CultureInfo("es-ES");

    // Una visita: todo lo que se midió el mismo día. Las celdas ya vienen del dominio
    // agrupadas por columna, así que acá solo se dan vuelta las filas por las fechas.
    private sealed class Visita
    {
        public DateTime Fecha { get; init; }
        public List<CeldaEnCuadro> Celdas { get; } = new();
    }

    // Lo más reciente primero: en un historial se mira para atrás, no para adelante.
    private List<Visita> Visitas()
    {
        var porFecha = new Dictionary<DateTime, Visita>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFecha.TryGetValue(celda.Fecha, out Visita? visita))
            {
                visita = new Visita { Fecha = celda.Fecha };
                porFecha[celda.Fecha] = visita;
            }
            visita.Celdas.Add(celda);
        }

        var visitas = porFecha.Values.ToList();
        visitas.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return visitas;
    }

    private Dictionary<string, InterpretacionDeAnalito> interpretaciones = new();

    private InterpretacionDeAnalito Lectura(string analito) =>
        interpretaciones.TryGetValue(analito, out InterpretacionDeAnalito l)
            ? l
            : new InterpretacionDeAnalito();

    // El chip sale de la SEVERIDAD que decidio el analito, con el mapeo del semáforo:
    // rojo solo para "urgente", que el dominio reserva.
    //
    // El ambar sigue sin usarse para "salto inverosimil": no es una alarma clinica, es
    // "repeti el examen", y el chip neutro lo dice sin gritar.
    private string Insignia(PresenciaDeAnalito p)
    {
        InterpretacionDeAnalito lectura = Lectura(p.Analito);
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!p.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private string Insignia(ConstanciaDeAnalito c)
    {
        InterpretacionDeAnalito lectura = Lectura(c.Analito);
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!c.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private string Insignia(TendenciaDeAnalito t)
    {
        InterpretacionDeAnalito lectura = Lectura(t.Analito);
        if (lectura.SugiereRepetirElExamen) return "chip--repetir";
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!t.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    // Formato explícito SIEMPRE. Medido en el negocio de facturas: la escala del decimal
    // no sobrevive el journal (5571.50 entra, 5571.5 sale del replay), así que un
    // ToString() pelado mostraría valores distintos antes y después de reabrir la app.
    private static string Valor(decimal medido) => medido.ToString("0.##", CultureInfo.InvariantCulture);
