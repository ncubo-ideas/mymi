    private Task Exportar() => Intentar("exportar", async () =>
    {
        ResultadoDeExportacion resultado = await estado.Exportar();
        if (!resultado.Ok) throw new InvalidOperationException(resultado.Motivo);
    });

    // Importar reemplaza el expediente y rearranca el actor, asi que despues hay que
    // releer TODO de la app: los campos del componente quedaron del expediente viejo.
    private Task Importar() => Intentar("importar", async () =>
    {
        string motivo = await estado.Importar();
        if (motivo.Length > 0) throw new InvalidOperationException(motivo);
        Releer();
    });

    // EL ENLACE DEL HANDOFF. Depende de la plataforma -intent:// con fallback en Android,
    // https en el resto- y de las aserciones que haya para pasar, asi que se arma cuando ya
    // se sabe que esta instalacion se retiro. Se guarda en un campo porque tiene que ser un
    // <a href> de verdad: iOS no abre la app desde una navegacion hecha por script.
    private async Task ArmarEnlace()
    {
        if (!estado.EstaArriba || !estado.Migrada) { enlaceAGnothi = ""; return; }

        enlaceAGnothi = estado.EnlaceParaAbrirGnothi(await estado.EsAndroid());
    }

    private Task Arrancar() => Intentar("arrancar", async () =>
    {
        await estado.Arrancar();
        await ArmarEnlace();
        Releer();
    });


    // DECLARAR EL SEXO ES UN COMANDO, y por eso pasa por Intentar como cualquier otro: si
    // la carpeta rechaza la escritura, la persona tiene que enterarse.
    //
    // Después del comando se relee TODO. No es exceso: al declararlo, el historial entero
    // se vuelve interpretable de una vez —los rangos se computan al consultar, nunca se
    // guardaron con la medición— así que cambian las tarjetas, el titular, el conteo y el
    // historial. Releer parcialmente dejaría media pantalla del expediente viejo.
    private Task Declarar(string cual) => Intentar("declararSexo", async () =>
    {
        await estado.DeclararSexo(cual);
        cambiandoSexo = false;
        Releer();
    });

    private Task Refrescar() => Intentar("refrescar", async () =>
    {
        refrescando = true;
        try { await estado.Refrescar(); await ArmarEnlace(); }
        finally { refrescando = false; Releer(); }
    });

    // Una app que no puede abrir tiene que DECIR por que. Sin esto, un fallo en el
    // arranque deja la pantalla igual que antes de apretar el boton y no hay forma de
    // distinguirlo de un click perdido.
    // El mensaje del error solo no alcanza: "no se encontró el archivo" puede venir de
    // leer la carpeta, de escribirla o de la base de handles, y cada una se arregla
    // distinto. Cada paso se nombra, así el próximo fallo dice DÓNDE ocurrió.
    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder(
                textos.Con("fallo.paso", ("paso", textos["fallo." + paso]))
                + $"\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append(textos.Con("fallo.causa",
                    ("causa", $"{interna.GetType().FullName}: {interna.Message}")));
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE, en cualquier salida.
            //
            // Casi todo lo que decide esta pantalla -si hay carpeta, si falta re-otorgar
            // el permiso, si la app ya arranco- vive en EstadoDeLaApp, que es un servicio
            // inyectado. Blazor no observa objetos ajenos al componente: solo repinta por
            // sus propios campos y por el ciclo del evento. Al elegir carpeta el estado
            // cambiaba de verdad, pero la pantalla seguia mostrando el boton, y recien el
            // click siguiente -aunque se cancelara el dialogo sin elegir nada- disparaba
            // el render que mostraba lo correcto. Se veia como "hay que apretar dos veces".
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload del proveedor nunca llega
    // hasta acá: solo entra como argumento de un comando, dentro del bucle de refresh.
    private void Releer()
    {
        examenes = estado.Examenes();
        cantidad = estado.Cantidad();
        fueraDeRango = estado.AnalitosFueraDeRango();
        enRango = estado.LoQueEstaEnRango();
        urgente = estado.Urgente();
        pedido = estado.PedidoDeSexo();
        sexo = estado.SexoDelPaciente();
        ultimoEvento = estado.UltimoEvento();

        // Una lectura por analito con historia. Se piden de a uno porque cada una es una
        // consulta sobre el actor: la pantalla no recorre el dominio, le pregunta.
        //
        // Y SE PREGUNTA POR LA FORMA ANTES QUE POR LOS HECHOS. Un binario no tiene
        // tendencia —el dominio contesta «no aplica»— ni puntos con número, así que
        // pedírselos daría ceros. Cuál puerta usar lo decide la forma, que es dominio: la
        // pantalla la lee, no la inventa.
        var hechos = new List<TendenciaDeAnalito>();
        var presentes = new List<PresenciaDeAnalito>();
        var leidos = new Dictionary<string, InterpretacionDeAnalito>();

        // LOS TRES GRUPOS DE INICIO, armados en la MISMA pasada: es donde ya se
        // conocen PideAlgo (de la lectura) y HaySerie (del hecho/presencia), asi que
        // clasificar aca es leer dos booleanos, no una segunda consulta.
        var atencionT = new List<TendenciaDeAnalito>();
        var atencionP = new List<PresenciaDeAnalito>();
        var atencionC = new List<ConstanciaDeAnalito>();
        var sinTendenciaT = new List<TendenciaDeAnalito>();
        var sinTendenciaP = new List<PresenciaDeAnalito>();
        var sinTendenciaC = new List<ConstanciaDeAnalito>();
        var tranquiloT = new List<TendenciaDeAnalito>();
        var tranquiloP = new List<PresenciaDeAnalito>();
        var tranquiloC = new List<ConstanciaDeAnalito>();

        foreach (string analito in estado.Analitos())
        {
            InterpretacionDeAnalito lectura = estado.Interpretacion(analito);
            leidos[analito] = lectura;

            if (lectura.Forma == FormaDePresencia)
            {
                PresenciaDeAnalito presencia = estado.Presencia(analito);
                presentes.Add(presencia);
                pruebas[analito] = estado.Pruebas(analito);

                if (lectura.PideAlgo) atencionP.Add(presencia);
                else if (!presencia.HaySerie) sinTendenciaP.Add(presencia);
                else tranquiloP.Add(presencia);
                continue;
            }

            // TERCERA PUERTA, y por la misma razón que la segunda. Un color no tiene
            // tendencia ni puntos con número: tiene categorías. Antes caía por la puerta
            // continua y salía como una tarjeta de tendencia «no aplica» con un valor cero.
            if (lectura.Forma == FormaDeCategoria)
            {
                ConstanciaDeAnalito constancia = estado.Constancia(analito);
                observaciones[analito] = estado.Observaciones(analito);

                if (lectura.PideAlgo) atencionC.Add(constancia);
                else if (!constancia.HaySerie) sinTendenciaC.Add(constancia);
                else tranquiloC.Add(constancia);
                continue;
            }

            TendenciaDeAnalito hecho = estado.Tendencia(analito);
            hechos.Add(hecho);
            puntos[analito] = estado.Puntos(analito);
            lineas[analito] = estado.Referencias(analito);

            if (lectura.PideAlgo) atencionT.Add(hecho);
            else if (!hecho.HaySerie) sinTendenciaT.Add(hecho);
            else tranquiloT.Add(hecho);
        }
        analitos = hechos;
        presencias = presentes;
        interpretaciones = leidos;
        celdas = estado.Cuadro();

        atencionAnalitos = atencionT;
        atencionPresencias = atencionP;
        atencionConstancias = atencionC;
        sinTendenciaAnalitos = sinTendenciaT;
        sinTendenciaPresencias = sinTendenciaP;
        sinTendenciaConstancias = sinTendenciaC;
        tranquiloAnalitos = tranquiloT;
        tranquiloPresencias = tranquiloP;
        tranquiloConstancias = tranquiloC;
    }

    private void VerSerie(string analito) =>
        navegacion.NavigateTo($"analito/{Uri.EscapeDataString(analito)}");

    // Los HECHOS de la serie, contados por la pantalla. Es lo que hace imposible el
    // consejo de plantilla: acá no hay de dónde sacar "bajá las grasas".
    //
    // Sin serie devuelve VACÍO y no una frase: esa la dice el analito en su ParaSonia, y
    // tenerla en los dos lados imprimía "todavía no hay serie" dos veces seguidas en la
    // misma tarjeta.
    // Los HECHOS de una serie binaria, contados por la pantalla con lo que da el dominio.
    // No hay de dónde sacar un consejo acá tampoco: son cuántas pruebas y cuántas dieron
    // presente.
    private string Relato(PresenciaDeAnalito p) =>
        p.HaySerie
            ? textos.Con("tranquilo.relatoPresencia",
                ("positivas", p.Positivas.ToString(CultureInfo.InvariantCulture)),
                ("pruebas", p.Mediciones.ToString(CultureInfo.InvariantCulture)),
                ("dias", textos.Dias(p.Dias)))
            : "";

    private string Relato(ConstanciaDeAnalito c) =>
        c.HaySerie
            ? textos.Con("tranquilo.relatoConstancia",
                ("esperables", (c.Mediciones - c.NoEsperables).ToString(CultureInfo.InvariantCulture)),
                ("veces", c.Mediciones.ToString(CultureInfo.InvariantCulture)),
                ("dias", textos.Dias(c.Dias)))
            : "";

    private string Relato(TendenciaDeAnalito t) =>
        t.HaySerie
            ? textos.Con("tranquilo.relatoTendencia",
                ("antes", textos.Numero(t.ValorInicial)),
                ("ahora", textos.Medida(t.ValorFinal, t.Unidad)),
                ("dias", textos.Dias(t.Dias)),
                ("mediciones", Mediciones(t.Mediciones)))
            : "";

    private IReadOnlyList<CeldaEnCuadro> celdas = new List<CeldaEnCuadro>();

    private sealed class FilaDelCuadro
    {
        public string Analito { get; init; } = "";
        public string ParaMostrar { get; init; } = "";
        public string[] Celdas { get; init; } = new string[0];
    }

    // Las columnas salen de las celdas: el dominio manda la fecha en cada una, ya
    // colapsada por dia, asi que reconstruirlas es juntar las distintas en orden. No es
    // una decision, es un desarmado.
    private List<DateTime> ColumnasDelCuadro()
    {
        var fechas = new List<DateTime>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            while (fechas.Count <= celda.Columna) fechas.Add(default);
            fechas[celda.Columna] = celda.Fecha;
        }
        return fechas;
    }

    private List<FilaDelCuadro> FilasDelCuadro()
    {
        int columnas = ColumnasDelCuadro().Count;
        var porFila = new Dictionary<int, FilaDelCuadro>();

        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFila.TryGetValue(celda.Fila, out FilaDelCuadro fila))
            {
                fila = new FilaDelCuadro
                {
                    Analito = celda.Analito,
                    ParaMostrar = celda.ParaMostrar,
                    // Vacias por defecto: lo que el dominio no mando, no se midio.
                    Celdas = new string[columnas],
                };
                for (int i = 0; i < columnas; i++) fila.Celdas[i] = "";
                porFila[celda.Fila] = fila;
            }
            fila.Celdas[celda.Columna] = celda.Expresado;
        }

        var ordenadas = new List<FilaDelCuadro>();
        for (int i = 0; i < porFila.Count; i++)
            if (porFila.TryGetValue(i, out FilaDelCuadro fila)) ordenadas.Add(fila);
        return ordenadas;
    }

    // El indicador del final de la fila. Lo provee el DOMINIO: es la severidad que decidió
    // el analito, pedida a su Interpretación.
    //
    // Había acá una rama para las filas que no forman serie —los colores— que leía la
    // severidad de la celda. Se fue con ellas: todas las filas tienen serie, así que todas
    // se preguntan igual, y la pantalla dejó de tener dos fuentes para la misma respuesta.
    private string Marca(FilaDelCuadro fila)
    {
        InterpretacionDeAnalito lectura = Lectura(fila.Analito);
        if (lectura.SugiereRepetirElExamen) return "↻";
        return lectura.PideAlgo ? "⚠" : "·";
    }

    // El nombre de la forma tal como lo dice el dominio. La pantalla hace un switch sobre
    // esto y ese switch SÍ es presentación legítima: traduce una forma del dominio a
    // píxeles. Lo que no puede es decidirla.
    private const string FormaDePresencia = "presencia en el tiempo";
    private const string FormaDeCategoria = "categoria en el tiempo";

    private List<PresenciaDeAnalito> presencias = new();
    private Dictionary<string, IReadOnlyList<PruebaEnSerie>> pruebas = new();

    private IReadOnlyList<PruebaEnSerie> Tira(string analito) =>
        pruebas.TryGetValue(analito, out var p) ? p : new List<PruebaEnSerie>();

    private Dictionary<string, IReadOnlyList<ObservacionEnSerie>> observaciones = new();

    private IReadOnlyList<ObservacionEnSerie> Categorias(string analito) =>
        observaciones.TryGetValue(analito, out var o) ? o : new List<ObservacionEnSerie>();

    private Dictionary<string, IReadOnlyList<PuntoDeSerie>> puntos = new();
    private Dictionary<string, IReadOnlyList<LineaDeReferencia>> lineas = new();

    private IReadOnlyList<PuntoDeSerie> Serie(string analito) =>
        puntos.TryGetValue(analito, out var p) ? p : new List<PuntoDeSerie>();

    private IReadOnlyList<LineaDeReferencia> Lineas(string analito) =>
        lineas.TryGetValue(analito, out var l) ? l : new List<LineaDeReferencia>();

    // Una visita: todo lo que se midió el mismo día. Las celdas ya vienen del dominio
    // agrupadas por columna, así que acá solo se dan vuelta las filas por las fechas.
    private sealed class Visita
    {
        public DateTime Fecha { get; init; }
        public List<CeldaEnCuadro> Celdas { get; } = new();
    }

    // Lo más reciente primero: en un historial se mira para atrás, no para adelante.
    private List<Visita> Visitas()
    {
        var porFecha = new Dictionary<DateTime, Visita>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFecha.TryGetValue(celda.Fecha, out Visita? visita))
            {
                visita = new Visita { Fecha = celda.Fecha };
                porFecha[celda.Fecha] = visita;
            }
            visita.Celdas.Add(celda);
        }

        var visitas = porFecha.Values.ToList();
        visitas.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return visitas;
    }

    private Dictionary<string, InterpretacionDeAnalito> interpretaciones = new();

    private InterpretacionDeAnalito Lectura(string analito) =>
        interpretaciones.TryGetValue(analito, out InterpretacionDeAnalito l)
            ? l
            : new InterpretacionDeAnalito();

    // El chip sale de la SEVERIDAD que decidio el analito, con el mapeo del semáforo:
    // rojo solo para "urgente", que el dominio reserva.
    //
    // El ambar sigue sin usarse para "salto inverosimil": no es una alarma clinica, es
    // "repeti el examen", y el chip neutro lo dice sin gritar.
    private string Insignia(PresenciaDeAnalito p)
    {
        InterpretacionDeAnalito lectura = Lectura(p.Analito);
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!p.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private string Insignia(ConstanciaDeAnalito c)
    {
        InterpretacionDeAnalito lectura = Lectura(c.Analito);
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!c.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private string Insignia(TendenciaDeAnalito t)
    {
        InterpretacionDeAnalito lectura = Lectura(t.Analito);
        if (lectura.SugiereRepetirElExamen) return "chip--repetir";
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!t.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    /// <summary>
    /// UN VALOR MEDIDO, dicho por el renderizador. El separador decimal lo pone el idioma, y
    /// el formato es explicito siempre: la escala del decimal no sobrevive el journal.
    /// </summary>
    private string Valor(decimal medido) => textos.Numero(medido);
