    });

    // Una app que no puede abrir tiene que DECIR por que. Sin esto, un fallo en el
    // arranque deja la pantalla igual que antes de apretar el boton y no hay forma de
    // distinguirlo de un click perdido.
    // El mensaje del error solo no alcanza: "no se encontró el archivo" puede venir de
    // leer la carpeta, de escribirla o de la base de handles, y cada una se arregla
    // distinto. Cada paso se nombra, así el próximo fallo dice DÓNDE ocurrió.
    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder($"Paso: {paso}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE, en cualquier salida.
            //
            // Casi todo lo que decide esta pantalla -si hay carpeta, si falta re-otorgar
            // el permiso, si la app ya arranco- vive en EstadoDeLaApp, que es un servicio
            // inyectado. Blazor no observa objetos ajenos al componente: solo repinta por
            // sus propios campos y por el ciclo del evento. Al elegir carpeta el estado
            // cambiaba de verdad, pero la pantalla seguia mostrando el boton, y recien el
            // click siguiente -aunque se cancelara el dialogo sin elegir nada- disparaba
            // el render que mostraba lo correcto. Se veia como "hay que apretar dos veces".
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload del proveedor nunca llega
    // hasta acá: solo entra como argumento de un comando, dentro del bucle de refresh.
    private void Releer()
    {
        examenes = estado.Examenes();
        cantidad = estado.Cantidad();
        fueraDeRango = estado.AnalitosFueraDeRango();
        enRango = estado.LoQueEstaEnRango();
        urgente = estado.Urgente();
        pedido = estado.PedidoDeSexo();
        sexo = estado.SexoDelPaciente();
        ultimoEvento = estado.UltimoEvento();

        // Una lectura por analito con historia. Se piden de a uno porque cada una es una
        // consulta sobre el actor: la pantalla no recorre el dominio, le pregunta.
        //
        // Y SE PREGUNTA POR LA FORMA ANTES QUE POR LOS HECHOS. Un binario no tiene
        // tendencia —el dominio contesta «no aplica»— ni puntos con número, así que
        // pedírselos daría ceros. Cuál puerta usar lo decide la forma, que es dominio: la
        // pantalla la lee, no la inventa.
        var hechos = new List<TendenciaDeAnalito>();
        var presentes = new List<PresenciaDeAnalito>();
        var leidos = new Dictionary<string, InterpretacionDeAnalito>();

        // LOS TRES GRUPOS DE INICIO, armados en la MISMA pasada: es donde ya se
        // conocen PideAlgo (de la lectura) y HaySerie (del hecho/presencia), asi que
        // clasificar aca es leer dos booleanos, no una segunda consulta.
        var atencionT = new List<TendenciaDeAnalito>();
        var atencionP = new List<PresenciaDeAnalito>();
        var atencionC = new List<ConstanciaDeAnalito>();
        var sinTendenciaT = new List<TendenciaDeAnalito>();
        var sinTendenciaP = new List<PresenciaDeAnalito>();
        var sinTendenciaC = new List<ConstanciaDeAnalito>();
        var tranquiloT = new List<TendenciaDeAnalito>();
        var tranquiloP = new List<PresenciaDeAnalito>();
        var tranquiloC = new List<ConstanciaDeAnalito>();

        foreach (string analito in estado.Analitos())
        {
            InterpretacionDeAnalito lectura = estado.Interpretacion(analito);
            leidos[analito] = lectura;

            if (lectura.Forma == FormaDePresencia)
            {
                PresenciaDeAnalito presencia = estado.Presencia(analito);
                presentes.Add(presencia);
                pruebas[analito] = estado.Pruebas(analito);

                if (lectura.PideAlgo) atencionP.Add(presencia);
                else if (!presencia.HaySerie) sinTendenciaP.Add(presencia);
                else tranquiloP.Add(presencia);
                continue;
            }

            // TERCERA PUERTA, y por la misma razón que la segunda. Un color no tiene
            // tendencia ni puntos con número: tiene categorías. Antes caía por la puerta
            // continua y salía como una tarjeta de tendencia «no aplica» con un valor cero.
            if (lectura.Forma == FormaDeCategoria)
            {
                ConstanciaDeAnalito constancia = estado.Constancia(analito);
                observaciones[analito] = estado.Observaciones(analito);

                if (lectura.PideAlgo) atencionC.Add(constancia);
                else if (!constancia.HaySerie) sinTendenciaC.Add(constancia);
                else tranquiloC.Add(constancia);
                continue;
            }

            TendenciaDeAnalito hecho = estado.Tendencia(analito);
            hechos.Add(hecho);
            puntos[analito] = estado.Puntos(analito);
            lineas[analito] = estado.Referencias(analito);

            if (lectura.PideAlgo) atencionT.Add(hecho);
            else if (!hecho.HaySerie) sinTendenciaT.Add(hecho);
            else tranquiloT.Add(hecho);
        }
        analitos = hechos;
        presencias = presentes;
        interpretaciones = leidos;
        celdas = estado.Cuadro();

        atencionAnalitos = atencionT;
        atencionPresencias = atencionP;
        atencionConstancias = atencionC;
        sinTendenciaAnalitos = sinTendenciaT;
        sinTendenciaPresencias = sinTendenciaP;
        sinTendenciaConstancias = sinTendenciaC;
        tranquiloAnalitos = tranquiloT;
        tranquiloPresencias = tranquiloP;
        tranquiloConstancias = tranquiloC;
    }

