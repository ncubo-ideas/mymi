@page "/"
@using System.Globalization
@using Examenes.App.Vistas
@using Puppets.Portador
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

<PageTitle>Mis exámenes</PageTitle>

@* EL BLOQUE DE MARCA, SOLO PARA EL ARRANQUE. La gota por la muestra, el círculo por el
   oráculo; solo trazo, nunca relleno. Una vez que el expediente está arriba (`else` de
   más abajo) la marca se repite ADENTRO del hero -es contenido suyo en la referencia
   nueva, no un encabezado aparte-, así que acá queda condicionada a antes de abrir: no
   hay forma de compartir el mismo markup entre los dos fondos sin un componente nuevo,
   y esta ronda es solo el hero. *@
@if (!estado.EstaArriba)
{
    <div class="marca">
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"
             fill="none" stroke="var(--logo)" stroke-width="2.4" aria-hidden="true">
            <circle cx="20" cy="20" r="18" />
            <path d="M20 9c4.4 5.4 6.8 9.3 6.8 12.4A6.8 6.8 0 0 1 20 28.2a6.8 6.8 0
                     0 1-6.8-6.8C13.2 18.3 15.6 14.4 20 9z" />
        </svg>
        <div>
            <div class="marca-nombre">Laboratorio Clínico Delfos</div>
            <div class="marca-claim">Al servicio de su salud desde 1987</div>
        </div>
    </div>
}

@* EL TITULO GENERICO SOLO VIVE EN LA PANTALLA DE ARRANQUE (todavia sin carpeta
   conectada): una vez que el expediente esta arriba, este lugar lo ocupa el saludo
   humano de Inicio (mas abajo, adentro del "else" de EstaArriba) y "Mis exámenes" no
   hace falta decirlo dos veces. *@
@if (!estado.EstaArriba)
{
    <h1 class="titular">Mis exámenes</h1>
    <p class="membrete">Tu expediente, en tu computadora.</p>
}

@* UN solo lugar para los errores, y arriba. Antes habia dos bloques -uno adentro del
   arranque y otro al final de la pagina- asi que un mismo fallo se veia dos veces, y
   estando abajo quedaba fuera de pantalla: la app parecia no reaccionar al click. *@
@* role="alert": el error es lo único de esta pantalla que un lector de pantalla tiene que
   interrumpir para decir. Subirlo arriba resolvió el «parecía no reaccionar al click» para
   quien ve; sin esto, para quien no ve seguía sin pasar nada. *@
@if (error.Length > 0)
{
    <div class="aviso aviso--problema" role="alert">
        <strong>@(estado.EstaArriba ? "No se pudo completar la operación." : "No se pudo abrir la app.")</strong>
        <pre>@error</pre>
    </div>
}

@if (!estado.EstaArriba && resolviendo)
{
    @* MIENTRAS SE RESUELVE QUÉ HABÍA RECORDADO, no se pinta el elegidor. Hasta que
       IndexedDB contesta no sabemos si la persona ya eligió, y mostrarle «Elegí dónde» a
       quien eligió la semana pasada es pedirle que vuelva a decidir. Encima sin la tecla
       grande, porque «soportado» y «opfs» todavía son null y los tres modos salen
       deshabilitados. El elegidor aparece SOLO cuando se sabe que no hay nada recordado o
       que recuperarlo falló. *@
    <p class="abriendo" role="status" aria-live="polite">@TextoDeAbriendo()</p>
}
else if (!estado.EstaArriba)
{
    <div class="aviso aviso--neutro">
        @* Cuando el handle volvio de IndexedDB pero el permiso caduco, la accion correcta
           es RE-OTORGAR, no volver a elegir la carpeta. Ofrecer "Elegir carpeta" como
           primaria hacia que la persona reabriera el picker y volviera a navegar hasta la
           misma carpeta cada vez. *@
        @if (estado.FaltaReotorgarPermiso)
        {
            <p>
                Tu carpeta es <strong>&laquo;@estado.NombreDeLaCarpeta&raquo;</strong>. El browser pide
                confirmar el permiso de escritura cada vez que volvés a abrir la app.
            </p>
            <div class="fila" style="margin-top:12px">
                <button class="boton boton--atencion" @onclick="PedirPermiso">
                    Dar permiso a &laquo;@estado.NombreDeLaCarpeta&raquo;
                </button>
                @* Elegir carpeta es una accion de primera clase, siempre. Estaba como
                   outline-secondary y se leia deshabilitada, asi que la opcion de elegir
                   OTRA carpeta parecia no estar disponible. *@
                <button class="boton" @onclick="ConectarCarpeta"
                        disabled="@(soportado == false)">
                    Elegir carpeta
                </button>
            </div>
        }
        else
        {
            <p>Esta app guarda <strong>tus</strong> exámenes. Elegí dónde.</p>

            @* Cuando NINGUN modo de guardado esta disponible, la causa importa: se
               arreglan distinto y una de las dos no es culpa del navegador. *@
            @if (sinAlmacenamiento == "inseguro")
            {
                <p class="aviso aviso--atencion">
                    <strong>Esta página no está en una conexión segura</strong>, y por eso el
                    navegador no le deja guardar nada — en cualquier navegador pasaría lo mismo.
                    Entrá por <strong>https</strong> y las opciones de guardado aparecen.
                </p>
            }
            else if (sinAlmacenamiento == "navegador")
            {
                <p class="aviso aviso--atencion">
                    <strong>@(instalada ? "Acá no se puede guardar el expediente." : "Este navegador no puede guardar el expediente.")</strong>
                    Podés usar la app igual, pero lo que veas se pierde al cerrar. Para que
                    quede guardado, @(instalada ? "instalala" : "abrila") desde
                    <strong>Chrome</strong> o <strong>Edge</strong>.
                </p>
            }

            @* TRES MODOS, y los tres se dicen con lo que dan y lo que no. Ofrecer solo la
               carpeta y fallar donde no hay picker es lo que hacia antes: en Safari,
               Firefox y movil la app andaba pero no persistia nada, y la unica forma de
               enterarse era cerrarla y perder todo. *@
            <div class="modos">
                <div class="modo @(soportado == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">Una carpeta tuya</div>
                    <p>El expediente queda en la carpeta que elijas, en tu disco.
                       <strong>Es el único modo en el que tu asistente lo puede leer.</strong></p>
                    @if (soportado == true)
                    {
                        <button class="boton" @onclick="ConectarCarpeta">Elegir carpeta</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "Hace falta una conexión segura (https)."
                                : instalada
                                    ? "Acá no está disponible. Para usarlo, instalá la app desde Chrome o Edge."
                                    : "Este navegador no lo permite. Para usarlo, abrí la app en Chrome o Edge.")
                        </p>
                    }
                </div>

                @* Instalada, la app NO es "un navegador" para quien la usa: es una ventana
                   con su nombre y su icono, y hablarle de navegadores ahi suena a que se
                   refiere a otra cosa. El almacenamiento es el mismo; cambia como se
                   llama delante de la persona. *@
                <div class="modo @(opfs == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">@(instalada ? "Dentro de la app" : "En este navegador")</div>
                    <p>Se guarda igual y sobrevive al cerrar, pero
                       @(instalada ? "queda dentro de la app" : "lo administra el navegador"):
                       <strong>no es una carpeta tuya y tu asistente no lo puede leer.</strong></p>
                    @if (opfs == true)
                    {
                        <button class="boton boton--contorno" @onclick="UsarNavegador">Guardar acá</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "También hace falta una conexión segura (https)."
                                : "Acá tampoco está disponible.")
                        </p>
                    }
                </div>

                <div class="modo">
                    <div class="modo-titulo">Un archivo</div>
                    <p>Traé un expediente que exportaste antes, desde esta u otra computadora.
                       Funciona en cualquier navegador.</p>
                    <button class="boton boton--contorno" @onclick="Importar">Importar</button>
                </div>
            </div>
        }

        @* Abrir sin guardar es la salida de emergencia, no una alternativa pareja: la app
           anda pero no deja registro tuyo. Va aparte y como enlace, para que se note que
           es otra cosa. *@
        <div style="margin-top:16px">
            <button class="boton boton--enlace" @onclick="Arrancar">Abrir sin guardar nada</button>
        </div>
    </div>
}
else
{
    @*  EL HERO — RONDA 4, RECOMPOSICIÓN VISUAL (no un ajuste más de padding sobre la
        ronda 2/3). La pregunta con la que alguien abre la app sigue siendo la misma:
        «¿estoy bien?». La respuesta sigue siendo del dominio -LoMasUrgente/LoQueEstaEnRango-,
        y esta pantalla no la compone: la ubica.

        LA JERARQUÍA DENTRO DEL HERO SIGUE SIENDO LA DE LA RONDA 2 -la lectura, que es la
        respuesta a "¿estoy bien?", es el titular grande; el saludo humano baja a kicker-,
        Saludo() no cambió una línea, solo dónde se pinta. Lo que cambia esta ronda es la
        COMPOSICIÓN EN TRES ZONAS -marca / contexto personal / protagonista-, con aire real
        entre cada una en vez de un único bloque apilado:

        - ZONA 1 (marca): el `<div class="inicio-hero-marca">` de siempre, sin tocar su
          markup -mismo SVG, mismas clases `marca-nombre`/`marca-claim` que ya usa el bloque
          de arranque-, pero con más aire propio (`margin-bottom` en el CSS).
        - ZONA 2 (contexto personal): "Hola, Sonia." pasa a ser un `<strong>` DENTRO del
          mismo párrafo del kicker -no un `<p>` aparte-, porque separarlos en dos bloques
          (ronda 2) dejaba un hueco vertical inútil entre ambos sin ganar nada de lectura.
          Debajo, la fecha deja de ser un párrafo de una sola línea ("Tu último chequeo ·
          28 abr 2026") y pasa a `.inicio-hero-chequeo`: un rótulo y la fecha en los dos
          extremos de una fila -la fecha "respira" a la derecha, como en la referencia, en
          vez de sumarse a la misma columna de texto que todo lo demás-.
        - ZONA 3 (protagonista): titular, secundario y CTA sin cambios de markup, con más
          espacio propio en el CSS.

        Lo que pide atención sigue siendo la sección de abajo (§2, sin tocar esta ronda). *@
    @* EL @key VA EN EL CUERPO, desde que Actualizar vive acá adentro. Sube en cada Releer
       y obliga a Blazor a RECREAR estos nodos para que la animación de CSS se vuelva a
       disparar -sin él, apretar Actualizar sin exámenes nuevos no producía ningún cambio
       visible-. *@
    <section class="inicio-hero" @key="@($"hero-{estado.Refrescos}")">
        @*  RONDA 6 — LA FOTO DEL MICROSCOPIO SE VA: NO ERA EL ASSET CORRECTO. La ronda
            pasada usé `hero-inicio-v2.png` (recortado) sacado de `Mi Salud v2 oscuro.dc.html`
            porque el nombre del archivo sonaba a "el hero de la propuesta" -exactamente el
            error que se pidió no repetir: elegir por nombre y no por comparación visual-.

            Comparando la captura de referencia con LOS TRES `.dc.html` del ZIP, la ilustración
            azul/cian con curva, nodos y grid que se ve arriba a la derecha en la captura NO es
            ninguna imagen -no hay ningún PNG del ZIP que se le parezca; se probaron los seis
            (`hero-inicio.png`, `hero-inicio-v2.png`, `dx-hero.png`, `dx-hero-scope.png`,
            `dx-logo-tile.png`, `dx-mark-white.png`) y todos son fotos/ilustraciones de
            microscopio o el ícono de la marca-. Es un `<svg>` inline: vive en
            `Mi Salud.dc.html` (el archivo SIN "v2 oscuro" en el nombre -la variante que de
            hecho ya usa Plus Jakarta Sans, no serif-), con `ref="heroArtRef"`: una curva con
            gradiente que se enciende de celeste a cian hacia la derecha, un par de círculos
            de brillo (`radialGradient`), puntitos sueltos, y un mini clúster de 3 nodos
            conectados -el "elemento abstracto tipo molécula" que se pidió en rondas
            anteriores-. ESTA es la pieza que reaparece en el cuadrante superior derecho de la
            captura de referencia: se confirmó comparando la captura recortada contra el
            render de ese SVG antes de portarlo acá, no por el nombre del archivo.

            Se adapta -no se copia entera-: en el original mide 390×180 y cruza casi todo el
            ancho del hero por abajo del status bar; acá se achica a ~190×130 y se ancla arriba
            a la derecha, contenida en la zona de la marca/kicker -así nunca llega a la altura
            del titular, sin necesitar `max-width` en el texto para evitarlo-. Sigue siendo un
            elemento propio (`<div aria-hidden>`, primer hijo de la sección) por la misma razón
            que antes: la máscara que la funde con el fondo aplica a TODO lo que la lleva, así
            que si fuera parte del `background` del hero también taparía el texto. *@
        <div class="inicio-hero-cientifico" aria-hidden="true">
            <svg viewBox="0 0 190 130" width="190" height="130" fill="none">
                <defs>
                    <linearGradient id="ihcCurva" x1="0" y1="0" x2="190" y2="0" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#7db4e0" stop-opacity="0" />
                        <stop offset=".4" stop-color="#7db4e0" stop-opacity=".5" />
                        <stop offset=".78" stop-color="#63d3f0" stop-opacity=".95" />
                        <stop offset="1" stop-color="#9ae6ff" stop-opacity="1" />
                    </linearGradient>
                    <radialGradient id="ihcGlow">
                        <stop offset="0" stop-color="#9ae6ff" stop-opacity=".8" />
                        <stop offset="1" stop-color="#9ae6ff" stop-opacity="0" />
                    </radialGradient>
                </defs>
                <path d="M-6 84 C 26 80 48 66 72 60 C 100 53 116 34 142 26 C 158 21 170 15 196 4"
                      stroke="url(#ihcCurva)" stroke-width="1.5" stroke-linecap="round" />
                <circle cx="142" cy="26" r="16" fill="url(#ihcGlow)" opacity=".55" />
                <circle cx="178" cy="10" r="18" fill="url(#ihcGlow)" opacity=".4" />
                <circle cx="72" cy="60" r="1.7" fill="#bfe6ff" opacity=".5" />
                <circle cx="108" cy="46" r="1.5" fill="#bfe6ff" opacity=".5" />
                <circle cx="142" cy="26" r="2.8" fill="#eaf8ff" />
                <circle cx="178" cy="10" r="2.2" fill="#eaf8ff" opacity=".9" />
                <g stroke="#9ae6ff" stroke-opacity=".3" stroke-width=".8">
                    <path d="M150 76 L 163 68 L 174 74" />
                    <path d="M163 68 L 163 57" />
                </g>
                <g fill="#bfe6ff">
                    <circle cx="150" cy="76" r="1.5" opacity=".42" />
                    <circle cx="163" cy="68" r="1.7" opacity=".48" />
                    <circle cx="174" cy="74" r="1.5" opacity=".4" />
                    <circle cx="163" cy="57" r="1.3" opacity=".32" />
                </g>
            </svg>
        </div>

        @*  LA MARCA — RONDA 6: MÁS PRESENCIA. Mismo SVG y mismas clases `marca-nombre`/
            `marca-claim` que el bloque de arranque de más arriba (ver el
            `@if (!estado.EstaArriba)` guardado al principio del archivo); lo que cambia es
            puramente CSS -logo e tipografía más grandes, más aire arriba del hero (el
            "safe-area" de la referencia: NO se simula una status bar falsa, solo se respeta
            ese espacio con padding) y más separación antes del saludo-. *@
        <div class="inicio-hero-marca">
            <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"
                 fill="none" stroke="var(--logo)" stroke-width="2.4" aria-hidden="true">
                <circle cx="20" cy="20" r="18" />
                <path d="M20 9c4.4 5.4 6.8 9.3 6.8 12.4A6.8 6.8 0 0 1 20 28.2a6.8 6.8 0
                         0 1-6.8-6.8C13.2 18.3 15.6 14.4 20 9z" />
            </svg>
            <div>
                <div class="marca-nombre">Laboratorio Clínico Delfos</div>
                <div class="marca-claim">Al servicio de su salud desde 1987</div>
            </div>

            @* ACTUALIZAR NO ESTÁ EN EL CONTENIDO DE LA REFERENCIA -ahí, arriba a la
               derecha, va una campana de notificaciones que esta app no tiene-, pero
               sigue siendo la única forma de volver a preguntarle al proveedor, y
               sacarla sería perder una acción real. Ocupa el mismo lugar de esa campana,
               como ícono chico y no como botón de texto -discreto, como pediste-: es lo
               que le corresponde a algo que no es el foco del hero.
               aria-busy, recuperado de origin/master: «Actualizando…» ya cambia el
               título del botón, pero un lector de pantalla no vuelve a leerlo si el foco
               ya estaba ahí -el estado ocupado sí lo anuncia-. *@
            <button class="inicio-hero-actualizar" @onclick="Refrescar" disabled="@refrescando"
                    title="@(refrescando ? "Actualizando…" : "Actualizar")" aria-label="Actualizar"
                    aria-busy="@(refrescando ? "true" : "false")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                     class="@(refrescando ? "gira" : "")">
                    <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                    <path d="M21 4v6h-6" />
                </svg>
            </button>
        </div>

        <p class="inicio-hero-kicker"><strong>Hola, Sonia.</strong>Entendé cómo venís, no solo cómo saliste hoy.</p>

        @* LA LÍNEA/DIVISOR "EXTREMADAMENTE SUTIL" ENTRE RÓTULO Y FECHA es la misma técnica
           de la referencia: un `<span>` vacío que ocupa el espacio sobrante (`flex:1`) con
           una línea de 1px, en vez del `border-bottom` de toda la fila que había antes. *@
        @if (UltimoChequeo() is DateTime ultimo)
        {
            <div class="inicio-hero-chequeo">
                <span class="inicio-hero-chequeo-label">Tu último chequeo</span>
                <span class="inicio-hero-chequeo-linea" aria-hidden="true"></span>
                <span class="inicio-hero-chequeo-fecha">@ultimo.ToString("dd MMM yyyy", Cultura)</span>
            </div>
        }

        @* EL MENSAJE PRINCIPAL ES Saludo() -la misma frase de la ronda 1, sin tocar una
           palabra-, ahora con el peso visual más grande del hero. *@
        <h1 class="inicio-hero-titular">@Saludo()</h1>

        @* LA CIFRA ("5 de 6...") sigue siendo literal LoQueEstaEnRango.ParaSonia. *@
        @if (enRango.HayAlgo)
        {
            <p class="inicio-hero-secundario">@enRango.ParaSonia</p>
        }

        @* No hay una pantalla de "chequeo" separada todavía -esta ronda es solo el
           hero-, así que "ver mi chequeo" baja a la visita más reciente de Tu historial
           (§7), que ya está en esta misma página. *@
        <a class="inicio-hero-cta" href="#historial">Ver mi chequeo &rarr;</a>
    </section>

    @* §2 LO QUE MERECE ATENCIÓN — la pieza de mayor jerarquía. Un analito entra acá
       SOLO si su propia Interpretacion dice PideAlgo -nunca por su nombre-, así que si
       mañana es la hemoglobina la que pide algo y el colesterol se calma, este bloque
       cambia solo. El titular, la lectura y la acción siguen siendo del dominio; lo
       único que agrega la pantalla es la cadena "182 → 188 → 212" -los mismos puntos
       que ya grafica la forma, dichos también en números-. *@
    @if (atencionAnalitos.Count > 0 || atencionPresencias.Count > 0)
    {
        int cuantosMerecenAtencion = atencionAnalitos.Count + atencionPresencias.Count + atencionConstancias.Count;
        <section class="inicio-atencion" @key="@($"atencion-{estado.Refrescos}")">
            @* ENCABEZADO — RONDA 7: rótulo de siempre + un indicador contado, no una frase
               genérica. Se pidió explícitamente NO agregar algo como "hay resultados que
               salieron del rango": el colesterol de hoy sigue dentro de su rango informado,
               y esa frase mentiría. Si no hay un texto que se derive de los datos reales,
               se omite -acá directamente no hay ninguno-. *@
            <div class="inicio-atencion-encabezado">
                <p class="inicio-atencion-rotulo">merece atención</p>
                <span class="inicio-atencion-conteo">
                    <span class="inicio-atencion-conteo-punto" aria-hidden="true"></span>
                    <span>@cuantosMerecenAtencion resultado@(cuantosMerecenAtencion == 1 ? "" : "s")</span>
                </span>
            </div>

            @foreach (TendenciaDeAnalito t in atencionAnalitos)
            {
                <div class="inicio-atencion-tarjeta">
                    @{
                        InterpretacionDeAnalito lectura = Lectura(t.Analito);
                        decimal? limiteSuperior = LimiteSuperior(lectura.ReferenciaLegible);
                    }
                    <div class="inicio-atencion-cabeza">
                        <div class="inicio-atencion-titulo">
                            @* EL ÍCONO — RONDA 8: puramente decorativo (un pulso/latido, el
                               símbolo más cercano a "resultado/seguimiento" clínico que se
                               puede dibujar a mano sin sumar una librería), en un círculo
                               ámbar bien translúcido. No representa ningún dato -no cambia
                               con la severidad ni con el analito-, así que no hace falta
                               tocar el code-behind para esto. *@
                            <span class="inicio-atencion-icono" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 12h4l2.5-7 4 14 2.5-7H22" />
                                </svg>
                            </span>
                            <div class="inicio-atencion-nombre-grupo">
                                <span class="inicio-atencion-nombre">@t.ParaMostrar</span>
                                @{ string estadoBreve = EstadoBreve(t, lectura); }
                                @if (estadoBreve.Length > 0)
                                {
                                    <span class="inicio-atencion-estado">@Flecha(t.Tendencia) @estadoBreve</span>
                                }
                            </div>
                        </div>
                        <span class="inicio-atencion-valor">@Valor(t.ValorFinal) <span>@t.Unidad</span></span>
                    </div>
                    @if (t.HaySerie)
                    {
                        <p class="inicio-atencion-serie">@CadenaDeValores(t)</p>
                    }
                    @if (lectura.ReferenciaLegible.Length > 0)
                    {
                        <p class="inicio-atencion-referencia">referencia: @lectura.ReferenciaLegible</p>
                    }
                    @if (!lectura.RequiereElSexo && lectura.Forma.Length > 0)
                    {
                        @switch (lectura.Forma)
                        {
                            case "trayectoria con linea base":
                                <TrayectoriaConLineaBase Puntos="Serie(t.Analito)"
                                                         Referencias="Lineas(t.Analito)"
                                                         PideAlgo="lectura.PideAlgo"
                                                         Descripcion="@lectura.ParaSonia" />
                                break;
                            case "progreso hacia meta":
                                @* RONDA 7: ya NO usa <ProgresoHaciaMeta/> acá adentro -ese
                                   componente es compartido con Tendencia.razor y sigue
                                   dibujando la partida→meta orientativa, sin tocar-. Esta
                                   tarjeta necesita otra cosa: "tu resultado" contra el ÚNICO
                                   límite que el modelo conoce (el de ReferenciaLegible, el
                                   mismo "hasta 220 mg/dL" que ya se ve arriba), sin zonas
                                   normal/límite/alto que el dominio no define. *@
                                @if (limiteSuperior is decimal limite && limite > 0)
                                {
                                    decimal proporcion = Math.Max(0m, Math.Min(1m, t.ValorFinal / limite));
                                    <div class="inicio-atencion-rango">
                                        <div class="inicio-atencion-rango-pista">
                                            <div class="inicio-atencion-rango-limite"></div>
                                            <div class="inicio-atencion-rango-marca" style="left:@((proporcion * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        <div class="inicio-atencion-rango-etiquetas">
                                            <span>Tu resultado · <b>@Valor(t.ValorFinal) @t.Unidad</b></span>
                                            <span>Referencia · @lectura.ReferenciaLegible</span>
                                        </div>
                                    </div>
                                }
                                break;
                            case "posicion en banda":
                                <PosicionEnBanda Puntos="Serie(t.Analito)"
                                                 Referencias="Lineas(t.Analito)"
                                                 Descripcion="@lectura.ParaSonia" />
                                break;
                        }
                    }
                    @if (!string.IsNullOrEmpty(lectura.ParaSonia))
                    {
                        @* EL BLOQUE INFORMATIVO — RONDA 8: mismo texto de siempre
                           (lectura.ParaSonia + lectura.Accion, nada agregado), ahora en una
                           caja chica con ícono "i" en vez de texto suelto bajo una línea. *@
                        <div class="inicio-atencion-lectura">
                            <span class="inicio-atencion-lectura-icono" aria-hidden="true">i</span>
                            <p class="inicio-atencion-lectura-texto">
                                <span>@Mayuscula(lectura.ParaSonia).</span>
                                @if (lectura.PideAlgo && !string.IsNullOrEmpty(lectura.Accion))
                                {
                                    <span class="inicio-atencion-lectura-accion">@Mayuscula(lectura.Accion).</span>
                                }
                            </p>
                        </div>
                    }
                    <div class="inicio-atencion-acciones">
                        <button class="boton" @onclick="() => VerSerie(t.Analito)">Entender este resultado &rarr;</button>
                        <button class="boton boton--contorno" @onclick="() => VerSerie(t.Analito)">Ver evolución</button>
                    </div>
                </div>
            }

            @foreach (PresenciaDeAnalito p in atencionPresencias)
            {
                <div class="inicio-atencion-tarjeta">
                    @{ InterpretacionDeAnalito lectura = Lectura(p.Analito); }
                    <div class="inicio-atencion-cabeza">
                        <span class="inicio-atencion-nombre">@p.ParaMostrar</span>
                        <span class="inicio-atencion-valor">@p.UltimoResultado</span>
                    </div>
                    @if (p.HaySerie)
                    {
                        <PresenciaEnElTiempo Pruebas="Tira(p.Analito)"
                                             Seguidas="p.PositivasSeguidas"
                                             Descripcion="@lectura.ParaSonia" />
                    }
                    @if (!string.IsNullOrEmpty(lectura.ParaSonia))
                    {
                        @* Mismo encuadre que la tarjeta de arriba -ícono "i" + caja-, para que
                           el bloque informativo no quede roto por el CSS compartido
                           (.inicio-atencion-lectura pasó a ser flex esta ronda). Mismo texto
                           de siempre: lectura.ParaSonia + lectura.Accion, nada nuevo. *@
                        <div class="inicio-atencion-lectura">
                            <span class="inicio-atencion-lectura-icono" aria-hidden="true">i</span>
                            <p class="inicio-atencion-lectura-texto">@lectura.ParaSonia@(lectura.PideAlgo ? ": " : ".")<b>@lectura.Accion</b></p>
                        </div>
                    }
                    <div class="inicio-atencion-acciones">
                        <button class="boton" @onclick="() => VerSerie(p.Analito)">Entender este resultado &rarr;</button>
                    </div>
                </div>
            }

            @* RONDA 10 — un color que SÍ pide algo (PideAlgo, la misma pregunta que ya
               clasifica tendencias y presencias) es un caso raro -la mayoría son
               "siempre lo esperable"-, pero si aparece no puede desaparecer de la
               pantalla: por eso esta tercera tarjeta, con el MISMO patrón que la de
               presencia (nombre, categoría, CategoriaEnElTiempo con sus observaciones
               reales, y la misma caja "i" con lectura.ParaSonia/Accion). *@
            @foreach (ConstanciaDeAnalito c in atencionConstancias)
            {
                <div class="inicio-atencion-tarjeta">
                    @{ InterpretacionDeAnalito lectura = Lectura(c.Analito); }
                    <div class="inicio-atencion-cabeza">
                        <span class="inicio-atencion-nombre">@c.ParaMostrar</span>
                        <span class="inicio-atencion-valor">@c.UltimaCategoria</span>
                    </div>
                    @if (c.HaySerie)
                    {
                        <CategoriaEnElTiempo Observaciones="Categorias(c.Analito)"
                                             Seguidas="c.NoEsperablesSeguidas"
                                             Descripcion="@lectura.ParaSonia" />
                    }
                    @if (!string.IsNullOrEmpty(lectura.ParaSonia))
                    {
                        <div class="inicio-atencion-lectura">
                            <span class="inicio-atencion-lectura-icono" aria-hidden="true">i</span>
                            <p class="inicio-atencion-lectura-texto">@lectura.ParaSonia@(lectura.PideAlgo ? ": " : ".")<b>@lectura.Accion</b></p>
                        </div>
                    }
                    <div class="inicio-atencion-acciones">
                        <button class="boton" @onclick="() => VerSerie(c.Analito)">Entender este resultado &rarr;</button>
                    </div>
                </div>
            }
        </section>
    }

    @* Si la app no esta guardando, eso es lo MAS importante de la pantalla y va arriba,
       no en una nota al pie debajo de la tabla. Sin carpeta la app sigue funcionando
       -se pone al dia contra el proveedor en cada apertura- asi que se ve completa y
       correcta, y no hay forma de notar que no persiste salvo que se diga. Es la
       degradacion silenciosa que hizo que el servidor MCP leyera un estado viejo. *@
    @if (!estado.HayCarpeta)
    {
        <div class="aviso aviso--atencion fila">
            <div class="crece">
                <strong>No se está guardando nada.</strong>
                Esta app está funcionando sin destino: lo que ves lo vuelve a pedir al proveedor
                cada vez que abrís, y no queda registro tuyo.
            </div>
            @if (soportado == true)
            {
                <button class="boton boton--atencion" @onclick="ConectarCarpeta">Elegir carpeta</button>
            }
            else if (opfs == true)
            {
                <button class="boton boton--atencion" @onclick="UsarNavegador">Guardar en este navegador</button>
            }
        </div>
    }
    else if (estado.GuardadoFallando.Length > 0)
    {
        <div class="aviso aviso--problema fila">
            <div class="crece">
                <strong>La carpeta rechazó la escritura.</strong>
                Lo que ves en pantalla no está guardado en &laquo;@estado.NombreDeLaCarpeta&raquo;.
                Suele ser el permiso, que caduca al reabrir.
                <div class="apunte mono" style="margin-top:6px">@estado.GuardadoFallando</div>
            </div>
            <button class="boton boton--problema" @onclick="PedirPermiso">Volver a dar permiso</button>
        </div>
    }
    else
    {
        @if (estado.EnAlmacenamientoDelNavegador)
        {
            @* Que persista no alcanza: en este modo la mitad "tu IA lo lee" del producto NO
               funciona, porque el MCP corre afuera del browser y no ve este almacenamiento.
               Decirlo es la diferencia entre degradar y enganar. *@
            @* NEUTRO Y NO AMBAR, desde que existe la portada. Esto no habla de tu salud:
               habla de la app. Con los dos en ámbar quedaban dos bloques idénticos
               seguidos y el clínico dejaba de destacar — el ámbar tiene UN trabajo, y
               este aviso no es ese. Sigue siendo imposible de no ver: es el primer
               bloque después de la portada y lo que importa va en negrita. *@
            <p class="aviso aviso--neutro">
                <strong>@(instalada ? "Se está guardando dentro de la app" : "Se está guardando en este navegador")</strong>,
                así que tu expediente sobrevive al cerrar. Pero tu asistente
                <strong>no lo puede leer</strong>: para eso hace falta una carpeta tuya, y
                @(instalada ? "acá" : "este navegador") no las permite.
                <button class="boton boton--enlace" @onclick="Exportar">Exportar a un archivo</button>
            </p>
        }
        else
        {
            <p class="apunte">
                Se guarda en &laquo;@estado.NombreDeLaCarpeta&raquo; después de cada cambio.
                &middot; <button class="boton boton--enlace" @onclick="Exportar">Exportar</button>
            </p>
        }
    }

    @* El web token ya no se pega: la app se lo pide al proveedor contra el device key de
       esta instalacion, y las tres piezas de la credencial viven en el journal. Por eso
       esta pantalla tiene lo que tiene que tener y nada mas. *@
    @* LO QUE NINGUNA HOJA DE LABORATORIO TRAE, y por eso va PRIMERO: la lectura de cada
       serie. Una hoja de resultados trae un valor y una fecha; esto dice para donde viene.

       Las frases se arman ACA, con los hechos que devuelve el dominio. El dominio no
       devuelve prosa, y por eso esta pantalla no puede mostrar un consejo de plantilla:
       dice "pasó de 200 a 280 mg/dL en 365 días", no "bajá las grasas". *@

    @*  EL BLOQUE QUE INSISTE.

        Álvaro: «la pantalla de la UI debería insistir que le diga el sexo cuando aún es
        desconocido».

        INSISTIR BIEN NO ES UN MODAL BLOQUEANTE en cada arranque. Es mostrar el valor
        BLOQUEADO —igual que los tramos incompletos en el dominio de cargas—: la persona ve
        qué se está perdiendo y el costo de no responder queda a la vista.

        Tres cosas lo hacen funcionar mejor que un recordatorio, y las tres las trae el
        DOMINIO, no esta pantalla:

          1. es específico y cuantificado   «2 de tus 7 resultados», no «completá tu perfil»
          2. explica el porqué en términos  la frase la escribe el dominio, que es el único
             de ella                        que sabe por qué falta cada analito
          3. se responde en un toque        acá sólo van los dos botones

        SEVERIDAD INFORMATIVO: no es un hallazgo clínico y no se pinta de ámbar ni de rojo.
        El semáforo está reservado para resultados. Va en neutro, arriba de «Cómo vienen
        tus valores», y se puede COLAPSAR pero no descartar: eso es la insistencia.        *@
    @* §3 LO DEMÁS ESTÁ BIEN — RONDA 9: una sola tarjeta compacta, no cuatro grandes con
       gráfico. Cada fila se lee sin abrir nada: nombre, valor, y la MISMA barra
       verde→amarillo→rojo que ya usa la tarjeta de "merece atención"
       (.inicio-atencion-rango-pista/-marca, reutilizadas tal cual, sin una propiedad
       nueva), con el marcador en la posición real del valor. El límite numérico sale de
       LimitesDeRango(lectura.ReferenciaLegible) -la MISMA frase que LimiteSuperior ya
       parsea arriba, ahora leída también por su piso: la hemoglobina es una banda
       ("entre 12.5 g/dL y 16.5 g/dL"), no un techo, y sin el piso el marcador mentiría-.
       Los binarios (Nitritos, Sangre en heces/orina) no reciben una escala inventada: su
       marcador cae en un extremo u otro según p.EstaPresente, el mismo booleano real que
       ya decide "positivo"/"negativo" en el resto de la app, y la frase bajo la barra es
       lectura.ReferenciaLegible tal cual la escribe el dominio ("lo esperable es
       negativo") en vez de dos palabras Negativo/Positivo inventadas por la pantalla,
       que para una serología real dirían "reactivo" y no "positivo". El chip "en rango"
       usa Insignia(), que ya vivía en este archivo sin usarse (servía para constancias);
       para todo lo que llega hasta acá siempre da "chip--estable" porque solo entra lo
       que el dominio ya decidió que no pide nada (!lectura.PideAlgo). "Ver todos mis
       resultados" sigue sin navegar -no hay ruta nueva-: despliega la MISMA lectura del
       dominio (lectura.ParaSonia) debajo de cada fila, como antes de esta ronda. *@
    @if (tranquiloAnalitos.Count > 0 || tranquiloPresencias.Count > 0 || tranquiloConstancias.Count > 0)
    {
        <section class="inicio-tranquilo" id="valores" @key="@($"tranquilo-{estado.Refrescos}")">
            <p class="inicio-tranquilo-rotulo">lo demás está bien</p>
            <div class="inicio-tranquilo-tarjeta">
                <p class="inicio-tranquilo-titulo">Estos resultados están dentro de lo esperado.</p>
                <ul class="inicio-tranquilo-lista">
                    @foreach (TendenciaDeAnalito t in tranquiloAnalitos)
                    {
                        <li>
                            @{
                                InterpretacionDeAnalito lectura = Lectura(t.Analito);
                                (decimal? piso, decimal? techo) = LimitesDeRango(lectura.ReferenciaLegible);
                            }
                            <button class="inicio-tranquilo-item" @onclick="() => VerSerie(t.Analito)">
                                <div class="inicio-tranquilo-cabeza">
                                    <span class="inicio-tranquilo-nombre">@t.ParaMostrar</span>
                                    <span class="inicio-tranquilo-valor">@Valor(t.ValorFinal) <small>@t.Unidad</small></span>
                                </div>
                                @if (techo is decimal limite && limite > 0)
                                {
                                    decimal piso2 = piso ?? 0m;
                                    decimal proporcion = limite > piso2
                                        ? Math.Max(0m, Math.Min(1m, (t.ValorFinal - piso2) / (limite - piso2)))
                                        : 0m;
                                    <div class="inicio-tranquilo-rango">
                                        <div class="inicio-atencion-rango-pista">
                                            <div class="inicio-atencion-rango-marca" style="left:@((proporcion * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        @if (lectura.ReferenciaLegible.Length > 0)
                                        {
                                            <div class="inicio-tranquilo-rango-etiquetas">
                                                <span>@lectura.ReferenciaLegible</span>
                                                <span class="chip @Insignia(t)">en rango</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </button>
                            @if (tranquiloExpandido && !string.IsNullOrEmpty(lectura.ParaSonia))
                            {
                                <p class="inicio-tranquilo-detalle">@lectura.ParaSonia</p>
                            }
                        </li>
                    }
                    @foreach (PresenciaDeAnalito p in tranquiloPresencias)
                    {
                        <li>
                            @{ InterpretacionDeAnalito lectura = Lectura(p.Analito); }
                            <button class="inicio-tranquilo-item" @onclick="() => VerSerie(p.Analito)">
                                <div class="inicio-tranquilo-cabeza">
                                    <span class="inicio-tranquilo-nombre">@p.ParaMostrar</span>
                                    <span class="inicio-tranquilo-valor">@p.UltimoResultado</span>
                                </div>
                                <div class="inicio-tranquilo-rango">
                                    <div class="inicio-atencion-rango-pista">
                                        <div class="inicio-atencion-rango-marca" style="left:@(p.EstaPresente ? "100" : "0")%"></div>
                                    </div>
                                    @if (lectura.ReferenciaLegible.Length > 0)
                                    {
                                        <div class="inicio-tranquilo-rango-etiquetas">
                                            <span>@lectura.ReferenciaLegible</span>
                                            <span class="chip @Insignia(p)">en rango</span>
                                        </div>
                                    }
                                </div>
                            </button>
                            @if (tranquiloExpandido && !string.IsNullOrEmpty(lectura.ParaSonia))
                            {
                                <p class="inicio-tranquilo-detalle">@lectura.ParaSonia</p>
                            }
                        </li>
                    }
                    @* RONDA 10 — los colores que nunca pidieron nada (ni HaySerie ==
                       false: acá siempre hay serie por construcción del bucket) bajan
                       con SU propio vocabulario: Relato(c) ya arma "2 de 2 veces
                       dentro de lo esperable" -el mismo texto que antes vivía en la
                       tarjeta grande- y el chip usa c.Constancia tal cual lo escribe
                       el dominio ("siempre lo esperable"), no un "en rango" genérico.
                       Sin barra: acá no hay un límite numérico que dibujar, la frase
                       ya lo dice todo. *@
                    @foreach (ConstanciaDeAnalito c in tranquiloConstancias)
                    {
                        <li>
                            @{ InterpretacionDeAnalito lectura = Lectura(c.Analito); }
                            <button class="inicio-tranquilo-item" @onclick="() => VerSerie(c.Analito)">
                                <div class="inicio-tranquilo-cabeza">
                                    <span class="inicio-tranquilo-nombre">@c.ParaMostrar</span>
                                    <span class="inicio-tranquilo-valor">@c.UltimaCategoria</span>
                                </div>
                                <div class="inicio-tranquilo-rango-etiquetas" style="margin-top:6px">
                                    <span>@Relato(c)</span>
                                    <span class="chip @Insignia(c)">@c.Constancia</span>
                                </div>
                            </button>
                            @if (tranquiloExpandido && !string.IsNullOrEmpty(lectura.ParaSonia))
                            {
                                <p class="inicio-tranquilo-detalle">@lectura.ParaSonia</p>
                            }
                        </li>
                    }
                </ul>
            </div>
            <button class="boton--enlace inicio-tranquilo-cta" @onclick="() => tranquiloExpandido = !tranquiloExpandido">
                @(tranquiloExpandido ? "Ocultar detalle" : "Ver todos mis resultados") &rarr;
            </button>
        </section>
    }

    @*  §4 EL BLOQUE QUE INSISTE.

        Álvaro: «la pantalla de la UI debería insistir que le diga el sexo cuando aún es
        desconocido». INSISTIR BIEN NO ES UN MODAL BLOQUEANTE: se puede COLAPSAR pero no
        descartar, y el texto entero -cuántos resultados, y por qué- lo sigue escribiendo
        el dominio (pedido.ParaSonia / pedido.PorQue); esta ronda solo le cambia el
        rótulo, que no habla con el vocabulario de "falta un dato" sino de lo que la
        persona gana si contesta.

        SEVERIDAD INFORMATIVO: no es un hallazgo clínico y no se pinta de ámbar ni de
        rojo. El semáforo está reservado para resultados.                             *@
    @if (pedido.HaceFalta)
    {
        <div class="pedido">
            <div class="pedido-cabeza">
                <span class="pedido-rotulo">ayudanos a interpretar mejor un resultado</span>
                @* «Ver» y «Ocultar» solos no dicen de qué, y fuera de contexto es lo único
                   que se oye. El aria-expanded además dice si está abierto, que el texto
                   deja implícito. Recuperado de origin/master. *@
                <button class="pedido-plegar" @onclick="() => pedidoPlegado = !pedidoPlegado"
                        aria-expanded="@(pedidoPlegado ? "false" : "true")"
                        aria-label="@(pedidoPlegado ? "Ver el dato que falta" : "Ocultar el dato que falta")">
                    @(pedidoPlegado ? "Ver" : "Ocultar")
                </button>
            </div>

            @if (!pedidoPlegado)
            {
                @* El texto NO se compone acá: sale entero del dominio, que es el único que
                   sabe cuántos resultados quedan sin leer y por qué. *@
                <p class="pedido-texto">@pedido.ParaSonia</p>
                <p class="pedido-porque">@pedido.PorQue</p>
                <div class="pedido-botones">
                    <button class="boton" @onclick="@(() => Declarar("hombre"))">Soy hombre</button>
                    <button class="boton" @onclick="@(() => Declarar("mujer"))">Soy mujer</button>
                </div>
            }
        </div>
    }

    @* §5 QUÉ CAMBIÓ DESDE TU ÚLTIMO CHEQUEO — RONDA 10: deja de ser una fila de texto y
       pasa a ser una tarjeta por analito con un micro-gráfico, pero sigue siendo
       EXACTAMENTE el mismo dato de siempre -el último salto de cada serie, Previo/
       Actual de CambioReciente- más el trazado de Serie(analito) completo (los MISMOS
       puntos que ya usa CadenaDeValores más arriba: si solo hay dos mediciones, el
       gráfico tiene dos puntos y un solo segmento, nunca uno inventado). El color del
       trazo sale de Insignia(t) -la misma clasificación semáforo que ya usa el chip de
       "merece atención"-, así que un colesterol que pide seguimiento se dibuja en
       ámbar y no en rojo solo porque subió: el rojo queda reservado para Severidad ==
       "urgente", igual que en el resto de la pantalla. *@
    @if (Cambios().Count > 0)
    {
        <section class="inicio-cambios">
            <h2 class="seccion">Qué cambió desde tu último chequeo</h2>
            <p class="inicio-cambios-intro">Esto es lo que cambió desde tu resultado anterior.</p>
            @foreach (CambioReciente c in Cambios())
            {
                InterpretacionDeAnalito lectura = Lectura(c.Analito.Analito);
                string tono = Insignia(c.Analito).Substring(6);
                string estadoTexto = c.Analito.Tendencia == "estable" ? "se mantiene estable" : EstadoBreve(c.Analito, lectura);
                List<PuntoDelMicroChart> puntosChart = MicroChart(Serie(c.Analito.Analito), AnchoDelMicroChart, AltoDelMicroChart);
                <button class="inicio-cambio-tarjeta inicio-cambio-tarjeta--@tono" @onclick="() => VerSerie(c.Analito.Analito)">
                    <div class="inicio-cambio-cabeza">
                        <span class="inicio-cambio-nombre">@c.Analito.ParaMostrar</span>
                        @if (estadoTexto.Length > 0)
                        {
                            <span class="inicio-cambio-estado inicio-cambio-estado--@tono">@Flecha(c.Analito.Tendencia) @estadoTexto</span>
                        }
                    </div>
                    <div class="inicio-cambio-cifras">@Valor(c.Previo.Valor) &rarr; <b>@Valor(c.Actual.Valor)</b> <span>@c.Analito.Unidad</span></div>
                    @if (puntosChart.Count >= 2)
                    {
                        <svg class="inicio-cambio-grafico" viewBox="0 0 @((AnchoDelMicroChart + 2 * MargenDelMicroChart).ToString(CultureInfo.InvariantCulture)) @((AltoDelMicroChart + 2 * MargenDelMicroChart).ToString(CultureInfo.InvariantCulture))" aria-hidden="true">
                            <polyline points="@PolilineaDelMicroChart(puntosChart)" fill="none" stroke-width="2.5" />
                            @foreach (PuntoDelMicroChart p in puntosChart)
                            {
                                <circle cx="@(p.X.ToString("0.#", CultureInfo.InvariantCulture))" cy="@(p.Y.ToString("0.#", CultureInfo.InvariantCulture))" r="3.5" />
                                string xTextoDelPunto = p.X.ToString("0.#", CultureInfo.InvariantCulture);
                                string yFechaDelPunto = (AltoDelMicroChart + 2 * MargenDelMicroChart - 4).ToString(CultureInfo.InvariantCulture);
                                @((MarkupString)$"<text x='{xTextoDelPunto}' y='14' text-anchor='middle' class='inicio-cambio-grafico-valor'>{System.Net.WebUtility.HtmlEncode(p.Valor)}</text>")
                                @((MarkupString)$"<text x='{xTextoDelPunto}' y='{yFechaDelPunto}' text-anchor='middle' class='inicio-cambio-grafico-fecha'>{System.Net.WebUtility.HtmlEncode(p.Fecha)}</text>")
                            }
                        </svg>
                    }
                    @if (!string.IsNullOrEmpty(lectura.ParaSonia))
                    {
                        <p class="inicio-cambio-conclusion">
                            @lectura.ParaSonia@(lectura.PideAlgo && !string.IsNullOrEmpty(lectura.Accion) ? ":" : ".")
                            @if (lectura.PideAlgo && !string.IsNullOrEmpty(lectura.Accion))
                            {
                                <b>@lectura.Accion</b>
                            }
                        </p>
                    }
                </button>
            }
            <a class="boton--enlace" href="#valores">Ver comparación completa &rarr;</a>
        </section>
    }

    @* §6 AÚN NO HAY TENDENCIA — RONDA 11: vuelve a ser un bloque compacto y de bajo
       protagonismo (antes ocupaba demasiado peso visual). Sigue siendo cualquier
       analito con UNA sola medición (HaySerie == false: la misma Tendencia.Indeterminada
       del dominio), no solo el LDL de hoy -Presencia/Constancia entran por la misma
       puerta-. La frase de cierre ahora es fija y explícita ("con tu próximo resultado
       podremos empezar a mostrarte cómo viene cambiando"), a pedido: reemplaza a
       lectura.ParaSonia acá porque el dominio no distingue "sin tendencia" de otros
       casos con el mismo texto genérico, y esta oración es más clara para Sonia sin
       sonar a alerta ni a indicación médica. El conteo de mediciones sigue siendo el
       real de cada vista (t.Mediciones/p.Mediciones/c.Mediciones), nunca inventado. *@
    @if (sinTendenciaAnalitos.Count > 0 || sinTendenciaPresencias.Count > 0 || sinTendenciaConstancias.Count > 0)
    {
        <section class="inicio-sintendencia">
            <p class="inicio-sintendencia-rotulo">aún no hay tendencia</p>
            @foreach (TendenciaDeAnalito t in sinTendenciaAnalitos)
            {
                <div class="inicio-sintendencia-tarjeta">
                    <div class="inicio-sintendencia-cuerpo">
                        <p class="inicio-sintendencia-nombre">@t.ParaMostrar</p>
                        <div class="inicio-sintendencia-fila">
                            <span class="inicio-sintendencia-valor">@Valor(t.ValorFinal) <span>@t.Unidad</span></span>
                            <span class="chip chip--repetir">@t.Mediciones medición@(t.Mediciones == 1 ? "" : "es")</span>
                        </div>
                        <p class="inicio-sintendencia-texto">Con tu próximo resultado podremos empezar a mostrarte cómo viene cambiando.</p>
                    </div>
                    <span class="inicio-sintendencia-icono" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12h4l2.5-7 4 14 2.5-7H22" />
                        </svg>
                    </span>
                </div>
            }
            @foreach (PresenciaDeAnalito p in sinTendenciaPresencias)
            {
                <div class="inicio-sintendencia-tarjeta">
                    <div class="inicio-sintendencia-cuerpo">
                        <p class="inicio-sintendencia-nombre">@p.ParaMostrar</p>
                        <div class="inicio-sintendencia-fila">
                            <span class="inicio-sintendencia-valor">@p.UltimoResultado</span>
                            <span class="chip chip--repetir">@p.Mediciones medición@(p.Mediciones == 1 ? "" : "es")</span>
                        </div>
                        <p class="inicio-sintendencia-texto">Con tu próximo resultado podremos empezar a mostrarte cómo viene cambiando.</p>
                    </div>
                    <span class="inicio-sintendencia-icono" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12h4l2.5-7 4 14 2.5-7H22" />
                        </svg>
                    </span>
                </div>
            }
            @foreach (ConstanciaDeAnalito c in sinTendenciaConstancias)
            {
                <div class="inicio-sintendencia-tarjeta">
                    <div class="inicio-sintendencia-cuerpo">
                        <p class="inicio-sintendencia-nombre">@c.ParaMostrar</p>
                        <div class="inicio-sintendencia-fila">
                            <span class="inicio-sintendencia-valor">@c.UltimaCategoria</span>
                            <span class="chip chip--repetir">@c.Mediciones medición@(c.Mediciones == 1 ? "" : "es")</span>
                        </div>
                        <p class="inicio-sintendencia-texto">Con tu próximo resultado podremos empezar a mostrarte cómo viene cambiando.</p>
                    </div>
                    <span class="inicio-sintendencia-icono" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12h4l2.5-7 4 14 2.5-7H22" />
                        </svg>
                    </span>
                </div>
            }
        </section>
    }

    @* RONDA 10: la tercera puerta (nominales/categóricos) ya no vive acá suelta -era
       una tarjeta grande, idéntica para lo que pedía algo y para lo que nunca pidió
       nada-. Ahora entra por las MISMAS tres secciones de arriba (merece atención,
       aún no hay tendencia, lo demás está bien), clasificada con el mismo PideAlgo/
       HaySerie que ya separa tendencias y presencias: ver atencionConstancias/
       sinTendenciaConstancias/tranquiloConstancias en Releer(). *@

    @* §7 TU HISTORIAL — RONDA 11: pasa a vivir dentro de una tarjeta (el mismo lenguaje
       navy/gradiente que ya usan atención/qué cambió/lo demás está bien) con una línea de
       tiempo real: un punto por visita, conectados por una línea vertical, el más
       reciente resaltado. Los datos son los MISMOS de siempre -Visitas()/
       VisitasRecientes(), EstadoDeLaVisita()/ClaseDeSeveridad()/TextoDeSeveridad()-, no
       se agregó ninguna fuente nueva. Las filas NO son clickeables porque hoy no existe
       una pantalla de detalle por visita -VerSerie() navega por analito, no por fecha-:
       agregar una flecha ahí prometería una navegación que todavía no hay. "Ver
       historial completo" comparte encabezado con "Tu historial" y, si no entra en 390px,
       el propio flex-wrap de la fila lo manda a su propia línea sin achicar la letra. Los
       rangos de referencia se mudan al pie de esta misma tarjeta, como contexto del
       análisis -no como resultado-, con exactamente la misma lógica de siempre
       (pedido.HaceFalta/sexo/cambiandoSexo/Declarar). *@
    <div class="inicio-historial-tarjeta">
        <div class="inicio-historial-encabezado">
            <h2 class="seccion inicio-historial-titulo" id="historial">Tu historial</h2>
            @if (examenes.Count > 0 && (Visitas().Count > VisitasRecientes().Count || historialExpandido))
            {
                <button class="boton boton--enlace inicio-historial-ver" @onclick="() => historialExpandido = !historialExpandido">
                    @(historialExpandido ? "Ver menos" : "Ver historial completo →")
                </button>
            }
        </div>
        @if (examenes.Count == 0)
        {
            <p class="apunte">Todavía no hay exámenes. Apretá <em>Actualizar</em>.</p>
        }
        else
        {
            <p class="inicio-historial-intro">Aquí podés ver tus resultados anteriores.</p>
            <ul class="inicio-historial-timeline">
                @{ int indiceVisita = 0; }
                @foreach (Visita visita in VisitasRecientes())
                {
                    string estadoVisita = EstadoDeLaVisita(visita);
                    bool esReciente = indiceVisita == 0;
                    indiceVisita++;
                    <li class="inicio-historial-evento @(esReciente ? "inicio-historial-evento--reciente" : "")">
                        <span class="inicio-historial-nodo" aria-hidden="true"></span>
                        <div class="inicio-historial-fila">
                            <div class="inicio-historial-datos">
                                <span class="inicio-historial-fecha">@visita.Fecha.ToString("dd MMM yyyy", Cultura)</span>
                                <span class="inicio-historial-cantidad">@visita.Celdas.Count resultado@(visita.Celdas.Count == 1 ? "" : "s")</span>
                            </div>
                            <span class="inicio-historial-estado inicio-historial-estado--@ClaseDeSeveridad(estadoVisita)">@TextoDeSeveridad(estadoVisita)</span>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (!pedido.HaceFalta && sexo.Length > 0 && sexo != "desconocido")
        {
            <div class="inicio-config-fila">
                <span class="inicio-config-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 20V10M12 20V4M18 20v-7" />
                    </svg>
                </span>
                <p class="inicio-config-texto">
                    Tus resultados se comparan contra los rangos de <strong>@sexo</strong>.
                    @if (cambiandoSexo)
                    {
                        @* Un lector de pantalla lista los botones fuera de su frase, y ahí «hombre»
                           y «Cambiar» no dicen qué hacen. El texto visible se queda como está —la
                           frase que lo rodea lo explica para quien ve—; el nombre accesible lo dice
                           entero. *@
                        <button class="boton boton--enlace" @onclick="@(() => Declarar("hombre"))"
                                aria-label="Comparar contra los rangos de hombre">hombre</button>
                        <text>·</text>
                        <button class="boton boton--enlace" @onclick="@(() => Declarar("mujer"))"
                                aria-label="Comparar contra los rangos de mujer">mujer</button>
                    }
                    else
                    {
                        <button class="boton boton--enlace" @onclick="() => cambiandoSexo = true"
                                aria-label="Cambiar el sexo contra el que se comparan tus resultados">Cambiar</button>
                    }
                </p>
            </div>
        }
    </div>

    @* La ventana de perdida se dice, porque esconderla seria vender durabilidad que no hay.
       El conteo de archivos y bytes de MEMFS era diagnostico mio, no informacion para el
       usuario, y se fue. *@
    @if (!estado.HayCarpeta)
    {
        <p class="apunte" style="margin-top:28px">
            <strong>Sin carpeta:</strong> el registro vive solo en memoria y se pierde al cerrar.
        </p>
    }

    @*  LA LINEA DE PRIVACIDAD — RONDA 11: mismo mensaje y mismo ícono de candado de
        siempre, ahora en su propia tarjeta muy sutil (fondo tenue, borde discreto) para
        que se lea como una nota de contexto y no compita con "Tu historial" de arriba.  *@
    <div class="inicio-privacidad">
        <span class="inicio-privacidad-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="4" y="11" width="16" height="9" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
        </span>
        <p class="inicio-privacidad-texto">Tus datos se quedan en tu dispositivo. Vos decidís qué compartir.</p>
    </div>
}


@code {
    private bool? soportado;
    private bool? opfs;
    private string sinAlmacenamiento = "";
    private bool instalada;
    private bool refrescando;

    // LO QUE SABEMOS DEL ARRANQUE, y son tres cosas y no dos: hasta que IndexedDB contesta
    // no sabemos si hay un modo recordado. `resolviendo` es ese rato; `abriendo` dice qué
    // se está reenganchando, para que el texto lo nombre.
    private bool resolviendo = true;
    private string abriendo = "";

    private IReadOnlyList<ExamenEnLista> examenes = new List<ExamenEnLista>();
    private IReadOnlyList<TendenciaDeAnalito> analitos = new List<TendenciaDeAnalito>();
    private int cantidad;
    private int fueraDeRango;

    // LO QUE ESTÁ BIEN, ya contado y ya dicho por el dominio: el numerador, el
    // denominador y la frase. Esta pantalla no cuenta ni compone — igual que con el
    // pedido de sexo, pone el bloque y nada más.
    private LoQueEstaBien enRango = new();
    private LoMasUrgente urgente = new();

    // EL DATO QUE FALTA. Viene entero del dominio: cuántos resultados quedan sin leer,
    // cuáles y la frase que lo explica. Esta pantalla decide UNA cosa —si está plegado— y
    // eso sí es presentación.
    private FaltaElSexoDelPaciente pedido = new();
    private string sexo = "";
    private bool pedidoPlegado;
    private bool cambiandoSexo;

    // El tono lo decide el DOMINIO, no esta pantalla: es la severidad que salió de
    // recorrer las series, traducida con el mapeo del semáforo de la marca. Ahora pinta
    // EL BLOQUE que habla de lo que pide algo, no la tarjeta entera — el verde de al lado
    // tiene el suyo y no depende de esto.
    private string TonoDeLoQuePide() => urgente.Severidad switch
    {
        "urgente"         => "veredicto--problema",
        "consulte pronto" => "veredicto--atencion",
        "vigilar"         => "veredicto--atencion",
        _                 => "veredicto--atencion",
    };

    // Las series que piden LO MISMO que el expediente entero. Es una igualdad, no un
    // orden: ordenar severidades es del dominio, y acá no hace falta — la mayor ya vino
    // resuelta y esto sólo busca cuáles la empatan.
    private List<InterpretacionDeAnalito> LosQuePiden()
    {
        var cuales = new List<InterpretacionDeAnalito>();
        if (!urgente.PideAlgo) return cuales;

        foreach (KeyValuePair<string, InterpretacionDeAnalito> par in interpretaciones)
            if (par.Value.Severidad == urgente.Severidad) cuales.Add(par.Value);

        cuales.Sort((a, b) => string.Compare(a.ParaMostrar, b.ParaMostrar, StringComparison.OrdinalIgnoreCase));
        return cuales;
    }

    // Desde cuándo hay registro. Es lo que convierte una lista de exámenes en un
    // historial: no es cuántos hay, es cuánto tiempo cubren.
    private DateTime? Desde()
    {
        DateTime? primera = null;
        foreach (ExamenEnLista e in examenes)
            if (primera is null || e.Fecha < primera) primera = e.Fecha;
        return primera;
    }

    private static string Mayuscula(string frase) =>
        frase.Length == 0 ? frase : char.ToUpperInvariant(frase[0]) + frase.Substring(1);
    private long ultimoEvento;
    private string error = "";

    // ============================================================ INICIO, RONDA 1
    //
    // LOS TRES GRUPOS DE LA NUEVA JERARQUIA, armados una sola vez en Releer() con lo
    // que YA calcula ese metodo (PideAlgo, HaySerie): nada de esto es un dato nuevo,
    // es el mismo InterpretacionDeAnalito/TendenciaDeAnalito/PresenciaDeAnalito de
    // siempre, ordenado distinto para que la pantalla no trate un colesterol que pide
    // atencion igual que una hemoglobina estable.
    //
    //   atencion       PideAlgo == true                    -> la pieza mas grande
    //   sinTendencia   HaySerie == false (una sola medicion) -> "todavia es pronto"
    //   tranquilo      el resto                              -> compacto, en una lista
    //
    // Si mañana cambia CUAL analito pide atencion, estas listas cambian solas: no hay
    // ningun nombre de analito escrito en esta pantalla.
    private List<TendenciaDeAnalito> atencionAnalitos = new();
    private List<PresenciaDeAnalito> atencionPresencias = new();
    private List<TendenciaDeAnalito> sinTendenciaAnalitos = new();
    private List<PresenciaDeAnalito> sinTendenciaPresencias = new();
    private List<TendenciaDeAnalito> tranquiloAnalitos = new();
    private List<PresenciaDeAnalito> tranquiloPresencias = new();

    // RONDA 10 — LA TERCERA PUERTA SE CLASIFICA IGUAL. Hasta esta ronda todo color
    // caía en una lista plana, sin importar si pedía algo o no: una tarjeta grande e
    // idéntica para "salió ámbar la primera vez" y para "siempre fue el esperado". El
    // mismo criterio de PideAlgo/HaySerie que ya separa tendencias y presencias
    // también vale acá -es la MISMA InterpretacionDeAnalito, la misma pregunta-.
    private List<ConstanciaDeAnalito> atencionConstancias = new();
    private List<ConstanciaDeAnalito> sinTendenciaConstancias = new();
    private List<ConstanciaDeAnalito> tranquiloConstancias = new();

    // "Ver todos mis resultados" y "Ver historial completo" no navegan a una pantalla
    // nueva -esta ronda es solo Inicio, y no hay que inventar una ruta que no existe-:
    // despliegan mas de lo mismo aca abajo, con el mismo boton que ya usa el pedido de
    // sexo para plegarse/desplegarse.
    private bool tranquiloExpandido;
    private bool historialExpandido;

    // LA CONCLUSION DEL SALUDO. Depende de la MISMA severidad que ya calcula
    // LoMasUrgente -el semaforo del dominio-, y no es un texto fijo: el dia que exista
    // algo mas serio que "vigilar" esta frase tiene que poder decirlo.
    private string Saludo() => urgente.Severidad switch
    {
        "urgente"         => "Hay algo que conviene revisar pronto.",
        "consulte pronto" => "Conviene comentar un resultado con tu médico.",
        _                 => "En general, tus resultados vienen bien.",
    };

    // LA FECHA DEL ULTIMO CHEQUEO es la fecha de la visita mas reciente -Visitas() ya
    // las trae ordenadas de la mas nueva a la mas vieja-, no un dato aparte.
    private DateTime? UltimoChequeo()
    {
        List<Visita> visitas = Visitas();
        return visitas.Count > 0 ? visitas[0].Fecha : (DateTime?)null;
    }

    // LA CADENA DE VALORES ("182 → 188 → 212"), armada con los MISMOS puntos que ya
    // usa el grafico de la serie (Serie(analito)). Cuenta agnostica: con 2 mediciones
    // arma un solo salto, con 5 arma una cadena de 5 -nada esta pensado para "3".
    private string CadenaDeValores(TendenciaDeAnalito t)
    {
        IReadOnlyList<PuntoDeSerie> serie = Serie(t.Analito);
        if (serie.Count == 0) return "";

        var texto = new System.Text.StringBuilder();
        for (int i = 0; i < serie.Count; i++)
        {
            if (i > 0) texto.Append(" → ");
            texto.Append(Valor(serie[i].Valor));
        }
        return texto.ToString();
    }

    // "QUE CAMBIO DESDE TU ULTIMO CHEQUEO": el ultimo salto de CADA serie -no la serie
    // entera, que ya se ve en "lo que merece atencion" y en el detalle-. Mira los MISMOS
    // puntos que Serie(analito); no inventa un calculo nuevo.
    private sealed class CambioReciente
    {
        public TendenciaDeAnalito Analito { get; init; } = new();
        public PuntoDeSerie Previo { get; init; } = new();
        public PuntoDeSerie Actual { get; init; } = new();
    }

    private List<CambioReciente> Cambios()
    {
        var cambios = new List<CambioReciente>();
        foreach (TendenciaDeAnalito t in analitos)
        {
            if (!t.HaySerie) continue;
            IReadOnlyList<PuntoDeSerie> serie = Serie(t.Analito);
            if (serie.Count < 2) continue;

            cambios.Add(new CambioReciente
            {
                Analito = t,
                Previo = serie[serie.Count - 2],
                Actual = serie[serie.Count - 1],
            });
        }
        return cambios;
    }

    // EL MICRO-GRÁFICO DE "QUÉ CAMBIÓ" — RONDA 10: los MISMOS puntos que ya usa
    // CadenaDeValores/Serie(analito), solo puestos en un plano. El rango vertical NO es
    // clínico -no hay zonas ni límites, esos ya los dibuja la barra de "merece
    // atención"-: es nada más el recorrido real de esos puntos, con un margen para que
    // la línea no toque los bordes. La única pregunta que este dibujo contesta es
    // "¿para dónde va?", no "¿cuánto le falta al límite?". Con un solo valor único en
    // toda la serie (rango == 0) la línea queda plana al medio, y con una sola medición
    // no se llama nunca -Cambios() ya exige serie.Count >= 2-.
    private const double AnchoDelMicroChart = 260;
    private const double AltoDelMicroChart = 36;
    private const double MargenDelMicroChart = 20;

    private sealed class PuntoDelMicroChart
    {
        public double X { get; init; }
        public double Y { get; init; }
        public string Valor { get; init; } = "";
        public string Fecha { get; init; } = "";
    }

    private static List<PuntoDelMicroChart> MicroChart(IReadOnlyList<PuntoDeSerie> serie, double ancho, double alto)
    {
        var puntos = new List<PuntoDelMicroChart>();
        if (serie.Count == 0) return puntos;

        decimal minimo = serie[0].Valor, maximo = serie[0].Valor;
        foreach (PuntoDeSerie p in serie)
        {
            if (p.Valor < minimo) minimo = p.Valor;
            if (p.Valor > maximo) maximo = p.Valor;
        }
        decimal rango = maximo - minimo;

        for (int i = 0; i < serie.Count; i++)
        {
            double x = MargenDelMicroChart + (serie.Count == 1 ? ancho / 2 : ancho * i / (serie.Count - 1));
            double y;
            if (rango == 0)
            {
                y = MargenDelMicroChart + alto / 2;
            }
            else
            {
                double proporcion = (double)((serie[i].Valor - minimo) / rango);
                y = MargenDelMicroChart + alto - proporcion * alto;
            }

            puntos.Add(new PuntoDelMicroChart
            {
                X = x,
                Y = y,
                Valor = Valor(serie[i].Valor),
                Fecha = serie[i].Fecha.ToString("MMM yyyy", Cultura),
            });
        }
        return puntos;
    }

    private static string PolilineaDelMicroChart(List<PuntoDelMicroChart> puntos)
    {
        var texto = new System.Text.StringBuilder();
        for (int i = 0; i < puntos.Count; i++)
        {
            if (i > 0) texto.Append(' ');
            texto.Append(puntos[i].X.ToString("0.#", CultureInfo.InvariantCulture));
            texto.Append(',');
            texto.Append(puntos[i].Y.ToString("0.#", CultureInfo.InvariantCulture));
        }
        return texto.ToString();
    }

    // LA FLECHA la decide la TENDENCIA que ya calculo el dominio (Analito/Tendencia.cs),
    // no una resta hecha aca: una hemoglobina que sube de 13.1 a 13.4 sigue siendo
    // "estable" para el dominio -que mira la banda, no el delta crudo- y por eso va con
    // "→" y no "↑".
    private static string Flecha(string tendencia) => tendencia switch
    {
        "en ascenso"  => "↑",
        "en descenso" => "↓",
        _             => "→",
    };

    // EL ESTADO BREVE DE LA TARJETA DE ATENCIÓN ("viene aumentando", "en seguimiento").
    // RONDA 7: se pidió explícitamente NO mostrar "por encima del rango" -contradice un
    // valor que todavía está dentro de lo informado- y, si hace falta un estado, que
    // salga de la lógica existente. No es un texto nuevo: es la MISMA Tendencia que ya
    // lee Flecha() arriba, más SugiereRepetirElExamen, dichos con el vocabulario que ya
    // usa esta pantalla en otros lados (Insignia, Marca). Ningún nombre de analito entra
    // en este switch.
    private static string EstadoBreve(TendenciaDeAnalito t, InterpretacionDeAnalito lectura)
    {
        if (lectura.SugiereRepetirElExamen) return "posible error de medición";
        return t.Tendencia switch
        {
            "en ascenso"  => "viene aumentando",
            "en descenso" => "viene bajando",
            "estable"     => "en seguimiento",
            _             => "",
        };
    }

    // EL LÍMITE NUMÉRICO PARA LA BARRA DE RANGO, leído de `ReferenciaLegible` -la MISMA
    // frase que el dominio ya escribe y que la tarjeta ya muestra ("hasta 220 mg/dL",
    // "entre 13 y 17 g/dL")-. No es un número inventado ni el de MetaDeColesterol (esa es
    // una meta orientativa, 200, para otra pregunta): es el único límite que el rango de
    // referencia expone, tomando el ÚLTIMO número de la frase -el techo, sea un rango con
    // piso ("entre X y Y") o solo un techo ("hasta Y")-.
    private static decimal? LimiteSuperior(string referenciaLegible)
    {
        if (string.IsNullOrWhiteSpace(referenciaLegible)) return null;

        decimal? ultimo = null;
        foreach (string palabra in referenciaLegible.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            string candidato = palabra.Trim(',', '.', ';');
            if (decimal.TryParse(candidato, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal valor))
                ultimo = valor;
            else if (decimal.TryParse(candidato, NumberStyles.Number, CultureInfo.CurrentCulture, out valor))
                ultimo = valor;
        }
        return ultimo;
    }

    // EL PISO Y EL TECHO PARA "LO DEMÁS ESTÁ BIEN" — RONDA 9: la MISMA frase que
    // LimiteSuperior ya lee arriba, pero acá hace falta el piso también. Un "hasta 220
    // mg/dL" sigue sin piso -se asume 0, el mismo criterio de siempre-, pero una "entre
    // 12.5 g/dL y 16.5 g/dL" (la hemoglobina: una banda, no un techo) sí lo tiene, y sin
    // él el marcador mentiría sobre dónde cae el valor real. Un solo número en la frase
    // = sigue siendo "hasta X" (piso null); dos o más = el primero es el piso y el
    // último el techo, igual que LimiteSuperior ya elige "el último".
    private static (decimal? piso, decimal? techo) LimitesDeRango(string referenciaLegible)
    {
        if (string.IsNullOrWhiteSpace(referenciaLegible)) return (null, null);

        var numeros = new List<decimal>();
        foreach (string palabra in referenciaLegible.Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            string candidato = palabra.Trim(',', '.', ';');
            if (decimal.TryParse(candidato, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal valor))
                numeros.Add(valor);
            else if (decimal.TryParse(candidato, NumberStyles.Number, CultureInfo.CurrentCulture, out valor))
                numeros.Add(valor);
        }

        if (numeros.Count == 0) return (null, null);
        if (numeros.Count == 1) return (null, numeros[0]);
        return (numeros[0], numeros[^1]);
    }

    // "TODAVIA ES PRONTO PARA HABLAR DE TENDENCIA": las visitas recientes, recortadas a
    // 3 salvo que la persona pida ver mas. Reusa Visitas(), que ya esta ordenada de la
    // mas nueva a la mas vieja.
    private List<Visita> VisitasRecientes()
    {
        List<Visita> todas = Visitas();
        return historialExpandido ? todas : todas.GetRange(0, Math.Min(3, todas.Count));
    }

    // EL ESTADO GENERAL DE UNA VISITA: la peor severidad entre lo que se midio ESE dia.
    // Todas las filas preguntan a su Interpretacion, misma fuente que el resto de la
    // pantalla: CeldaEnCuadro ya no carga su propia severidad -la celda solo dice QUE se
    // midio y CUANDO-, porque desde que toda fila forma serie (Marca() lo explica igual)
    // no hay una segunda fuente que consultar.
    private string EstadoDeLaVisita(Visita visita)
    {
        string peor = "";
        int rango = -1;
        foreach (CeldaEnCuadro celda in visita.Celdas)
        {
            string severidad = Lectura(celda.Analito).Severidad;
            int actual = RangoDeSeveridad(severidad);
            if (actual > rango) { rango = actual; peor = severidad; }
        }
        return peor;
    }

    // EL MISMO ORDEN DE SEMAFORO que ya usa TonoDeLoQuePide: informativo/vacio primero,
    // urgente al final. Es la unica forma de saber cual severidad "gana" en una visita
    // con varios resultados.
    private static int RangoDeSeveridad(string severidad) => severidad switch
    {
        "urgente"         => 3,
        "consulte pronto" => 2,
        "vigilar"         => 1,
        _                 => 0,
    };

    private static string ClaseDeSeveridad(string severidad) => severidad switch
    {
        "urgente"         => "problema",
        "consulte pronto" => "atencion",
        "vigilar"         => "atencion",
        _                 => "bien",
    };

    private static string TextoDeSeveridad(string severidad) => severidad switch
    {
        "urgente"         => "requiere atención",
        "consulte pronto" => "requiere atención",
        "vigilar"         => "a seguir",
        _                 => "en orden",
    };

    protected override async Task OnInitializedAsync()
    {
        if (estado.EstaArriba) { resolviendo = false; Releer(); return; }

        try
        {
            // EL MODO RECORDADO VA PRIMERO, porque es lo único que decide qué pantalla va.
            // La app ya guardaba cuál eligió la persona la vez pasada y ninguna pantalla lo
            // consumía: al recargar, quien había elegido «este navegador» volvía al
            // elegidor como si fuera la primera vez, y quien había elegido carpeta se
            // reenganchaba de casualidad, por el handle, sin que nadie leyera el modo.
            string recordado = await estado.ModoRecordado();
            abriendo = recordado is "opfs" or "carpeta" ? recordado : "";
            StateHasChanged();

            soportado = await estado.EstaSoportado();
            opfs = await estado.OpfsSoportado();
            sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
            instalada = await estado.EstaInstalada();

            // La carpeta necesita revalidar el permiso —sin gesto solo se recupera el
            // handle—, pero OPFS no necesita nada: si eligió eso, se reengancha sola.
            if (abriendo == "opfs" && opfs == true)
            {
                if ((await estado.UsarAlmacenamientoDelNavegador()).Ok)
                {
                    await estado.Arrancar();
                    Releer();
                    return;
                }
            }

            if (soportado != true) return;

            // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI. Por eso
            // acá solo se consulta, y si quedó en 'prompt' la UI ofrece el botón. Se intenta
            // también sin modo recordado: una instalación anterior a que se guardara el modo
            // tiene handle y no tiene modo, y no hay que mandarla al elegidor por eso.
            ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();
            // el estado del permiso lo lleva el puente; la pantalla lo consulta
            StateHasChanged();

            // Con permiso ya otorgado se abre solo: el usuario no tiene que apretar nada
            // para ver sus propios examenes.
            if (recuperada.Ok) { await estado.Arrancar(); Releer(); }
        }
        catch (Exception ex)
        {
            // Recuperar lo recordado falló —carpeta movida, MEMFS ilegible—. Se dice arriba
            // y se cae al elegidor: es el caso «no se pudo», no un cartel de espera eterno.
            var detalle = new System.Text.StringBuilder($"Paso: abrir la app\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            resolviendo = false;
            abriendo = "";
        }
    }

    // El texto nombra lo que se está reenganchando. «Abriendo…» pelado es lo que se ve el
