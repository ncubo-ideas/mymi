@page "/"
@using System.Globalization
@using Examenes.App.Vistas
@using Puppets.Portador
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

<PageTitle>Mis exámenes</PageTitle>

@* EL BLOQUE DE MARCA. La gota por la muestra, el círculo por el oráculo; solo trazo,
   nunca relleno, y el nombre va acá y no solo en el subtítulo: cuando alguien descarga
   la app desde la página del laboratorio, lo que se abre debe reconocerse en un
   segundo. El SVG es el mismo de la página, a 40 px — sobre oscuro va en blanco, y el
   blanco lo dice el token para que el manual viva en un solo lugar. *@
<div class="marca">
    <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"
         fill="none" stroke="var(--logo)" stroke-width="2.4" aria-hidden="true">
        <circle cx="20" cy="20" r="18" />
        <path d="M20 9c4.4 5.4 6.8 9.3 6.8 12.4A6.8 6.8 0 0 1 20 28.2a6.8 6.8 0
                 0 1-6.8-6.8C13.2 18.3 15.6 14.4 20 9z" />
    </svg>
    <div>
        <div class="marca-nombre">Laboratorio Clínico Delfos</div>
        <div class="marca-claim">Al servicio de su salud desde 1987</div>
    </div>
</div>

<h1 class="titular">Mis exámenes</h1>
<p class="membrete">Tu expediente, en tu computadora.</p>

@* UN solo lugar para los errores, y arriba. Antes habia dos bloques -uno adentro del
   arranque y otro al final de la pagina- asi que un mismo fallo se veia dos veces, y
   estando abajo quedaba fuera de pantalla: la app parecia no reaccionar al click. *@
@* role="alert": el error es lo único de esta pantalla que un lector de pantalla tiene que
   interrumpir para decir. Subirlo arriba resolvió el «parecía no reaccionar al click» para
   quien ve; sin esto, para quien no ve seguía sin pasar nada. *@
@if (error.Length > 0)
{
    <div class="aviso aviso--problema" role="alert">
        <strong>@(estado.EstaArriba ? "No se pudo completar la operación." : "No se pudo abrir la app.")</strong>
        <pre>@error</pre>
    </div>
}

@if (!estado.EstaArriba && resolviendo)
{
    @* MIENTRAS SE RESUELVE QUÉ HABÍA RECORDADO, no se pinta el elegidor. Hasta que
       IndexedDB contesta no sabemos si la persona ya eligió, y mostrarle «Elegí dónde» a
       quien eligió la semana pasada es pedirle que vuelva a decidir. Encima sin la tecla
       grande, porque «soportado» y «opfs» todavía son null y los tres modos salen
       deshabilitados. El elegidor aparece SOLO cuando se sabe que no hay nada recordado o
       que recuperarlo falló. *@
    <p class="abriendo" role="status" aria-live="polite">@TextoDeAbriendo()</p>
}
else if (!estado.EstaArriba)
{
    <div class="aviso aviso--neutro">
        @* Cuando el handle volvio de IndexedDB pero el permiso caduco, la accion correcta
           es RE-OTORGAR, no volver a elegir la carpeta. Ofrecer "Elegir carpeta" como
           primaria hacia que la persona reabriera el picker y volviera a navegar hasta la
           misma carpeta cada vez. *@
        @if (estado.FaltaReotorgarPermiso)
        {
            <p>
                Tu carpeta es <strong>&laquo;@estado.NombreDeLaCarpeta&raquo;</strong>. El browser pide
                confirmar el permiso de escritura cada vez que volvés a abrir la app.
            </p>
            <div class="fila" style="margin-top:12px">
                <button class="boton boton--atencion" @onclick="PedirPermiso">
                    Dar permiso a &laquo;@estado.NombreDeLaCarpeta&raquo;
                </button>
                @* Elegir carpeta es una accion de primera clase, siempre. Estaba como
                   outline-secondary y se leia deshabilitada, asi que la opcion de elegir
                   OTRA carpeta parecia no estar disponible. *@
                <button class="boton" @onclick="ConectarCarpeta"
                        disabled="@(soportado == false)">
                    Elegir carpeta
                </button>
            </div>
        }
        else
        {
            <p>Esta app guarda <strong>tus</strong> exámenes. Elegí dónde.</p>

            @* Cuando NINGUN modo de guardado esta disponible, la causa importa: se
               arreglan distinto y una de las dos no es culpa del navegador. *@
            @if (sinAlmacenamiento == "inseguro")
            {
                <p class="aviso aviso--atencion">
                    <strong>Esta página no está en una conexión segura</strong>, y por eso el
                    navegador no le deja guardar nada — en cualquier navegador pasaría lo mismo.
                    Entrá por <strong>https</strong> y las opciones de guardado aparecen.
                </p>
            }
            else if (sinAlmacenamiento == "navegador")
            {
                <p class="aviso aviso--atencion">
                    <strong>@(instalada ? "Acá no se puede guardar el expediente." : "Este navegador no puede guardar el expediente.")</strong>
                    Podés usar la app igual, pero lo que veas se pierde al cerrar. Para que
                    quede guardado, @(instalada ? "instalala" : "abrila") desde
                    <strong>Chrome</strong> o <strong>Edge</strong>.
                </p>
            }

            @* TRES MODOS, y los tres se dicen con lo que dan y lo que no. Ofrecer solo la
               carpeta y fallar donde no hay picker es lo que hacia antes: en Safari,
               Firefox y movil la app andaba pero no persistia nada, y la unica forma de
               enterarse era cerrarla y perder todo. *@
            <div class="modos">
                <div class="modo @(soportado == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">Una carpeta tuya</div>
                    <p>El expediente queda en la carpeta que elijas, en tu disco.
                       <strong>Es el único modo en el que tu asistente lo puede leer.</strong></p>
                    @if (soportado == true)
                    {
                        <button class="boton" @onclick="ConectarCarpeta">Elegir carpeta</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "Hace falta una conexión segura (https)."
                                : instalada
                                    ? "Acá no está disponible. Para usarlo, instalá la app desde Chrome o Edge."
                                    : "Este navegador no lo permite. Para usarlo, abrí la app en Chrome o Edge.")
                        </p>
                    }
                </div>

                @* Instalada, la app NO es "un navegador" para quien la usa: es una ventana
                   con su nombre y su icono, y hablarle de navegadores ahi suena a que se
                   refiere a otra cosa. El almacenamiento es el mismo; cambia como se
                   llama delante de la persona. *@
                <div class="modo @(opfs == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">@(instalada ? "Dentro de la app" : "En este navegador")</div>
                    <p>Se guarda igual y sobrevive al cerrar, pero
                       @(instalada ? "queda dentro de la app" : "lo administra el navegador"):
                       <strong>no es una carpeta tuya y tu asistente no lo puede leer.</strong></p>
                    @if (opfs == true)
                    {
                        <button class="boton boton--contorno" @onclick="UsarNavegador">Guardar acá</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "También hace falta una conexión segura (https)."
                                : "Acá tampoco está disponible.")
                        </p>
                    }
                </div>

                <div class="modo">
                    <div class="modo-titulo">Un archivo</div>
                    <p>Traé un expediente que exportaste antes, desde esta u otra computadora.
                       Funciona en cualquier navegador.</p>
                    <button class="boton boton--contorno" @onclick="Importar">Importar</button>
                </div>
            </div>
        }

        @* Abrir sin guardar es la salida de emergencia, no una alternativa pareja: la app
           anda pero no deja registro tuyo. Va aparte y como enlace, para que se note que
           es otra cosa. *@
        <div style="margin-top:16px">
            <button class="boton boton--enlace" @onclick="Arrancar">Abrir sin guardar nada</button>
        </div>
    </div>
}
else
{
    @*  LA PRIMERA PREGUNTA, y hasta ahora esta pantalla no la hacía.

        Alguien abre esta app para saber una cosa: «¿estoy bien?». Lo que veía primero era
        un botón de Refresh y «leído hasta el evento 212», y para contestarse tenía que
        leer siete tarjetas y sintetizarlas por su cuenta.

        El dominio ya sabía la respuesta —`Expediente.SeveridadMayor` recorre cada serie,
        la interpreta con el criterio de SU analito y se queda con la mayor— y no la
        consumía ninguna carátula.

        CUANDO HAY ALGO QUE HACER, EL TITULAR ES LA FRASE DEL DOMINIO, literal. No es una
        oración que esta pantalla arme: sale del conjunto cerrado de `Severidad`, que es lo
        que impide que un .razor invente un consejo. Lo único que la pantalla escribe es el
        caso en que NO hay nada que hacer, y ahí no hay consejo que inventar.               *@
    @* EL @key VA EN EL CUERPO Y NO EN LA <section>, desde que Actualizar vive acá adentro.

       El @key obliga a Blazor a RECREAR estos nodos. Sin él reusa el mismo elemento, la
       animación de CSS no se vuelve a disparar, y apretar Actualizar no produce ningún
       cambio visible cuando no entraron exámenes nuevos — o sea que el botón parecía no
       hacer nada. Medido: `getAnimations()[0].currentTime` se quedaba en 1000 y el nodo
       era idéntico.

       Pero si la sección ENTERA se recrea, también se recrea el botón que acabás de
       apretar, y el foco de teclado se pierde en el reemplazo del nodo. Con el @key un
       nivel más abajo la cabecera sobrevive al redibujo y el cuerpo se vuelve a animar.

       LA LLAVE ES estado.Refrescos Y NO UN CONTADOR DE ESTA PANTALLA. Un contador local
       subía en cada Releer, y Releer corre en TODA interacción: declarar el sexo, importar
       un expediente, arrancar. La animación de entrada se volvía a disparar por tocar un
       botón que no fue a buscar nada, que es lo contrario de lo que este @key significa.
       Refrescos sube solo cuando se fue al laboratorio, y por eso dice lo que dice. *@
    @* LA PORTADA MUESTRA DOS COSAS A LA VEZ, como el telefono del landing: el verde que
       dice cuantos valores estan donde tienen que estar, y aparte lo que pide atencion.
       Antes era UNA tarjeta que cambiaba de tono entero, y eso tenia un costo: apenas un
       analito pedia algo, la tranquilidad de los otros diecisiete desaparecia de la
       pantalla. La severidad ya no pinta la tarjeta; pinta el bloque al que pertenece. *@
    <section class="portada">
        @* ACTUALIZAR VIVE EN LA PORTADA, no en una fila suelta debajo. Es el botón que
           vuelve a contestar la pregunta que contesta esta tarjeta: si el rótulo dice
           «hoy», entonces «¿esto es de hoy?» pertenece acá y a ningún otro lado.

           Suelto y en azul lleno tenía tres problemas: quedaba segundo en la pantalla sin
           ser el segundo en importancia, le competía el ojo al titular —que es lo único
           que alguien tiene que leer si no lee nada más—, y empujaba el aviso de que no se
           está guardando nada a un tercer lugar que no le corresponde.

           Lleva el trazo de contorno y no el de la acción principal porque no lo es: la
           app se pone al día sola al abrir, así que esto es «volvé a chequear AHORA». *@
        <div class="portada-cabeza">
            <p class="portada-rotulo">tu expediente, hoy</p>
            @* aria-busy y no solo el texto: «Actualizando…» cambia el nombre del botón, y
               un lector de pantalla no vuelve a leerlo si el foco ya estaba ahí. El estado
               ocupado sí lo anuncia. *@
            <button class="portada-releer" @onclick="Refrescar" disabled="@(refrescando || estado.Migrada)"
                    aria-busy="@(refrescando ? "true" : "false")">
                @(estado.Migrada ? "Ya no se actualiza" : refrescando ? "Actualizando…" : "Actualizar")
            </button>
        </div>

        @* aria-live: este bloque ES la respuesta a Actualizar, y el @key lo recrea entero.
           Sin esto la única señal de que la app fue y volvió es una animación. *@
        <div class="portada-cuerpo" @key="@($"portada-{estado.Refrescos}")"
             aria-live="polite">
            @* EL BLOQUE QUE TRANQUILIZA. No se dibuja cuando la severidad es «urgente»:
               el rojo lo reserva el dominio para lo que no puede esperar, y poner un
               «todo está bien» al lado de eso lo contradice. Fuera de ese caso el verde
               convive con el ámbar, que es justo lo que hace el mock. *@
            @if (enRango.HayAlgo && urgente.Severidad != "urgente")
            {
                <div class="veredicto veredicto--bien">
                    @* La carita del landing, tal cual: el círculo, los dos ojos y la
                       boca. Es lo que hace que la pantalla se reconozca de un vistazo. *@
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" fill="none" stroke-width="1.6" />
                        <circle cx="8.5" cy="10" r="0.6" fill="currentColor" stroke="none" />
                        <circle cx="15.5" cy="10" r="0.6" fill="currentColor" stroke="none" />
                        <path d="M8 14.5c1 1.3 2.4 2 4 2s3-.7 4-2" fill="none"
                              stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <div>
                        @* LA FRASE ES DEL DOMINIO, igual que la del ámbar de al lado. Acá
                           se decide UNA cosa —si va de titular o de detalle— y eso sí es
                           presentación: con algo pidiendo atención el conteo titula, porque
                           «Todo está bien» encima de «mostrále esto a tu médico este mes»
                           se contradice. Sin nada pidiendo, la afirmación se puede hacer y
                           el conteo pasa debajo, que es el bloque del mock.

                           El conteo TITULA BIEN porque se lee solo: es un hecho y no se
                           apoya en nada que venga después. «El resto está bien» no podía —
                           nombraba una excepción que todavía no se había dicho, y el verde
                           va primero. *@
                        <p class="veredicto-titulo">
                            @(urgente.PideAlgo ? enRango.ParaSonia : "Todo está bien")
                        </p>
                        @if (!urgente.PideAlgo)
                        {
                            <p class="veredicto-detalle">@enRango.ParaSonia</p>
                        }
                    </div>
                </div>
            }

            @if (urgente.PideAlgo)
            {
                <div class="veredicto @TonoDeLoQuePide()">
                    @* La misma cara, con la boca recta. La diferencia entre «bien» y
                       «mirá esto» son dos paths, no dos dibujos. *@
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" fill="none" stroke-width="1.6" />
                        <circle cx="8.5" cy="10" r="0.6" fill="currentColor" stroke="none" />
                        <circle cx="15.5" cy="10" r="0.6" fill="currentColor" stroke="none" />
                        <path d="M8.5 15.5h7" fill="none" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <div>
                        <p class="veredicto-titulo">@Mayuscula(urgente.Accion).</p>
                        <div class="portada-cuales">
                            @foreach (InterpretacionDeAnalito lectura in LosQuePiden())
                            {
                                <button class="portada-cual" @onclick="() => VerSerie(lectura.Analito)">
                                    @lectura.ParaMostrar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            @* NI VERDE NI ÁMBAR: no hay nada en rango que contar y nada que pida algo.
               Es el expediente recién abierto, y decirlo es mejor que una tarjeta vacía. *@
            @if (!enRango.HayAlgo && !urgente.PideAlgo)
            {
                <p class="veredicto-titulo">Todavía no hay nada que leer.</p>
            }

            <div class="portada-pie">
                <span><b>@cantidad</b> @(cantidad == 1 ? "examen" : "exámenes")</span>
                <span><b>@enRango.Analitos</b> @(enRango.Analitos == 1 ? "analito con historia" : "analitos con historia")</span>
                @if (Desde() is DateTime desde)
                {
                    <span>desde <b>@desde.ToString("MMM yyyy", Cultura)</b></span>
                }
                @* «leído hasta el evento N» es el MISMO tipo de dato que el resto del pie
                   —el registro de lo que se viene juntando— y por eso termina acá en vez
                   de pegado al botón. Siguen relacionados donde importa: es el número que
                   el botón mueve, está en la misma tarjeta, y ahora dejó de estar a la
                   altura de los ojos, que es donde nunca tuvo que estar el número de
                   evento de un journal. *@
                <span>leído hasta el evento <b>@ultimoEvento</b></span>
            </div>

            @* LA LÍNEA DEL CANDADO del landing. Allá vive en la pantalla del teléfono y
               es lo último que se lee antes del botón; acá cierra la portada por la misma
               razón: es la promesa desde la que alguien instaló esto.

               Va en el tuteo del resto de la app y NO en el usted del landing. La frase
               de Geaninna es «Sus datos permanecen en su dispositivo. Usted decide qué
               compartir.», y entra tal cual el día que ella pase el copy de toda la app a
               usted. Una sola línea de usted entre veinticinco de tuteo se lee como un
               descuido, no como su voz. *@
            <p class="portada-candado">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                    <rect x="4" y="9" width="12" height="8" rx="1.5" fill="none" stroke-width="1.6" />
                    <path d="M7 9V6.5a3 3 0 0 1 6 0V9" fill="none" stroke-width="1.6" />
                </svg>
                <span>Tus datos se quedan en tu dispositivo. Vos decidís qué compartir.</span>
            </p>
        </div>
    </section>

    @* Si la app no esta guardando, eso es lo MAS importante de la pantalla y va arriba,
       no en una nota al pie debajo de la tabla. Sin carpeta la app sigue funcionando
       -se pone al dia contra el proveedor en cada apertura- asi que se ve completa y
       correcta, y no hay forma de notar que no persiste salvo que se diga. Es la
       degradacion silenciosa que hizo que el servidor MCP leyera un estado viejo. *@
    @* HOSPEDADA: el destino es Gnothi y sí se está guardando. El cartel de abajo mira
       HayCarpeta, que es vocabulario del modo suelto, y ahí diría exactamente lo contrario
       de lo que pasa. Decirle a la persona "no se está guardando nada" mientras el journal
       baja a los archivos de Gnothi es la misma mentira silenciosa que este archivo evita
       en el otro sentido. *@
    @* MIGRADA: el proveedor marcó que los hechos nuevos de esta cuenta ya entran por Gnothi
       (especificación 13 §4 y §6.2). El registro NO se mudó: sigue en el teléfono de la
       persona y es de ella (§10.6). "Desaparecer" NO es desinstalar y NO es borrar: la app
       sigue mostrando lo que tiene, porque es de ella. Lo que deja de hacer es SINCRONIZAR,
       que es lo único que produciría dos historias que divergen. El ícono lo quita ella. *@
    @if (estado.Migrada)
    {
        <div class="aviso aviso--atencion fila">
            <div class="crece">
                <strong>Tus exámenes nuevos ahora entran por @estado.DondeVive, en este
                mismo teléfono.</strong>
                Lo que ves acá se queda y sigue siendo tuyo; lo que esta copia deja de
                hacer es buscar novedades.
            </div>
            @* UN <a href> TOCADO, no window.location desde JS: en iOS una navegación hecha
               por script se trata como pegar la URL en la barra y nunca abre la app; en
               Android, sin gesto Chrome se va derecho al fallback. *@
            <a class="boton boton--atencion" href="@enlaceAGnothi">Abrir @estado.DondeVive</a>
        </div>
    }
    else if (estado.Hospedada)
    {
        <div class="aviso fila">
            <div class="crece">
                <strong>Se está guardando en este teléfono.</strong>
                Tu expediente es tuyo y está acá: Gnothi le dio a este laboratorio una
                carpeta en tu teléfono, y tu asistente la puede leer desde ahí.
            </div>
        </div>
    }
    else if (!estado.HayCarpeta)
    {
        <div class="aviso aviso--atencion fila">
            <div class="crece">
                <strong>No se está guardando nada.</strong>
                Esta app está funcionando sin destino: lo que ves lo vuelve a pedir al proveedor
                cada vez que abrís, y no queda registro tuyo.
            </div>
            @if (soportado == true)
            {
                <button class="boton boton--atencion" @onclick="ConectarCarpeta">Elegir carpeta</button>
            }
            else if (opfs == true)
            {
                <button class="boton boton--atencion" @onclick="UsarNavegador">Guardar en este navegador</button>
            }
        </div>
    }
    else if (estado.GuardadoFallando.Length > 0)
    {
        <div class="aviso aviso--problema fila">
            <div class="crece">
                <strong>La carpeta rechazó la escritura.</strong>
                Lo que ves en pantalla no está guardado en &laquo;@estado.NombreDeLaCarpeta&raquo;.
                Suele ser el permiso, que caduca al reabrir.
                <div class="apunte mono" style="margin-top:6px">@estado.GuardadoFallando</div>
            </div>
            <button class="boton boton--problema" @onclick="PedirPermiso">Volver a dar permiso</button>
        </div>
    }
    else
    {
        @if (estado.EnAlmacenamientoDelNavegador)
        {
            @* Que persista no alcanza: en este modo la mitad "tu IA lo lee" del producto NO
               funciona, porque el MCP corre afuera del browser y no ve este almacenamiento.
               Decirlo es la diferencia entre degradar y enganar. *@
            @* NEUTRO Y NO AMBAR, desde que existe la portada. Esto no habla de tu salud:
               habla de la app. Con los dos en ámbar quedaban dos bloques idénticos
               seguidos y el clínico dejaba de destacar — el ámbar tiene UN trabajo, y
               este aviso no es ese. Sigue siendo imposible de no ver: es el primer
               bloque después de la portada y lo que importa va en negrita. *@
            <p class="aviso aviso--neutro">
                <strong>@(instalada ? "Se está guardando dentro de la app" : "Se está guardando en este navegador")</strong>,
                así que tu expediente sobrevive al cerrar. Pero tu asistente
                <strong>no lo puede leer</strong>: para eso hace falta una carpeta tuya, y
                @(instalada ? "acá" : "este navegador") no las permite.
                <button class="boton boton--enlace" @onclick="Exportar">Exportar a un archivo</button>
            </p>
        }
        else
        {
            <p class="apunte">
                Se guarda en &laquo;@estado.NombreDeLaCarpeta&raquo; después de cada cambio.
                &middot; <button class="boton boton--enlace" @onclick="Exportar">Exportar</button>
            </p>
        }
    }

    @* El web token ya no se pega: la app se lo pide al proveedor contra el device key de
       esta instalacion, y las tres piezas de la credencial viven en el journal. Por eso
       esta pantalla tiene lo que tiene que tener y nada mas. *@
    @* LO QUE NINGUNA HOJA DE LABORATORIO TRAE, y por eso va PRIMERO: la lectura de cada
       serie. Una hoja de resultados trae un valor y una fecha; esto dice para donde viene.

       Las frases se arman ACA, con los hechos que devuelve el dominio. El dominio no
       devuelve prosa, y por eso esta pantalla no puede mostrar un consejo de plantilla:
       dice "pasó de 200 a 280 mg/dL en 365 días", no "bajá las grasas". *@

    @*  EL BLOQUE QUE INSISTE.

        Álvaro: «la pantalla de la UI debería insistir que le diga el sexo cuando aún es
        desconocido».

        INSISTIR BIEN NO ES UN MODAL BLOQUEANTE en cada arranque. Es mostrar el valor
        BLOQUEADO —igual que los tramos incompletos en el dominio de cargas—: la persona ve
        qué se está perdiendo y el costo de no responder queda a la vista.

        Tres cosas lo hacen funcionar mejor que un recordatorio, y las tres las trae el
        DOMINIO, no esta pantalla:

          1. es específico y cuantificado   «2 de tus 7 resultados», no «completá tu perfil»
          2. explica el porqué en términos  la frase la escribe el dominio, que es el único
             de ella                        que sabe por qué falta cada analito
          3. se responde en un toque        acá sólo van los dos botones

        SEVERIDAD INFORMATIVO: no es un hallazgo clínico y no se pinta de ámbar ni de rojo.
        El semáforo está reservado para resultados. Va en neutro, arriba de «Cómo vienen
        tus valores», y se puede COLAPSAR pero no descartar: eso es la insistencia.        *@
    @if (pedido.HaceFalta)
    {
        <div class="pedido">
            <div class="pedido-cabeza">
                <span class="pedido-rotulo">falta un dato tuyo</span>
                @* «Ver» y «Ocultar» solos no dicen de qué, y fuera de contexto es lo único
                   que se oye. El aria-expanded además dice si está abierto, que el texto
                   deja implícito. *@
                <button class="pedido-plegar" @onclick="() => pedidoPlegado = !pedidoPlegado"
                        aria-expanded="@(pedidoPlegado ? "false" : "true")"
                        aria-label="@(pedidoPlegado ? "Ver el dato que falta" : "Ocultar el dato que falta")">
                    @(pedidoPlegado ? "Ver" : "Ocultar")
                </button>
            </div>

            @if (!pedidoPlegado)
            {
                @* El texto NO se compone acá: sale entero del dominio, que es el único que
                   sabe cuántos resultados quedan sin leer y por qué. *@
                <p class="pedido-texto">@pedido.ParaSonia</p>
                <p class="pedido-porque">@pedido.PorQue</p>
                <div class="pedido-botones">
                    <button class="boton" @onclick="@(() => Declarar("hombre"))">Soy hombre</button>
                    <button class="boton" @onclick="@(() => Declarar("mujer"))">Soy mujer</button>
                </div>
            }
        </div>
    }

    @if (analitos.Count > 0)
    {
        <h2 class="seccion">Cómo vienen tus valores</h2>
        @foreach (TendenciaDeAnalito t in analitos)
        {
            <button class="serie" @key="@($"{t.Analito}-{estado.Refrescos}")" @onclick="() => VerSerie(t.Analito)">
                @{ InterpretacionDeAnalito lectura = Lectura(t.Analito); }
                <div class="serie-cabeza">
                    <div>
                        <span class="serie-nombre">@t.ParaMostrar</span>
                        <span class="chip @Insignia(t)">@t.Tendencia</span>
                        <div class="serie-relato">@Relato(t)</div>
                    </div>
                    <div>
                        <div class="serie-valor">@Valor(t.ValorFinal) <span>@t.Unidad</span></div>
                        @* NINGUN NUMERO SIN SU REFERENCIA. La escribe el dominio, no esta
                           pantalla: sale del analito, que sabe que depende de la edad. *@
                        @if (lectura.ReferenciaLegible.Length > 0)
                        {
                            <div class="serie-referencia">referencia: @lectura.ReferenciaLegible</div>
                        }
                    </div>
                </div>

                @* CADA ANALITO CON SU FORMA. El dominio dice cuál es -no la pantalla- y
                   acá solo se traduce a píxeles. Un antígeno se lee como trayectoria
                   contra su línea base, un colesterol como progreso hacia una meta, una
                   hemoglobina como posición en una banda. Dibujarlos igual sería la misma
                   tabla que Álvaro rechazó, un piso más arriba. *@
                @* La trayectoria necesita serie; la meta y la banda se dibujan con un
                   solo punto, porque no hablan del tiempo sino de dónde estás parado. *@
                @* SIN VEREDICTO NO HAY DIBUJO. Las formas se dibujan CONTRA una referencia
                   —la banda de la hemoglobina, el techo del antígeno— y esa referencia es
                   justamente lo que depende del dato que falta. El valor sigue a la vista
                   arriba; lo que se retiene es la lectura. *@
                @if (!lectura.RequiereElSexo
                     && (t.HaySerie || lectura.Forma != "trayectoria con linea base"))
                {
                    @switch (lectura.Forma)
                    {
                        case "trayectoria con linea base":
                            <TrayectoriaConLineaBase Puntos="Serie(t.Analito)"
                                                     Referencias="Lineas(t.Analito)"
                                                     PideAlgo="lectura.PideAlgo"
                                                     Descripcion="@lectura.ParaSonia" />
                            break;
                        case "progreso hacia meta":
                            <ProgresoHaciaMeta Puntos="Serie(t.Analito)"
                                               Referencias="Lineas(t.Analito)"
                                               Descripcion="@lectura.ParaSonia" />
                            break;
                        case "posicion en banda":
                            <PosicionEnBanda Puntos="Serie(t.Analito)"
                                             Referencias="Lineas(t.Analito)"
                                             Descripcion="@lectura.ParaSonia" />
                            break;
                    }
                }

                @* La lectura y la acción salen del ANALITO. Esta pantalla ya no decide
                   qué decir: antes tenía escrito "Conviene que lo vea tu médico" acá
                   adentro, igual para el antígeno que para el colesterol. *@
                @if (!string.IsNullOrEmpty(lectura.ParaSonia))
                {
                    <div class="serie-lectura@(lectura.PideAlgo ? " serie-lectura--atencion" : "")">
                        @lectura.ParaSonia@(lectura.PideAlgo ? ": " : ".")<b>@lectura.Accion</b>
                    </div>
                }
            </button>
        }
    }

    @* LOS BINARIOS, con SU forma. Van en la misma sección y en tarjetas iguales porque
       son lo mismo que los de arriba —la lectura de una serie— y se leen distinto porque
       lo son: acá no hay «pasó de 200 a 280», hay «apareció en las 2 seguidas».

       Que estén acá y no perdidos en el historial es lo que cambió: hasta ahora una
       sangre oculta no tenía serie, así que sólo podía aparecer como una celda con un
       positivo y un aviso suelto. *@
    @foreach (PresenciaDeAnalito p in presencias)
    {
        <button class="serie" @key="@($"{p.Analito}-{estado.Refrescos}")" @onclick="() => VerSerie(p.Analito)">
            @{ InterpretacionDeAnalito suya = Lectura(p.Analito); }
            <div class="serie-cabeza">
                <div>
                    <span class="serie-nombre">@p.ParaMostrar</span>
                    <span class="chip @Insignia(p)">@p.Presencia</span>
                    <div class="serie-relato">@Relato(p)</div>
                </div>
                <div>
                    <div class="serie-valor">@p.UltimoResultado</div>
                    @if (suya.ReferenciaLegible.Length > 0)
                    {
                        <div class="serie-referencia">@suya.ReferenciaLegible</div>
                    }
                </div>
            </div>

            @if (p.HaySerie)
            {
                <PresenciaEnElTiempo Pruebas="Tira(p.Analito)"
                                     Seguidas="p.PositivasSeguidas"
                                     Descripcion="@suya.ParaSonia" />
            }

            @if (!string.IsNullOrEmpty(suya.ParaSonia))
            {
                <div class="serie-lectura@(suya.PideAlgo ? " serie-lectura--atencion" : "")">
                    @suya.ParaSonia@(suya.PideAlgo ? ": " : ".")<b>@suya.Accion</b>
                </div>
            }
        </button>
    }

    @* LOS NOMINALES, con SU forma. Terceras tarjetas iguales, y por la misma razón que las
       de los binarios: son la lectura de una serie y se leen distinto porque lo son. Acá
       no hay «pasó de 200 a 280» ni «apareció en las 2 seguidas»: hay «salió ámbar, y las
       tres veces estuvo dentro de lo esperable».

       Esto reemplazó un bloque de avisos sueltos. Los colores eran lo único medido sin
       serie, así que su lectura salía de la magnitud —que dice lo mismo siempre— y viajaba
       colgada de la celda del cuadro. Desde que tienen serie subieron acá, que es donde
       tenían que estar, y con la lectura que mira la historia: un oscuro que después
       volvió a ámbar ya no pide nada. *@
    @foreach (ConstanciaDeAnalito c in constancias)
    {
        <button class="serie" @key="@($"{c.Analito}-{estado.Refrescos}")" @onclick="() => VerSerie(c.Analito)">
            @{ InterpretacionDeAnalito suya = Lectura(c.Analito); }
            <div class="serie-cabeza">
                <div>
                    <span class="serie-nombre">@c.ParaMostrar</span>
                    <span class="chip @Insignia(c)">@c.Constancia</span>
                    <div class="serie-relato">@Relato(c)</div>
                </div>
                <div>
                    <div class="serie-valor">@c.UltimaCategoria</div>
                    @if (suya.ReferenciaLegible.Length > 0)
                    {
                        <div class="serie-referencia">@suya.ReferenciaLegible</div>
                    }
                </div>
            </div>

            @if (c.HaySerie)
            {
                <CategoriaEnElTiempo Observaciones="Categorias(c.Analito)"
                                     Seguidas="c.NoEsperablesSeguidas"
                                     Descripcion="@suya.ParaSonia" />
            }

            @if (!string.IsNullOrEmpty(suya.ParaSonia))
            {
                <div class="serie-lectura@(suya.PideAlgo ? " serie-lectura--atencion" : "")">
                    @suya.ParaSonia@(suya.PideAlgo ? ": " : ".")<b>@suya.Accion</b>
                </div>
            }
        </button>
    }

    <h2 class="seccion">Tu historial</h2>
    @if (examenes.Count == 0)
    {
        <p class="apunte">Todavía no hay exámenes. Apretá <em>Actualizar</em>.</p>
    }
    else
    {
        @*  UNA LÍNEA DE TIEMPO DE VISITAS, no una tabla.

            La matriz que había acá era mejor que la lista plana, pero seguía siendo una
            tabla genérica sobre analitos que no se parecen en nada — y las trayectorias
            ya se ven arriba, cada una con su forma. Lo que esta sección aporta que las
            tarjetas no: QUÉ PASÓ CADA DÍA. Una visita al laboratorio trae varios
            analitos a la vez, y eso es una cronología, no una grilla.

            Por eso también cambia el nombre. «Tus exámenes» describía una lista de
            papeles; esto es el historial.                                              *@
        <ol class="visitas">
            @foreach (Visita visita in Visitas())
            {
                <li class="visita">
                    <div class="visita-fecha">
                        <span class="visita-dia">@visita.Fecha.ToString("dd MMM", Cultura)</span>
                        <span class="visita-ano">@visita.Fecha.Year</span>
                    </div>
                    <ul class="visita-cosas">
                        @foreach (CeldaEnCuadro celda in visita.Celdas)
                        {
                            <li class="visita-cosa">
                                <span class="visita-que">@celda.ParaMostrar</span>
                                <span class="visita-cuanto">@celda.Expresado</span>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ol>
    }

    @*  EDITABLE DESPUÉS, sin fricción. §6.2 de la spec: una vez respondido, el bloque de
        arriba desaparece y el dato tiene que seguir siendo corregible — y en clave
        clínica, no de identidad.

        Va al pie y en tono de apunte porque no es una acción de la app: es un ajuste. Con
        el sexo todavía desconocido no aparece, porque de eso ya se ocupa el bloque que
        insiste y dos pedidos del mismo dato en la misma pantalla se anulan.               *@
    @if (!pedido.HaceFalta && sexo.Length > 0 && sexo != "desconocido")
    {
        <p class="apunte" style="margin-top:28px">
            Tus resultados se comparan contra los rangos de <strong>@sexo</strong>.
            @if (cambiandoSexo)
            {
                @* Un lector de pantalla lista los botones fuera de su frase, y ahí «hombre»
                   y «Cambiar» no dicen qué hacen. El texto visible se queda como está —la
                   frase que lo rodea lo explica para quien ve—; el nombre accesible lo dice
                   entero. *@
                <button class="boton boton--enlace" @onclick="@(() => Declarar("hombre"))"
                        aria-label="Comparar contra los rangos de hombre">hombre</button>
                <text>·</text>
                <button class="boton boton--enlace" @onclick="@(() => Declarar("mujer"))"
                        aria-label="Comparar contra los rangos de mujer">mujer</button>
            }
            else
            {
                <button class="boton boton--enlace" @onclick="() => cambiandoSexo = true"
                        aria-label="Cambiar el sexo contra el que se comparan tus resultados">Cambiar</button>
            }
        </p>
    }

    @* La ventana de perdida se dice, porque esconderla seria vender durabilidad que no hay.
       El conteo de archivos y bytes de MEMFS era diagnostico mio, no informacion para el
       usuario, y se fue.

       PERO HOSPEDADA SÍ HAY DURABILIDAD, y este cartel la negaba. `HayCarpeta` es el handle del
       modo suelto y hospedada no hay ninguno porque el destino es la carpeta que Gnothi le dio en
       el teléfono, así que la condición pelada decía «vive solo en memoria y se pierde al cerrar»
       justo cuando es más falso — y encima a dos pantallas de distancia del aviso de arriba, que
       dice lo contrario. Es la misma guarda que MisCompras, MiCarro y MyCar.

       NO LO TRAJO EL MERGE: esta pantalla tuvo el arranque hospedado y su propio aviso desde el
       principio, y este cartel se quedó sin guarda. Lo encontró el barrido de avisos falsos del
       2026-09-08, preguntándole a los cuatro módulos hospedados si alguno decía que no estaba
       guardando. Solo este. *@
    @if (!estado.Hospedada && !estado.HayCarpeta)
    {
        <p class="apunte" style="margin-top:28px">
            <strong>Sin carpeta:</strong> el registro vive solo en memoria y se pierde al cerrar.
        </p>
    }
}

@code {
    private bool? soportado;
    private bool? opfs;
    private string sinAlmacenamiento = "";
    private bool instalada;
    private bool refrescando;

    // LO QUE SABEMOS DEL ARRANQUE, y son tres cosas y no dos: hasta que IndexedDB contesta
    // no sabemos si hay un modo recordado. `resolviendo` es ese rato; `abriendo` dice qué
    // se está reenganchando, para que el texto lo nombre.
    private bool resolviendo = true;
    private string abriendo = "";

    private IReadOnlyList<ExamenEnLista> examenes = new List<ExamenEnLista>();
    private IReadOnlyList<TendenciaDeAnalito> analitos = new List<TendenciaDeAnalito>();
    private int cantidad;
    private int fueraDeRango;

    // LO QUE ESTÁ BIEN, ya contado y ya dicho por el dominio: el numerador, el
    // denominador y la frase. Esta pantalla no cuenta ni compone — igual que con el
    // pedido de sexo, pone el bloque y nada más.
    private LoQueEstaBien enRango = new();
    private LoMasUrgente urgente = new();

    // EL DATO QUE FALTA. Viene entero del dominio: cuántos resultados quedan sin leer,
    // cuáles y la frase que lo explica. Esta pantalla decide UNA cosa —si está plegado— y
    // eso sí es presentación.
    private FaltaElSexoDelPaciente pedido = new();
    private string sexo = "";
    private bool pedidoPlegado;
    private bool cambiandoSexo;

    // El tono lo decide el DOMINIO, no esta pantalla: es la severidad que salió de
    // recorrer las series, traducida con el mapeo del semáforo de la marca. Ahora pinta
    // EL BLOQUE que habla de lo que pide algo, no la tarjeta entera — el verde de al lado
    // tiene el suyo y no depende de esto.
    private string TonoDeLoQuePide() => urgente.Severidad switch
    {
        "urgente"         => "veredicto--problema",
        "consulte pronto" => "veredicto--atencion",
        "vigilar"         => "veredicto--atencion",
        _                 => "veredicto--atencion",
    };

    // Las series que piden LO MISMO que el expediente entero. Es una igualdad, no un
    // orden: ordenar severidades es del dominio, y acá no hace falta — la mayor ya vino
    // resuelta y esto sólo busca cuáles la empatan.
    private List<InterpretacionDeAnalito> LosQuePiden()
    {
        var cuales = new List<InterpretacionDeAnalito>();
        if (!urgente.PideAlgo) return cuales;

        foreach (KeyValuePair<string, InterpretacionDeAnalito> par in interpretaciones)
            if (par.Value.Severidad == urgente.Severidad) cuales.Add(par.Value);

        cuales.Sort((a, b) => string.Compare(a.ParaMostrar, b.ParaMostrar, StringComparison.OrdinalIgnoreCase));
        return cuales;
    }

    // Desde cuándo hay registro. Es lo que convierte una lista de exámenes en un
    // historial: no es cuántos hay, es cuánto tiempo cubren.
    private DateTime? Desde()
    {
        DateTime? primera = null;
        foreach (ExamenEnLista e in examenes)
            if (primera is null || e.Fecha < primera) primera = e.Fecha;
        return primera;
    }

    private static string Mayuscula(string frase) =>
        frase.Length == 0 ? frase : char.ToUpperInvariant(frase[0]) + frase.Substring(1);
    private long ultimoEvento;
    private string error = "";

    // EL ENLACE QUE ABRE GNOTHI, ya armado. Tiene que estar en el markup como <a href> y no
    // construirse al hacer clic: en iOS una navegacion hecha por script no abre la app.
    private string enlaceAGnothi = "";

    protected override async Task OnInitializedAsync()
    {
        if (estado.EstaArriba) { resolviendo = false; Releer(); return; }

        // HOSPEDADA: el destino es de Gnothi y no hay nada que elegir ni permiso que pedir.
        // La app arranca sola; el selector de almacenamiento es vocabulario del modo suelto.
        if (estado.Hospedada) { await Arrancar(); return; }

        // El enlace del handoff depende de la plataforma, y se arma una sola vez.
        // Si la app ya estaba arriba de una carga anterior, el enlace se arma igual.
        await ArmarEnlace();

        soportado = await estado.EstaSoportado();
        opfs = await estado.OpfsSoportado();
        sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
        instalada = await estado.EstaInstalada();
        if (soportado != true) return;
        try
        {
            // EL MODO RECORDADO VA PRIMERO, porque es lo único que decide qué pantalla va.
            // La app ya guardaba cuál eligió la persona la vez pasada y ninguna pantalla lo
            // consumía: al recargar, quien había elegido «este navegador» volvía al
            // elegidor como si fuera la primera vez, y quien había elegido carpeta se
            // reenganchaba de casualidad, por el handle, sin que nadie leyera el modo.
            string recordado = await estado.ModoRecordado();
            abriendo = recordado is "opfs" or "carpeta" ? recordado : "";
            StateHasChanged();

            soportado = await estado.EstaSoportado();
            opfs = await estado.OpfsSoportado();
            sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
            instalada = await estado.EstaInstalada();

            // La carpeta necesita revalidar el permiso —sin gesto solo se recupera el
            // handle—, pero OPFS no necesita nada: si eligió eso, se reengancha sola.
            if (abriendo == "opfs" && opfs == true)
            {
                if ((await estado.UsarAlmacenamientoDelNavegador()).Ok)
                {
                    await estado.Arrancar();
                    Releer();
                    return;
                }
            }

            if (soportado != true) return;

            // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI. Por eso
            // acá solo se consulta, y si quedó en 'prompt' la UI ofrece el botón. Se intenta
            // también sin modo recordado: una instalación anterior a que se guardara el modo
            // tiene handle y no tiene modo, y no hay que mandarla al elegidor por eso.
            ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();
            // el estado del permiso lo lleva el puente; la pantalla lo consulta
            StateHasChanged();

            // Con permiso ya otorgado se abre solo: el usuario no tiene que apretar nada
            // para ver sus propios examenes.
            if (recuperada.Ok) { await estado.Arrancar(); Releer(); }
        }
        catch (Exception ex)
        {
            // Recuperar lo recordado falló —carpeta movida, MEMFS ilegible—. Se dice arriba
            // y se cae al elegidor: es el caso «no se pudo», no un cartel de espera eterno.
            var detalle = new System.Text.StringBuilder($"Paso: abrir la app\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            resolviendo = false;
            abriendo = "";
        }
    }

    // El texto nombra lo que se está reenganchando. «Abriendo…» pelado es lo que se ve el
    // instante antes de saber si había algo recordado.
    private string TextoDeAbriendo() => abriendo switch
    {
        "opfs"    => "Abriendo tu expediente guardado en este navegador…",
        "carpeta" => estado.NombreDeLaCarpeta.Length > 0
                         ? $"Abriendo tu carpeta «{estado.NombreDeLaCarpeta}»…"
                         : "Abriendo tu carpeta…",
        _         => "Abriendo…",
    };

    private Task ConectarCarpeta() => Intentar("elegir carpeta", async () =>
    {
        if ((await estado.ConectarCarpeta()).Ok)
        {
            await estado.Arrancar();
            await ArmarEnlace();
            Releer();
        }
    });

    private Task PedirPermiso() => Intentar("dar permiso a la carpeta", async () =>
    {
        if ((await estado.PedirPermiso()).Ok)
        {
            await estado.Arrancar();
            await ArmarEnlace();
            Releer();
        }
    });

    private Task UsarNavegador() => Intentar("guardar en este navegador", async () =>
    {
        if ((await estado.UsarAlmacenamientoDelNavegador()).Ok)
        {
            await estado.Arrancar();
            await ArmarEnlace();
            Releer();
        }
    });

    private Task Exportar() => Intentar("exportar el expediente", async () =>
    {
        ResultadoDeExportacion resultado = await estado.Exportar();
        if (!resultado.Ok) throw new InvalidOperationException(resultado.Motivo);
    });

    // Importar reemplaza el expediente y rearranca el actor, asi que despues hay que
    // releer TODO de la app: los campos del componente quedaron del expediente viejo.
    private Task Importar() => Intentar("importar un expediente", async () =>
    {
        string motivo = await estado.Importar();
        if (motivo.Length > 0) throw new InvalidOperationException(motivo);
        Releer();
    });

    // EL ENLACE DEL HANDOFF. Depende de la plataforma -intent:// con fallback en Android,
    // https en el resto- y de las aserciones que haya para pasar, asi que se arma cuando ya
    // se sabe que esta instalacion se retiro. Se guarda en un campo porque tiene que ser un
    // <a href> de verdad: iOS no abre la app desde una navegacion hecha por script.
    private async Task ArmarEnlace()
    {
        if (!estado.EstaArriba || !estado.Migrada) { enlaceAGnothi = ""; return; }

        enlaceAGnothi = estado.EnlaceParaAbrirGnothi(await estado.EsAndroid());
    }

    private Task Arrancar() => Intentar("abrir la app", async () =>
    {
        await estado.Arrancar();
        await ArmarEnlace();
        Releer();
    });


    // DECLARAR EL SEXO ES UN COMANDO, y por eso pasa por Intentar como cualquier otro: si
    // la carpeta rechaza la escritura, la persona tiene que enterarse.
    //
    // Después del comando se relee TODO. No es exceso: al declararlo, el historial entero
    // se vuelve interpretable de una vez —los rangos se computan al consultar, nunca se
    // guardaron con la medición— así que cambian las tarjetas, el titular, el conteo y el
    // historial. Releer parcialmente dejaría media pantalla del expediente viejo.
    private Task Declarar(string cual) => Intentar("declarar tu sexo", async () =>
    {
        await estado.DeclararSexo(cual);
        cambiandoSexo = false;
        Releer();
    });

    private Task Refrescar() => Intentar("refrescar contra el proveedor", async () =>
    {
        refrescando = true;
        try { await estado.Refrescar(); await ArmarEnlace(); }
        finally { refrescando = false; Releer(); }
    });

    // Una app que no puede abrir tiene que DECIR por que. Sin esto, un fallo en el
    // arranque deja la pantalla igual que antes de apretar el boton y no hay forma de
    // distinguirlo de un click perdido.
    // El mensaje del error solo no alcanza: "no se encontró el archivo" puede venir de
    // leer la carpeta, de escribirla o de la base de handles, y cada una se arregla
    // distinto. Cada paso se nombra, así el próximo fallo dice DÓNDE ocurrió.
    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder($"Paso: {paso}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE, en cualquier salida.
            //
            // Casi todo lo que decide esta pantalla -si hay carpeta, si falta re-otorgar
            // el permiso, si la app ya arranco- vive en EstadoDeLaApp, que es un servicio
            // inyectado. Blazor no observa objetos ajenos al componente: solo repinta por
            // sus propios campos y por el ciclo del evento. Al elegir carpeta el estado
            // cambiaba de verdad, pero la pantalla seguia mostrando el boton, y recien el
            // click siguiente -aunque se cancelara el dialogo sin elegir nada- disparaba
            // el render que mostraba lo correcto. Se veia como "hay que apretar dos veces".
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload del proveedor nunca llega
    // hasta acá: solo entra como argumento de un comando, dentro del bucle de refresh.
    private void Releer()
    {
        examenes = estado.Examenes();
        cantidad = estado.Cantidad();
        fueraDeRango = estado.AnalitosFueraDeRango();
        enRango = estado.LoQueEstaEnRango();
        urgente = estado.Urgente();
        pedido = estado.PedidoDeSexo();
        sexo = estado.SexoDelPaciente();
        ultimoEvento = estado.UltimoEvento();

        // Una lectura por analito con historia. Se piden de a uno porque cada una es una
        // consulta sobre el actor: la pantalla no recorre el dominio, le pregunta.
        //
        // Y SE PREGUNTA POR LA FORMA ANTES QUE POR LOS HECHOS. Un binario no tiene
        // tendencia —el dominio contesta «no aplica»— ni puntos con número, así que
        // pedírselos daría ceros. Cuál puerta usar lo decide la forma, que es dominio: la
        // pantalla la lee, no la inventa.
        var hechos = new List<TendenciaDeAnalito>();
        var presentes = new List<PresenciaDeAnalito>();
        var categorias = new List<ConstanciaDeAnalito>();
        var leidos = new Dictionary<string, InterpretacionDeAnalito>();
        foreach (string analito in estado.Analitos())
        {
            InterpretacionDeAnalito lectura = estado.Interpretacion(analito);
            leidos[analito] = lectura;

            if (lectura.Forma == FormaDePresencia)
            {
                presentes.Add(estado.Presencia(analito));
                pruebas[analito] = estado.Pruebas(analito);
                continue;
            }

            // TERCERA PUERTA, y por la misma razón que la segunda. Un color no tiene
            // tendencia ni puntos con número: tiene categorías. Antes caía por la puerta
            // continua y salía como una tarjeta de tendencia «no aplica» con un valor cero.
            if (lectura.Forma == FormaDeCategoria)
            {
                categorias.Add(estado.Constancia(analito));
                observaciones[analito] = estado.Observaciones(analito);
                continue;
            }

            hechos.Add(estado.Tendencia(analito));
            puntos[analito] = estado.Puntos(analito);
            lineas[analito] = estado.Referencias(analito);
        }
        analitos = hechos;
        presencias = presentes;
        constancias = categorias;
        interpretaciones = leidos;
        celdas = estado.Cuadro();
    }

    private void VerSerie(string analito) =>
        navegacion.NavigateTo($"analito/{Uri.EscapeDataString(analito)}");

    // Los HECHOS de la serie, contados por la pantalla. Es lo que hace imposible el
    // consejo de plantilla: acá no hay de dónde sacar "bajá las grasas".
    //
    // Sin serie devuelve VACÍO y no una frase: esa la dice el analito en su ParaSonia, y
    // tenerla en los dos lados imprimía "todavía no hay serie" dos veces seguidas en la
    // misma tarjeta.
    // Los HECHOS de una serie binaria, contados por la pantalla con lo que da el dominio.
    // No hay de dónde sacar un consejo acá tampoco: son cuántas pruebas y cuántas dieron
    // presente.
    private static string Relato(PresenciaDeAnalito p) =>
        p.HaySerie
            ? $"{p.Positivas} de {p.Mediciones} pruebas en {p.Dias} {(p.Dias == 1 ? "día" : "días")}"
            : "";

    private static string Relato(ConstanciaDeAnalito c) =>
        c.HaySerie
            ? $"{c.Mediciones - c.NoEsperables} de {c.Mediciones} veces dentro de lo esperable, "
              + $"en {c.Dias} {(c.Dias == 1 ? "día" : "días")}"
            : "";

    private static string Relato(TendenciaDeAnalito t) =>
        t.HaySerie
            ? $"pasó de {Valor(t.ValorInicial)} a {Valor(t.ValorFinal)} {t.Unidad} "
              + $"en {t.Dias} {(t.Dias == 1 ? "día" : "días")}, sobre {t.Mediciones} mediciones"
            : "";

    private IReadOnlyList<CeldaEnCuadro> celdas = new List<CeldaEnCuadro>();

    private sealed class FilaDelCuadro
    {
        public string Analito { get; init; } = "";
        public string ParaMostrar { get; init; } = "";
        public string[] Celdas { get; init; } = new string[0];
    }

    // Las columnas salen de las celdas: el dominio manda la fecha en cada una, ya
    // colapsada por dia, asi que reconstruirlas es juntar las distintas en orden. No es
    // una decision, es un desarmado.
    private List<DateTime> ColumnasDelCuadro()
    {
        var fechas = new List<DateTime>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            while (fechas.Count <= celda.Columna) fechas.Add(default);
            fechas[celda.Columna] = celda.Fecha;
        }
        return fechas;
    }

    private List<FilaDelCuadro> FilasDelCuadro()
    {
        int columnas = ColumnasDelCuadro().Count;
        var porFila = new Dictionary<int, FilaDelCuadro>();

        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFila.TryGetValue(celda.Fila, out FilaDelCuadro fila))
            {
                fila = new FilaDelCuadro
                {
                    Analito = celda.Analito,
                    ParaMostrar = celda.ParaMostrar,
                    // Vacias por defecto: lo que el dominio no mando, no se midio.
                    Celdas = new string[columnas],
                };
                for (int i = 0; i < columnas; i++) fila.Celdas[i] = "";
                porFila[celda.Fila] = fila;
            }
            fila.Celdas[celda.Columna] = celda.Expresado;
        }

        var ordenadas = new List<FilaDelCuadro>();
        for (int i = 0; i < porFila.Count; i++)
            if (porFila.TryGetValue(i, out FilaDelCuadro fila)) ordenadas.Add(fila);
        return ordenadas;
    }

    // El indicador del final de la fila. Lo provee el DOMINIO: es la severidad que decidió
    // el analito, pedida a su Interpretación.
    //
    // Había acá una rama para las filas que no forman serie —los colores— que leía la
    // severidad de la celda. Se fue con ellas: todas las filas tienen serie, así que todas
    // se preguntan igual, y la pantalla dejó de tener dos fuentes para la misma respuesta.
    private string Marca(FilaDelCuadro fila)
    {
        InterpretacionDeAnalito lectura = Lectura(fila.Analito);
        if (lectura.SugiereRepetirElExamen) return "↻";
        return lectura.PideAlgo ? "⚠" : "·";
    }

    // El nombre de la forma tal como lo dice el dominio. La pantalla hace un switch sobre
    // esto y ese switch SÍ es presentación legítima: traduce una forma del dominio a
    // píxeles. Lo que no puede es decidirla.
    private const string FormaDePresencia = "presencia en el tiempo";
    private const string FormaDeCategoria = "categoria en el tiempo";

    private List<PresenciaDeAnalito> presencias = new();
    private Dictionary<string, IReadOnlyList<PruebaEnSerie>> pruebas = new();

    private IReadOnlyList<PruebaEnSerie> Tira(string analito) =>
        pruebas.TryGetValue(analito, out var p) ? p : new List<PruebaEnSerie>();

    private List<ConstanciaDeAnalito> constancias = new();
    private Dictionary<string, IReadOnlyList<ObservacionEnSerie>> observaciones = new();

    private IReadOnlyList<ObservacionEnSerie> Categorias(string analito) =>
        observaciones.TryGetValue(analito, out var o) ? o : new List<ObservacionEnSerie>();

    private Dictionary<string, IReadOnlyList<PuntoDeSerie>> puntos = new();
    private Dictionary<string, IReadOnlyList<LineaDeReferencia>> lineas = new();

    private IReadOnlyList<PuntoDeSerie> Serie(string analito) =>
        puntos.TryGetValue(analito, out var p) ? p : new List<PuntoDeSerie>();

    private IReadOnlyList<LineaDeReferencia> Lineas(string analito) =>
        lineas.TryGetValue(analito, out var l) ? l : new List<LineaDeReferencia>();

    private static readonly CultureInfo Cultura = new CultureInfo("es-ES");

    // Una visita: todo lo que se midió el mismo día. Las celdas ya vienen del dominio
    // agrupadas por columna, así que acá solo se dan vuelta las filas por las fechas.
    private sealed class Visita
    {
        public DateTime Fecha { get; init; }
        public List<CeldaEnCuadro> Celdas { get; } = new();
    }

    // Lo más reciente primero: en un historial se mira para atrás, no para adelante.
    private List<Visita> Visitas()
    {
        var porFecha = new Dictionary<DateTime, Visita>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFecha.TryGetValue(celda.Fecha, out Visita? visita))
            {
                visita = new Visita { Fecha = celda.Fecha };
                porFecha[celda.Fecha] = visita;
            }
            visita.Celdas.Add(celda);
        }

        var visitas = porFecha.Values.ToList();
        visitas.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return visitas;
    }

    private Dictionary<string, InterpretacionDeAnalito> interpretaciones = new();

    private InterpretacionDeAnalito Lectura(string analito) =>
        interpretaciones.TryGetValue(analito, out InterpretacionDeAnalito l)
            ? l
            : new InterpretacionDeAnalito();

    // El chip sale de la SEVERIDAD que decidio el analito, con el mapeo del semáforo:
    // rojo solo para "urgente", que el dominio reserva.
    //
    // El ambar sigue sin usarse para "salto inverosimil": no es una alarma clinica, es
    // "repeti el examen", y el chip neutro lo dice sin gritar.
    private string Insignia(PresenciaDeAnalito p)
    {
        InterpretacionDeAnalito lectura = Lectura(p.Analito);
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!p.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private string Insignia(ConstanciaDeAnalito c)
    {
        InterpretacionDeAnalito lectura = Lectura(c.Analito);
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!c.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private string Insignia(TendenciaDeAnalito t)
    {
        InterpretacionDeAnalito lectura = Lectura(t.Analito);
        if (lectura.SugiereRepetirElExamen) return "chip--repetir";
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!t.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    // Formato explícito SIEMPRE. Medido en el negocio de facturas: la escala del decimal
    // no sobrevive el journal (5571.50 entra, 5571.5 sale del replay), así que un
    // ToString() pelado mostraría valores distintos antes y después de reabrir la app.
    private static string Valor(decimal medido) => medido.ToString("0.##", CultureInfo.InvariantCulture);
}
