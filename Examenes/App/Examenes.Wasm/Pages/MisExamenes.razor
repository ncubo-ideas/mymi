@page "/"
@using System.Globalization
@using Examenes.App.Vistas
@using Puppets.Portador
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

<PageTitle>Mis exámenes</PageTitle>

<h1 class="titular">Mis exámenes</h1>
<p class="membrete"><b>Laboratorios Sotavento</b> &middot; tu expediente, en tu computadora.</p>

@* UN solo lugar para los errores, y arriba. Antes habia dos bloques -uno adentro del
   arranque y otro al final de la pagina- asi que un mismo fallo se veia dos veces, y
   estando abajo quedaba fuera de pantalla: la app parecia no reaccionar al click. *@
@if (error.Length > 0)
{
    <div class="aviso aviso--problema">
        <strong>@(estado.EstaArriba ? "No se pudo completar la operación." : "No se pudo abrir la app.")</strong>
        <pre>@error</pre>
    </div>
}

@if (!estado.EstaArriba)
{
    <div class="aviso aviso--neutro">
        @* Cuando el handle volvio de IndexedDB pero el permiso caduco, la accion correcta
           es RE-OTORGAR, no volver a elegir la carpeta. Ofrecer "Elegir carpeta" como
           primaria hacia que la persona reabriera el picker y volviera a navegar hasta la
           misma carpeta cada vez. *@
        @if (estado.FaltaReotorgarPermiso)
        {
            <p>
                Tu carpeta es <strong>&laquo;@estado.NombreDeLaCarpeta&raquo;</strong>. El browser pide
                confirmar el permiso de escritura cada vez que volvés a abrir la app.
            </p>
            <div class="fila" style="margin-top:12px">
                <button class="boton boton--atencion" @onclick="PedirPermiso">
                    Dar permiso a &laquo;@estado.NombreDeLaCarpeta&raquo;
                </button>
                @* Elegir carpeta es una accion de primera clase, siempre. Estaba como
                   outline-secondary y se leia deshabilitada, asi que la opcion de elegir
                   OTRA carpeta parecia no estar disponible. *@
                <button class="boton" @onclick="ConectarCarpeta"
                        disabled="@(soportado == false)">
                    Elegir carpeta
                </button>
            </div>
        }
        else
        {
            <p>Esta app guarda <strong>tus</strong> exámenes. Elegí dónde.</p>

            @* Cuando NINGUN modo de guardado esta disponible, la causa importa: se
               arreglan distinto y una de las dos no es culpa del navegador. *@
            @if (sinAlmacenamiento == "inseguro")
            {
                <p class="aviso aviso--atencion">
                    <strong>Esta página no está en una conexión segura</strong>, y por eso el
                    navegador no le deja guardar nada — en cualquier navegador pasaría lo mismo.
                    Entrá por <strong>https</strong> y las opciones de guardado aparecen.
                </p>
            }
            else if (sinAlmacenamiento == "navegador")
            {
                <p class="aviso aviso--atencion">
                    <strong>@(instalada ? "Acá no se puede guardar el expediente." : "Este navegador no puede guardar el expediente.")</strong>
                    Podés usar la app igual, pero lo que veas se pierde al cerrar. Para que
                    quede guardado, @(instalada ? "instalala" : "abrila") desde
                    <strong>Chrome</strong> o <strong>Edge</strong>.
                </p>
            }

            @* TRES MODOS, y los tres se dicen con lo que dan y lo que no. Ofrecer solo la
               carpeta y fallar donde no hay picker es lo que hacia antes: en Safari,
               Firefox y movil la app andaba pero no persistia nada, y la unica forma de
               enterarse era cerrarla y perder todo. *@
            <div class="modos">
                <div class="modo @(soportado == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">Una carpeta tuya</div>
                    <p>El expediente queda en la carpeta que elijas, en tu disco.
                       <strong>Es el único modo en el que tu asistente lo puede leer.</strong></p>
                    @if (soportado == true)
                    {
                        <button class="boton" @onclick="ConectarCarpeta">Elegir carpeta</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "Hace falta una conexión segura (https)."
                                : instalada
                                    ? "Acá no está disponible. Para usarlo, instalá la app desde Chrome o Edge."
                                    : "Este navegador no lo permite. Para usarlo, abrí la app en Chrome o Edge.")
                        </p>
                    }
                </div>

                @* Instalada, la app NO es "un navegador" para quien la usa: es una ventana
                   con su nombre y su icono, y hablarle de navegadores ahi suena a que se
                   refiere a otra cosa. El almacenamiento es el mismo; cambia como se
                   llama delante de la persona. *@
                <div class="modo @(opfs == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">@(instalada ? "Dentro de la app" : "En este navegador")</div>
                    <p>Se guarda igual y sobrevive al cerrar, pero
                       @(instalada ? "queda dentro de la app" : "lo administra el navegador"):
                       <strong>no es una carpeta tuya y tu asistente no lo puede leer.</strong></p>
                    @if (opfs == true)
                    {
                        <button class="boton boton--contorno" @onclick="UsarNavegador">Guardar acá</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "También hace falta una conexión segura (https)."
                                : "Acá tampoco está disponible.")
                        </p>
                    }
                </div>

                <div class="modo">
                    <div class="modo-titulo">Un archivo</div>
                    <p>Traé un expediente que exportaste antes, desde esta u otra computadora.
                       Funciona en cualquier navegador.</p>
                    <button class="boton boton--contorno" @onclick="Importar">Importar</button>
                </div>
            </div>
        }

        @* Abrir sin guardar es la salida de emergencia, no una alternativa pareja: la app
           anda pero no deja registro tuyo. Va aparte y como enlace, para que se note que
           es otra cosa. *@
        <div style="margin-top:16px">
            <button class="boton boton--enlace" @onclick="Arrancar">Abrir sin guardar nada</button>
        </div>
    </div>
}
else
{
    <div class="fila" style="margin-bottom:18px">
        <button class="boton" @onclick="Refrescar" disabled="@refrescando">
            @(refrescando ? "Refrescando…" : "Refresh")
        </button>
        <span class="apunte mono">
            @cantidad @(cantidad == 1 ? "examen" : "exámenes") &middot;
            @(fueraDeRango == 0
                ? "todo dentro de rango"
                : $"{fueraDeRango} fuera de rango") &middot;
            leído hasta el evento @ultimoEvento
        </span>
    </div>

    @* Si la app no esta guardando, eso es lo MAS importante de la pantalla y va arriba,
       no en una nota al pie debajo de la tabla. Sin carpeta la app sigue funcionando
       -se pone al dia contra el proveedor en cada apertura- asi que se ve completa y
       correcta, y no hay forma de notar que no persiste salvo que se diga. Es la
       degradacion silenciosa que hizo que el servidor MCP leyera un estado viejo. *@
    @if (!estado.HayCarpeta)
    {
        <div class="aviso aviso--atencion fila">
            <div class="crece">
                <strong>No se está guardando nada.</strong>
                Esta app está funcionando sin destino: lo que ves lo vuelve a pedir al proveedor
                cada vez que abrís, y no queda registro tuyo.
            </div>
            @if (soportado == true)
            {
                <button class="boton boton--atencion" @onclick="ConectarCarpeta">Elegir carpeta</button>
            }
            else if (opfs == true)
            {
                <button class="boton boton--atencion" @onclick="UsarNavegador">Guardar en este navegador</button>
            }
        </div>
    }
    else if (estado.GuardadoFallando.Length > 0)
    {
        <div class="aviso aviso--problema fila">
            <div class="crece">
                <strong>La carpeta rechazó la escritura.</strong>
                Lo que ves en pantalla no está guardado en &laquo;@estado.NombreDeLaCarpeta&raquo;.
                Suele ser el permiso, que caduca al reabrir.
                <div class="apunte mono" style="margin-top:6px">@estado.GuardadoFallando</div>
            </div>
            <button class="boton boton--problema" @onclick="PedirPermiso">Volver a dar permiso</button>
        </div>
    }
    else
    {
        @if (estado.EnAlmacenamientoDelNavegador)
        {
            @* Que persista no alcanza: en este modo la mitad "tu IA lo lee" del producto NO
               funciona, porque el MCP corre afuera del browser y no ve este almacenamiento.
               Decirlo es la diferencia entre degradar y enganar. *@
            <p class="aviso aviso--atencion">
                <strong>@(instalada ? "Se está guardando dentro de la app" : "Se está guardando en este navegador")</strong>,
                así que tu expediente sobrevive al cerrar. Pero tu asistente
                <strong>no lo puede leer</strong>: para eso hace falta una carpeta tuya, y
                @(instalada ? "acá" : "este navegador") no las permite.
                <button class="boton boton--enlace" @onclick="Exportar">Exportar a un archivo</button>
            </p>
        }
        else
        {
            <p class="apunte">
                Se guarda en &laquo;@estado.NombreDeLaCarpeta&raquo; después de cada cambio.
                &middot; <button class="boton boton--enlace" @onclick="Exportar">Exportar</button>
            </p>
        }
    }

    @* El web token ya no se pega: la app se lo pide al proveedor contra el device key de
       esta instalacion, y las tres piezas de la credencial viven en el journal. Por eso
       esta pantalla tiene lo que tiene que tener y nada mas. *@
    @* LO QUE NINGUNA HOJA DE LABORATORIO TRAE, y por eso va PRIMERO: la lectura de cada
       serie. Una hoja de resultados trae un valor y una fecha; esto dice para donde viene.

       Las frases se arman ACA, con los hechos que devuelve el dominio. El dominio no
       devuelve prosa, y por eso esta pantalla no puede mostrar un consejo de plantilla:
       dice "pasó de 200 a 280 mg/dL en 365 días", no "bajá las grasas". *@
    @if (analitos.Count > 0)
    {
        <h2 class="seccion">Cómo vienen tus valores</h2>
        @foreach (TendenciaDeAnalito t in analitos)
        {
            <button class="serie" @onclick="() => VerSerie(t.Analito)">
                <div class="serie-cabeza">
                    <div>
                        <span class="serie-nombre">@t.ParaMostrar</span>
                        <span class="chip @Insignia(t)">@t.Tendencia</span>
                        <div class="serie-relato">@Relato(t)</div>
                    </div>
                    <div class="serie-valor">@Valor(t.ValorFinal) <span>@t.Unidad</span></div>
                </div>
                @{ InterpretacionDeAnalito lectura = Lectura(t.Analito); }

                @* CADA ANALITO CON SU FORMA. El dominio dice cuál es -no la pantalla- y
                   acá solo se traduce a píxeles. Un antígeno se lee como trayectoria
                   contra su línea base, un colesterol como progreso hacia una meta, una
                   hemoglobina como posición en una banda. Dibujarlos igual sería la misma
                   tabla que Álvaro rechazó, un piso más arriba. *@
                @* La trayectoria necesita serie; la meta y la banda se dibujan con un
                   solo punto, porque no hablan del tiempo sino de dónde estás parado. *@
                @if (t.HaySerie || lectura.Forma != "trayectoria con linea base")
                {
                    @switch (lectura.Forma)
                    {
                        case "trayectoria con linea base":
                            <TrayectoriaConLineaBase Puntos="Serie(t.Analito)"
                                                     Referencias="Lineas(t.Analito)"
                                                     PideAlgo="lectura.PideAlgo"
                                                     Descripcion="@lectura.ParaSonia" />
                            break;
                        case "progreso hacia meta":
                            <ProgresoHaciaMeta Puntos="Serie(t.Analito)"
                                               Referencias="Lineas(t.Analito)"
                                               Descripcion="@lectura.ParaSonia" />
                            break;
                        case "posicion en banda":
                            <PosicionEnBanda Puntos="Serie(t.Analito)"
                                             Referencias="Lineas(t.Analito)"
                                             Descripcion="@lectura.ParaSonia" />
                            break;
                    }
                }

                @* La lectura y la acción salen del ANALITO. Esta pantalla ya no decide
                   qué decir: antes tenía escrito "Conviene que lo vea tu médico" acá
                   adentro, igual para el antígeno que para el colesterol. *@
                @if (!string.IsNullOrEmpty(lectura.ParaSonia))
                {
                    <div class="serie-lectura@(lectura.PideAlgo ? " serie-lectura--atencion" : "")">
                        @lectura.ParaSonia@(lectura.PideAlgo ? ": " : ".")<b>@lectura.Accion</b>
                    </div>
                }
            </button>
        }
    }

    @* Un hallazgo de un examen sin serie. Va acá arriba y no perdido en una celda:
       «apareció sangre» no es un dato de tabla. El texto y la urgencia los pone el
       dominio — dos positivos de la misma forma pueden decir cosas muy distintas. *@
    @foreach (FilaDelCuadro hallazgo in Hallazgos())
    {
        <div class="aviso @(hallazgo.Severidad == "atencion inmediata" ? "aviso--problema" : "aviso--atencion")" style="margin-top:26px">
            <strong>@hallazgo.ParaMostrar.</strong> @hallazgo.ParaSonia.
        </div>
    }

    <h2 class="seccion">Tu historial</h2>
    @if (examenes.Count == 0)
    {
        <p class="apunte">Todavía no hay exámenes. Apretá <em>Refresh</em>.</p>
    }
    else
    {
        @*  UNA LÍNEA DE TIEMPO DE VISITAS, no una tabla.

            La matriz que había acá era mejor que la lista plana, pero seguía siendo una
            tabla genérica sobre analitos que no se parecen en nada — y las trayectorias
            ya se ven arriba, cada una con su forma. Lo que esta sección aporta que las
            tarjetas no: QUÉ PASÓ CADA DÍA. Una visita al laboratorio trae varios
            analitos a la vez, y eso es una cronología, no una grilla.

            Por eso también cambia el nombre. «Tus exámenes» describía una lista de
            papeles; esto es el historial.                                              *@
        <ol class="visitas">
            @foreach (Visita visita in Visitas())
            {
                <li class="visita">
                    <div class="visita-fecha">
                        <span class="visita-dia">@visita.Fecha.ToString("dd MMM", Cultura)</span>
                        <span class="visita-ano">@visita.Fecha.Year</span>
                    </div>
                    <ul class="visita-cosas">
                        @foreach (CeldaEnCuadro celda in visita.Celdas)
                        {
                            <li class="visita-cosa">
                                <span class="visita-que">@celda.ParaMostrar</span>
                                <span class="visita-cuanto">@celda.Expresado</span>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ol>
    }

    @* La ventana de perdida se dice, porque esconderla seria vender durabilidad que no hay.
       El conteo de archivos y bytes de MEMFS era diagnostico mio, no informacion para el
       usuario, y se fue. *@
    @if (!estado.HayCarpeta)
    {
        <p class="apunte" style="margin-top:28px">
            <strong>Sin carpeta:</strong> el registro vive solo en memoria y se pierde al cerrar.
        </p>
    }
}

@code {
    private bool? soportado;
    private bool? opfs;
    private string sinAlmacenamiento = "";
    private bool instalada;
    private bool refrescando;

    private IReadOnlyList<ExamenEnLista> examenes = new List<ExamenEnLista>();
    private IReadOnlyList<TendenciaDeAnalito> analitos = new List<TendenciaDeAnalito>();
    private int cantidad;
    private int fueraDeRango;
    private long ultimoEvento;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        if (estado.EstaArriba) { Releer(); return; }

        soportado = await estado.EstaSoportado();
        opfs = await estado.OpfsSoportado();
        sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
        instalada = await estado.EstaInstalada();
        if (soportado != true) return;

        // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI. Por eso
        // acá solo se consulta, y si quedó en 'prompt' la UI ofrece el botón.
        ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();
        // el estado del permiso lo lleva el puente; la pantalla lo consulta

        // Con permiso ya otorgado se abre solo: el usuario no tiene que apretar nada
        // para ver sus propios examenes.
        if (recuperada.Ok) await Arrancar();
    }

    private Task ConectarCarpeta() => Intentar("elegir carpeta", async () =>
    {
        if ((await estado.ConectarCarpeta()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task PedirPermiso() => Intentar("dar permiso a la carpeta", async () =>
    {
        if ((await estado.PedirPermiso()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task UsarNavegador() => Intentar("guardar en este navegador", async () =>
    {
        if ((await estado.UsarAlmacenamientoDelNavegador()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task Exportar() => Intentar("exportar el expediente", async () =>
    {
        ResultadoDeExportacion resultado = await estado.Exportar();
        if (!resultado.Ok) throw new InvalidOperationException(resultado.Motivo);
    });

    // Importar reemplaza el expediente y rearranca el actor, asi que despues hay que
    // releer TODO de la app: los campos del componente quedaron del expediente viejo.
    private Task Importar() => Intentar("importar un expediente", async () =>
    {
        string motivo = await estado.Importar();
        if (motivo.Length > 0) throw new InvalidOperationException(motivo);
        Releer();
    });

    private Task Arrancar() => Intentar("abrir la app", async () =>
    {
        await estado.Arrancar();
        Releer();
    });


    private Task Refrescar() => Intentar("refrescar contra el proveedor", async () =>
    {
        refrescando = true;
        try { await estado.Refrescar(); }
        finally { refrescando = false; Releer(); }
    });

    // Una app que no puede abrir tiene que DECIR por que. Sin esto, un fallo en el
    // arranque deja la pantalla igual que antes de apretar el boton y no hay forma de
    // distinguirlo de un click perdido.
    // El mensaje del error solo no alcanza: "no se encontró el archivo" puede venir de
    // leer la carpeta, de escribirla o de la base de handles, y cada una se arregla
    // distinto. Cada paso se nombra, así el próximo fallo dice DÓNDE ocurrió.
    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder($"Paso: {paso}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE, en cualquier salida.
            //
            // Casi todo lo que decide esta pantalla -si hay carpeta, si falta re-otorgar
            // el permiso, si la app ya arranco- vive en EstadoDeLaApp, que es un servicio
            // inyectado. Blazor no observa objetos ajenos al componente: solo repinta por
            // sus propios campos y por el ciclo del evento. Al elegir carpeta el estado
            // cambiaba de verdad, pero la pantalla seguia mostrando el boton, y recien el
            // click siguiente -aunque se cancelara el dialogo sin elegir nada- disparaba
            // el render que mostraba lo correcto. Se veia como "hay que apretar dos veces".
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload del proveedor nunca llega
    // hasta acá: solo entra como argumento de un comando, dentro del bucle de refresh.
    private void Releer()
    {
        examenes = estado.Examenes();
        cantidad = estado.Cantidad();
        fueraDeRango = estado.AnalitosFueraDeRango();
        ultimoEvento = estado.UltimoEvento();

        // Una lectura por analito con historia. Se piden de a uno porque cada una es una
        // consulta sobre el actor: la pantalla no recorre el dominio, le pregunta.
        var hechos = new List<TendenciaDeAnalito>();
        var leidos = new Dictionary<string, InterpretacionDeAnalito>();
        foreach (string analito in estado.Analitos())
        {
            hechos.Add(estado.Tendencia(analito));
            leidos[analito] = estado.Interpretacion(analito);
            puntos[analito] = estado.Puntos(analito);
            lineas[analito] = estado.Referencias(analito);
        }
        analitos = hechos;
        interpretaciones = leidos;
        celdas = estado.Cuadro();
    }

    private void VerSerie(string analito) =>
        navegacion.NavigateTo($"analito/{Uri.EscapeDataString(analito)}");

    // Los HECHOS de la serie, contados por la pantalla. Es lo que hace imposible el
    // consejo de plantilla: acá no hay de dónde sacar "bajá las grasas".
    //
    // Sin serie devuelve VACÍO y no una frase: esa la dice el analito en su ParaSonia, y
    // tenerla en los dos lados imprimía "todavía no hay serie" dos veces seguidas en la
    // misma tarjeta.
    private static string Relato(TendenciaDeAnalito t) =>
        t.HaySerie
            ? $"pasó de {Valor(t.ValorInicial)} a {Valor(t.ValorFinal)} {t.Unidad} "
              + $"en {t.Dias} {(t.Dias == 1 ? "día" : "días")}, sobre {t.Mediciones} mediciones"
            : "";

    private IReadOnlyList<CeldaEnCuadro> celdas = new List<CeldaEnCuadro>();

    private sealed class FilaDelCuadro
    {
        public string Analito { get; init; } = "";
        public string ParaMostrar { get; init; } = "";
        public bool AportaSerie { get; init; }
        public string[] Celdas { get; init; } = new string[0];

        // Las filas sin serie traen su lectura en la celda; las de serie la piden aparte.
        public string Severidad { get; init; } = "";
        public string ParaSonia { get; init; } = "";
    }

    // Las columnas salen de las celdas: el dominio manda la fecha en cada una, ya
    // colapsada por dia, asi que reconstruirlas es juntar las distintas en orden. No es
    // una decision, es un desarmado.
    private List<DateTime> ColumnasDelCuadro()
    {
        var fechas = new List<DateTime>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            while (fechas.Count <= celda.Columna) fechas.Add(default);
            fechas[celda.Columna] = celda.Fecha;
        }
        return fechas;
    }

    private List<FilaDelCuadro> FilasDelCuadro()
    {
        int columnas = ColumnasDelCuadro().Count;
        var porFila = new Dictionary<int, FilaDelCuadro>();

        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFila.TryGetValue(celda.Fila, out FilaDelCuadro fila))
            {
                fila = new FilaDelCuadro
                {
                    Analito = celda.Analito,
                    ParaMostrar = celda.ParaMostrar,
                    AportaSerie = celda.AportaSerie,
                    Severidad = celda.Severidad,
                    ParaSonia = celda.ParaSonia,
                    // Vacias por defecto: lo que el dominio no mando, no se midio.
                    Celdas = new string[columnas],
                };
                for (int i = 0; i < columnas; i++) fila.Celdas[i] = "";
                porFila[celda.Fila] = fila;
            }
            fila.Celdas[celda.Columna] = celda.Expresado;
        }

        var ordenadas = new List<FilaDelCuadro>();
        for (int i = 0; i < porFila.Count; i++)
            if (porFila.TryGetValue(i, out FilaDelCuadro fila)) ordenadas.Add(fila);
        return ordenadas;
    }

    // El indicador del final de la fila. Lo provee el DOMINIO: es la severidad que
    // decidio el analito. Una fila que no forma serie -la orina- no lleva ninguno, y eso
    // no es un hueco: es que no hay veredicto que dar sobre un color.
    private string Marca(FilaDelCuadro fila)
    {
        // Las filas sin serie traen su severidad en la celda: una orina o unas heces se
        // leen de un solo punto. Las de serie la piden a su Interpretación.
        if (!fila.AportaSerie)
            return fila.Severidad == "informativo" || fila.Severidad == "" ? "·" : "⚠";

        InterpretacionDeAnalito lectura = Lectura(fila.Analito);
        if (lectura.SugiereRepetirElExamen) return "↻";
        return lectura.PideAlgo ? "⚠" : "·";
    }

    // Los hallazgos de los exámenes que no forman serie. No entran en «Cómo vienen tus
    // valores» porque no vienen de ningún lado: son de un solo punto. Pero un positivo
    // no puede quedar escondido en una celda de tabla.
    private List<FilaDelCuadro> Hallazgos()
    {
        var hallazgos = new List<FilaDelCuadro>();
        foreach (FilaDelCuadro fila in FilasDelCuadro())
            if (!fila.AportaSerie && fila.Severidad != "" && fila.Severidad != "informativo")
                hallazgos.Add(fila);
        return hallazgos;
    }

    private Dictionary<string, IReadOnlyList<PuntoDeSerie>> puntos = new();
    private Dictionary<string, IReadOnlyList<LineaDeReferencia>> lineas = new();

    private IReadOnlyList<PuntoDeSerie> Serie(string analito) =>
        puntos.TryGetValue(analito, out var p) ? p : new List<PuntoDeSerie>();

    private IReadOnlyList<LineaDeReferencia> Lineas(string analito) =>
        lineas.TryGetValue(analito, out var l) ? l : new List<LineaDeReferencia>();

    private static readonly CultureInfo Cultura = new CultureInfo("es-ES");

    // Una visita: todo lo que se midió el mismo día. Las celdas ya vienen del dominio
    // agrupadas por columna, así que acá solo se dan vuelta las filas por las fechas.
    private sealed class Visita
    {
        public DateTime Fecha { get; init; }
        public List<CeldaEnCuadro> Celdas { get; } = new();
    }

    // Lo más reciente primero: en un historial se mira para atrás, no para adelante.
    private List<Visita> Visitas()
    {
        var porFecha = new Dictionary<DateTime, Visita>();
        foreach (CeldaEnCuadro celda in celdas)
        {
            if (!porFecha.TryGetValue(celda.Fecha, out Visita? visita))
            {
                visita = new Visita { Fecha = celda.Fecha };
                porFecha[celda.Fecha] = visita;
            }
            visita.Celdas.Add(celda);
        }

        var visitas = porFecha.Values.ToList();
        visitas.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return visitas;
    }

    private Dictionary<string, InterpretacionDeAnalito> interpretaciones = new();

    private InterpretacionDeAnalito Lectura(string analito) =>
        interpretaciones.TryGetValue(analito, out InterpretacionDeAnalito l)
            ? l
            : new InterpretacionDeAnalito();

    // El chip sale de la SEVERIDAD que decidio el analito, no de un bool generico.
    //
    // El ambar sigue reservado para lo que exige atencion, y por eso "salto inverosimil"
    // NO lo usa: no es una alarma clinica, es "repeti el examen".
    private string Insignia(TendenciaDeAnalito t)
    {
        InterpretacionDeAnalito lectura = Lectura(t.Analito);
        if (lectura.SugiereRepetirElExamen) return "chip--repetir";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!t.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    // Formato explícito SIEMPRE. Medido en el negocio de facturas: la escala del decimal
    // no sobrevive el journal (5571.50 entra, 5571.5 sale del replay), así que un
    // ToString() pelado mostraría valores distintos antes y después de reabrir la app.
    private static string Valor(decimal medido) => medido.ToString("0.##", CultureInfo.InvariantCulture);
}
