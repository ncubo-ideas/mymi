@page "/analito/{Analito}"
@using System.Globalization
@using System.Linq
@using Examenes.App.Vistas
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion
@inject Textos textos

@* La pantalla de detalle de este negocio NO es "el examen": es LA SERIE de un analito.
   Un examen suelto ya se ve en la lista, y ademas el laboratorio ya se lo entrego en una
   hoja. Lo que la app puede mostrar y la hoja no es la historia: de cuanto a cuanto, en
   cuanto tiempo, y que significa ese ritmo.

   Igual que en la lista, la frase la arma la PANTALLA con los hechos del dominio. El
   dominio devuelve tendencia, extremos, unidad y dias; no devuelve prosa. Por eso aca no
   hay -y no puede haber- un consejo de plantilla.

   ------------------------------------------------------- QUE JUSTIFICA ESTA PANTALLA

   Nada, hasta ahora: la tarjeta de la lista habia crecido hasta traer la forma visual, la
   lectura y la accion, y esta pantalla mostraba MENOS que ella. Un click que quita
   informacion no es un detalle, es un castigo.

   Lo que la tarjeta no puede dar por como esta hecha es CADA MEDICION. La tarjeta
   comprime la serie en una frase -«paso de 3.0 a 5.2 ng/mL en 1095 dias, sobre 4
   mediciones»- y esa frase esconde lo unico que cambia como se lee: si el cambio fue
   parejo o fue un salto. El antigeno del guion sembrado es el caso exacto: 3.0 → 3.1 →
   3.0 → 5.2. Tres anos planchados y un salto al final tienen los MISMOS extremos, los
   MISMOS dias y las MISMAS mediciones que una subida lenta, y no significan lo mismo.

   Y no se solapa con «Tu historial» de la lista: aquel es el corte por VISITA -varios
   analitos, un dia-, esto es el corte ortogonal -un analito, todas sus fechas.

   La forma visual tambien baja aca, porque un detalle tiene que ser un superconjunto de
   su resumen: el grafico dice la FORMA, la lista dice los NUMEROS. *@

<PageTitle>@Analito</PageTitle>

<button class="boton boton--enlace detalle-volver" @onclick="Volver">@textos["detalle.volver"]</button>

@if (!estado.EstaArriba)
{
    <div class="aviso aviso--atencion">@((MarkupString)textos["detalle.appNoAbierta"])</div>
}
@* role="alert", por lo mismo que en la lista: es lo único de esta pantalla que hay que
   interrumpir para decir. *@
else if (error.Length > 0)
{
    <div class="aviso aviso--problema" role="alert">@error</div>
}
else
{
    <h1 class="titular">@(EsBinario ? presencia.ParaMostrar : lectura.ParaMostrar)</h1>

    @*  NO EXISTE PARA ESTA PERSONA, y va PRIMERO porque no es un caso de la serie: es
        la pregunta la que no tiene sentido. Sin esta rama la pantalla caía en «no hay
        ninguna medición todavía», que es confundir la APLICABILIDAD con la falta de
        datos —justamente los dos efectos que este modelo separó—. Las mediciones están
        en el journal y siguen ahí; lo que no aplica es leerlas.

        La frase la escribe el dominio. La pantalla no sabe POR QUÉ un examen no
        corresponde, y componerla acá sería el filtro de vista que esto vino a evitar. *@
    @if (interpretacion.NoLeCorresponde)
    {
        <div class="aviso aviso--neutro" style="margin-top:22px">
            @textos.Con("detalle.tranquilo", ("lectura", interpretacion.ParaSonia))
        </div>
    }
    else if (EsBinario)
    {
        @*  UN BINARIO SE CUENTA DISTINTO, porque es distinto. Acá no hay «de cuánto a
            cuánto»: hay cuántas veces se buscó, cuántas apareció, y —lo único que cambia
            la conducta— cuántas SEGUIDAS. La pantalla no elige cuál de las dos historias
            contar: se lo pregunta a la forma, que la dice el dominio.                  *@
        @if (!presencia.HaySerie)
        {
            <p class="apunte" style="margin-top:14px">
                @textos[presencia.Mediciones == 0 ? "detalle.sinPrueba" : "detalle.soloUnaPrueba"]
            </p>
            @if (presencia.Mediciones == 1)
            {
                <p class="cifra-par">@presencia.UltimoResultado</p>
            }
        }
        else
        {
            <p style="margin:10px 0 0"><span class="chip chip--grande @Insignia()">@presencia.PresenciaDicha</span></p>

            <p class="cifra-par">
                <span class="@(interpretacion.PideAlgo ? "final" : "")">@presencia.UltimoResultado</span>
            </p>
            <p class="apunte">
                @textos.Con("detalle.pruebasEnDias",
                    ("positivas", presencia.Positivas.ToString(CultureInfo.InvariantCulture)),
                    ("pruebas", presencia.Mediciones.ToString(CultureInfo.InvariantCulture)),
                    ("dias", textos.Dias(presencia.Dias)))
                @(presencia.PositivasSeguidas >= 2
                    ? textos.Con("detalle.seguidasAlFinal",
                        ("seguidas", presencia.PositivasSeguidas.ToString(CultureInfo.InvariantCulture)))
                    : "")
                @if (interpretacion.ReferenciaLegible.Length > 0)
                {
                    <text>@textos.Con("detalle.conReferencia", ("referencia", interpretacion.ReferenciaLegible))</text>
                }
            </p>

            <PresenciaEnElTiempo Pruebas="pruebas"
                                 Seguidas="presencia.PositivasSeguidas"
                                 Descripcion="@interpretacion.ParaSonia" />
        }

        @if (interpretacion.PideAlgo)
        {
            <div class="aviso @(interpretacion.Severidad == "urgente" ? "aviso--problema" : "aviso--atencion")" style="margin-top:22px">
                @((MarkupString)textos.Con("detalle.pideAlgo",
                    ("lectura", System.Net.WebUtility.HtmlEncode(interpretacion.ParaSonia)),
                    ("accion", System.Net.WebUtility.HtmlEncode(interpretacion.Accion))))
            </div>
        }
        else if (interpretacion.ParaSonia.Length > 0)
        {
            <div class="aviso" style="margin-top:22px;border-left-color:var(--bien)">
                @textos.Con("detalle.tranquilo", ("lectura", interpretacion.ParaSonia))
            </div>
        }

        @* CADA PRUEBA, una por una. La tira de arriba dice la forma; esto dice las fechas.
           En un binario el hueco entre pruebas es la mitad del dato: «apareció dos veces»
           es una cosa si fue en dos meses y otra si fue en cuatro años. *@
        @if (presencia.Mediciones > 0)
        {
            <h2 class="seccion">@textos["detalle.cadaPrueba"]</h2>
            <ol class="mediciones">
                @foreach (Paso paso in PasosBinarios())
                {
                    <li class="medicion@(paso.EsPositivo ? " medicion--presente" : "")">
                        <div class="medicion-fecha">
                            <span class="medicion-dia">@paso.Fecha.ToString("dd MMM", textos.Cultura)</span>
                            <span class="medicion-ano">@paso.Fecha.Year</span>
                        </div>
                        <div class="medicion-valor">@paso.Expresado</div>
                        <div class="medicion-salto">@paso.Salto</div>
                    </li>
                }
            </ol>
        }
    }
    else if (EsNominal)
    {
        @*  UN NOMINAL SE CUENTA DISTINTO OTRA VEZ, y por eso son tres ramas y no dos. Acá
            no hay «de cuánto a cuánto» ni «cuántas veces apareció»: hay CUÁL salió, cuántas
            veces se salió de lo esperable y —lo que cambia la conducta— cuántas SEGUIDAS.

            Con una sola observación no hay «todavía no se puede decir»: un color ES su
            categoría, así que la lectura ya está completa. Es la diferencia de fondo con
            las otras dos formas.                                                        *@
        <p style="margin:10px 0 0"><span class="chip chip--grande @Insignia()">@constancia.ConstanciaDicha</span></p>

        <p class="cifra-par">
            <span class="@(interpretacion.PideAlgo ? "final" : "")">@constancia.UltimaCategoria</span>
        </p>
        <p class="apunte">
            @if (constancia.HaySerie)
            {
                <text>
                    @textos.Con("detalle.vecesEsperable",
                        ("esperables", (constancia.Mediciones - constancia.NoEsperables).ToString(CultureInfo.InvariantCulture)),
                        ("veces", constancia.Mediciones.ToString(CultureInfo.InvariantCulture)),
                        ("dias", textos.Dias(constancia.Dias)))
                    @(constancia.NoEsperablesSeguidas >= 2
                        ? textos.Con("detalle.seguidasAlFinal",
                            ("seguidas", constancia.NoEsperablesSeguidas.ToString(CultureInfo.InvariantCulture)))
                        : "")
                </text>
            }
            else
            {
                <text>@textos["detalle.unaSolaObservacion"]</text>
            }
            @if (interpretacion.ReferenciaLegible.Length > 0)
            {
                <text>@textos.Con("detalle.conReferencia", ("referencia", interpretacion.ReferenciaLegible))</text>
            }
        </p>

        @if (constancia.HaySerie)
        {
            <CategoriaEnElTiempo Observaciones="observaciones"
                                 Seguidas="constancia.NoEsperablesSeguidas"
                                 Descripcion="@interpretacion.ParaSonia" />
        }

        @if (interpretacion.PideAlgo)
        {
            <div class="aviso @(interpretacion.Severidad == "urgente" ? "aviso--problema" : "aviso--atencion")" style="margin-top:22px">
                @((MarkupString)textos.Con("detalle.pideAlgo",
                    ("lectura", System.Net.WebUtility.HtmlEncode(interpretacion.ParaSonia)),
                    ("accion", System.Net.WebUtility.HtmlEncode(interpretacion.Accion))))
            </div>
        }
        else if (interpretacion.ParaSonia.Length > 0)
        {
            <div class="aviso" style="margin-top:22px;border-left-color:var(--bien)">
                @textos.Con("detalle.tranquilo", ("lectura", interpretacion.ParaSonia))
            </div>
        }

        @* CADA OBSERVACION, una por una. La tira de arriba dice la forma; esto dice las
           fechas — y en un color el hueco entre observaciones es la mitad del dato. *@
        @if (constancia.Mediciones > 0)
        {
            <h2 class="seccion">@textos["detalle.cadaObservacion"]</h2>
            <ol class="mediciones">
                @foreach (Paso paso in PasosNominales())
                {
                    <li class="medicion@(paso.EsPositivo ? " medicion--presente" : "")">
                        <div class="medicion-fecha">
                            <span class="medicion-dia">@paso.Fecha.ToString("dd MMM", textos.Cultura)</span>
                            <span class="medicion-ano">@paso.Fecha.Year</span>
                        </div>
                        <div class="medicion-valor">@paso.Expresado</div>
                        <div class="medicion-salto">@paso.Salto</div>
                    </li>
                }
            </ol>
        }
    }
    else
    {
        List<Paso> pasos = Pasos();

        @if (lectura.Mediciones == 0)
        {
            <p class="apunte" style="margin-top:14px">@textos["detalle.sinMediciones"]</p>
        }
        else
        {
            @* CABECERA — Paso 3: el chip con el vocabulario REAL del dominio (el mismo que
               ya usa Home: Flecha()+EstadoCabecera() para una serie, "1 medición" -mismo
               chip--sinserie que ya usa Home- cuando no la hay todavía) y, debajo, la frase
               que ya escribe el propio analito (interpretacion.ParaSonia) contando la
               historia con SUS hechos. No es prosa nueva de esta pantalla. *@
            <p style="margin:10px 0 0">
                <span class="chip chip--grande @Insignia()">@(lectura.HaySerie ? $"{Flecha()} {EstadoCabecera()}" : textos["detalle.unaMedicion"])</span>
            </p>
            @if (interpretacion.ParaSonia.Length > 0)
            {
                <p class="detalle-historia">@Mayuscula(interpretacion.ParaSonia).</p>
            }

            @* EVOLUCION — Paso 4/RONDA 16-3: los dos extremos cuando hay serie, con el
               micro-gráfico (RONDA 13, duplicado de "Qué cambió" en Home -esta página no
               puede referenciar miembros privados de MisExamenes.razor-, ahora coloreado
               según la Severidad real -RONDA 16-4: nunca verde sólo porque es un gráfico,
               ámbar/rojo cuando el dominio dice que pide algo-) y un RESUMEN VISUAL de tres
               columnas -RONDA 16-3: antes era una línea chica de microcopy, ahora son cifras
               grandes, igual jerarquía que la referencia-. SIN SERIE -Paso 5- no se inventa
               un "antes": se muestra el valor actual solo. *@
            @if (lectura.HaySerie)
            {
                <p class="cifra-par">
                    @Valor(lectura.ValorInicial)<span class="flecha">&rarr;</span><span class="@(interpretacion.PideAlgo ? "final" : "")">@Valor(lectura.ValorFinal)</span><span class="unidad">@lectura.Unidad</span>
                </p>

                List<PuntoDelMicroChart> puntosChart = MicroChart();
                @if (puntosChart.Count >= 2)
                {
                    <svg class="detalle-grafico @ClaseDelGrafico()" viewBox="0 0 @VbAncho @VbAlto" aria-hidden="true">
                        <polyline points="@PolilineaDelMicroChart(puntosChart)" fill="none" stroke-width="2.5" />
                        @foreach (PuntoDelMicroChart p in puntosChart)
                        {
                            <circle cx="@(p.X.ToString("0.#", CultureInfo.InvariantCulture))" cy="@(p.Y.ToString("0.#", CultureInfo.InvariantCulture))" r="4" />
                            string xTexto = p.X.ToString("0.#", CultureInfo.InvariantCulture);
                            @((MarkupString)$"<text x='{xTexto}' y='14' text-anchor='middle' class='detalle-grafico-valor'>{System.Net.WebUtility.HtmlEncode(p.Valor)}</text>")
                            @((MarkupString)$"<text x='{xTexto}' y='{YFecha}' text-anchor='middle' class='detalle-grafico-fecha'>{System.Net.WebUtility.HtmlEncode(p.Fecha)}</text>")
                        }
                    </svg>
                }

                <div class="detalle-stats">
                    <div class="detalle-stats-item">
                        <span class="detalle-stats-valor @(lectura.Cambio > 0 ? "detalle-stats-valor--sube" : lectura.Cambio < 0 ? "detalle-stats-valor--baja" : "")">@(lectura.Cambio > 0 ? "+" : lectura.Cambio < 0 ? "−" : "")@Valor(Math.Abs(lectura.Cambio)) <small>@lectura.Unidad</small></span>
                        <span class="detalle-stats-rotulo">@textos[lectura.Cambio > 0 ? "detalle.aumentoTotal" : lectura.Cambio < 0 ? "detalle.descensoTotal" : "detalle.cambioTotal"]</span>
                    </div>
                    <div class="detalle-stats-item">
                        <span class="detalle-stats-valor">@lectura.Mediciones</span>
                        <span class="detalle-stats-rotulo">@textos["detalle.mediciones"]</span>
                    </div>
                    <div class="detalle-stats-item">
                        <span class="detalle-stats-valor">@textos.Dias(lectura.Dias)</span>
                        <span class="detalle-stats-rotulo">@textos["detalle.entrePrimeraYUltima"]</span>
                    </div>
                </div>
                @if (pasos.Count > 0 && pasos[0].Salto.Length > 0)
                {
                    <p class="detalle-delta">@textos.Con("detalle.ultimoSalto", ("salto", pasos[0].Salto))</p>
                }
            }
            else
            {
                <p class="cifra-par">
                    <span class="@(interpretacion.PideAlgo ? "final" : "")">@Valor(lectura.ValorFinal)</span><span class="unidad">@lectura.Unidad</span>
                </p>
            }

            @* La frase de referencia en texto plano — Paso 14: no se pierde para las formas
               que no muestran ya un "Resultado actual/Referencia" propio (posicion en
               banda/trayectoria con linea base la dicen en números en su forma-pie, no en
               esta frase completa). "progreso hacia meta" la repite dentro de su propia
               barra nueva de abajo, así que acá se omite para no duplicarla. *@
            @if (interpretacion.ReferenciaLegible.Length > 0 && interpretacion.Forma != "progreso-hacia-meta")
            {
                <p class="apunte">@textos.Con("detalle.referenciaMinuscula", ("referencia", interpretacion.ReferenciaLegible))</p>
            }

            @* TU RESULTADO Y EL RANGO — Paso 6/RONDA 16-6: prioridad visual sobre la meta
               orientativa (Paso 11/RONDA 16-5). RangoNumerico() busca PRIMERO las líneas
               reales estructuradas (piso/techo de "posicion en banda", o el techo real de
               "trayectoria con linea base") y sólo si no existen cae al único número que
               expone ReferenciaLegible ("progreso hacia meta": Colesterol/LDL/Triglicéridos,
               que no tienen piso/techo estructurado). Alcanzable con serie o con una sola
               medición -Paso 9-B-. Sin veredicto no hay dibujo -Paso 12-. *@
            @if (!interpretacion.RequiereElSexo && interpretacion.Forma.Length > 0)
            {
                <h2 class="seccion">@textos["detalle.tuResultadoYElRango"]</h2>
                @switch (interpretacion.Forma)
                {
                    case "trayectoria-con-linea-base":
                        <TrayectoriaConLineaBase Puntos="puntos"
                                                 Referencias="referencias"
                                                 PideAlgo="interpretacion.PideAlgo"
                                                 Descripcion="@interpretacion.ParaSonia" />
                        break;
                    case "progreso-hacia-meta":
                        (decimal? piso, decimal? techo) = RangoNumerico();
                        @if (techo is decimal techoReal)
                        {
                            decimal pisoReal = piso ?? 0m;
                            decimal recorrido = techoReal - pisoReal;
                            decimal proporcion = recorrido <= 0 ? 0m : Math.Max(0m, Math.Min(1m, (lectura.ValorFinal - pisoReal) / recorrido));
                            <div class="detalle-rango-grande">
                                <div class="detalle-rango-grande-marcador" style="left:@((proporcion * 100).ToString("0.#", CultureInfo.InvariantCulture))%">
                                    <span class="detalle-rango-grande-valor">@Valor(lectura.ValorFinal)</span>
                                    <span class="detalle-rango-grande-flecha" aria-hidden="true">&#9660;</span>
                                </div>
                                <div class="detalle-rango-grande-pista"></div>
                                <div class="detalle-rango-grande-limites">
                                    <span>@Valor(pisoReal) @lectura.Unidad</span>
                                    <span class="detalle-rango-grande-limite-der">@Valor(techoReal) @lectura.Unidad<br /><small>@textos["detalle.limiteDeReferencia"]</small></span>
                                </div>
                            </div>
                            <p class="detalle-rango-resumen">@((MarkupString)textos.Con("detalle.resultadoActual",
                                ("valor", System.Net.WebUtility.HtmlEncode(textos.Medida(lectura.ValorFinal, lectura.Unidad))),
                                ("referencia", System.Net.WebUtility.HtmlEncode(interpretacion.ReferenciaLegible))))</p>
                        }
                        @* Paso 11 — "META" Y "REFERENCIA" NO SON LO MISMO, y ahora quedan en ese
                           orden: primero el rango de referencia clínico (arriba), después,
                           más chica y con su propia nota, la meta orientativa -partida→meta:
                           MetaDeColesterol para el colesterol total; para LDL/Triglicéridos,
                           un alias del propio techo clínico, sin escalón de coaching-. *@
                        <p class="detalle-meta-rotulo">@textos["detalle.metaRotulo"]</p>
                        <ProgresoHaciaMeta Puntos="puntos"
                                           Referencias="referencias"
                                           Descripcion="@interpretacion.ParaSonia" />
                        <p class="detalle-meta-nota">@textos["detalle.metaNota"]</p>
                        break;
                    case "posicion-en-banda":
                        <PosicionEnBanda Puntos="puntos"
                                         Referencias="referencias"
                                         Descripcion="@interpretacion.ParaSonia" />
                        break;
                }
            }

            @* LA INTERPRETACION — Paso 8/RONDA 16-1 y 16-7: YA NO usa interpretacion.Veredicto
               como título -esa palabra del dominio ("empeorando"/"mejorando") es justo lo que
               se pidió sacar de pantalla por alarmista-. En su lugar tres líneas separadas y
               siempre reales: ESTADO ACTUAL (posición contra el rango, calculada -Paso 8 y
               RONDA 16-8: nunca "extremo alto" fijo, sale de EstadoActualTexto() con los
               piso/techo reales de este analito), EVOLUCIÓN (la MISMA Tendencia neutra del
               chip de cabecera, nunca "empeorando") y ACCIÓN (interpretacion.Accion, el
               conjunto cerrado de siempre). Paso 7 -MUY IMPORTANTE- esta rama sólo se toma
               cuando interpretacion.PideAlgo es real.

               RONDA 17 -sólo visual, el contenido de arriba no cambia-: se sacó el
               triángulo de alerta -ya no hay ⚠ en ningún lado de este bloque, ni
               siquiera para "urgente"- y en su lugar hay un ícono "i" informativo
               dentro de un círculo de color (ámbar para lo que merece atención, rojo
               sólo para lo urgente). El contenedor pasó de "panel con barra lateral
               gruesa" a una tarjeta integrada -fondo `--panel-navy`, el mismo tono que
               ya usa Inicio para "lo que merece atención", con un borde fino y sutil
               del color de la severidad-, para que se sienta informativa y no como una
               alerta de sistema. *@
            @if (interpretacion.PideAlgo)
            {
                string estadoActual = (!interpretacion.RequiereElSexo && !EsBinario && !EsNominal) ? EstadoActualTexto() : "";
                string evolucion = EvolucionTexto();
                <div class="detalle-interpretacion @(interpretacion.Severidad == "urgente" ? "detalle-interpretacion--problema" : (interpretacion.SugiereRepetirElExamen ? "detalle-interpretacion--neutro" : "detalle-interpretacion--atencion"))">
                    <span class="detalle-interpretacion-icono" aria-hidden="true">@(interpretacion.SugiereRepetirElExamen ? "↻" : "i")</span>
                    <div class="detalle-interpretacion-cuerpo">
                        @if (estadoActual.Length > 0)
                        {
                            <p class="detalle-interpretacion-estado">@estadoActual</p>
                        }
                        @if (evolucion.Length > 0)
                        {
                            <p class="detalle-interpretacion-evolucion">@evolucion</p>
                        }
                        @if (interpretacion.Accion.Length > 0)
                        {
                            <p class="detalle-interpretacion-accion">@((MarkupString)textos.Con("detalle.valePenaAccion", ("accion", System.Net.WebUtility.HtmlEncode(interpretacion.Accion))))</p>
                        }
                    </div>
                </div>
            }
            else if (interpretacion.RequiereElSexo)
            {
                @* NI VERDE NI AMBAR. No se puede decir que esto esté bien —no se sabe— y
                   tampoco es un hallazgo. La frase la escribe el analito, que es el único que
                   sabe por qué no puede leerse. *@
                <div class="aviso aviso--neutro" style="margin-top:22px">
                    @((MarkupString)textos.Con("detalle.faltaUnDato",
                        ("lectura", System.Net.WebUtility.HtmlEncode(interpretacion.ParaSonia))))
                </div>
            }
            else
            {
                <p class="detalle-conclusion">
                    <span class="detalle-conclusion-icono" aria-hidden="true">&check;</span>
                    @Mayuscula(interpretacion.ParaSonia).
                </p>
            }

            @* CONTEXTO DEL RANGO — Paso 12/RONDA 16-9, recoloreado RONDA 17-7: dos niveles
               de color bien distintos -ÁMBAR es el bloque de arriba, lo que merece
               atención; CELESTE es este, información de cómo se calculó el rango, nunca se
               confunden-, separados por una línea fina (el "divider" de la referencia).
               Dinámico -edad/sexo reales-, y ausente por completo si RequiereElSexo -ahí ya
               lo explica el aviso de arriba- o si esta forma no tiene rango. *@
            @if (!interpretacion.RequiereElSexo && interpretacion.Forma.Length > 0)
            {
                <p class="detalle-contexto">
                    <span class="detalle-contexto-icono" aria-hidden="true">&#9432;</span> @textos.Con("detalle.contextoRango", ("edad", estado.EdadDelPaciente().ToString(CultureInfo.InvariantCulture)), ("sexo", Sexo()))
                </p>
            }

            @* EL RITMO, cuando el analito lo tiene. Es otra pregunta que la tendencia y sobre
               otro tramo: la tendencia mira la serie entera, esto mira el más reciente. *@
            @if (velocidad.EsAplicable)
            {
                <p class="ritmo @(velocidad.ExigeAtencion ? "ritmo--atencion" : "")">
                    <span class="ritmo-rotulo">@textos["detalle.ritmoRotulo"]</span>
                    <span class="ritmo-cifra">@velocidad.Expresada</span>
                    <span class="ritmo-nota">
                        @textos.Con("detalle.ritmoNota",
                            ("dias", textos.Dias(velocidad.Dias)),
                            ("umbral", textos.Medida(velocidad.Umbral, velocidad.Unidad)))
                    </span>
                </p>
            }

            @* CADA MEDICIÓN — Paso 13: compacta, con fecha, valor, unidad y el salto contra
               la anterior cuando lo hay. Con una sola medición muestra esa única fila, sin
               salto -no hay contra qué compararla-. Totalmente dinámica: tantas filas como
               mediciones reales haya -Paso 10 de esta ronda-. *@
            @if (pasos.Count > 0)
            {
                <h2 class="seccion">@textos["detalle.cadaMedicion"]</h2>
                <ol class="detalle-timeline">
                    @{ int indiceMedicion = 0; }
                    @foreach (Paso paso in pasos)
                    {
                        bool esReciente = indiceMedicion == 0;
                        indiceMedicion++;
                        <li class="detalle-evento @(esReciente ? "detalle-evento--reciente" : "")">
                            <span class="detalle-punto" aria-hidden="true"></span>
                            <div class="detalle-evento-fila">
                                <div class="detalle-evento-datos">
                                    <span class="detalle-evento-fecha">@paso.Fecha.ToString("dd MMM yyyy", textos.Cultura)</span>
                                    <span class="detalle-evento-valor">@paso.Expresado <small>@lectura.Unidad</small></span>
                                </div>
                                @if (paso.Salto.Length > 0)
                                {
                                    <span class="detalle-evento-salto">@paso.Salto</span>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        }
    }

    @* DOS CASOS SIN ESCALA QUE PROMETER, y por la misma razón de fondo: decir «se
       evalúan para 60 años» sería inventarle a la persona una escala que no existe.
       Un binario no tiene rango de referencia —lo que sí depende de la edad en su caso
       es cada cuánto conviene repetirlo—, y un analito que no le corresponde no tiene
       contra qué compararse en ningún sexo ni a ninguna edad. *@
    <p class="apunte" style="margin-top:30px">
        @if (EsNominal)
        {
            @* Los DOS parámetros clínicos con los que el dominio elige los rangos, dichos
               juntos porque juntos deciden: 12.2 g/dL no significa lo mismo a los 30 que
               a los 60, ni en un hombre que en una mujer. *@
            <text>@textos.Con("detalle.rangosSeEvaluan", ("edad", estado.EdadDelPaciente().ToString(CultureInfo.InvariantCulture)), ("sexo", Sexo()))</text>
        }
        @textos.Con("detalle.leidoHasta", ("evento", estado.UltimoEvento().ToString(CultureInfo.InvariantCulture)))
    </p>
}

@code {
    // El sexo dicho como parte del pie, o nada cuando todavía no se sabe: ahí el bloque de
    // la pantalla principal ya lo está pidiendo, y repetirlo acá sería insistir dos veces.
    private string Sexo()
    {
        string cual = estado.SexoDelPaciente();
        return cual.Length == 0 || cual == "desconocido"
            ? ""
            : textos.Con("detalle.ySexo", ("sexo", textos["historial." + cual]));
    }

    [Parameter] public string Analito { get; set; } = "";

    private TendenciaDeAnalito lectura = new();

    // Un binario no tiene tendencia ni puntos con número: tiene presencias en fechas. Se
    // piden por su propia puerta, y cuál usar lo dice la forma.
    private const string FormaDePresencia = "presencia-en-el-tiempo";
    private PresenciaDeAnalito presencia = new();
    private IReadOnlyList<PruebaEnSerie> pruebas = new List<PruebaEnSerie>();
    private bool EsBinario => interpretacion.Forma == FormaDePresencia;

    // Y un nominal tampoco tiene tendencia: tiene categorias en fechas. Tercera puerta,
    // por la misma razon que la segunda.
    private const string FormaDeCategoria = "categoria-en-el-tiempo";
    private ConstanciaDeAnalito constancia = new();
    private IReadOnlyList<ObservacionEnSerie> observaciones = new List<ObservacionEnSerie>();
    private bool EsNominal => interpretacion.Forma == FormaDeCategoria;

    // Los HECHOS y la LECTURA son dos consultas distintas: aquella dice que paso, esta
    // dice que significa segun el analito. La pantalla no combina ni interpreta, muestra.
    private InterpretacionDeAnalito interpretacion = new();

    // Los puntos con su numero y las lineas que los acompanan: es lo que la forma dibuja.
    private IReadOnlyList<PuntoDeSerie> puntos = new List<PuntoDeSerie>();
    private IReadOnlyList<LineaDeReferencia> referencias = new List<LineaDeReferencia>();

    private VelocidadDeAnalito velocidad = new();
    private string error = "";

    protected override void OnParametersSet()
    {
        error = "";
        if (!estado.EstaArriba) return;

        // TODO lo que se ve sale de consultar al actor. El payload del laboratorio nunca
        // llega hasta acá: solo entra como argumento de un comando, dentro del refresh.
        try
        {
            // La forma primero: es lo que decide qué se puede preguntar después.
            interpretacion = estado.Interpretacion(Analito);

            if (interpretacion.Forma == FormaDePresencia)
            {
                presencia = estado.Presencia(Analito);
                pruebas = estado.Pruebas(Analito);
                return;
            }

            if (interpretacion.Forma == FormaDeCategoria)
            {
                constancia = estado.Constancia(Analito);
                observaciones = estado.Observaciones(Analito);
                return;
            }

            lectura = estado.Tendencia(Analito);
            puntos = estado.Puntos(Analito);
            referencias = estado.Referencias(Analito);
            velocidad = estado.Velocidad(Analito);
        }
        catch (Exception ex) { error = $"No se pudo leer la serie de {Analito}: {ex.Message}"; }
    }

    private string Insignia()
    {
        if (interpretacion.SugiereRepetirElExamen) return "chip--repetir";
        // SIN SERIE (Paso 5/9-B): el mismo chip--sinserie que ya usa Home cuando
        // !HaySerie -- nunca lo pinta la lectura por defecto ("indeterminado"), que
        // seria un verde "todo bien" sin base real. Sólo en la forma continua: en un
        // binario/nominal `lectura` sigue en su valor por defecto y esta rama no debe
        // aplicar ahí.
        if (!EsBinario && !EsNominal && !lectura.HaySerie) return "chip--sinserie";
        if (interpretacion.Severidad == "urgente") return "chip--problema";
        if (interpretacion.PideAlgo) return "chip--atencion";
        return "chip--estable";
    }

    private void Volver() => navegacion.NavigateTo("");

    // UNA MEDICION en la lista, ya con el salto contra la anterior resuelto. Se arma en
    // C# y no en el markup porque el salto necesita al vecino, y un @foreach no lo tiene.
    private sealed class Paso
    {
        public DateTime Fecha { get; init; }
        public string Expresado { get; init; } = "";
        public string Salto { get; init; } = "";
        public bool EsPositivo { get; init; }
    }

    // LO MAS RECIENTE PRIMERO, igual que el historial de la lista: en una historia se mira
    // para atras. Pero el salto se calcula contra la medicion ANTERIOR EN EL TIEMPO, que
    // en pantalla es la de abajo — por eso se recorre en orden y se da vuelta al final.
    //
    // La mas vieja no lleva salto y eso no es un hueco: es el punto de partida, no hay
    // contra que compararla.
    private List<Paso> Pasos()
    {
        var pasos = new List<Paso>();
        for (int i = 0; i < puntos.Count; i++)
        {
            PuntoDeSerie punto = puntos[i];
            string salto = "";
            if (i > 0)
            {
                decimal cambio = punto.Valor - puntos[i - 1].Valor;
                // TotalDays y NO .Days: el corelib recortado del runtime browser-wasm no
                // trae TimeSpan.get_Days y el detalle reventaba SOLO publicado — con
                // dotnet run andaba. MEDIDO: strings sobre System.Private.CoreLib.*.wasm
                // encuentra get_TotalDays y no get_Days. El dominio ya usa TotalDays en
                // todos lados, por eso el resto de la app no lo sufria.
                int dias = (int)(punto.Fecha - puntos[i - 1].Fecha).TotalDays;
                salto = $"{(cambio >= 0 ? "+" : "−")}{Valor(Math.Abs(cambio))} "
                    + textos.Con("detalle.enDias", ("dias", textos.Dias(dias)));
            }

            pasos.Add(new Paso { Fecha = punto.Fecha, Expresado = Valor(punto.Valor), Salto = salto });
        }

        pasos.Reverse();
        return pasos;
    }

    // En un binario no hay salto que restar: lo que separa una prueba de la anterior es el
    // TIEMPO, y eso es lo que cambia como se lee una racha.
    private List<Paso> PasosBinarios()
    {
        var pasos = new List<Paso>();
        for (int i = 0; i < pruebas.Count; i++)
        {
            PruebaEnSerie prueba = pruebas[i];
            string salto = "";
            if (i > 0)
            {
                // TotalDays por lo mismo que en Pasos(): get_Days no existe publicado.
                int dias = (int)(prueba.Fecha - pruebas[i - 1].Fecha).TotalDays;
                salto = textos.Con("detalle.despues", ("dias", textos.Dias(dias)));
            }

            pasos.Add(new Paso
            {
                Fecha = prueba.Fecha,
                Expresado = prueba.Expresado,
                Salto = salto,
                EsPositivo = prueba.EsPositivo,
            });
        }

        pasos.Reverse();
        return pasos;
    }

    // En un nominal tampoco hay salto que restar, y lo que se marca no es «positivo» sino
    // «se salió de lo esperable». Se reusa Paso —y su EsPositivo— porque la lista de la
    // pantalla es la misma; lo que cambia es qué la pinta.
    private List<Paso> PasosNominales()
    {
        var pasos = new List<Paso>();
        for (int i = 0; i < observaciones.Count; i++)
        {
            ObservacionEnSerie observacion = observaciones[i];
            string salto = "";
            if (i > 0)
            {
                // TotalDays por lo mismo que en Pasos(): get_Days no existe publicado.
                int dias = (int)(observacion.Fecha - observaciones[i - 1].Fecha).TotalDays;
                salto = textos.Con("detalle.despues", ("dias", textos.Dias(dias)));
            }

            pasos.Add(new Paso
            {
                Fecha = observacion.Fecha,
                Expresado = observacion.Expresado,
                Salto = salto,
                EsPositivo = observacion.EsHallazgo,
            });
        }

        pasos.Reverse();
        return pasos;
    }

    // Formato explícito SIEMPRE. Medido en el negocio de facturas: la escala del decimal
    // no sobrevive el journal (5571.50 entra, 5571.5 sale del replay), así que un
    // ToString() pelado mostraría valores distintos antes y después de reabrir la app.
    private static string Valor(decimal medido) => medido.ToString("0.##", CultureInfo.InvariantCulture);

    // EL ESTADO EN PALABRAS PARA EL CHIP GRANDE — RONDA 15: el MISMO vocabulario que ya
    // usa Home (EstadoBreve/Flecha en MisExamenes.razor) para que la cabecera del detalle
    // cuente la misma historia que la tarjeta de "merece atención" (Paso 15).
    // SugiereRepetirElExamen antes que la tendencia, igual que en Home.
    private string EstadoCabecera()
    {
        if (interpretacion.SugiereRepetirElExamen) return textos["atencion.posibleErrorDeMedicion"];
        return lectura.Tendencia switch
        {
            "en-ascenso"  => textos["atencion.vieneAumentando"],
            "en-descenso" => textos["atencion.vieneBajando"],
            "estable"     => textos["atencion.enSeguimiento"],
            _             => "",
        };
    }

    // LA FLECHA, igual que en Home: la decide la Tendencia que ya calculó el dominio, no
    // una resta hecha acá.
    private string Flecha() => lectura.Tendencia switch
    {
        "en-ascenso"  => "↑",
        "en-descenso" => "↓",
        _             => "→",
    };

    // Primera letra en mayúscula, para arrancar como oración una frase del dominio que
    // viene toda en minúscula. Duplicado de Home (MisExamenes.razor.Mayuscula) por la
    // misma razón que MicroChart: esta página no referencia miembros privados de otra.
    private static string Mayuscula(string frase) =>
        frase.Length == 0 ? frase : char.ToUpperInvariant(frase[0]) + frase.Substring(1);

    // EL PISO Y EL TECHO NUMÉRICOS — RONDA 16: PRIMERO las líneas reales y estructuradas
    // que ya trae Referencias(analito) ("piso"/"techo" de "posicion en banda", el "techo"
    // de "trayectoria con linea base"); si esta forma no expone ninguna -"progreso hacia
    // meta": Colesterol Total/LDL/Triglicéridos, que sólo tienen "partida"/"meta"-, los
    // extremos son los que la propia referencia nombra, que desde la localización viajan
    // como NÚMEROS al lado de la frase. Nunca inventa un piso: si la referencia es un
    // techo solo, el piso vuelve null y la pantalla asume 0, igual que ya hacía Home.
    private (decimal? piso, decimal? techo) RangoNumerico()
    {
        LineaDeReferencia? pisoLinea = referencias.FirstOrDefault(r => r.Nombre == "piso");
        LineaDeReferencia? techoLinea = referencias.FirstOrDefault(r => r.Nombre == "techo");
        if (pisoLinea is not null || techoLinea is not null)
            return (pisoLinea?.Valor, techoLinea?.Valor);

        // LOS EXTREMOS VIENEN COMO NUMEROS, no leidos de vuelta de la frase. Sacarlos del
        // texto era re-derivar lo que el dominio ya habia calculado, y ademas se rompia en
        // cuanto la frase cambiaba de idioma: una coma decimal no se parsea con la cultura
        // de la maquina, que es de la maquina y no de la persona.
        //
        // Cero significa "la referencia no nombra ese extremo", que es lo que dice su clave.
        return (interpretacion.MinimoDeLaReferencia > 0m ? interpretacion.MinimoDeLaReferencia : (decimal?)null,
                interpretacion.MaximoDeLaReferencia > 0m ? interpretacion.MaximoDeLaReferencia : (decimal?)null);
    }


    // EL ESTADO ACTUAL, separado de la EVOLUCIÓN — RONDA 16-7/16-8: dónde cae el valor
    // respecto al rango, calculado con datos reales (nunca "extremo alto" fijo). 85%/15%
    // del recorrido real son el único umbral -no un valor clínico-: son la distancia a la
    // que un marcador ya se lee "cerca del borde" en la barra de abajo, la misma pista
    // que dibuja el marcador. Sin rango resoluble, no se inventa una posición: se cae al
    // propio texto del dominio (ParaSonia), nunca a una frase nueva de esta pantalla.
    private string EstadoActualTexto()
    {
        (decimal? piso, decimal? techo) = RangoNumerico();
        decimal actual = lectura.ValorFinal;

        if (techo is decimal t)
        {
            if (actual > t) return textos["detalle.porEncimaDelRango"];

            decimal desdePiso = piso ?? 0m;
            decimal recorrido = t - desdePiso;
            if (recorrido > 0)
            {
                decimal proporcion = (actual - desdePiso) / recorrido;
                if (proporcion >= 0.85m) return textos["detalle.cercaDelAlto"];
                if (piso is not null && proporcion <= 0.15m) return textos["detalle.cercaDelBajo"];
            }
            return textos["detalle.dentroDelRango"];
        }
        if (piso is decimal p && actual < p)
            return textos["detalle.porDebajoDelRango"];

        return interpretacion.ParaSonia.Length > 0 ? Mayuscula(interpretacion.ParaSonia) + "." : "";
    }

    // LA EVOLUCIÓN, en el MISMO vocabulario neutro del chip de cabecera — RONDA 16-1: acá
    // NUNCA aparece "empeorando"/"mejorando" (eso es Veredicto, la palabra que se pidió
    // sacar de esta pantalla): sólo el HECHO de Tendencia, igual que EstadoCabecera().
    // Sin serie no hay evolución que contar -Paso 5-, así que devuelve vacío.
    private string EvolucionTexto()
    {
        if (!lectura.HaySerie) return "";
        return lectura.Tendencia switch
        {
            "en-ascenso"  => textos["detalle.evolucionAumentando"],
            "en-descenso" => textos["detalle.evolucionBajando"],
            "estable"     => textos["detalle.evolucionEstable"],
            _             => "",
        };
    }

    // EL COLOR DEL GRÁFICO — RONDA 16-4: nunca verde por defecto sólo porque hay una
    // línea; sigue la MISMA Severidad que ya pinta el chip (Insignia()) y el bloque de
    // interpretación, nunca una lectura de color aparte.
    private string ClaseDelGrafico()
    {
        if (!interpretacion.PideAlgo) return "";
        return interpretacion.Severidad == "urgente" ? "detalle-grafico--problema" : "detalle-grafico--atencion";
    }


    // EL MICRO-GRAFICO COMPARATIVO — RONDA 13: mismo lenguaje visual y mismo algoritmo
    // que ya usa "Qué cambió" en Home (línea + puntos, sin ejes ni escala clínica),
    // duplicado acá -no compartido- porque esta página no puede referenciar los
    // miembros privados de MisExamenes.razor y esa pantalla queda fuera del alcance de
    // esta ronda. Usa TODOS los puntos reales de la serie (puntos), nunca solo el
    // último salto: si hay 2 mediciones dibuja 2, si hay 5 dibuja 5. Esta rama sólo se
    // alcanza con lectura.HaySerie, así que puntos.Count siempre es >= 2 acá.
    private const double AnchoDelMicroChart = 260;
    private const double AltoDelMicroChart = 40;
    private const double MargenDelMicroChart = 20;
    private string VbAncho => (AnchoDelMicroChart + 2 * MargenDelMicroChart).ToString("0", CultureInfo.InvariantCulture);
    private string VbAlto => (AltoDelMicroChart + 2 * MargenDelMicroChart).ToString("0", CultureInfo.InvariantCulture);
    private string YFecha => (AltoDelMicroChart + 2 * MargenDelMicroChart - 4).ToString("0", CultureInfo.InvariantCulture);

    private sealed class PuntoDelMicroChart
    {
        public double X { get; init; }
        public double Y { get; init; }
        public string Valor { get; init; } = "";
        public string Fecha { get; init; } = "";
    }

    private List<PuntoDelMicroChart> MicroChart()
    {
        var lista = new List<PuntoDelMicroChart>();
        if (puntos.Count == 0) return lista;

        decimal minimo = puntos[0].Valor, maximo = puntos[0].Valor;
        foreach (PuntoDeSerie p in puntos)
        {
            if (p.Valor < minimo) minimo = p.Valor;
            if (p.Valor > maximo) maximo = p.Valor;
        }
        decimal rango = maximo - minimo;

        for (int i = 0; i < puntos.Count; i++)
        {
            double x = MargenDelMicroChart + (puntos.Count == 1 ? AnchoDelMicroChart / 2 : AnchoDelMicroChart * i / (puntos.Count - 1));
            double y;
            if (rango == 0)
            {
                y = MargenDelMicroChart + AltoDelMicroChart / 2;
            }
            else
            {
                double proporcion = (double)((puntos[i].Valor - minimo) / rango);
                y = MargenDelMicroChart + AltoDelMicroChart - proporcion * AltoDelMicroChart;
            }
            lista.Add(new PuntoDelMicroChart
            {
                X = x,
                Y = y,
                Valor = Valor(puntos[i].Valor),
                Fecha = puntos[i].Fecha.ToString("MMM yyyy", textos.Cultura),
            });
        }
        return lista;
    }

    private static string PolilineaDelMicroChart(List<PuntoDelMicroChart> pts)
    {
        var texto = new System.Text.StringBuilder();
        for (int i = 0; i < pts.Count; i++)
        {
            if (i > 0) texto.Append(' ');
            texto.Append(pts[i].X.ToString("0.#", CultureInfo.InvariantCulture));
            texto.Append(',');
            texto.Append(pts[i].Y.ToString("0.#", CultureInfo.InvariantCulture));
        }
        return texto.ToString();
    }
}
