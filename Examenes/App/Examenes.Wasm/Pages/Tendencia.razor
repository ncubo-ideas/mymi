@page "/analito/{Analito}"
@using System.Globalization
@using Examenes.App.Vistas
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

@* La pantalla de detalle de este negocio NO es "el examen": es LA SERIE de un analito.
   Un examen suelto ya se ve en la lista, y ademas el laboratorio ya se lo entrego en una
   hoja. Lo que la app puede mostrar y la hoja no es la historia: de cuanto a cuanto, en
   cuanto tiempo, y que significa ese ritmo.

   Igual que en la lista, la frase la arma la PANTALLA con los hechos del dominio. El
   dominio devuelve tendencia, extremos, unidad y dias; no devuelve prosa. Por eso aca no
   hay -y no puede haber- un consejo de plantilla.

   ------------------------------------------------------- QUE JUSTIFICA ESTA PANTALLA

   Nada, hasta ahora: la tarjeta de la lista habia crecido hasta traer la forma visual, la
   lectura y la accion, y esta pantalla mostraba MENOS que ella. Un click que quita
   informacion no es un detalle, es un castigo.

   Lo que la tarjeta no puede dar por como esta hecha es CADA MEDICION. La tarjeta
   comprime la serie en una frase -«paso de 3.0 a 5.2 ng/mL en 1095 dias, sobre 4
   mediciones»- y esa frase esconde lo unico que cambia como se lee: si el cambio fue
   parejo o fue un salto. El antigeno del guion sembrado es el caso exacto: 3.0 → 3.1 →
   3.0 → 5.2. Tres anos planchados y un salto al final tienen los MISMOS extremos, los
   MISMOS dias y las MISMAS mediciones que una subida lenta, y no significan lo mismo.

   Y no se solapa con «Tu historial» de la lista: aquel es el corte por VISITA -varios
   analitos, un dia-, esto es el corte ortogonal -un analito, todas sus fechas.

   La forma visual tambien baja aca, porque un detalle tiene que ser un superconjunto de
   su resumen: el grafico dice la FORMA, la lista dice los NUMEROS. *@

<PageTitle>@Analito</PageTitle>

<button class="boton boton--contorno" @onclick="Volver" style="margin-bottom:24px">&larr; Volver a mis exámenes</button>

@if (!estado.EstaArriba)
{
    <div class="aviso aviso--atencion">
        La app no está abierta. <a href="">Volvé a la lista</a> para abrirla.
    </div>
}
else if (error.Length > 0)
{
    <div class="aviso aviso--problema">@error</div>
}
else
{
    <h1 class="titular">@(EsBinario ? presencia.ParaMostrar : lectura.ParaMostrar)</h1>

    @*  UN BINARIO SE CUENTA DISTINTO, porque es distinto. Acá no hay «de cuánto a
        cuánto»: hay cuántas veces se buscó, cuántas apareció, y —lo único que cambia la
        conducta— cuántas SEGUIDAS. La pantalla no elige cuál de las dos historias contar:
        se lo pregunta a la forma, que la dice el dominio.                               *@
    @if (EsBinario)
    {
        @if (!presencia.HaySerie)
        {
            <p class="apunte" style="margin-top:14px">
                @(presencia.Mediciones == 0
                    ? "Todavía no te hicieron esta prueba."
                    : "Sólo hay una prueba. Con un solo resultado no se puede decir si esto "
                      + "se repite: hace falta una segunda.")
            </p>
            @if (presencia.Mediciones == 1)
            {
                <p class="cifra-par">@presencia.UltimoResultado</p>
            }
        }
        else
        {
            <p style="margin:10px 0 0"><span class="chip chip--grande @Insignia()">@presencia.Presencia</span></p>

            <p class="cifra-par">
                <span class="@(interpretacion.PideAlgo ? "final" : "")">@presencia.UltimoResultado</span>
            </p>
            <p class="apunte">
                @presencia.Positivas de @presencia.Mediciones pruebas,
                en @presencia.Dias @(presencia.Dias == 1 ? "día" : "días")
                @(presencia.PositivasSeguidas >= 2
                    ? $"· {presencia.PositivasSeguidas} seguidas al final"
                    : "")
                @if (interpretacion.ReferenciaLegible.Length > 0)
                {
                    <text>· @interpretacion.ReferenciaLegible</text>
                }
            </p>

            <PresenciaEnElTiempo Pruebas="pruebas"
                                 Seguidas="presencia.PositivasSeguidas"
                                 Descripcion="@interpretacion.ParaSonia" />
        }

        @if (interpretacion.PideAlgo)
        {
            <div class="aviso @(interpretacion.Severidad == "urgente" ? "aviso--problema" : "aviso--atencion")" style="margin-top:22px">
                <strong>@interpretacion.Veredicto.</strong>
                @interpretacion.ParaSonia. No es un diagnóstico: es la lectura de tu propia
                serie. Lo que corresponde es <strong>@interpretacion.Accion</strong>.
            </div>
        }
        else if (interpretacion.ParaSonia.Length > 0)
        {
            <div class="aviso" style="margin-top:22px;border-left-color:var(--bien)">
                @interpretacion.ParaSonia.
            </div>
        }

        @* CADA PRUEBA, una por una. La tira de arriba dice la forma; esto dice las fechas.
           En un binario el hueco entre pruebas es la mitad del dato: «apareció dos veces»
           es una cosa si fue en dos meses y otra si fue en cuatro años. *@
        @if (presencia.Mediciones > 0)
        {
            <h2 class="seccion">Cada prueba</h2>
            <ol class="mediciones">
                @foreach (Paso paso in PasosBinarios())
                {
                    <li class="medicion@(paso.EsPositivo ? " medicion--presente" : "")">
                        <div class="medicion-fecha">
                            <span class="medicion-dia">@paso.Fecha.ToString("dd MMM", Cultura)</span>
                            <span class="medicion-ano">@paso.Fecha.Year</span>
                        </div>
                        <div class="medicion-valor">@paso.Expresado</div>
                        <div class="medicion-salto">@paso.Salto</div>
                    </li>
                }
            </ol>
        }
    }
    else if (!lectura.HaySerie)
    {
        <p class="apunte" style="margin-top:14px">
            @(lectura.Mediciones == 0
                ? "No hay ninguna medición de este analito todavía."
                : "Hay una sola medición. Con un solo punto no se puede decir para dónde viene: "
                  + "hace falta al menos una segunda para que haya serie.")
        </p>
        @if (lectura.Mediciones == 1)
        {
            <p class="cifra-par">@Valor(lectura.ValorFinal)<span class="unidad">@lectura.Unidad</span></p>
            @if (interpretacion.ReferenciaLegible.Length > 0)
            {
                <p class="apunte">referencia: @interpretacion.ReferenciaLegible</p>
            }
        }
    }
    else
    {
        <p style="margin:10px 0 0"><span class="chip chip--grande @Insignia()">@lectura.Tendencia</span></p>

        @* Los dos extremos, grandes y monoespaciados: es LA lectura de la pantalla. El
           valor final se tiñe solo cuando exige atencion - el color dice algo o no esta. *@
        <p class="cifra-par">
            @Valor(lectura.ValorInicial)<span class="flecha">&rarr;</span><span class="@(interpretacion.PideAlgo ? "final" : "")">@Valor(lectura.ValorFinal)</span><span class="unidad">@lectura.Unidad</span>
        </p>
        <p class="apunte">
            en @lectura.Dias @(lectura.Dias == 1 ? "día" : "días"),
            sobre @lectura.Mediciones mediciones
            @(lectura.Cambio >= 0 ? "· subió " : "· bajó ")@Valor(Math.Abs(lectura.Cambio)) @lectura.Unidad
            @if (interpretacion.ReferenciaLegible.Length > 0)
            {
                <text>· referencia: @interpretacion.ReferenciaLegible</text>
            }
        </p>

        @* LA FORMA, la misma que en la tarjeta y por la misma razón: el dominio dice cuál
           le toca a este analito y acá sólo se traduce a píxeles. Que la tarjeta la
           tuviera y el detalle no era el bug: se perdía la forma justo al pedir más. *@
        @* SIN VEREDICTO NO HAY DIBUJO: las tres formas se trazan CONTRA una referencia
           —la banda, la meta, el techo— y esa referencia es justamente lo que depende del
           dato que falta. Los valores de arriba siguen estando; lo que se retiene es la
           lectura. *@
        @switch (interpretacion.RequiereElSexo ? "" : interpretacion.Forma)
        {
            case "trayectoria con linea base":
                <TrayectoriaConLineaBase Puntos="puntos"
                                         Referencias="referencias"
                                         PideAlgo="interpretacion.PideAlgo"
                                         Descripcion="@interpretacion.ParaSonia" />
                break;
            case "progreso hacia meta":
                <ProgresoHaciaMeta Puntos="puntos"
                                   Referencias="referencias"
                                   Descripcion="@interpretacion.ParaSonia" />
                break;
            case "posicion en banda":
                <PosicionEnBanda Puntos="puntos"
                                 Referencias="referencias"
                                 Descripcion="@interpretacion.ParaSonia" />
                break;
        }

        @* TODO este bloque salia de la pantalla: dos textos fijos que se elegian con un
           bool. Ahora la frase la escribe el analito y la accion sale del conjunto cerrado
           de severidades, asi que agregar un analito no obliga a tocar este .razor. *@
        @if (interpretacion.PideAlgo)
        {
            <div class="aviso @(interpretacion.SugiereRepetirElExamen ? "aviso--neutro" : "aviso--atencion")" style="margin-top:22px">
                <strong>@interpretacion.Veredicto.</strong>
                @interpretacion.ParaSonia. No es un diagnóstico: es la lectura de tu propia
                serie. Lo que corresponde es <strong>@interpretacion.Accion</strong>.
            </div>
        }
        else if (interpretacion.RequiereElSexo)
        {
            @* NI VERDE NI AMBAR. No se puede decir que esto esté bien —no se sabe— y
               tampoco es un hallazgo. La frase la escribe el analito, que es el único que
               sabe por qué no puede leerse. *@
            <div class="aviso aviso--neutro" style="margin-top:22px">
                <strong>Falta un dato tuyo.</strong> @interpretacion.ParaSonia.
                Los valores de arriba son reales; lo que no hay todavía es la lectura.
                <a href="">Decilo en tus exámenes</a> y esto se interpreta solo.
            </div>
        }
        else
        {
            <div class="aviso" style="margin-top:22px;border-left-color:var(--bien)">
                Se mantiene dentro de lo esperable para tu historia.
            </div>
        }

        @* EL RITMO, cuando el analito lo tiene. Es otra pregunta que la tendencia y sobre
           otro tramo: la tendencia mira la serie entera, esto mira el más reciente. Hoy
           sólo el antígeno la contesta —el dominio dice «no aplica» en el resto— y por eso
           el bloque aparece o no aparece, en vez de mostrar un cero. *@
        @if (velocidad.EsAplicable)
        {
            <p class="ritmo @(velocidad.ExigeAtencion ? "ritmo--atencion" : "")">
                <span class="ritmo-rotulo">al ritmo del último tramo</span>
                <span class="ritmo-cifra">@velocidad.Expresada</span>
                <span class="ritmo-nota">
                    medido sobre @velocidad.Dias @(velocidad.Dias == 1 ? "día" : "días")
                    · el umbral de este analito es @Valor(velocidad.Umbral) @velocidad.Unidad al año
                </span>
            </p>
        }

        @* CADA MEDICIÓN, con el salto contra la anterior. Es lo que esta pantalla aporta y
           la tarjeta no puede: los extremos y el promedio esconden si el cambio fue parejo
           o fue de golpe, y eso es justo lo que hay que ver.

           La resta la hace la PANTALLA, y puede: son dos puntos contiguos que el dominio
           ya mandó, sin criterio ni umbral de por medio. Es el mismo desarmado que
           reconstruir las columnas del cuadro, no una interpretación. *@
        <h2 class="seccion">Cada medición</h2>
        <ol class="mediciones">
            @foreach (Paso paso in Pasos())
            {
                <li class="medicion">
                    <div class="medicion-fecha">
                        <span class="medicion-dia">@paso.Fecha.ToString("dd MMM", Cultura)</span>
                        <span class="medicion-ano">@paso.Fecha.Year</span>
                    </div>
                    <div class="medicion-valor">@paso.Expresado <span>@lectura.Unidad</span></div>
                    <div class="medicion-salto">@paso.Salto</div>
                </li>
            }
        </ol>
    }

    @* Un binario NO tiene rango de referencia, así que decirle a la persona que «se
       evalúan para 60 años» sería inventarle una escala que no existe. Lo que sí depende
       de la edad en su caso es cada cuánto conviene repetirlo. *@
    <p class="apunte" style="margin-top:30px">
        @if (!EsBinario)
        {
            @* Los DOS parámetros clínicos con los que el dominio elige los rangos, dichos
               juntos porque juntos deciden: 12.2 g/dL no significa lo mismo a los 30 que
               a los 60, ni en un hombre que en una mujer. *@
            <text>Los rangos de referencia se evalúan para @estado.EdadDelPaciente() años@Sexo().</text>
        }
        Leído hasta el evento @estado.UltimoEvento().
    </p>
}

@code {
    // El sexo dicho como parte del pie, o nada cuando todavía no se sabe: ahí el bloque de
    // la pantalla principal ya lo está pidiendo, y repetirlo acá sería insistir dos veces.
    private string Sexo()
    {
        string cual = estado.SexoDelPaciente();
        return cual.Length == 0 || cual == "desconocido" ? "" : $" y sexo {cual}";
    }

    [Parameter] public string Analito { get; set; } = "";

    private TendenciaDeAnalito lectura = new();

    // Un binario no tiene tendencia ni puntos con número: tiene presencias en fechas. Se
    // piden por su propia puerta, y cuál usar lo dice la forma.
    private const string FormaDePresencia = "presencia en el tiempo";
    private PresenciaDeAnalito presencia = new();
    private IReadOnlyList<PruebaEnSerie> pruebas = new List<PruebaEnSerie>();
    private bool EsBinario => interpretacion.Forma == FormaDePresencia;

    // Los HECHOS y la LECTURA son dos consultas distintas: aquella dice que paso, esta
    // dice que significa segun el analito. La pantalla no combina ni interpreta, muestra.
    private InterpretacionDeAnalito interpretacion = new();

    // Los puntos con su numero y las lineas que los acompanan: es lo que la forma dibuja.
    private IReadOnlyList<PuntoDeSerie> puntos = new List<PuntoDeSerie>();
    private IReadOnlyList<LineaDeReferencia> referencias = new List<LineaDeReferencia>();

    private VelocidadDeAnalito velocidad = new();
    private string error = "";

    protected override void OnParametersSet()
    {
        error = "";
        if (!estado.EstaArriba) return;

        // TODO lo que se ve sale de consultar al actor. El payload del laboratorio nunca
        // llega hasta acá: solo entra como argumento de un comando, dentro del refresh.
        try
        {
            // La forma primero: es lo que decide qué se puede preguntar después.
            interpretacion = estado.Interpretacion(Analito);

            if (interpretacion.Forma == FormaDePresencia)
            {
                presencia = estado.Presencia(Analito);
                pruebas = estado.Pruebas(Analito);
                return;
            }

            lectura = estado.Tendencia(Analito);
            puntos = estado.Puntos(Analito);
            referencias = estado.Referencias(Analito);
            velocidad = estado.Velocidad(Analito);
        }
        catch (Exception ex) { error = $"No se pudo leer la serie de {Analito}: {ex.Message}"; }
    }

    private string Insignia()
    {
        if (interpretacion.SugiereRepetirElExamen) return "chip--repetir";
        if (interpretacion.Severidad == "urgente") return "chip--problema";
        if (interpretacion.PideAlgo) return "chip--atencion";
        return "chip--estable";
    }

    private void Volver() => navegacion.NavigateTo("");

    private static readonly CultureInfo Cultura = new CultureInfo("es-ES");

    // UNA MEDICION en la lista, ya con el salto contra la anterior resuelto. Se arma en
    // C# y no en el markup porque el salto necesita al vecino, y un @foreach no lo tiene.
    private sealed class Paso
    {
        public DateTime Fecha { get; init; }
        public string Expresado { get; init; } = "";
        public string Salto { get; init; } = "";
        public bool EsPositivo { get; init; }
    }

    // LO MAS RECIENTE PRIMERO, igual que el historial de la lista: en una historia se mira
    // para atras. Pero el salto se calcula contra la medicion ANTERIOR EN EL TIEMPO, que
    // en pantalla es la de abajo — por eso se recorre en orden y se da vuelta al final.
    //
    // La mas vieja no lleva salto y eso no es un hueco: es el punto de partida, no hay
    // contra que compararla.
    private List<Paso> Pasos()
    {
        var pasos = new List<Paso>();
        for (int i = 0; i < puntos.Count; i++)
        {
            PuntoDeSerie punto = puntos[i];
            string salto = "";
            if (i > 0)
            {
                decimal cambio = punto.Valor - puntos[i - 1].Valor;
                // TotalDays y NO .Days: el corelib recortado del runtime browser-wasm no
                // trae TimeSpan.get_Days y el detalle reventaba SOLO publicado — con
                // dotnet run andaba. MEDIDO: strings sobre System.Private.CoreLib.*.wasm
                // encuentra get_TotalDays y no get_Days. El dominio ya usa TotalDays en
                // todos lados, por eso el resto de la app no lo sufria.
                int dias = (int)(punto.Fecha - puntos[i - 1].Fecha).TotalDays;
                salto = $"{(cambio >= 0 ? "+" : "−")}{Valor(Math.Abs(cambio))} en {dias} {(dias == 1 ? "día" : "días")}";
            }

            pasos.Add(new Paso { Fecha = punto.Fecha, Expresado = Valor(punto.Valor), Salto = salto });
        }

        pasos.Reverse();
        return pasos;
    }

    // En un binario no hay salto que restar: lo que separa una prueba de la anterior es el
    // TIEMPO, y eso es lo que cambia como se lee una racha.
    private List<Paso> PasosBinarios()
    {
        var pasos = new List<Paso>();
        for (int i = 0; i < pruebas.Count; i++)
        {
            PruebaEnSerie prueba = pruebas[i];
            string salto = "";
            if (i > 0)
            {
                // TotalDays por lo mismo que en Pasos(): get_Days no existe publicado.
                int dias = (int)(prueba.Fecha - pruebas[i - 1].Fecha).TotalDays;
                salto = $"{dias} {(dias == 1 ? "día" : "días")} después";
            }

            pasos.Add(new Paso
            {
                Fecha = prueba.Fecha,
                Expresado = prueba.Expresado,
                Salto = salto,
                EsPositivo = prueba.EsPositivo,
            });
        }

        pasos.Reverse();
        return pasos;
    }

    // Formato explícito SIEMPRE. Medido en el negocio de facturas: la escala del decimal
    // no sobrevive el journal (5571.50 entra, 5571.5 sale del replay), así que un
    // ToString() pelado mostraría valores distintos antes y después de reabrir la app.
    private static string Valor(decimal medido) => medido.ToString("0.##", CultureInfo.InvariantCulture);
}
