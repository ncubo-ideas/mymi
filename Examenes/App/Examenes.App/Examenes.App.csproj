<Project Sdk="Microsoft.NET.Sdk">

  <!-- La superficie intencional de la app: donde viven los PerformCmd y PerformQry.
       La UI, el servidor MCP y la consola llaman a ExamenesAPI, nunca al actor crudo.
       Que la logica sea UNA es lo que hace que la IA y la persona vean lo mismo.

       El motor viene por NuGet; la version esta en Directory.Build.props (raiz) para no
       repetirla en cada proyecto. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- El dominio se referencia pero NO se puede nombrar: es enteramente `internal` y
         este ensamblado no esta en su lista de InternalsVisibleTo. La referencia existe
         porque el dll tiene que llegar al output y figurar en el deps.json de cada host:
         ElDominio lo carga por nombre en tiempo de ejecucion. Referenciar sin poder
         nombrar es exactamente la cerca: el atajo no es de mal gusto, es un error de
         compilacion. -->
    <ProjectReference Include="..\..\Dominio\Examenes.Dominio.csproj" />
    <ProjectReference Include="..\Examenes.Eventos\Examenes.Eventos.csproj" />
    <ProjectReference Include="..\..\Mecanismo\Puppets.Portador\Puppets.Portador.csproj" />

    <!-- THE CARGO CONTRACT, compiled against but NOT copied (ExcludeAssets=runtime). The
         surface class wears [ModuleSurface]/[Query] from here; at run time the Host lends its
         copy, so the module package does not carry it. Private=false keeps it out of the
         packages of the OTHER consumers (Mcp, Wasm, Consola) too -they do not use the surface,
         and its attributes resolve lazily, so a missing copy never bites them. -->
    <ProjectReference Include="..\..\..\Gnothi.Contract\Gnothi.Contract.csproj"
                      ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

  <!-- Solo el core. Los tres paquetes de adapters (Adapters, Adapters.Sql,
       Adapters.Sockets) no se usan aca: la app solo necesita PerformanceV2, que viene en
       este. MEDIDO que agregarlos no cambia el payload del browser en un byte — 46 MB y
       199 assemblies con los cuatro o con solo este — porque sus dependencias no son
       compatibles con browser-wasm y quedan afuera. Un host que de verdad use SQL o
       sockets los agrega el. -->
  <ItemGroup>
    <PackageReference Include="Ncubo.Puppeteer" Version="$(VersionDelMotor)" />
  </ItemGroup>

</Project>
