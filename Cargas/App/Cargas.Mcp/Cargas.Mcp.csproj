<Project Sdk="Microsoft.NET.Sdk">

  <!-- La superficie MCP: un proceso local, SOLO LECTURA, sobre la misma carpeta de
       journal que escribe la app instalada.
       No le habla al browser ni el browser le habla a el. Los dos comparten la carpeta,
       y el journal YA es el protocolo: no hay que inventar uno.
       Una pagina en el browser no puede hospedar un servidor MCP (no puede escuchar
       conexiones entrantes), asi que este proceso es inevitable. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cargas.Mcp</RootNamespace>
    <AssemblyName>Cargas.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />

    <!-- El host generico (Host.CreateApplicationBuilder). Se declara ACA a proposito.
         Antes llegaba transitivamente porque Choreography arrastraba el FrameworkReference
         de ASP.NET Core; al pasar el motor a NuGet y quedarnos con el core, eso desaparecio
         y el build fallo con "el nombre 'Host' no existe". Es una mejora, no una molestia:
         quien usa un host generico lo declara, en vez de heredarlo de una dependencia que
         no tiene nada que ver. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cargas.App\Cargas.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README-para-la-IA.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
