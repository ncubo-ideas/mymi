@inherits LayoutComponentBase
@using Cargas.App.Vistas
@using Puppets.Portador
@inject EstadoDeLaApp estado
@inject Textos texto
@implements IDisposable

@* LA CASCARA DE LA APP: el capo, las pestañas y todo lo que habla de la APP y no del carro.

   POR QUE EL ARRANQUE VIVE ACA Y NO EN LA PAGINA. Hasta las pestañas, abrir la carpeta y
   levantar el actor pasaban en la unica pagina que habia. El patron heredado -que Compras y
   Examenes todavia tienen- deja eso en la raiz y las paginas secundarias muestran "anda a
   Inicio y elegi tu carpeta". Con una barra inferior eso es inaceptable: la persona toca
   Lealtad y tiene que funcionar, y un deep link a /app/ruta tambien.

   Asi que la cascara decide: si la app no esta arriba, muestra donde guardar y NO dibuja el
   @@Body. Ninguna pagina tiene que defenderse de un estado a medio levantar.

   POR QUE LA MARCA VIVE ACA. Es de toda la app, y repetirla en cada pantalla ademas compite
   con el titulo de la pantalla. Compras ya hizo este movimiento y dejo escrito el motivo.

   Y LOS AVISOS DE PERSISTENCIA TAMBIEN. "No se esta guardando nada" es lo mas importante
   que la app puede decir, y si viviera en el Tablero, alguien que se queda en la Ruta nunca
   se entera de que sus kilometrajes se van a perder. *@

<header class="capo">
    @* EL CAPÓ. ⚠️ MARCA PROVISIONAL: el nombre y la paleta esperan la especificación de
       Geaninna; lo que no espera es la estructura. El faro va de un solo trazo -torre y
       haz-, nunca relleno, legible a 24 px. *@
    <div class="capo-dentro">
        <div class="marca">
            <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"
                 fill="none" stroke="var(--logo)" stroke-width="2.4" aria-hidden="true">
                <path d="M16 34 L18 12 h4 L24 34 z" />
                <path d="M15 12 h10 M17 7 h6 M18 12 V7 M22 12 V7" />
                <path d="M26 8 l6 -2.5 M26 11 l7 0" />
            </svg>
            <div>
                <div class="marca-nombre">@Textos.NombreDeLaMarca</div>
                <div class="marca-claim">@Textos.ClaimDeLaMarca</div>
            </div>
        </div>

        @* DE QUIEN ES ESTE TABLERO. Con un carro es una placa y nada mas; con varios se
           vuelve selector, que es el patron de Road Trip -el nombre del vehiculo en el
           encabezado ES el selector- y evita UI gratis para el caso comun.

           Un <select> nativo y no una lista propia: en telefono abre la rueda del sistema,
           llega por teclado sin que haya que escribirlo, y no hay que resolver el cierre
           al tocar afuera. *@
        @if (estado.EstaArriba && vehiculos.Count == 1)
        {
            <span class="placa">
                @vehiculos[0].Placa
                @if (vehiculos[0].TieneFicha)
                {
                    <span class="apodo">@vehiculos[0].Nombre</span>
                }
            </span>
        }
        else if (estado.EstaArriba && vehiculos.Count > 1)
        {
            <select class="placa placa--selector" value="@enFoco"
                    aria-label="@texto["comun.elegiCarro"]"
                    @onchange="CambiarDeCarro">
                @foreach (VehiculoEnLista vehiculo in vehiculos)
                {
                    <option value="@vehiculo.Placa">
                        @(vehiculo.TieneFicha ? $"{vehiculo.Nombre} · {vehiculo.Placa}" : vehiculo.Placa)
                    </option>
                }
            </select>
        }

        @* LAS CUATRO PESTAÑAS, y son UNA sola UI que se comporta distinto por resolucion: pestañas
           a la derecha del capo en escritorio, barra fija al pie en telefono. El markup es uno solo
           y el CSS decide donde se paran. Es el patron de Compras, textual.

           LOS ICONOS SE DIBUJAN, no se escriben: un glifo cae en otra familia con otras metricas
           justo al lado de la etiqueta. Y `stroke="currentColor"` para que hereden el color
           del estado activo sin repetir la paleta.

           EL BADGE DE CARGAS NO ES ADORNO. Antes de las pestañas, la ausencia que bloquea un
           calculo se veia porque estaba en la misma pantalla que los instrumentos. Partida en
           pestañas se esconde, y partir sin avisar seria una regresion: la cuenta de lo que
           espera un dato suyo viaja hasta la pestaña. *@
        @if (estado.EstaArriba)
        {
        <nav class="pestanas">
            <div class="pestanas-dentro">
                <NavLink class="pestana" href="" Match="NavLinkMatch.All">
                    @* El medidor: un arco y su aguja. *@
                    <svg class="pestana-icono" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3.6 14.4a6.4 6.4 0 0 1 12.8 0" />
                        <path d="M10 14.4 13.4 10.8" />
                    </svg>
                    @texto["tablero.titulo"]
                </NavLink>

                <NavLink class="pestana" href="cargas">
                    @* El surtidor: el cuerpo, la ventanilla y la manguera. *@
                    <svg class="pestana-icono" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3.6" y="3.4" width="8.2" height="13.2" rx="1.2" />
                        <path d="M5.8 6h3.8v3.2H5.8z" />
                        <path d="M11.8 8.2h1.6a1.4 1.4 0 0 1 1.4 1.4v4.2a1.1 1.1 0 0 0 2.2 0V8.6l-1.8-1.8" />
                    </svg>
                    @texto["ruta.titulo"]
                    @if (pendientes > 0)
                    {
                        <span class="pestana-badge"
                              aria-label="@texto.Con("comun.pendientesAria", ("cuantos", pendientes.ToString()))">@pendientes</span>
                    }
                </NavLink>

                <NavLink class="pestana" href="lealtad">
                    @* El boleto, con su linea de corte. *@
                    <svg class="pestana-icono" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2.8" y="5.6" width="14.4" height="8.8" rx="1.6" />
                        <path d="M12.4 5.6v8.8" stroke-dasharray="1.6 1.5" />
                    </svg>
                    @texto["lealtad.titulo"]
                </NavLink>

                <NavLink class="pestana" href="mi-carro">
                    @* El carro, de perfil. *@
                    <svg class="pestana-icono" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3.4 13.2v-2.4l1.8-4h9.6l1.8 4v2.4" />
                        <path d="M3.4 10.8h13.2" />
                        <circle cx="6.6" cy="13.4" r="1.4" />
                        <circle cx="13.4" cy="13.4" r="1.4" />
                    </svg>
                    @texto["miCarro.titulo"]
                </NavLink>
            </div>
        </nav>

        @* La tecla va DESPUES de las pestañas: en escritorio queda al borde derecho, donde
           no compite con la navegacion. Es tenue a proposito -la app se pone al dia sola al
           abrir-, asi que esto es "volve a chequear AHORA" y no el punto de partida. *@
        @* MIGRADA LA APAGA, y lo DICE en vez de quedarse gris: una tecla deshabilitada sin
           explicación se lee como que la app se rompió. El aviso de más abajo dice por qué. *@
        <button class="tecla tecla--releer" @onclick="Refrescar"
                disabled="@(estado.Refrescando || estado.Migrada)">
            @(estado.Migrada ? texto["comun.yaNoSeActualiza"]
                : estado.Refrescando ? texto["comun.actualizando"] : texto["comun.actualizar"])
        </button>
        }
    </div>
</header>

<main class="tablero">
    @* UN solo lugar para los errores, y arriba de todo: un fallo abajo queda fuera de
       pantalla y la app parece no reaccionar al click. *@
    <Problema De="error" />

    @if (!estado.EstaArriba)
    {
        @* MIENTRAS SE RESUELVE QUÉ HABÍA RECORDADO, no se pinta el elegidor. Hasta que
           IndexedDB contesta no sabemos si la persona ya eligió, y mostrarle «Elegí dónde»
           a quien eligió la semana pasada es pedirle que vuelva a decidir: medido, entre 2
           y 8 segundos de elegidor en cada recarga, y encima sin la tecla grande, porque
           «soportado» y «opfs» todavía eran null. El elegidor aparece SOLO cuando se sabe
           que no hay nada recordado o que recuperarlo falló. *@
        @if (resolviendo)
        {
            <p class="abriendo" role="status" aria-live="polite">@TextoDeAbriendo()</p>
        }
        @* Cuando el handle volvió de IndexedDB pero el permiso caducó, la acción correcta
           es RE-OTORGAR, no volver a elegir la carpeta. *@
        else if (estado.FaltaReotorgarPermiso)
        {
            <div class="parte parte--neutro">
                <p>
                    @((MarkupString)texto.Con("arranque.permisoCaduco",
                        ("carpeta", "<strong>&laquo;" + estado.NombreDeLaCarpeta + "&raquo;</strong>")))
                </p>
                <div class="fila">
                    <button class="tecla tecla--alerta" @onclick="PedirPermiso">
                        @texto.Con("arranque.darPermiso", ("carpeta", "«" + estado.NombreDeLaCarpeta + "»"))
                    </button>
                    <button class="tecla tecla--contorno" @onclick="ConectarCarpeta"
                            disabled="@(soportado == false)">
                        @texto["arranque.elegirOtraCarpeta"]
                    </button>
                </div>
            </div>
        }
        else
        {
            @* LA PRIMERA VUELTA DE LLAVE, y no un diálogo de configuración.

               Acá había tres tarjetas del mismo tamaño y el mismo peso, así que las tres se
               leían como igual de válidas. No lo son: una es la recomendada y las otras dos
               son salidas de emergencia. Ahora hay UNA acción primaria y el resto se pliega.

               Y el diferenciador que de verdad decide —«¿tu asistente la puede leer?»— era
               una frase en negrita adentro de un párrafo. Es una comparación, así que se
               muestra como una: tres filas que se leen de un vistazo y donde la respuesta
               correcta se ve sola, sin que la pantalla tenga que insistir.

               LO QUE NO CAMBIA: cada modo sigue diciendo lo que NO da. Eso no es adorno. *@
            <div class="arranque">
                <p class="arranque-promesa">@((MarkupString)texto["arranque.promesa"])</p>

                @if (sinAlmacenamiento == "inseguro")
                {
                    <p class="parte parte--atencion">@((MarkupString)texto["arranque.sinHttps"])</p>
                }
                else if (sinAlmacenamiento == "navegador")
                {
                    <p class="parte parte--atencion">@((MarkupString)texto[instalada
                        ? "arranque.sinAlmacenamientoInstalada" : "arranque.sinAlmacenamiento"])</p>
                }

                @* LA ÚNICA ACCIÓN PRIMARIA, y cuál es depende de qué se puede: si la carpeta
                   no está disponible, la recomendada pasa a ser el navegador. La pantalla no
                   puede empujar hacia una puerta cerrada. *@
                @if (soportado == true)
                {
                    <button class="tecla tecla--grande" @onclick="ConectarCarpeta">@texto["arranque.elegirCarpeta"]</button>
                    <p class="arranque-porque">@((MarkupString)texto["arranque.porqueCarpeta"])</p>
                }
                else if (opfs == true)
                {
                    <button class="tecla tecla--grande" @onclick="UsarNavegador">
                        @texto[instalada ? "arranque.guardarEnLaApp" : "arranque.guardarEnElNavegador"]
                    </button>
                    <p class="arranque-porque">@((MarkupString)texto[instalada
                        ? "arranque.porqueLaApp" : "arranque.porqueElNavegador"])</p>
                }

                @* LA COMPARACIÓN. Tres filas, y la de abajo es la que decide. *@
                <table class="comparacion">
                    <thead>
                        <tr>
                            <th scope="col"><span class="solo-para-lectores">@texto["arranque.queDaCadaModo"]</span></th>
                            <th scope="col">@texto["arranque.unaCarpetaTuya"]</th>
                            <th scope="col">@texto[instalada ? "arranque.dentroDeLaApp" : "arranque.esteNavegador"]</th>
                            <th scope="col">@texto["arranque.sinGuardar"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">@texto["arranque.sobreviveAlCerrar"]</th>
                            <td class="si">@texto["comun.si"]</td><td class="si">@texto["comun.si"]</td><td class="no">@texto["comun.no"]</td>
                        </tr>
                        <tr>
                            <th scope="row">@texto["arranque.esUnaCarpetaTuya"]</th>
                            <td class="si">@texto["comun.si"]</td><td class="no">@texto["comun.no"]</td><td class="no">@texto["comun.no"]</td>
                        </tr>
                        <tr>
                            <th scope="row">@texto["arranque.tuAsistenteLaPuedeLeer"]</th>
                            <td class="si">@texto["comun.si"]</td><td class="no">@texto["comun.no"]</td><td class="no">@texto["comun.no"]</td>
                        </tr>
                    </tbody>
                </table>

                @if (soportado != true)
                {
                    <p class="arranque-nota">
                        @texto[sinAlmacenamiento == "inseguro"
                            ? "arranque.notaSinHttps"
                            : instalada ? "arranque.notaInstalada" : "arranque.notaNavegador"]
                    </p>
                }

                @* Las salidas de emergencia, plegadas: siguen a un toque, pero dejan de
                   competir con la recomendada.

                   SALVO CUANDO NO HAY RECOMENDADA. Sin carpeta ni OPFS -un browser embebido,
                   un WebView- la pantalla quedaba con la tabla de comparación y ni una sola
                   tecla a la vista: todo lo que se podía hacer estaba plegado acá. Cuando
                   estas son las únicas puertas, van abiertas y con su nombre. *@
                <details class="otras" open="@sinRecomendada">
                    <summary>@texto[sinRecomendada ? "arranque.comoEmpezarAca" : "arranque.otrasFormas"]</summary>

                    @if (soportado == true && opfs == true)
                    {
                        <div class="otra">
                            <button class="tecla tecla--contorno" @onclick="UsarNavegador">
                                @texto[instalada ? "arranque.guardarEnLaApp" : "arranque.guardarEnElNavegador"]
                            </button>
                            <p>@((MarkupString)texto[instalada
                               ? "arranque.otraLaApp" : "arranque.otraElNavegador"])</p>
                        </div>
                    }

                    <div class="otra">
                        <button class="tecla tecla--contorno" @onclick="Importar">@texto["arranque.importar"]</button>
                        <p>@texto["arranque.porqueImportar"]</p>
                    </div>

                    <div class="otra">
                        <button class="@(sinRecomendada ? "tecla tecla--contorno" : "tecla tecla--texto")"
                                @onclick="Arrancar">@texto["arranque.sinGuardarNada"]</button>
                        <p>@((MarkupString)texto["arranque.porqueSinGuardar"])</p>
                    </div>
                </details>
            </div>
        }
    }
    else
    {
        @* Si la app no está guardando, eso es lo MÁS importante de la pantalla y va antes que
           los instrumentos: sin destino se ve completa y correcta, y no hay forma de notar
           que no persiste salvo que se diga.

           PERO HOSPEDADA SÍ ESTÁ GUARDANDO: `HayCarpeta` es el handle del modo suelto, y
           hospedada no hay ninguno porque el destino es la carpeta que Gnothi le dio en el
           teléfono. Sin esta condición el cartel dice «no se está guardando nada» y «tus
           kilometrajes se pierden» justo cuando es más falso. Es la misma guarda que
           MisCompras.razor. *@
        @if (!estado.Hospedada && !estado.HayCarpeta)
        {
            <div class="parte parte--atencion fila">
                <div class="crece">@((MarkupString)texto["aviso.sinGuardar"])</div>
                @if (soportado == true)
                {
                    <button class="tecla tecla--alerta" @onclick="ConectarCarpeta">@texto["arranque.elegirCarpetaCorto"]</button>
                }
                else if (opfs == true)
                {
                    <button class="tecla tecla--alerta" @onclick="UsarNavegador">@texto["arranque.guardarEnElNavegador"]</button>
                }
            </div>
        }
        else if (estado.GuardadoFallando.Length > 0)
        {
            <div class="parte parte--problema fila">
                <div class="crece">
                    @((MarkupString)texto.Con("aviso.carpetaRechazo",
                        ("carpeta", "&laquo;" + estado.NombreDeLaCarpeta + "&raquo;")))
                    <div class="apunte mono">@estado.GuardadoFallando</div>
                </div>
                <button class="tecla tecla--problema" @onclick="PedirPermiso">@texto["arranque.volverADarPermiso"]</button>
            </div>
        }
        else if (estado.ProblemaAlPonerseAlDia.Length > 0)
        {
            @* EL REFRESH QUE NO LLEGÓ. Va después de las alarmas y no antes: no guardar es
               una alarma; no haberse podido poner al día es atención. Antes esto no se veía
               en ninguna parte, y una estación caída se leía igual que una sin novedades. *@
            <div class="parte parte--atencion fila">
                <div class="crece">
                    @((MarkupString)texto["aviso.noSePudoPonerAlDia"])
                    <div class="apunte mono">@estado.ProblemaAlPonerseAlDia</div>
                </div>
                @* También la apaga migrada: este cartel puede quedar de un refresh fallido de
                   ANTES de la migración, y ofrecer un reintento que no va a hacer nada. *@
                <button class="tecla tecla--contorno" @onclick="Refrescar"
                        disabled="@(estado.Refrescando || estado.Migrada)">
                    @texto["comun.volverAIntentar"]
                </button>
            </div>
        }

        @* MIGRADA: el proveedor marcó que los hechos nuevos de esta cuenta ya entran por Gnothi
           (especificación 13 §4 y §6.2). El registro NO se mudó: sigue en el teléfono de la
           persona y es de ella (§10.6). «Desaparecer» NO es desinstalar y NO es borrar: la app
           sigue mostrando lo que tiene, porque es de ella. Lo que deja de hacer es SINCRONIZAR,
           que es lo único que produciría dos historias que divergen.

           VA EN LA CÁSCARA Y NO EN UNA PESTAÑA, al contrario que el aviso neutro de acá abajo:
           no es un dato informativo sino un cambio en lo que la app VA A HACER de ahora en más,
           vale para las cuatro pestañas, y es lo que explica que la tecla de Actualizar diga «Ya
           no se actualiza» — que también vive en esta cáscara. Estaba en MisCargas.razor, que
           master partió en cuatro pantallas, y por eso hubo que re-expresarlo y no fusionarlo.

           Y NO ES UNA ALARMA: va después de "no se está guardando nada" y del refresh que no
           llegó, porque nada está roto. Es el orden que pide el comentario de abajo. *@
        @if (estado.Migrada)
        {
            <div class="parte parte--atencion fila">
                <div class="crece">@((MarkupString)texto.Con("aviso.migrada",
                    ("host", estado.DondeVive)))</div>
            </div>
        }

        @* El aviso NEUTRO -"se esta guardando en este navegador"- ya no vive aca: vive en
           Mi carro, junto a "donde vive tu bitacora". La razon es de orden. En la cascara
           quedaba ARRIBA DE LA FRANJA, o sea que un dato informativo se leia antes que el
           veredicto del dominio, que es lo primero que alguien abre esta app para saber.
           Los dos de arriba SI se quedan: no se esta guardando nada y la carpeta rechazo
           la escritura son alarmas, y una alarma sí va antes que todo. *@

        @* LO QUE TRAJO ACTUALIZAR. Antes la tecla volvía a decir «Actualizar» y nada más: una
           estación sin novedades y una tecla que no hizo nada se veían iguales, y la persona
           apretaba de nuevo. Solo el refresh de la tecla, no el del arranque: al abrir, lo
           que se ve ES la respuesta. *@
        @if (listo.Texto.Length > 0)
        {
            <div class="parte parte--listo parte--pasajero" role="status">@listo.Texto</div>
        }

        @Body

    }
</main>

@code {
    private bool? soportado;
    private bool? opfs;
    private string sinAlmacenamiento = "";
    private bool instalada;
    private Fallo error = Fallo.Ninguno;

    // LO QUE SABEMOS DEL ARRANQUE, y son tres cosas y no dos: hasta que IndexedDB contesta
    // no sabemos si hay un modo recordado. `resolviendo` es ese rato; `abriendo` dice qué
    // se está reenganchando, para que el texto lo nombre.
    private bool resolviendo = true;
    private string abriendo = "";

    // Ni carpeta ni OPFS: no hay tecla grande que recomendar, y lo plegado es lo unico.
    private bool sinRecomendada => soportado != true && opfs != true;

    private IReadOnlyList<VehiculoEnLista> vehiculos = new List<VehiculoEnLista>();

    // LO QUE VIAJA HASTA LA PESTAÑA DE LA RUTA, y es lo unico que la cascara sabe del
    // carro: la ausencia que bloquea un calculo tiene que verse desde cualquier pantalla,
    // no solo desde la que la muestra.
    //
    // ES LA CUENTA DE FALTANTES Y NO LA DE TRAMOS BLOQUEADOS. Medido: con 7 kilometrajes
    // esperando, los tramos bloqueados eran CERO y el badge no aparecia. Tiene sentido —
    // sin kilometraje el tramo ni se forma, asi que no hay nada que bloquear— pero es
    // exactamente el caso en que mas hace falta avisar. Un badge cuenta lo que espera algo
    // de la persona, y eso es Faltantes.
    private int pendientes;

    // La placa que se esta mirando. La cascara la necesita para el selector y para saber
    // de que carro cuenta los pendientes del badge.
    private string enFoco = "";

    protected override async Task OnInitializedAsync()
    {
        estado.Cambio += CuandoElEstadoCambia;

        if (estado.EstaArriba) { resolviendo = false; Releer(); return; }

        // HOSPEDADA ARRANCA SOLA, y no pasa por nada de lo de abajo: el destino ya lo puso
        // Gnothi, no hay carpeta que elegir, modo que recordar ni permiso que revalidar. Todo
        // eso es vocabulario del modo suelto.
        //
        // ESTO VIVIA EN MisCargas.razor, que master partio en cuatro pantallas y le mudo el
        // arranque al layout. Sin esta linea el modulo instala y corre, pero se queda en el
        // elegidor de almacenamiento —que hospedada no tiene sentido— y el actor nunca arranca:
        // la comprobacion del Host contesta el rechazo `app-no-arranco` y toda tool falla.
        // Medido en el emulador el 2026-09-08.
        //
        // CON SU PROPIO try/finally y no con un `return` pelado: `resolviendo` arranca en true
        // y quien lo apaga es el finally de abajo, que este atajo se saltea. Sin esto, un
        // Arrancar que falle deja «Abriendo…» para siempre — la misma advertencia que ese
        // finally ya tiene escrita.
        if (estado.Hospedada)
        {
            try { await estado.Arrancar(); }
            catch (Exception ex) { error = Fallo.Detalle("abrir la app", ex); }
            finally { resolviendo = false; StateHasChanged(); }
            return;
        }

        try
        {
            // EL MODO RECORDADO VA PRIMERO, porque es lo unico que decide que pantalla va.
            // La app ya guardaba cual eligio la persona la vez pasada y ninguna pantalla lo
            // consumia: al recargar, quien habia elegido "este navegador" volvia a la
            // pantalla de elegir destino como si fuera la primera vez.
            string recordado = await estado.ModoRecordado();
            abriendo = recordado is "opfs" or "carpeta" ? recordado : "";
            StateHasChanged();

            soportado = await estado.EstaSoportado();
            opfs = await estado.OpfsSoportado();
            sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
            instalada = await estado.EstaInstalada();

            // La carpeta necesita revalidar el permiso -sin gesto solo se recupera el
            // handle-, pero OPFS no necesita nada: si eligio eso, se reengancha sola.
            if (abriendo == "opfs" && opfs == true)
            {
                if ((await estado.UsarAlmacenamientoDelNavegador()).Ok) { await estado.Arrancar(); return; }
            }

            if (soportado != true) return;

            // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI. Se
            // intenta tambien sin modo recordado: una instalacion anterior a que se
            // guardara el modo tiene handle y no tiene modo, y no hay que mandarla al
            // elegidor por eso.
            ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();
            StateHasChanged();
            if (recuperada.Ok) await estado.Arrancar();
        }
        catch (Exception ex)
        {
            // Recuperar lo recordado fallo -carpeta movida, MEMFS ilegible-. Se dice arriba
            // y se cae al elegidor: es el caso "no se pudo", no un cartel de espera eterno.
            error = Fallo.Detalle("abrir la app", ex);
        }
        finally
        {
            // PASE LO QUE PASE se deja de esperar. Si esto quedara dentro del try, un fallo
            // al abrir dejaria «Abriendo…» para siempre: es la misma advertencia que dejo
            // escrita Compras en su propio layout.
            resolviendo = false;
            abriendo = "";
            StateHasChanged();
        }
    }

    // El texto nombra lo que se esta reenganchando. «Abriendo…» pelado es lo que se ve el
    // instante antes de saber si habia algo recordado.
    private string TextoDeAbriendo() => abriendo switch
    {
        "opfs"    => texto["arranque.abriendoNavegador"],
        "carpeta" => estado.NombreDeLaCarpeta.Length > 0
                         ? texto.Con("arranque.abriendoCarpetaConNombre",
                             ("carpeta", estado.NombreDeLaCarpeta))
                         : texto["arranque.abriendoCarpeta"],
        _         => texto["arranque.abriendo"],
    };

    private void CuandoElEstadoCambia()
    {
        Releer();
        StateHasChanged();
    }

    // La cascara lee poquito: quien es el carro y cuanto falta. Todo lo demas es de las
    // paginas, y sale de consultar al actor igual que acá.
    private void Releer()
    {
        if (!estado.EstaArriba) return;

        vehiculos = estado.Vehiculos();
        enFoco = estado.PlacaEnFoco(vehiculos);
        pendientes = enFoco.Length == 0 ? 0 : estado.Faltantes(enFoco).Count;
    }

    private Task CambiarDeCarro(ChangeEventArgs e) => Intentar("cambiar-de-carro", async () =>
    {
        string placa = e.Value?.ToString() ?? "";
        if (placa.Length > 0) await estado.ElegirVehiculo(placa);
    });

    private Task ConectarCarpeta() => Intentar("elegir-carpeta", async () =>
    {
        if ((await estado.ConectarCarpeta()).Ok) await estado.Arrancar();
    });

    private Task PedirPermiso() => Intentar("dar-permiso-a-la-carpeta", async () =>
    {
        if ((await estado.PedirPermiso()).Ok) await estado.Arrancar();
    });

    private Task UsarNavegador() => Intentar("guardar-en-este-navegador", async () =>
    {
        if ((await estado.UsarAlmacenamientoDelNavegador()).Ok) await estado.Arrancar();
    });

    private Task Importar() => Intentar("importar-una-bitacora", async () =>
    {
        string motivo = await estado.Importar();
        if (motivo.Length > 0) throw new RechazoDeLaApp(motivo);
    });

    private Task Arrancar() => Intentar("abrir-la-app", () => estado.Arrancar().AsTask());

    // El "Actualizando…" de la tecla ya no se lleva aca: lo dice EstadoDeLaApp, que es el
    // unico que sabe cuando empieza y termina un refresh, incluido el del arranque.
    private readonly AvisoDeListo listo = new();

    private Task Refrescar() => Intentar("refrescar-contra-la-estacion", async () =>
    {
        ResultadoDeRefresh resultado = await estado.Refrescar();
        listo.Mostrar(resultado.Aplicados == 0
            ? texto["aviso.sinNovedades"]
            : texto.Con(resultado.Aplicados == 1 ? "aviso.unaNovedad" : "aviso.novedades",
                ("cuantas", resultado.Aplicados.ToString())),
            () => InvokeAsync(StateHasChanged));
    });

    // El mismo Intentar de las pantallas, y por la misma razon: el StateHasChanged del
    // finally. Casi todo lo que decide esta cascara vive en EstadoDeLaApp, y Blazor no
    // observa servicios inyectados; sin esto, "hay que apretar dos veces". No se hereda de
    // PantallaDeCargas porque un layout tiene que heredar de LayoutComponentBase.
    private async Task Intentar(string claveDelPaso, Func<Task> accion)
    {
        error = Fallo.Ninguno;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            error = Fallo.Detalle(claveDelPaso, ex);
        }
        finally
        {
            StateHasChanged();
        }
    }

    public void Dispose() => estado.Cambio -= CuandoElEstadoCambia;
}
