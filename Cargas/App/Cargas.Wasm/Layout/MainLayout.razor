@inherits LayoutComponentBase

@* Sin sidebar, sin navegacion, sin barra "About" del template. Un tablero no tiene
   secciones a las que ir: todo lo que la app sabe cabe en una pantalla -los
   instrumentos arriba, la ruta abajo-, y lo unico que se toca es la tecla de
   actualizar y los campos de la ruta. Una app que le entregas a una persona para ver
   SUS datos no tiene por que traer el andamio del framework con el que se hizo. *@
<main class="tablero">
    @Body
</main>
