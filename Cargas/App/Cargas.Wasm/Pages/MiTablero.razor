@page "/"
@using System.Globalization
@using Cargas.App.Vistas
@using Puppets.Portador
@inject EstadoDeLaApp estado

<PageTitle>Mi tablero · Estaciones Faro</PageTitle>

@* El h1 existe para los lectores de pantalla y para el FocusOnNavigate del router. No
   se dibuja: en un tablero el título es la marca del capó, y un titular grande arriba
   le comería el alto a los instrumentos. *@
<h1 class="solo-para-lectores">Mi tablero de cargas</h1>

@* EL CAPÓ. ⚠️ MARCA PROVISIONAL: el nombre y la paleta esperan la especificación de
   Geaninna; lo que no espera es la estructura. El faro va de un solo trazo -torre y
   haz-, nunca relleno, legible a 24 px. *@
<div class="capo">
    <div class="marca">
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"
             fill="none" stroke="var(--logo)" stroke-width="2.4" aria-hidden="true">
            <path d="M16 34 L18 12 h4 L24 34 z" />
            <path d="M15 12 h10 M17 7 h6 M18 12 V7 M22 12 V7" />
            <path d="M26 8 l6 -2.5 M26 11 l7 0" />
        </svg>
        <div>
            <div class="marca-nombre">Estaciones Faro</div>
            <div class="marca-claim">Tu camino, claro</div>
        </div>
    </div>

    @if (estado.EstaArriba && vehiculos.Count > 0)
    {
        <span class="placa">
            @vehiculos[0].Placa
            @if (vehiculos[0].TieneFicha)
            {
                <span class="apodo">@vehiculos[0].Nombre</span>
            }
        </span>
    }

    @if (estado.EstaArriba)
    {
        <button class="tecla tecla--releer" @onclick="Refrescar" disabled="@refrescando">
            @(refrescando ? "Actualizando…" : "Actualizar")
        </button>
    }
</div>

@* UN solo lugar para los errores, y arriba: un fallo abajo queda fuera de pantalla y la
   app parece no reaccionar al click. *@
@if (error.Length > 0)
{
    <div class="parte parte--problema">
        <strong>@(estado.EstaArriba ? "No se pudo completar la operación." : "No se pudo abrir la app.")</strong>
        <pre>@error</pre>
    </div>
}

@if (!estado.EstaArriba)
{
    <div class="parte parte--neutro">
        @* Cuando el handle volvió de IndexedDB pero el permiso caducó, la acción correcta
           es RE-OTORGAR, no volver a elegir la carpeta. *@
        @if (estado.FaltaReotorgarPermiso)
        {
            <p>
                Tu carpeta es <strong>&laquo;@estado.NombreDeLaCarpeta&raquo;</strong>. El browser pide
                confirmar el permiso de escritura cada vez que volvés a abrir la app.
            </p>
            <div class="fila">
                <button class="tecla tecla--alerta" @onclick="PedirPermiso">
                    Dar permiso a &laquo;@estado.NombreDeLaCarpeta&raquo;
                </button>
                <button class="tecla tecla--contorno" @onclick="ConectarCarpeta"
                        disabled="@(soportado == false)">
                    Elegir carpeta
                </button>
            </div>
        }
        else
        {
            <p>Esta app guarda <strong>tus</strong> cargas. Elegí dónde.</p>

            @if (sinAlmacenamiento == "inseguro")
            {
                <p>
                    <strong>Esta página no está en una conexión segura</strong>, y por eso el
                    navegador no le deja guardar nada — en cualquier navegador pasaría lo mismo.
                    Entrá por <strong>https</strong> y las opciones de guardado aparecen.
                </p>
            }
            else if (sinAlmacenamiento == "navegador")
            {
                <p>
                    <strong>@(instalada ? "Acá no se puede guardar la bitácora." : "Este navegador no puede guardar la bitácora.")</strong>
                    Podés usar la app igual, pero lo que veas se pierde al cerrar. Para que
                    quede guardado, @(instalada ? "instalala" : "abrila") desde
                    <strong>Chrome</strong> o <strong>Edge</strong>.
                </p>
            }

            @* TRES MODOS, y los tres se dicen con lo que dan y lo que no. En 'opfs' la
               bitácora sobrevive al cierre pero NO la puede leer su asistente, y callarlo
               sería vender algo que no hay. *@
            <div class="destinos">
                <div class="destino @(soportado == true ? "" : "destino--nodisponible")">
                    <div class="destino-titulo">Una carpeta tuya</div>
                    <p>La bitácora queda en la carpeta que elijas, en tu disco.
                       <b>Es el único modo en el que tu asistente la puede leer.</b></p>
                    @if (soportado == true)
                    {
                        <button class="tecla" @onclick="ConectarCarpeta">Elegir carpeta</button>
                    }
                    else
                    {
                        <p class="destino-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "Hace falta una conexión segura (https)."
                                : instalada
                                    ? "Acá no está disponible. Para usarlo, instalá la app desde Chrome o Edge."
                                    : "Este navegador no lo permite. Para usarlo, abrí la app en Chrome o Edge.")
                        </p>
                    }
                </div>

                <div class="destino @(opfs == true ? "" : "destino--nodisponible")">
                    <div class="destino-titulo">@(instalada ? "Dentro de la app" : "En este navegador")</div>
                    <p>Se guarda igual y sobrevive al cerrar, pero
                       @(instalada ? "queda dentro de la app" : "lo administra el navegador"):
                       <b>no es una carpeta tuya y tu asistente no lo puede leer.</b></p>
                    @if (opfs == true)
                    {
                        <button class="tecla tecla--contorno" @onclick="UsarNavegador">Guardar acá</button>
                    }
                    else
                    {
                        <p class="destino-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "También hace falta una conexión segura (https)."
                                : "Acá tampoco está disponible.")
                        </p>
                    }
                </div>

                <div class="destino">
                    <div class="destino-titulo">Un archivo</div>
                    <p>Traé una bitácora que exportaste antes, desde esta u otra computadora.
                       Funciona en cualquier navegador.</p>
                    <button class="tecla tecla--contorno" @onclick="Importar">Importar</button>
                </div>
            </div>

            <p><button class="tecla tecla--texto" @onclick="Arrancar">Abrir sin guardar nada</button></p>
        }
    </div>
}
else
{
    @* LA FRANJA. Lo primero de la pantalla es la frase del DOMINIO -«venías rindiendo
       12.6 y el último tramo dio 9.4»-, armada con los hechos de ella y nunca un consejo
       de plantilla que esta pantalla no tiene de dónde sacar. El color de la luz lo
       decide la severidad del dominio; acá solo se pinta.

       EL @key VA EN EL CUERPO Y NO EN LA FRANJA: sube en cada Releer y obliga a Blazor a
       recrear los nodos -sin él, Actualizar parecía no hacer nada-, pero si el bloque
       entero se recrea, el foco del botón recién apretado se pierde. *@
    <div class="franja @Tono()">
        <span class="franja-luz"></span>
        <div class="franja-texto" @key="@($"franja-{redibujo}")">
            @if (rendimiento.ParaSonia.Length > 0)
            {
                <p class="franja-frase">@Mayuscula(rendimiento.ParaSonia).</p>
                @if (rendimiento.PideAlgo && rendimiento.Accion.Length > 0)
                {
                    <p class="franja-accion">@Mayuscula(rendimiento.Accion).</p>
                }
            }
            else
            {
                <p class="franja-frase">Todavía no hay cargas. Apretá <em>Actualizar</em>.</p>
            }
        </div>
    </div>

    @* Si la app no está guardando, eso es lo MÁS importante de la pantalla y va antes que
       los instrumentos: sin destino se ve completa y correcta, y no hay forma de notar
       que no persiste salvo que se diga. *@
    @if (!estado.HayCarpeta)
    {
        <div class="parte parte--atencion fila">
            <div class="crece">
                <strong>No se está guardando nada.</strong>
                Esta app está funcionando sin destino: lo que la estación publicó se vuelve a
                pedir al abrir, pero <strong>tus kilometrajes y confirmaciones se pierden</strong>
                — esos no los sabe nadie más que vos.
            </div>
            @if (soportado == true)
            {
                <button class="tecla tecla--alerta" @onclick="ConectarCarpeta">Elegir carpeta</button>
            }
            else if (opfs == true)
            {
                <button class="tecla tecla--alerta" @onclick="UsarNavegador">Guardar en este navegador</button>
            }
        </div>
    }
    else if (estado.GuardadoFallando.Length > 0)
    {
        <div class="parte parte--problema fila">
            <div class="crece">
                <strong>La carpeta rechazó la escritura.</strong>
                Lo que ves en pantalla no está guardado en &laquo;@estado.NombreDeLaCarpeta&raquo;.
                Suele ser el permiso, que caduca al reabrir.
                <div class="apunte mono">@estado.GuardadoFallando</div>
            </div>
            <button class="tecla tecla--problema" @onclick="PedirPermiso">Volver a dar permiso</button>
        </div>
    }
    else if (estado.EnAlmacenamientoDelNavegador)
    {
        <div class="parte parte--neutro">
            <strong>@(instalada ? "Se está guardando dentro de la app" : "Se está guardando en este navegador")</strong>,
            así que tu bitácora sobrevive al cerrar. Pero tu asistente
            <strong>no la puede leer</strong>: para eso hace falta una carpeta tuya, y
            @(instalada ? "acá" : "este navegador") no las permite.
            <button class="tecla tecla--texto" @onclick="Exportar">Exportar a un archivo</button>
        </div>
    }

    @* ------------------------------------------------------------- EL CUADRO

       Los instrumentos, en el orden en que se preguntan: cuánto me queda, cómo viene
       rindiendo, cuándo tengo que cargar, cuánto me cuesta andar. *@
    <div class="cuadro" @key="@($"cuadro-{redibujo}")">

        <div class="instrumento instrumento--medidor">
            <span class="rotulo">Autonomía</span>
            @if (autonomia.Hay)
            {
                <MedidorDeAutonomia Fraccion="proxima.FraccionRestante"
                                    Descripcion="@DescripcionDelMedidor()" />
                <div class="cifra">
                    ~@Entero(proxima.Hay ? proxima.KilometrosRestantes : autonomia.Kilometros)<span class="unidad">km</span>
                </div>
                <div class="cifra-pie">
                    @if (proxima.Hay)
                    {
                        <text>lo que queda, estimado &middot; con el tanque lleno son
                        <b>~@Entero(autonomia.Kilometros) km</b></text>
                    }
                    else
                    {
                        <text>con el tanque lleno &middot; @Cifra(autonomia.CapacidadEnLitros) L
                        a <b>@Cifra(autonomia.HabitualKmPorLitro) km/L</b></text>
                    }
                </div>
            }
            else
            {
                <div class="cifra">—</div>
                <div class="cifra-pie">
                    Hace falta un tramo cerrado entre dos tanques llenos para saber cuánto
                    rinde, y de ahí sale la autonomía.
                </div>
            }
        </div>

        <div class="instrumento instrumento--ancho">
            <div class="fila">
                <span class="rotulo crece">Rendimiento</span>
                @if (rendimiento.Veredicto.Length > 0)
                {
                    <span class="sello @Sello()">@rendimiento.Veredicto</span>
                }
            </div>

            @if (rendimiento.Actual > 0)
            {
                <div class="fila">
                    <span class="cifra">@Cifra(rendimiento.Actual)<span class="unidad">km/L</span></span>
                    @if (rendimiento.HaySerie && rendimiento.CambioPorcentual != 0)
                    {
                        @* La flecha y el signo son de la PRESENTACIÓN: en km/L más es
                           mejor, en L/100km menos, y esa inversión no toca el veredicto.
                           Por eso la clase la decide EstaMejorando y no el signo. *@
                        <span class="delta @(rendimiento.EstaMejorando ? "delta--mejor"
                            : rendimiento.EstaEmpeorando ? "delta--peor" : "delta--igual")">
                            @(rendimiento.EstaMejorando ? "▲" : rendimiento.EstaEmpeorando ? "▼" : "=")
                            @Math.Abs(rendimiento.CambioPorcentual)%
                        </span>
                    }
                </div>

                @if (rendimiento.TramosCalculados > 0)
                {
                    <ChispaDeTramos Tramos="tramos" Habitual="rendimiento.Habitual"
                                    PideAlgo="rendimiento.PideAlgo"
                                    Descripcion="@rendimiento.ParaSonia" />
                }

                <div class="cifra-pie">
                    @if (rendimiento.Habitual > 0)
                    {
                        <text>tu nivel de siempre: <b>@Cifra(rendimiento.Habitual) km/L</b> &middot; </text>
                    }
                    sobre @rendimiento.TramosCalculados @(rendimiento.TramosCalculados == 1 ? "tramo" : "tramos")
                    entre tanques llenos@(rendimiento.TramosBloqueados > 0
                        ? $", {rendimiento.TramosBloqueados} sin calcular" : "")
                </div>
            }
            else
            {
                <div class="cifra">—</div>
                <div class="cifra-pie">
                    @(rendimiento.QueFalta.Length > 0
                        ? Mayuscula(rendimiento.QueFalta) + "."
                        : "Todavía no hay un tramo cerrado entre dos tanques llenos.")
                </div>
            }
        </div>

        <div class="instrumento @(proxima.Hay ? "" : "instrumento--apagado")">
            <span class="rotulo">Próxima carga</span>
            @if (proxima.Hay)
            {
                <div class="cifra cifra--chica">
                    en ~@proxima.DiasEstimados<span class="unidad">@(proxima.DiasEstimados == 1 ? "día" : "días")</span>
                </div>
                <div class="cifra-pie">
                    estimado &middot; te quedan <b>~@Entero(proxima.KilometrosRestantes) km</b>
                    y andás <b>@Cifra(proxima.KilometrosPorDia) km</b> por día
                </div>
            }
            else
            {
                <div class="cifra cifra--chica">—</div>
                <div class="cifra-pie">Hace falta la autonomía y tu promedio diario.</div>
            }
        </div>

        @* UN INSTRUMENTO POR MONEDA, y no el primero de la lista. El dominio reparte el
           costo por moneda porque sumar colones con dólares no significa nada, y quedarse
           con costos[0] escondía la otra sin decirlo: la pantalla se veía completa y
           correcta, que es la peor forma de perder un dato. *@
        @foreach (CostoEnLista costo in costos)
        {
            <div class="instrumento" @key="@($"costo-{costo.Moneda}-{redibujo}")">
                <span class="rotulo">Costo por kilómetro</span>
                <div class="cifra cifra--chica">
                    @Simbolo(costo.Moneda)@Plata(costo.MontoPorKilometro)<span class="unidad">por km</span>
                </div>
                <div class="cifra-pie">
                    sobre <b>@Entero(costo.Kilometros) km</b> con kilometraje anotado
                </div>
            </div>
        }
        @if (costos.Count == 0)
        {
            <div class="instrumento instrumento--apagado">
                <span class="rotulo">Costo por kilómetro</span>
                <div class="cifra cifra--chica">—</div>
                <div class="cifra-pie">Hace falta kilometraje anotado para repartir el gasto.</div>
            </div>
        }

        <div class="instrumento instrumento--medio @(propuesta.Hay ? "" : "instrumento--apagado")">
            <span class="rotulo">Odómetro</span>
            @if (propuesta.Hay)
            {
                <TiraDeOdometro Kilometros="propuesta.Kilometros"
                                Descripcion="@($"{Entero(propuesta.Kilometros)} kilómetros, estimado para hoy")" />
                <div class="cifra-pie">
                    hoy, estimado &middot; <b>@Cifra(propuesta.KilometrosPorDia) km</b> por día
                    desde tu última lectura, hace
                    <b>@propuesta.DiasDesdeLaUltimaLectura</b> @(propuesta.DiasDesdeLaUltimaLectura == 1 ? "día" : "días")
                </div>
            }
            else
            {
                <TiraDeOdometro Kilometros="0" Descripcion="sin lecturas de odómetro" />
                <div class="cifra-pie">
                    Nadie sabe el kilometraje de tu carro salvo vos. Anotalo en una carga
                    de la ruta y este contador arranca.
                </div>
            }
        </div>

        @* Mismo criterio que el costo: el gasto del período viene repartido por moneda. *@
        @foreach (GastoEnLista gasto in gastos)
        {
            <div class="instrumento instrumento--medio" @key="@($"gasto-{gasto.Moneda}-{redibujo}")">
                <span class="rotulo">Gasto @MesDelGasto()</span>
                <div class="cifra cifra--chica">@Simbolo(gasto.Moneda)@Plata(gasto.Monto)</div>
                <div class="cifra-pie">
                    <b>@gasto.Cargas</b> @(gasto.Cargas == 1 ? "carga" : "cargas") &middot;
                    <b>@Cifra(gasto.Litros) L</b>
                </div>
            </div>
        }
        @if (gastos.Count == 0)
        {
            <div class="instrumento instrumento--medio instrumento--apagado">
                <span class="rotulo">Gasto</span>
                <div class="cifra cifra--chica">—</div>
                <div class="cifra-pie">Todavía no entró ninguna carga.</div>
            </div>
        }
    </div>

    @* EL REFUERZO: al cerrar un tramo se muestra lo que se DESBLOQUEÓ, no una insignia.
       El premio es información sobre su carro. *@
    @if (desbloqueado.Length > 0)
    {
        <div class="parte parte--neutro"><strong>Se desbloqueó:</strong> @desbloqueado</div>
    }

    @* -------------------------------------------------------------- LA RUTA

       El camino de paradas y trechos. El objeto de este negocio es el TRAMO entre dos
       tanques llenos, así que la pantalla lo dibuja como lo que es, y el HUECO que lo
       bloquea es parte del camino: bache con riel punteado y el dato que lo destraba ahí
       mismo, no en una sección aparte al final. *@
    <div class="ruta-cabeza">
        <span class="rotulo">La ruta</span>
        @if (completitud.TotalDeCargas > 0)
        {
            <span class="apunte">@completitud.Expresada</span>
        }
        <span class="apunte mono">leído hasta el evento @ultimoEvento</span>
    </div>

    @if (cargas.Count == 0)
    {
        <p class="apunte">Todavía no hay cargas. Apretá <em>Actualizar</em>.</p>
    }
    else
    {
        <ol class="ruta">
            @{
                List<CargaEnLista> camino = Recientes();
            }
            @for (int i = 0; i < camino.Count; i++)
            {
                CargaEnLista parada = camino[i];
                List<FaltanteEnLista> pendientes = FaltantesDe(parada.Transaccion);

                <li class="eslabon parada @(pendientes.Count > 0 ? "parada--pendiente" : "")"
                    @key="@($"parada-{parada.Transaccion}-{redibujo}")">
                    <div class="eslabon-riel"><span class="parada-punto"></span></div>
                    <div class="eslabon-cuerpo">
                        <div class="parada-cabeza">
                            <span class="parada-fecha">@parada.Fecha.ToString("dd MMM yyyy", Cultura)</span>
                            @if (parada.Tanque.Length > 0)
                            {
                                <span class="parada-tanque">tanque @parada.Tanque</span>
                            }
                        </div>

                        <div class="parada-datos">
                            <span><span class="n">@parada.Volumen</span> de @parada.Tipo</span>
                            <span>surtidor @parada.Surtidor</span>
                            <span class="n">@Simbolo(parada.Moneda)@Plata(parada.Total)</span>
                            <span class="n">@Simbolo(parada.Moneda)@Plata(parada.Precio)/L</span>
                            @if (parada.TieneKilometraje)
                            {
                                <span class="n">@parada.Kilometraje</span>
                            }
                        </div>

                        @* LA FOTO DEL TABLERO, nivel 1: el input NO otorga cámara -el
                           selector es del sistema y en móvil ya ofrece «tomar foto»-, así
                           que el sandbox del FAQ #5 queda intacto. El archivo va a la
                           carpeta; el journal guarda el nombre. *@
                        <div class="parada-datos">
                            @if (parada.TieneFoto)
                            {
                                <span>📷 foto guardada</span>
                            }
                            else if (estado.HayCarpeta)
                            {
                                <label class="tecla tecla--texto" style="cursor:pointer">
                                    📷 foto del tablero
                                    <InputFile OnChange="e => GuardarFoto(parada.Transaccion, e)"
                                               accept="image/*" style="display:none" />
                                </label>
                            }
                        </div>

                        @* LO QUE FALTA, en la carga que lo debe. El kilometraje llega
                           PRELLENADO con la proyección -«¿unos 42 900?»- para que
                           confirmar sea más fácil que recordar y teclear: si ella lo
                           acepta tal cual entra confirmado, si lo edita, observado. Nunca
                           se escribe solo.

                           UN CAMPO POR CARGA, y no uno compartido. Con un solo campo para
                           toda la lista, los nueve formularios mostraban el mismo número y
                           el que se tecleaba para una carga aparecía en las otras ocho: es
                           la invitación a apretar «Agregar» en la fila equivocada. *@
                        @foreach (FaltanteEnLista pendiente in pendientes)
                        {
                            <div class="falta" @key="@($"falta-{pendiente.Transaccion}-{pendiente.QueFalta}-{redibujo}")">
                                @if (pendiente.QueFalta == "el kilometraje")
                                {
                                    <div class="fila">
                                        <input class="campo" type="number" inputmode="numeric"
                                               aria-label="Kilometraje de esta carga"
                                               value="@Kilometraje(pendiente.Transaccion)"
                                               @onchange="e => AnotarEnElCampo(pendiente.Transaccion, e)" />
                                        <button class="tecla tecla--alerta"
                                                @onclick="() => AgregarKilometraje(pendiente.Transaccion)">
                                            Agregar kilometraje
                                        </button>
                                        @* La sugerencia SOLO donde se puede proyectar: la
                                           carga más reciente que espera kilometraje. Ver
                                           Releer(). Ponerla en todas sería sugerir el
                                           kilometraje de hoy para una carga de hace ocho
                                           meses. *@
                                        @if (propuesta.Hay && pendiente.Transaccion == transaccionConPropuesta)
                                        {
                                            <span class="apunte crece">¿unos @Entero(propuesta.Kilometros) km?
                                                Es lo que da tu promedio de @Cifra(propuesta.KilometrosPorDia) km por día.</span>
                                        }
                                    </div>
                                }
                                else if (pendiente.QueFalta == "la confirmación del tanque")
                                {
                                    <p class="apunte">@Mayuscula(pendiente.ParaSonia).</p>
                                    <div class="fila">
                                        <button class="tecla tecla--alerta"
                                                @onclick="() => ConfirmarTanque(pendiente.Transaccion)">
                                            Sí, quedó así
                                        </button>
                                        <button class="tecla tecla--contorno"
                                                @onclick="() => CorregirTanque(pendiente.Transaccion)">
                                            No, era al revés
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </li>

                @* EL TRECHO QUE ESTA PARADA CIERRA, o el BACHE si está bloqueado. Cuelga
                   de la carga que lo CIERRA y declara desde dónde viene, porque un tramo
                   no siempre une dos paradas vecinas: una carga PARCIAL en el medio no
                   cierra tramo, y el que la salta va de un tanque lleno al siguiente. Con
                   la pareja adyacente no aparecía ninguno.

                   Sin tramo no se dibuja nada: la primera carga de la historia no cierra
                   nada, y una parcial tampoco. Eso no es un hueco, es que ahí no hay
                   tramo que medir. *@
                TramoEnLista? tramo = TramoQueCierraEn(parada.Fecha);
                if (tramo is not null)
                {
                    if (tramo.EstaCalculado)
                    {
                        <li class="eslabon trecho @(tramo.EsComparable ? "" : "trecho--reservado")
                                   @(tramo.EsSospechoso ? "trecho--atencion" : "")"
                            @key="@($"trecho-{tramo.Desde:O}-{redibujo}")">
                            <div class="eslabon-riel"></div>
                            <div class="eslabon-cuerpo">
                                <div class="trecho-cifras">
                                    <span class="trecho-rinde">@Cifra(tramo.Rendimiento)<span class="unidad">km/L</span></span>
                                    <span class="trecho-dato">@Entero(tramo.Kilometros) km</span>
                                    <span class="trecho-dato">@Cifra(tramo.Litros) L</span>
                                    <span>desde el @tramo.Desde.ToString("dd MMM", Cultura)</span>
                                    @if (tramo.EsSospechoso)
                                    {
                                        <span class="sello sello--dudoso">dato sospechoso</span>
                                    }
                                </div>

                                @if (rendimiento.Habitual > 0 && tramo.EsComparable)
                                {
                                    @* La muesca es el nivel de siempre de ESTE carro, nunca
                                       un promedio nacional: un trecho solo no significa
                                       nada, significa contra su propia línea base. *@
                                    <div class="trecho-barra" role="img"
                                         aria-label="@Cifra(tramo.Rendimiento) km/L contra tu nivel de siempre de @Cifra(rendimiento.Habitual) km/L">
                                        <span class="relleno" style="width:@Ancho(tramo.Rendimiento)%"></span>
                                        <span class="muesca" style="left:60%"></span>
                                    </div>
                                }

                                @if (!tramo.EsComparable && tramo.MotivoDeReserva.Length > 0)
                                {
                                    <p class="cifra-pie">@Mayuscula(tramo.MotivoDeReserva).</p>
                                }
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="eslabon bache" @key="@($"bache-{tramo.Desde:O}-{redibujo}")">
                            <div class="eslabon-riel"></div>
                            <div class="eslabon-cuerpo">
                                <div class="bache-caja">
                                    <p class="bache-que">
                                        El tramo desde el @tramo.Desde.ToString("dd MMM", Cultura)
                                        no se puede calcular: falta <b>@tramo.QueFalta</b>.
                                    </p>
                                    <p class="bache-desbloquea">
                                        Con eso aparece cuánto rindió el carro entre estas dos cargas,
                                        y ese tramo entra a tu nivel de siempre.
                                    </p>
                                </div>
                            </div>
                        </li>
                    }
                }
            }
        </ol>
    }

    @* LA LEALTAD, discreta: presente para que se sienta real, no es el foco. *@
    @if (lealtad.Nivel.Length > 0)
    {
        <p class="apunte" style="margin-top:26px">
            Lealtad: <b>@lealtad.Saldo</b> puntos, nivel <b>@lealtad.Nivel</b>@(
                lealtad.PuntosParaElSiguienteNivel > 0
                    ? $" · faltan {lealtad.PuntosParaElSiguienteNivel} para el siguiente"
                    : "").
        </p>
    }

    @if (estado.HayCarpeta && !estado.EnAlmacenamientoDelNavegador && estado.GuardadoFallando.Length == 0)
    {
        <p class="apunte" style="margin-top:10px">
            Se guarda en &laquo;@estado.NombreDeLaCarpeta&raquo; después de cada cambio.
            &middot; <button class="tecla tecla--texto" @onclick="Exportar">Exportar</button>
        </p>
    }
    else if (!estado.HayCarpeta)
    {
        <p class="apunte" style="margin-top:10px">
            <strong>Sin carpeta:</strong> la bitácora vive solo en memoria y se pierde al cerrar.
        </p>
    }
}

@code {
    private bool? soportado;
    private bool? opfs;
    private string sinAlmacenamiento = "";
    private bool instalada;
    private bool refrescando;

    private IReadOnlyList<VehiculoEnLista> vehiculos = new List<VehiculoEnLista>();
    private IReadOnlyList<CargaEnLista> cargas = new List<CargaEnLista>();
    private IReadOnlyList<TramoEnLista> tramos = new List<TramoEnLista>();
    private IReadOnlyList<FaltanteEnLista> faltantes = new List<FaltanteEnLista>();
    private IReadOnlyList<CostoEnLista> costos = new List<CostoEnLista>();
    private RendimientoDelVehiculo rendimiento = new();
    private AutonomiaDelVehiculo autonomia = new();
    private ProximaCargaDelVehiculo proxima = new();
    private CompletitudDelVehiculo completitud = new();
    private OdometroPropuesto propuesta = new();
    private EstadoDeLealtad lealtad = new();
    private IReadOnlyList<GastoEnLista> gastos = new List<GastoEnLista>();
    private DateTime mesDelGasto;
    private long ultimoEvento;
    private string error = "";

    // El prellenado, UNO POR CARGA (llave: el numero de transaccion). Si ella manda la
    // propuesta tal cual, su origen es "confirmado" -miro el numero y dijo que si-; si
    // la edita, "observado".
    private Dictionary<string, decimal> kilometrajePorAnotar = new();

    private decimal Kilometraje(string transaccion) =>
        kilometrajePorAnotar.TryGetValue(transaccion, out decimal km) ? km : 0m;

    // La carga a la que se le propuso la proyeccion, si hay alguna. Vacio si no.
    private string transaccionConPropuesta = "";

    private void AnotarEnElCampo(string transaccion, ChangeEventArgs e)
    {
        kilometrajePorAnotar[transaccion] =
            decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture,
                out decimal km) ? km : 0m;
    }

    // El refuerzo del ingreso: lo que aparecio al cerrar un tramo.
    private string desbloqueado = "";

    // Sube en cada Releer: es la llave que hace que Blazor recree el cuadro y la ruta en
    // vez de reusarlos, y la respuesta visible a haber apretado Actualizar.
    private int redibujo;

    // ------------------------------------------------------------------ presentacion

    // El tono de la franja lo decide el DOMINIO: la severidad del veredicto, traducida
    // al semaforo de la marca. El rojo queda reservado y hoy nadie lo produce.
    private string Tono() => rendimiento.Severidad switch
    {
        "urgente"         => "franja--problema",
        "consulte pronto" => "franja--atencion",
        "vigilar"         => "franja--atencion",
        _                 => "",
    };

    private string Sello()
    {
        if (rendimiento.SugiereRegistrarLaCargaQueFalto) return "sello--dudoso";
        if (rendimiento.Severidad == "urgente") return "sello--problema";
        if (rendimiento.PideAlgo) return "sello--atencion";
        if (!rendimiento.HaySerie) return "";
        return "sello--bien";
    }

    private string DescripcionDelMedidor() => proxima.Hay
        ? $"Te quedan unos {Entero(proxima.KilometrosRestantes)} kilometros de los "
          + $"{Entero(autonomia.Kilometros)} de un tanque lleno"
        : $"Con el tanque lleno te alcanza para unos {Entero(autonomia.Kilometros)} kilometros";

    private string MesDelGasto() => mesDelGasto == default
        ? "" : "de " + mesDelGasto.ToString("MMMM", Cultura);

    // EL ANCHO DE LA BARRA DEL TRECHO. El nivel de siempre se planta en el 60% para que
    // un tramo mejor que el habitual tenga hacia donde crecer: con el habitual al 100%
    // toda mejora quedaria clavada contra el borde y se leerian iguales.
    private string Ancho(decimal rinde)
    {
        if (rendimiento.Habitual <= 0m) return "0";
        double proporcion = (double)(rinde / rendimiento.Habitual) * 60.0;
        return Math.Clamp(proporcion, 2, 100).ToString("0.#", CultureInfo.InvariantCulture);
    }

    // EL TRAMO QUE ESTA CARGA CIERRA. Es un emparejamiento de PRESENTACION -el dominio
    // ya dijo cuales son los tramos y entre que fechas-, no una regla.
    //
    // Se busca por la fecha que lo CIERRA y no por la pareja adyacente, porque un tramo
    // va de un tanque lleno al siguiente y en el medio puede haber una carga PARCIAL que
    // no lo cierra. Con adyacencia no aparecia ninguno de los que saltan una parcial, que
    // en el guion de la demo son justo los interesantes.
    private TramoEnLista? TramoQueCierraEn(DateTime hasta)
    {
        foreach (TramoEnLista tramo in tramos)
            if (tramo.Hasta == hasta) return tramo;
        return null;
    }

    private List<FaltanteEnLista> FaltantesDe(string transaccion)
    {
        var pendientes = new List<FaltanteEnLista>();
        foreach (FaltanteEnLista faltante in faltantes)
            if (faltante.Transaccion == transaccion) pendientes.Add(faltante);
        return pendientes;
    }

    // Lo mas reciente arriba: la ruta desciende hacia el pasado, que es como se mira un
    // historial y como se lee un tablero -lo de ahora primero.
    private List<CargaEnLista> Recientes()
    {
        var recientes = new List<CargaEnLista>(cargas);
        recientes.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return recientes;
    }

    private static string Mayuscula(string frase) =>
        frase.Length == 0 ? frase : char.ToUpperInvariant(frase[0]) + frase.Substring(1);

    private static string Simbolo(string moneda) => moneda switch
    {
        "CRC" => "₡",
        "PAB" => "B/.",
        "USD" => "$",
        _ => moneda + " ",
    };

    private static readonly CultureInfo Cultura = new CultureInfo("es-ES");

    // Formato explícito SIEMPRE: la escala del decimal no sobrevive el journal
    // (5571.50 entra, 5571.5 sale del replay), así que un ToString() pelado mostraría
    // valores distintos antes y después de reabrir la app.
    //
    // CON SEPARADOR DE MILES, y es del tablero: acá la cifra es el contenido, y "29392"
    // hay que contarlo con el dedo. El separador es un espacio fino -el mismo que ya usa
    // el dominio cuando expresa un kilometraje, "42 380 km"- y el decimal sigue siendo el
    // punto, así que no hay dos convenciones en la misma pantalla.
    private static readonly NumberFormatInfo Miles = new NumberFormatInfo
    {
        NumberGroupSeparator = "\u202f",
        NumberDecimalSeparator = ".",
    };

    // TRES FORMATOS, Y LOS TRES SON DEL DOMINIO. Había uno solo -"0.##" para todo- y eso
    // ponía a la pantalla a contradecirse consigo misma: el instrumento decía «9.43 km/L»
    // mientras la frase del dominio, tres centímetros más arriba, decía «el último tramo
    // dio 9.4». La misma cifra con dos redondeos en la misma pantalla se lee como dos
    // mediciones distintas.
    //
    // La precisión de cada magnitud ya estaba decidida, y no acá: Rendimiento.Expresado
    // es "0.#", Dinero.Expresado es "0.##", y Tramo.Expresado da los kilómetros enteros.
    // Estos tres son esos, con el separador de miles encima.

    /// <summary>Una decimal: rendimiento, litros, ritmos. El formato de Rendimiento.</summary>
    private static string Cifra(decimal medido) => medido.ToString("#,0.#", Miles);

    /// <summary>Kilómetros. El dominio los expresa enteros y la pantalla también.</summary>
    private static string Entero(decimal medido) => medido.ToString("#,0", Miles);

    /// <summary>Dinero, dos decimales. El formato de Dinero.Expresado.</summary>
    private static string Plata(decimal monto) => monto.ToString("#,0.##", Miles);

    // ------------------------------------------------------------------ el ciclo

    protected override async Task OnInitializedAsync()
    {
        if (estado.EstaArriba) { Releer(); return; }

        soportado = await estado.EstaSoportado();
        opfs = await estado.OpfsSoportado();
        sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
        instalada = await estado.EstaInstalada();
        if (soportado != true) return;

        // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI.
        ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();
        if (recuperada.Ok) await Arrancar();
    }

    private Task ConectarCarpeta() => Intentar("elegir carpeta", async () =>
    {
        if ((await estado.ConectarCarpeta()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task PedirPermiso() => Intentar("dar permiso a la carpeta", async () =>
    {
        if ((await estado.PedirPermiso()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task UsarNavegador() => Intentar("guardar en este navegador", async () =>
    {
        if ((await estado.UsarAlmacenamientoDelNavegador()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task Exportar() => Intentar("exportar la bitácora", async () =>
    {
        ResultadoDeExportacion resultado = await estado.Exportar();
        if (!resultado.Ok) throw new InvalidOperationException(resultado.Motivo);
    });

    private Task Importar() => Intentar("importar una bitácora", async () =>
    {
        string motivo = await estado.Importar();
        if (motivo.Length > 0) throw new InvalidOperationException(motivo);
        Releer();
    });

    private Task Arrancar() => Intentar("abrir la app", async () =>
    {
        await estado.Arrancar();
        Releer();
    });

    private Task Refrescar() => Intentar("refrescar contra la estación", async () =>
    {
        refrescando = true;
        try { await estado.Refrescar(); }
        finally { refrescando = false; Releer(); }
    });

    // EL APORTE DE ELLA. Si mando la propuesta sin tocarla, su origen es confirmado
    // -miro el numero y dijo que si-; si lo edito, observado. Nunca entra solo.
    private Task AgregarKilometraje(string transaccion) => Intentar("anotar el kilometraje", async () =>
    {
        decimal kilometraje = Kilometraje(transaccion);
        if (kilometraje <= 0) return;

        int tramosAntes = rendimiento.TramosCalculados;
        string origen = propuesta.Hay && kilometraje == propuesta.Kilometros
            ? "confirmado" : "observado";

        string rechazo = await estado.AnotarOdometro(transaccion, kilometraje, origen);
        if (rechazo.Length > 0)
            throw new InvalidOperationException(
                "La app no anotó ese kilometraje: no es coherente con la serie (el "
                + "odómetro solo crece). Revisá el número.");

        Releer();
        if (rendimiento.TramosCalculados > tramosAntes && rendimiento.Actual > 0)
            desbloqueado = $"el rendimiento de ese tramo: {Cifra(rendimiento.Actual)} km/L."
                + (autonomia.Hay ? $" Y tu autonomía estimada: ~{Entero(autonomia.Kilometros)} km." : "");
    });

    private Task ConfirmarTanque(string transaccion) => Intentar("confirmar el tanque", async () =>
    {
        string rechazo = await estado.ConfirmarTanque(transaccion);
        if (rechazo.Length > 0) throw new InvalidOperationException(rechazo);
        Releer();
    });

    // "Era al reves": lo que la inferencia propuso no era. Se declara lo contrario, con
    // la palabra de ella (origen observado).
    private Task CorregirTanque(string transaccion) => Intentar("corregir el tanque", async () =>
    {
        CargaEnLista? carga = null;
        foreach (CargaEnLista candidata in cargas)
            if (candidata.Transaccion == transaccion) { carga = candidata; break; }
        if (carga is null) return;

        string contrario = carga.Tanque.StartsWith("lleno") ? "parcial" : "lleno";
        string rechazo = await estado.DeclararTanque(transaccion, contrario);
        if (rechazo.Length > 0) throw new InvalidOperationException(rechazo);
        Releer();
    });

    // La foto entra entera a memoria antes de ir a la carpeta: una foto de tablero
    // ronda los pocos MB y el tope evita que un archivo equivocado tumbe la pestana.
    private Task GuardarFoto(string transaccion, InputFileChangeEventArgs e) =>
        Intentar("guardar la foto del tablero", async () =>
        {
            const long topeDeBytes = 15 * 1024 * 1024;
            IBrowserFile archivo = e.File;
            if (archivo.Size > topeDeBytes)
                throw new InvalidOperationException("La foto pesa más de 15 MB: elegí otra.");

            using var memoria = new MemoryStream();
            await archivo.OpenReadStream(topeDeBytes).CopyToAsync(memoria);

            string extension = Path.GetExtension(archivo.Name);
            if (extension.Length == 0) extension = ".jpg";

            string rechazo = await estado.AdjuntarFoto(transaccion, extension, memoria.ToArray());
            if (rechazo.Length > 0) throw new InvalidOperationException(rechazo);
            Releer();
        });

    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder($"Paso: {paso}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE: casi todo lo que decide esta pantalla vive en
            // EstadoDeLaApp, y Blazor no observa servicios inyectados. Sin esto, "hay
            // que apretar dos veces".
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload de la estacion nunca
    // llega hasta aca: solo entra como argumento de un comando, dentro del bucle.
    private void Releer()
    {
        vehiculos = estado.Vehiculos();
        ultimoEvento = estado.UltimoEvento();
        lealtad = estado.Lealtad();
        redibujo++;

        // El demo es de un vehiculo; el modelo contempla varios y este tablero, por
        // ahora, es el del primero con toda su historia.
        if (vehiculos.Count == 0)
        {
            cargas = new List<CargaEnLista>();
            tramos = new List<TramoEnLista>();
            faltantes = new List<FaltanteEnLista>();
            costos = new List<CostoEnLista>();
            rendimiento = new RendimientoDelVehiculo();
            autonomia = new AutonomiaDelVehiculo();
            proxima = new ProximaCargaDelVehiculo();
            completitud = new CompletitudDelVehiculo();
            propuesta = new OdometroPropuesto();
            gastos = new List<GastoEnLista>();
            mesDelGasto = default;
            return;
        }

        string placa = vehiculos[0].Placa;
        cargas = estado.Cargas(placa);
        tramos = estado.Tramos(placa);
        rendimiento = estado.Rendimiento(placa);
        autonomia = estado.Autonomia(placa);
        completitud = estado.Completitud(placa);
        faltantes = estado.Faltantes(placa);
        costos = estado.Costos(placa);

        // El "hoy" del prellenado y de la proyeccion lo pone ESTA caratula: el dominio no
        // lee el reloj. Si lo hiciera, el mismo journal reproducido manana daria otra
        // respuesta.
        propuesta = estado.Odometro(placa, DateTime.Now);
        proxima = estado.ProximaCarga(placa, DateTime.Now);

        // EL GASTO DEL MES DE LA ULTIMA CARGA, no el del mes del calendario. Con el mes
        // corriente el instrumento aparece vacio en cuanto pasan treinta dias sin cargar,
        // y "0" no es la respuesta: la respuesta es cuanto llevaba gastado la ultima vez
        // que cargo.
        gastos = new List<GastoEnLista>();
        mesDelGasto = default;
        foreach (CargaEnLista carga in cargas)
            if (carga.Fecha > mesDelGasto) mesDelGasto = carga.Fecha;
        if (mesDelGasto != default)
            gastos = estado.Gastos(mesDelGasto.Year, mesDelGasto.Month);

        // LA PROYECCION SE PROPONE SOLO EN LA ULTIMA CARGA DE TODAS, y solo si es ella la
        // que espera kilometraje. La proyeccion es "cuanto marca el odometro HOY", asi
        // que a cualquier carga anterior le queda grande.
        //
        // No alcanza con "la mas reciente que espera kilometraje": en el guion esa es la
        // de julio y la de agosto ya esta anotada en 43 200, asi que el campo llegaba
        // proponiendo los 43 225 de hoy para una carga anterior. El odometro solo crece
        // -el dominio lo iba a rechazar-, y proponer un numero que uno mismo va a
        // rechazar es peor que no proponer nada.
        transaccionConPropuesta = "";
        if (propuesta.Hay && cargas.Count > 0)
        {
            DateTime ultimaFecha = DateTime.MinValue;
            foreach (CargaEnLista carga in cargas)
                if (carga.Fecha > ultimaFecha) ultimaFecha = carga.Fecha;

            foreach (FaltanteEnLista faltante in faltantes)
                if (faltante.QueFalta == "el kilometraje" && faltante.Fecha == ultimaFecha)
                {
                    transaccionConPropuesta = faltante.Transaccion;
                    if (!kilometrajePorAnotar.ContainsKey(faltante.Transaccion))
                        kilometrajePorAnotar[faltante.Transaccion] = propuesta.Kilometros;
                    break;
                }
        }
    }
}
