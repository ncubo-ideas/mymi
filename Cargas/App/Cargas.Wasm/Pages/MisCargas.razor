    private Task Refrescar() => Intentar("refrescar contra la estación", async () =>
    {
        refrescando = true;
        try { await estado.Refrescar(); }
        finally { refrescando = false; Releer(); }
    });

    // EL APORTE DE SONIA. Si mando la propuesta sin tocarla, su origen es confirmado
    // -miro el numero y dijo que si-; si lo edito, observado. Nunca entra solo.
    private Task AgregarKilometraje(string transaccion) => Intentar("anotar el kilometraje", async () =>
    {
        decimal kilometraje = Kilometraje(transaccion);
        if (kilometraje <= 0) return;

        int tramosAntes = rendimiento.TramosCalculados;
        string origen = propuesta.Hay && kilometraje == propuesta.Kilometros
            ? "confirmado" : "observado";

        string rechazo = await estado.AnotarOdometro(transaccion, kilometraje, origen);
        if (rechazo.Length > 0)
            throw new InvalidOperationException(
                "La app no anotó ese kilometraje: no es coherente con la serie (el "
                + "odómetro solo crece). Revisá el número.");

        Releer();
        if (rendimiento.TramosCalculados > tramosAntes && rendimiento.Actual > 0)
            desbloqueado = $"el rendimiento de ese tramo: {Valor(rendimiento.Actual)} km/L."
                + (autonomia.Hay ? $" Y tu autonomía estimada: ~{Valor(autonomia.Kilometros)} km." : "");
    });

    private Task ConfirmarTanque(string transaccion) => Intentar("confirmar el tanque", async () =>
    {
        string rechazo = await estado.ConfirmarTanque(transaccion);
        if (rechazo.Length > 0) throw new InvalidOperationException(rechazo);
        Releer();
    });

    // "Era al reves": lo que la inferencia propuso no era. Se declara lo contrario, con
    // la palabra de Sonia (origen observado).
    private Task CorregirTanque(string transaccion) => Intentar("corregir el tanque", async () =>
    {
        CargaEnLista? carga = null;
        foreach (CargaEnLista candidata in cargas)
            if (candidata.Transaccion == transaccion) { carga = candidata; break; }
        if (carga is null) return;

        string contrario = carga.Tanque.StartsWith("lleno") ? "parcial" : "lleno";
        string rechazo = await estado.DeclararTanque(transaccion, contrario);
        if (rechazo.Length > 0) throw new InvalidOperationException(rechazo);
        Releer();
    });

    // La foto entra entera a memoria antes de ir a la carpeta: una foto de tablero
    // ronda los pocos MB y el tope evita que un archivo equivocado tumbe la pestana.
    private Task GuardarFoto(string transaccion, InputFileChangeEventArgs e) =>
        Intentar("guardar la foto del tablero", async () =>
        {
            const long topeDeBytes = 15 * 1024 * 1024;
            IBrowserFile archivo = e.File;
            if (archivo.Size > topeDeBytes)
                throw new InvalidOperationException("La foto pesa más de 15 MB: elegí otra.");

            using var memoria = new MemoryStream();
            await archivo.OpenReadStream(topeDeBytes).CopyToAsync(memoria);

            string extension = Path.GetExtension(archivo.Name);
            if (extension.Length == 0) extension = ".jpg";

            string rechazo = await estado.AdjuntarFoto(transaccion, extension, memoria.ToArray());
            if (rechazo.Length > 0) throw new InvalidOperationException(rechazo);
            Releer();
        });

    private async Task Intentar(string paso, Func<Task> accion)
    {
        error = "";
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            var detalle = new System.Text.StringBuilder($"Paso: {paso}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception? interna = ex.InnerException; interna is not null; interna = interna.InnerException)
                detalle.Append($"\n  causa: {interna.GetType().FullName}: {interna.Message}");
            error = detalle.ToString();
        }
        finally
        {
            // Repintar SIEMPRE: casi todo lo que decide esta pantalla vive en
            // EstadoDeLaApp, y Blazor no observa servicios inyectados. Sin esto, "hay
            // que apretar dos veces".
            StateHasChanged();
        }
    }

    // TODO lo que se ve sale de consultar al actor. El payload de la estacion nunca
    // llega hasta aca: solo entra como argumento de un comando, dentro del bucle.
    private void Releer()
    {
        vehiculos = estado.Vehiculos();
        cantidad = estado.Cantidad();
        ultimoEvento = estado.UltimoEvento();
        lealtad = estado.Lealtad();
        redibujo++;

        // El demo es de un vehiculo; el modelo contempla varios y esta pantalla, por
        // ahora, muestra el primero con toda su historia.
        if (vehiculos.Count == 0)
        {
            cargas = new List<CargaEnLista>();
            tramos = new List<TramoEnLista>();
            faltantes = new List<FaltanteEnLista>();
            costos = new List<CostoEnLista>();
            rendimiento = new RendimientoDelVehiculo();
            autonomia = new AutonomiaDelVehiculo();
            completitud = new CompletitudDelVehiculo();
            propuesta = new OdometroPropuesto();
            return;
        }

        string placa = vehiculos[0].Placa;
        cargas = estado.Cargas(placa);
        tramos = estado.Tramos(placa);
        rendimiento = estado.Rendimiento(placa);
        autonomia = estado.Autonomia(placa);
        completitud = estado.Completitud(placa);
        faltantes = estado.Faltantes(placa);
        costos = estado.Costos(placa);

        // El "hoy" del prellenado lo pone esta caratula: el dominio no lee el reloj.
        //
        // La proyeccion se propone SOLO en la carga mas reciente que espera kilometraje:
        // es la unica a la que se le puede proyectar desde hoy. Ponerla en todas seria
        // sugerir el kilometraje de hoy para una carga de hace ocho meses.
        propuesta = estado.Odometro(placa, DateTime.Now);
        transaccionConPropuesta = "";
        if (propuesta.Hay)
        {
            FaltanteEnLista? ultima = null;
            foreach (FaltanteEnLista faltante in faltantes)
                if (faltante.QueFalta == "el kilometraje"
                    && (ultima is null || faltante.Fecha > ultima.Fecha)) ultima = faltante;

            if (ultima is not null)
            {
                transaccionConPropuesta = ultima.Transaccion;
                if (!kilometrajePorAnotar.ContainsKey(ultima.Transaccion))
                    kilometrajePorAnotar[ultima.Transaccion] = propuesta.Kilometros;
            }
        }
    }

    // Lo mas reciente primero: en un historial se mira para atras.
    private List<CargaEnLista> Recientes()
    {
        var recientes = new List<CargaEnLista>(cargas);
        recientes.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return recientes;
    }

    private static string Simbolo(string moneda) => moneda switch
    {
        "CRC" => "₡",
        "PAB" => "B/.",
        "USD" => "$",
        _ => moneda + " ",
    };

    private static readonly CultureInfo Cultura = new CultureInfo("es-ES");

    // Formato explícito SIEMPRE: la escala del decimal no sobrevive el journal
    // (5571.50 entra, 5571.5 sale del replay), así que un ToString() pelado mostraría
    // valores distintos antes y después de reabrir la app.
    private static string Valor(decimal medido) => medido.ToString("0.##", CultureInfo.InvariantCulture);
}
