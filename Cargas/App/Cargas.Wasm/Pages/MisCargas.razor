@page "/"
@using System.Globalization
@using Cargas.App.Vistas
@using Puppets.Portador
@inject EstadoDeLaApp estado

<PageTitle>Mis cargas</PageTitle>

@* EL BLOQUE DE MARCA. Un faro de un solo trazo -torre y haz-, nunca relleno, legible a
   24 px: el patron heredado de Delfos. ⚠️ MARCA PROVISIONAL: el nombre y la paleta
   esperan la especificacion de Geaninna; lo que no espera es la estructura, y por eso
   el bloque existe y el manual va a vivir en los tokens de app.css. *@
<div class="marca">
    <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"
         fill="none" stroke="var(--logo)" stroke-width="2.4" aria-hidden="true">
        <path d="M16 34 L18 12 h4 L24 34 z" />
        <path d="M15 12 h10 M17 7 h6 M18 12 V7 M22 12 V7" />
        <path d="M26 8 l6 -2.5 M26 11 l7 0" />
    </svg>
    <div>
        <div class="marca-nombre">Estaciones Faro</div>
        <div class="marca-claim">Tu camino, claro</div>
    </div>
</div>

<h1 class="titular">Mis cargas</h1>
<p class="membrete">Tus cargas de combustible, en tu computadora.</p>

@* UN solo lugar para los errores, y arriba: un fallo abajo queda fuera de pantalla y
   la app parece no reaccionar al click. *@
@if (error.Length > 0)
{
    <div class="aviso aviso--problema">
        <strong>@(estado.EstaArriba ? "No se pudo completar la operación." : "No se pudo abrir la app.")</strong>
        <pre>@error</pre>
    </div>
}

@if (!estado.EstaArriba)
{
    <div class="aviso aviso--neutro">
        @* Cuando el handle volvio de IndexedDB pero el permiso caduco, la accion correcta
           es RE-OTORGAR, no volver a elegir la carpeta. *@
        @if (estado.FaltaReotorgarPermiso)
        {
            <p>
                Tu carpeta es <strong>&laquo;@estado.NombreDeLaCarpeta&raquo;</strong>. El browser pide
                confirmar el permiso de escritura cada vez que volvés a abrir la app.
            </p>
            <div class="fila" style="margin-top:12px">
                <button class="boton boton--atencion" @onclick="PedirPermiso">
                    Dar permiso a &laquo;@estado.NombreDeLaCarpeta&raquo;
                </button>
                <button class="boton" @onclick="ConectarCarpeta"
                        disabled="@(soportado == false)">
                    Elegir carpeta
                </button>
            </div>
        }
        else
        {
            <p>Esta app guarda <strong>tus</strong> cargas. Elegí dónde.</p>

            @if (sinAlmacenamiento == "inseguro")
            {
                <p class="aviso aviso--atencion">
                    <strong>Esta página no está en una conexión segura</strong>, y por eso el
                    navegador no le deja guardar nada — en cualquier navegador pasaría lo mismo.
                    Entrá por <strong>https</strong> y las opciones de guardado aparecen.
                </p>
            }
            else if (sinAlmacenamiento == "navegador")
            {
                <p class="aviso aviso--atencion">
                    <strong>@(instalada ? "Acá no se puede guardar la bitácora." : "Este navegador no puede guardar la bitácora.")</strong>
                    Podés usar la app igual, pero lo que veas se pierde al cerrar. Para que
                    quede guardado, @(instalada ? "instalala" : "abrila") desde
                    <strong>Chrome</strong> o <strong>Edge</strong>.
                </p>
            }

            @* TRES MODOS, y los tres se dicen con lo que dan y lo que no. En 'opfs' la
               bitacora sobrevive al cierre pero NO la puede leer tu asistente, y
               callarlo seria vender algo que no hay. *@
            <div class="modos">
                <div class="modo @(soportado == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">Una carpeta tuya</div>
                    <p>La bitácora queda en la carpeta que elijas, en tu disco.
                       <strong>Es el único modo en el que tu asistente la puede leer.</strong></p>
                    @if (soportado == true)
                    {
                        <button class="boton" @onclick="ConectarCarpeta">Elegir carpeta</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "Hace falta una conexión segura (https)."
                                : instalada
                                    ? "Acá no está disponible. Para usarlo, instalá la app desde Chrome o Edge."
                                    : "Este navegador no lo permite. Para usarlo, abrí la app en Chrome o Edge.")
                        </p>
                    }
                </div>

                <div class="modo @(opfs == true ? "" : "modo--nodisponible")">
                    <div class="modo-titulo">@(instalada ? "Dentro de la app" : "En este navegador")</div>
                    <p>Se guarda igual y sobrevive al cerrar, pero
                       @(instalada ? "queda dentro de la app" : "lo administra el navegador"):
                       <strong>no es una carpeta tuya y tu asistente no lo puede leer.</strong></p>
                    @if (opfs == true)
                    {
                        <button class="boton boton--contorno" @onclick="UsarNavegador">Guardar acá</button>
                    }
                    else
                    {
                        <p class="modo-nota">
                            @(sinAlmacenamiento == "inseguro"
                                ? "También hace falta una conexión segura (https)."
                                : "Acá tampoco está disponible.")
                        </p>
                    }
                </div>

                <div class="modo">
                    <div class="modo-titulo">Un archivo</div>
                    <p>Traé una bitácora que exportaste antes, desde esta u otra computadora.
                       Funciona en cualquier navegador.</p>
                    <button class="boton boton--contorno" @onclick="Importar">Importar</button>
                </div>
            </div>
        }

        <div style="margin-top:16px">
            <button class="boton boton--enlace" @onclick="Arrancar">Abrir sin guardar nada</button>
        </div>
    </div>
}
else
{
    @* LA PRIMERA PREGUNTA: «¿cómo viene mi carro?». El titular es la frase del DOMINIO,
       armada con los hechos de Sonia -"venías rindiendo 12.6 y el último tramo dio
       9.4"-, nunca un consejo de plantilla que esta pantalla no tiene de dónde sacar.

       EL @key VA EN EL CUERPO Y NO EN LA <section>: sube en cada Releer y obliga a
       Blazor a recrear los nodos -sin él, Actualizar parecía no hacer nada-, pero si
       la sección entera se recrea, el foco del botón recién apretado se pierde. *@
    <section class="portada @Tono()">
        <div class="portada-cabeza">
            <p class="portada-rotulo">tu carro, hoy</p>
            <button class="portada-releer" @onclick="Refrescar" disabled="@(refrescando || estado.Migrada)">
                @(estado.Migrada ? "Ya no se actualiza" : refrescando ? "Actualizando…" : "Actualizar")
            </button>
        </div>

        <div class="portada-cuerpo" @key="@($"portada-{redibujo}")">
            @if (rendimiento.ParaSonia.Length > 0)
            {
                <p class="portada-titular">@Mayuscula(rendimiento.ParaSonia).</p>
                @if (rendimiento.PideAlgo)
                {
                    <div class="portada-cuales">
                        <span class="portada-cual">@Mayuscula(rendimiento.Accion)</span>
                    </div>
                }
            }
            else
            {
                <p class="portada-titular">Todavía no hay cargas. Apretá <em>Actualizar</em>.</p>
            }

            <div class="portada-pie">
                <span><b>@cantidad</b> @(cantidad == 1 ? "carga" : "cargas")</span>
                @if (Desde() is DateTime desde)
                {
                    <span>desde <b>@desde.ToString("MMM yyyy", Cultura)</b></span>
                }
                @if (completitud.TotalDeCargas > 0)
                {
                    <span>@completitud.Expresada</span>
                }
                <span>leído hasta el evento <b>@ultimoEvento</b></span>
            </div>
        </div>
    </section>

    @* Si la app no esta guardando, eso es lo MAS importante de la pantalla y va arriba:
       sin destino se ve completa y correcta, y no hay forma de notar que no persiste
       salvo que se diga. *@
    @* MIGRADA: el proveedor dice que el registro de esta cuenta ya vive en Gnothi
       (especificación 13 §4 y §6.2). "Desaparecer" NO es desinstalar y NO es borrar: la app
       sigue mostrando lo que tiene, porque es de ella. Lo que deja de hacer es SINCRONIZAR,
       que es lo único que produciría dos historias que divergen. *@
    @if (estado.Migrada)
    {
        <div class="aviso aviso--atencion fila">
            <div class="crece">
                <strong>Tu registro ahora vive en @estado.DondeVive.</strong>
                Lo que ves acá se queda, pero esta copia ya no se actualiza: las cargas
                nuevas te llegan allá.
            </div>
        </div>
    }
    else if (estado.Hospedada)
    {
        <div class="aviso fila">
            <div class="crece">
                <strong>Se está guardando en Gnothi.</strong>
                Tu bitácora vive en el dispositivo, en la carpeta que Gnothi le dio a esta
                estación, y tu asistente la puede leer desde ahí.
            </div>
        </div>
    }
    else if (!estado.HayCarpeta)
    {
        <div class="aviso aviso--atencion fila">
            <div class="crece">
                <strong>No se está guardando nada.</strong>
                Esta app está funcionando sin destino: lo que la estación publicó se vuelve a
                pedir al abrir, pero <strong>tus kilometrajes y confirmaciones se pierden</strong>
                — esos no los sabe nadie más que vos.
            </div>
            @if (soportado == true)
            {
                <button class="boton boton--atencion" @onclick="ConectarCarpeta">Elegir carpeta</button>
            }
            else if (opfs == true)
            {
                <button class="boton boton--atencion" @onclick="UsarNavegador">Guardar en este navegador</button>
            }
        </div>
    }
    else if (estado.GuardadoFallando.Length > 0)
    {
        <div class="aviso aviso--problema fila">
            <div class="crece">
                <strong>La carpeta rechazó la escritura.</strong>
                Lo que ves en pantalla no está guardado en &laquo;@estado.NombreDeLaCarpeta&raquo;.
                Suele ser el permiso, que caduca al reabrir.
                <div class="apunte mono" style="margin-top:6px">@estado.GuardadoFallando</div>
            </div>
            <button class="boton boton--problema" @onclick="PedirPermiso">Volver a dar permiso</button>
        </div>
    }
    else
    {
        @if (estado.EnAlmacenamientoDelNavegador)
        {
            <p class="aviso aviso--neutro">
                <strong>@(instalada ? "Se está guardando dentro de la app" : "Se está guardando en este navegador")</strong>,
                así que tu bitácora sobrevive al cerrar. Pero tu asistente
                <strong>no la puede leer</strong>: para eso hace falta una carpeta tuya, y
                @(instalada ? "acá" : "este navegador") no las permite.
                <button class="boton boton--enlace" @onclick="Exportar">Exportar a un archivo</button>
            </p>
        }
        else
        {
            <p class="apunte">
                Se guarda en &laquo;@estado.NombreDeLaCarpeta&raquo; después de cada cambio.
                &middot; <button class="boton boton--enlace" @onclick="Exportar">Exportar</button>
            </p>
        }
    }

    @foreach (VehiculoEnLista vehiculo in vehiculos)
    {
        <h2 class="seccion">Cómo viene @(vehiculo.TieneFicha ? vehiculo.Nombre : $"tu carro ({vehiculo.Nombre})")</h2>

        @* LA TARJETA DEL RENDIMIENTO. Cuando hay tramo, el gráfico contra la banda del
           nivel de siempre; cuando no, la TARJETA BLOQUEADA que dice qué falta y qué se
           desbloquea — mostrar el valor bloqueado, no pedir el dato. *@
        <div class="serie" @key="@($"rendimiento-{vehiculo.Placa}-{redibujo}")">
            <div class="serie-cabeza">
                <div>
                    <span class="serie-nombre">Rendimiento</span>
                    <span class="chip @Insignia(rendimiento)">@rendimiento.Veredicto</span>
                    @if (rendimiento.HaySerie)
                    {
                        <div class="serie-relato">sobre @rendimiento.TramosCalculados tramos entre tanques llenos</div>
                    }
                </div>
                <div>
                    @if (rendimiento.Actual > 0)
                    {
                        <div class="serie-valor">@Valor(rendimiento.Actual) <span>km/L</span></div>
                        @if (rendimiento.HaySerie)
                        {
                            <div class="serie-referencia">tu nivel de siempre: @Valor(rendimiento.Habitual) km/L</div>
                        }
                    }
                </div>
            </div>

            @if (rendimiento.TramosCalculados > 0)
            {
                <TrayectoriaDeTramos Tramos="tramos"
                                     Habitual="rendimiento.Habitual"
                                     PideAlgo="rendimiento.PideAlgo"
                                     Descripcion="@rendimiento.ParaSonia" />
            }

            @if (rendimiento.ParaSonia.Length > 0)
            {
                <div class="serie-lectura@(rendimiento.PideAlgo ? " serie-lectura--atencion" : "")">
                    @Mayuscula(rendimiento.ParaSonia)@(rendimiento.PideAlgo ? ": " : ".")<b>@rendimiento.Accion</b>
                </div>
            }
        </div>

        @* LO DERIVADO: la tercera procedencia, siempre declarada como estimación. *@
        @if (autonomia.Hay)
        {
            <div class="serie" @key="@($"autonomia-{vehiculo.Placa}-{redibujo}")">
                <div class="serie-cabeza">
                    <div>
                        <span class="serie-nombre">Autonomía estimada</span>
                        <span class="chip chip--sinserie">proyección</span>
                        <div class="serie-relato">
                            @Valor(autonomia.CapacidadEnLitros) L de tanque (tu carga máxima)
                            × @Valor(autonomia.HabitualKmPorLitro) km/L de siempre
                        </div>
                    </div>
                    <div>
                        <div class="serie-valor">~@Valor(autonomia.Kilometros) <span>km</span></div>
                        <div class="serie-referencia">con el tanque lleno</div>
                    </div>
                </div>
            </div>
        }

        @foreach (CostoEnLista costo in costos)
        {
            <div class="serie" @key="@($"costo-{costo.Moneda}-{redibujo}")">
                <div class="serie-cabeza">
                    <div>
                        <span class="serie-nombre">Costo por kilómetro</span>
                        <div class="serie-relato">sobre @Valor(costo.Kilometros) km con kilometraje anotado</div>
                    </div>
                    <div>
                        <div class="serie-valor">@Simbolo(costo.Moneda)@Valor(costo.MontoPorKilometro) <span>por km</span></div>
                    </div>
                </div>
            </div>
        }

        @* LO QUE FALTA, con acción concreta: la consulta que motiva el ingreso. El
           kilometraje llega PRELLENADO con la proyección -«¿unos 42 900?»- para que
           confirmar sea más fácil que recordar y teclear. Si Sonia lo acepta tal cual
           entra confirmado; si lo edita, observado. Nunca se escribe solo. *@
        @if (faltantes.Count > 0)
        {
            <h2 class="seccion">Lo que falta</h2>
            @foreach (FaltanteEnLista faltante in faltantes)
            {
                <div class="aviso aviso--neutro" @key="@($"faltante-{faltante.Transaccion}-{faltante.QueFalta}-{redibujo}")">
                    <strong>@Mayuscula(faltante.ParaSonia).</strong>
                    @if (faltante.QueFalta == "el kilometraje")
                    {
                        @* UN CAMPO POR CARGA, y no uno compartido. Con un solo campo para
                           toda la lista, los nueve formularios mostraban el mismo número
                           y el que se tecleaba para una carga aparecía en las otras ocho:
                           es la invitación a apretar «Agregar» en la fila equivocada. El
                           dominio lo rechazaría por monotonía, pero el error no debería
                           llegar a existir. *@
                        <div class="fila" style="margin-top:10px">
                            <input class="boton boton--contorno mono" type="number" inputmode="numeric"
                                   style="max-width:11em"
                                   value="@Kilometraje(faltante.Transaccion)"
                                   @onchange="e => AnotarEnElCampo(faltante.Transaccion, e)" />
                            <button class="boton boton--atencion"
                                    @onclick="() => AgregarKilometraje(faltante.Transaccion)">
                                Agregar kilometraje
                            </button>
                            @* La sugerencia solo donde se puede proyectar: la carga mas
                               reciente que espera kilometraje. Ver Releer(). *@
                            @if (propuesta.Hay && faltante.Transaccion == transaccionConPropuesta)
                            {
                                <span class="apunte crece">¿unos @Valor(propuesta.Kilometros) km? Es lo que da
                                    tu promedio de @Valor(propuesta.KilometrosPorDia) km por día.</span>
                            }
                        </div>
                    }
                    else if (faltante.QueFalta == "la confirmación del tanque")
                    {
                        <div class="fila" style="margin-top:10px">
                            <button class="boton boton--atencion"
                                    @onclick="() => ConfirmarTanque(faltante.Transaccion)">
                                Sí, quedó así
                            </button>
                            <button class="boton boton--contorno"
                                    @onclick="() => CorregirTanque(faltante.Transaccion)">
                                No, era al revés
                            </button>
                        </div>
                    }
                </div>
            }
        }

        @* EL REFUERZO: al cerrar un tramo se muestra lo que se DESBLOQUEO, no una
           insignia. El premio es informacion sobre su carro. *@
        @if (desbloqueado.Length > 0)
        {
            <div class="aviso aviso--neutro"><strong>Se desbloqueó:</strong> @desbloqueado</div>
        }

        <h2 class="seccion">Tus cargas</h2>
        @if (cargas.Count == 0)
        {
            <p class="apunte">Todavía no hay cargas. Apretá <em>Actualizar</em>.</p>
        }
        else
        {
            <ol class="visitas">
                @foreach (CargaEnLista carga in Recientes())
                {
                    <li class="visita" @key="@($"carga-{carga.Transaccion}-{redibujo}")">
                        <div class="visita-fecha">
                            <span class="visita-dia">@carga.Fecha.ToString("dd MMM", Cultura)</span>
                            <span class="visita-ano">@carga.Fecha.Year</span>
                        </div>
                        <ul class="visita-cosas">
                            <li class="visita-cosa">
                                <span class="visita-que">@Valor(carga.Litros) L de @carga.Tipo · surtidor @carga.Surtidor</span>
                                <span class="visita-cuanto">@Simbolo(carga.Moneda)@Valor(carga.Total)</span>
                            </li>
                            <li class="visita-cosa">
                                <span class="visita-que">
                                    @(carga.TieneKilometraje ? carga.Kilometraje : "sin kilometraje")
                                    @(carga.Tanque.Length > 0 ? $" · tanque {carga.Tanque}" : "")
                                </span>
                                @* LA FOTO DEL TABLERO, nivel 1: el input NO otorga
                                   camara -el selector es del sistema y en movil ya
                                   ofrece "tomar foto"-, asi que el sandbox del FAQ #5
                                   queda intacto. El archivo va a la carpeta; el
                                   journal guarda el nombre. *@
                                <span class="visita-cuanto">
                                    @if (carga.TieneFoto)
                                    {
                                        <span class="apunte">📷 foto guardada</span>
                                    }
                                    else if (estado.HayCarpeta)
                                    {
                                        <label class="boton boton--enlace" style="cursor:pointer">
                                            📷 foto del tablero
                                            <InputFile OnChange="e => GuardarFoto(carga.Transaccion, e)"
                                                       accept="image/*" style="display:none" />
                                        </label>
                                    }
                                </span>
                            </li>
                        </ul>
                    </li>
                }
            </ol>
        }
    }

    @* LA LEALTAD, discreta: presente para que se sienta real, no es el foco. *@
    @if (lealtad.Nivel.Length > 0)
    {
        <p class="apunte" style="margin-top:20px">
            Lealtad: <b>@lealtad.Saldo</b> puntos, nivel <b>@lealtad.Nivel</b>@(
                lealtad.PuntosParaElSiguienteNivel > 0
                    ? $" · faltan {lealtad.PuntosParaElSiguienteNivel} para el siguiente"
                    : "").
        </p>
    }

    @if (!estado.Hospedada && !estado.HayCarpeta)
    {
        <p class="apunte" style="margin-top:28px">
            <strong>Sin carpeta:</strong> la bitácora vive solo en memoria y se pierde al cerrar.
        </p>
    }
}

@code {
    private bool? soportado;
    private bool? opfs;
    private string sinAlmacenamiento = "";
    private bool instalada;
    private bool refrescando;

    private IReadOnlyList<VehiculoEnLista> vehiculos = new List<VehiculoEnLista>();
    private IReadOnlyList<CargaEnLista> cargas = new List<CargaEnLista>();
    private IReadOnlyList<TramoEnLista> tramos = new List<TramoEnLista>();
    private IReadOnlyList<FaltanteEnLista> faltantes = new List<FaltanteEnLista>();
    private IReadOnlyList<CostoEnLista> costos = new List<CostoEnLista>();
    private RendimientoDelVehiculo rendimiento = new();
    private AutonomiaDelVehiculo autonomia = new();
    private CompletitudDelVehiculo completitud = new();
    private OdometroPropuesto propuesta = new();
    private EstadoDeLealtad lealtad = new();
    private int cantidad;
    private long ultimoEvento;
    private string error = "";

    // El prellenado, UNO POR CARGA (llave: el numero de transaccion). Si Sonia manda la
    // propuesta tal cual, su origen es "confirmado" -miro el numero y dijo que si-; si
    // la edita, "observado".
    private Dictionary<string, decimal> kilometrajePorAnotar = new();

    private decimal Kilometraje(string transaccion) =>
        kilometrajePorAnotar.TryGetValue(transaccion, out decimal km) ? km : 0m;

    // La carga a la que se le propuso la proyeccion, si hay alguna. Vacio si no.
    private string transaccionConPropuesta = "";

    private void AnotarEnElCampo(string transaccion, ChangeEventArgs e)
    {
        kilometrajePorAnotar[transaccion] =
            decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture,
                out decimal km) ? km : 0m;
    }

    // El refuerzo del ingreso: lo que aparecio al cerrar un tramo.
    private string desbloqueado = "";

    // Sube en cada Releer: es la llave que hace que Blazor recree las tarjetas en vez
    // de reusarlas, y la respuesta visible a haber apretado Actualizar.
    private int redibujo;

    // El tono de la portada lo decide el DOMINIO: la severidad del veredicto, traducida
    // con el semáforo de la marca. El rojo queda reservado y hoy nadie lo produce.
    private string Tono() => rendimiento.Severidad switch
    {
        "urgente"         => "portada--problema",
        "consulte pronto" => "portada--atencion",
        "vigilar"         => "portada--atencion",
        _                 => "portada--calma",
    };

    private string Insignia(RendimientoDelVehiculo lectura)
    {
        if (lectura.SugiereRegistrarLaCargaQueFalto) return "chip--repetir";
        if (lectura.Severidad == "urgente") return "chip--problema";
        if (lectura.PideAlgo) return "chip--atencion";
        if (!lectura.HaySerie) return "chip--sinserie";
        return "chip--estable";
    }

    private DateTime? Desde()
    {
        DateTime? primera = null;
        foreach (CargaEnLista carga in cargas)
            if (primera is null || carga.Fecha < primera) primera = carga.Fecha;
        return primera;
    }

    private static string Mayuscula(string frase) =>
        frase.Length == 0 ? frase : char.ToUpperInvariant(frase[0]) + frase.Substring(1);

    protected override async Task OnInitializedAsync()
    {
        if (estado.EstaArriba) { Releer(); return; }

        // HOSPEDADA: el destino es de Gnothi y no hay nada que elegir ni permiso que pedir.
        // La app arranca sola; el selector de almacenamiento es vocabulario del modo suelto.
        if (estado.Hospedada) { await Arrancar(); return; }

        soportado = await estado.EstaSoportado();
        opfs = await estado.OpfsSoportado();
        sinAlmacenamiento = await estado.MotivoSinAlmacenamiento();
        instalada = await estado.EstaInstalada();
        if (soportado != true) return;

        // Recuperar el handle NO necesita gesto; volver a otorgar el permiso SI.
        ResultadoDeCarpeta recuperada = await estado.RecuperarCarpeta();
        if (recuperada.Ok) await Arrancar();
    }

    private Task ConectarCarpeta() => Intentar("elegir carpeta", async () =>
    {
        if ((await estado.ConectarCarpeta()).Ok)
        {
            await estado.Arrancar();
            Releer();
        }
    });

    private Task PedirPermiso() => Intentar("dar permiso a la carpeta", async () =>
