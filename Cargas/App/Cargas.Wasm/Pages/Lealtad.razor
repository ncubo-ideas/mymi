@page "/lealtad"
@inherits PantallaDeCargas
@using Cargas.App.Vistas

<PageTitle>Lealtad · Estaciones Faro</PageTitle>

<h1 class="solo-para-lectores">Mi lealtad</h1>

@* LOS PUNTOS Y LOS BOLETOS LLEGAN COMO EVENTOS, no se calculan acá: la tasa de canje y la
   regla de la tómbola son del programa y pueden cambiar, y una app que las derivara
   discreparía con la estación el día que cambien. Discrepar sobre un premio es el peor bug
   posible en un programa de lealtad.

   Lo que la app SÍ deriva es la explicación de cada carga, que es justo lo que un tiquete
   de bomba no puede dar. *@
@if (Error.Length > 0)
{
    <div class="parte parte--problema"><pre>@Error</pre></div>
}

<Carnet lealtad="@lealtad" />

<div class="cuadro">
    <div class="instrumento instrumento--medio @(lealtad.Nivel.Length > 0 ? "" : "instrumento--apagado")">
        <span class="rotulo">Puntos</span>
        <div class="cifra">@Entero(lealtad.Saldo)</div>
        <div class="cifra-pie">
            @if (lealtad.Nivel.Length > 0)
            {
                <text>nivel <b>@lealtad.Nivel</b></text>
                @if (lealtad.PuntosParaElSiguienteNivel > 0)
                {
                    <text> &middot; faltan <b>@Entero(lealtad.PuntosParaElSiguienteNivel)</b> para el siguiente</text>
                }
            }
            else
            {
                <text>Todavía no entró ningún punto de la estación.</text>
            }
        </div>
    </div>

    @* LOS VIGENTES EN LA CIFRA. «16 boletos en 2 sorteos» sumaba los diez de una tómbola que
       ya se rifó, y un titular que cuenta boletos que ya no juegan promete de más. La cifra
       son los que juegan; los pasados se dicen aparte, porque tampoco se esfuman. *@
    <div class="instrumento instrumento--medio @(BoletosVigentes > 0 || BoletosPasados > 0 ? "" : "instrumento--apagado")">
        <span class="rotulo">Boletos de tómbola</span>
        <div class="cifra">@Entero(BoletosVigentes)</div>
        <div class="cifra-pie">
            @if (BoletosVigentes > 0)
            {
                <text>en <b>@SorteosVigentes</b> @(SorteosVigentes == 1 ? "sorteo vigente" : "sorteos vigentes")</text>
            }
            else if (BoletosPasados == 0)
            {
                <text>Un boleto por cada carga que alcance el monto. Los emite la estación.</text>
            }
            else
            {
                <text>ninguno en juego ahora</text>
            }
            @if (BoletosPasados > 0)
            {
                <text> &middot; y <b>@Entero(BoletosPasados)</b> de @(SorteosPasados == 1 ? "un sorteo que ya se rifó" : "sorteos que ya se rifaron")</text>
            }
        </div>
    </div>
</div>

@* LOS SORTEOS, cada uno con sus boletos. Un vencido SE MUESTRA VENCIDO y nunca
   desaparece: que se esfumen boletos de una app de lealtad es la forma más rápida de
   perder la confianza que este producto entero intenta construir. *@
@foreach (SorteoEnLista sorteo in sorteos)
{
    <div class="sorteo @(sorteo.EstaVencido ? "sorteo--vencido" : "")" @key="@sorteo.Codigo">
        <div class="sorteo-cabeza">
            <div>
                <span class="sorteo-nombre">@(sorteo.Nombre.Length > 0 ? sorteo.Nombre : sorteo.Codigo)</span>
                @if (sorteo.EstaVencido)
                {
                    <span class="sello">ya se rifó</span>
                }
                else if (sorteo.FueAnunciado)
                {
                    <span class="sello sello--bien">en @sorteo.DiasParaElSorteo días</span>
                }
                else
                {
                    <span class="sello sello--dudoso">sin anunciar</span>
                }
                @* La fecha y nada más. El relato del dominio —«10 boletos para el sorteo
                   del 15/06/2026, que ya se rifó»— repetía la cifra de la derecha y el
                   sello de al lado. La cuenta se dice una vez, en la cifra. *@
                @if (sorteo.FueAnunciado)
                {
                    <div class="sorteo-relato">sorteo del @sorteo.FechaDelSorteo.ToString("d 'de' MMMM 'de' yyyy", Cultura)</div>
                }
            </div>
            <div>
                <div class="cifra cifra--chica">@Entero(sorteo.Boletos)</div>
                <div class="cifra-pie">@(sorteo.Boletos == 1 ? "boleto" : "boletos")</div>
            </div>
        </div>

        @if (sorteo.Premio.Length > 0)
        {
            @* El monto sale ENTERO del dominio, sin recortarle nada: el `Split(" en ")` que
               había acá venía copiado del gasto -que sí dice "en N cargas"- y sobre esta
               cadena no cortaba nunca. Una cirugía sobre prosa ajena que un día corta. *@
            <p class="sorteo-premio">Se rifa <b>@sorteo.Premio</b>@(sorteo.MontoPorBoleto.Length > 0
                ? $", un boleto por cada {sorteo.MontoPorBoleto} de una carga" : "").</p>
        }
    </div>
}

@if (explicaciones.Count > 0)
{
    <h2 class="seccion-titulo">De dónde salieron</h2>
    <p class="apunte">
        Es lo que el tiquete de la bomba no dice: cuántos boletos te dio cada carga, y
        cuánto sobró.
    </p>
    @* UNA TABLA, Y EN EL ORDEN DE LA RUTA. Nueve filas con la misma oración —«esta carga dio
       2 boletos; sobraron ₡4 600, que no se acumulan»— se leen una por una; en columnas se
       leen de un vistazo. Y de la más reciente a la más vieja, como la ruta: dos listas de
       las mismas cargas en orden contrario obligan a reorientarse al cambiar de pestaña.
       La fila que no cuadra conserva la frase del dominio, que es la que explica. *@
    <table class="explicaciones">
        <thead>
            <tr>
                <th scope="col">carga</th>
                <th scope="col" class="num">boletos</th>
                <th scope="col">sobró</th>
            </tr>
        </thead>
        <tbody>
            @foreach (BoletosDeLaCargaEnLista fila in Recientes())
            {
                <tr @key="@fila.Transaccion" class="@(fila.ProbablementeFaltaUnDato ? "explicacion--dudosa" : "")">
                    <td class="n">@fila.Fecha.ToString("dd MMM yyyy", Cultura)</td>
                    @if (fila.HayRegla && !fila.ProbablementeFaltaUnDato)
                    {
                        <td class="n num">@fila.Emitidos</td>
                        <td class="n">@fila.Sobrante</td>
                    }
                    else
                    {
                        <td colspan="2">@Mayuscula(fila.ParaSonia).</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private EstadoDeLealtad lealtad = new();
    private IReadOnlyList<SorteoEnLista> sorteos = new List<SorteoEnLista>();
    private IReadOnlyList<BoletosDeLaCargaEnLista> explicaciones = new List<BoletosDeLaCargaEnLista>();

    private int BoletosVigentes => Suma(vencidos: false);
    private int BoletosPasados => Suma(vencidos: true);
    private int SorteosVigentes => Cuenta(vencidos: false);
    private int SorteosPasados => Cuenta(vencidos: true);

    private int Suma(bool vencidos)
    {
        int cuantos = 0;
        foreach (SorteoEnLista sorteo in sorteos)
            if (sorteo.EstaVencido == vencidos) cuantos += sorteo.Boletos;
        return cuantos;
    }

    private int Cuenta(bool vencidos)
    {
        int cuantos = 0;
        foreach (SorteoEnLista sorteo in sorteos)
            if (sorteo.EstaVencido == vencidos) cuantos++;
        return cuantos;
    }

    // Lo mas reciente arriba, como la ruta.
    private List<BoletosDeLaCargaEnLista> Recientes()
    {
        var recientes = new List<BoletosDeLaCargaEnLista>(explicaciones);
        recientes.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return recientes;
    }

    protected override void Releer()
    {
        lealtad = Estado.Lealtad();

        // El "hoy" lo pone esta carátula: el dominio no lee el reloj, y si lo hiciera el
        // mismo journal reproducido mañana diría que un sorteo ya venció.
        sorteos = Estado.Sorteos(DateTime.Now);

        IReadOnlyList<VehiculoEnLista> vehiculos = Estado.Vehiculos();
        string placa = Estado.PlacaEnFoco(vehiculos);
        explicaciones = placa.Length == 0
            ? new List<BoletosDeLaCargaEnLista>()
            : Estado.BoletosDeLasCargas(placa);
    }
}
