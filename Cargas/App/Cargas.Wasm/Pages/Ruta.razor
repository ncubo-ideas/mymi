@page "/cargas"
@inherits PantallaDeCargas
@using System.Globalization
@using Cargas.App.Vistas

<PageTitle>@Texto["ruta.titulo"] · @Textos.NombreDeLaMarca</PageTitle>

<h1 class="ruta-titulo">@Texto["ruta.titulo"]</h1>

@* EL ERROR VA DONDE ESTABA LA MANO. Con veintiocho cargas, anotar en la de abajo y que el
   dominio rechace el número mostraba el parte arriba de todo, fuera de pantalla: el mismo
   argumento que ya se aplicó a «Se desbloqueó». Si el fallo nació en una parada, se dibuja en
   esa parada; si no (el lote, la lista), arriba. *@
@if (errorEn.Length == 0)
{
    <Problema De="Error" />
}

@* -------------------------------------------------------------- LA RUTA

   El camino de paradas y trechos. El objeto de este negocio es el TRAMO entre dos
   tanques llenos, así que la pantalla lo dibuja como lo que es, y el HUECO que lo
   bloquea es parte del camino: bache con riel punteado y el dato que lo destraba ahí
   mismo, no en una sección aparte al final. *@
@* SE LLAMA «CARGAS», no «Ruta». La ruta es la metáfora del dibujo —paradas, trechos y
   baches— y sigue en los nombres del CSS, pero como título le sonaba a GPS y a puntos
   visitados. Lo que hay acá son las cargas, una por parada. *@
<div class="ruta-cabeza">
    @* «Leído hasta el evento N» no va acá: es un dato de la app sobre sí misma, no del
       carro. Vive en Mi carro, con «dónde vive tu bitácora», que es donde se habla de la app. *@
    @if (completitud.TotalDeCargas > 0)
    {
        <p class="ruta-resumen">
            @completitud.TotalDeCargas @(completitud.TotalDeCargas == 1 ? "carga registrada" : "cargas registradas")
        </p>
    }
</div>

@* EL ÉXITO DEL LOTE, en el lugar de la barra que acaba de desaparecer: la persona mira ahí
   cuando apretó, y ahí tiene que estar la respuesta. Se va solo (ver AvisoDeListo). *@
@if (Listo.Texto.Length > 0 && listoEn.Length == 0)
{
    <div class="parte parte--listo parte--pasajero" role="status">@Listo.Texto</div>
}

@* EL RESUMEN DE PENDIENTES, compacto y AL INICIO -no compite con el historial completo
   de abajo-. @completitud.Expresada (el string del dominio) y @tanquesEstimados.Count
   (real, ya calculado en Releer) no se pierden: se leen acá, más chico, con el atajo de
   confirmar-todos como control secundario y no como protagonista de la pantalla. *@
@if (faltantesPorCarga.Count > 0)
{
    <div class="ruta-pendientes">
        <div class="ruta-pendientes-texto">
            <p class="ruta-pendientes-titulo">
                @faltantesPorCarga.Count @(faltantesPorCarga.Count == 1 ? "carga necesita" : "cargas necesitan") @Texto["ruta.necesitaRevision"]
            </p>
            @if (completitud.Expresada.Length > 0)
            {
                <p class="ruta-pendientes-pie">@completitud.Expresada</p>
            }
        </div>
        @* CONFIRMAR LOS TANQUES DE UNA VEZ. Cada carga nace con el tanque INFERIDO por la
           forma de corte y solo se pide el visto bueno; con nueve cargas eran nueve visto
           buenos iguales, uno por uno. Si en todas quedó como dice, se confirman juntas; si
           alguna no, se entra a esa. En contorno, no en ámbar: el atajo confirma N
           suposiciones de un golpe, así que el camino cuidadoso -carga por carga- se queda
           con el color de atención. *@
        @if (tanquesEstimados.Count >= 2)
        {
            <button class="tecla tecla--contorno ruta-pendientes-cta" @onclick="ConfirmarTodosLosTanques" disabled="@(confirmando > 0)">
                @(confirmando > 0
                    ? Texto.Con("ruta.confirmandoLote", ("cual", Entero(confirmando)), ("cuantas", Entero(tanquesEstimados.Count)))
                    : Texto.Con("ruta.confirmarLote", ("cuantas", Entero(tanquesEstimados.Count))))
            </button>
        }
    </div>
}

@if (cargas.Count == 0)
{
    @* Mismo criterio que la franja del Tablero: mientras la app está yendo a la estación no
       se le pide a la persona que apriete una tecla que ya está en «Actualizando…». *@
    @if (Estado.Refrescando)
    {
        <p class="apunte">@Texto["tablero.buscando"]</p>
    }
    else
    {
        <p class="apunte">@((MarkupString)Texto.Con("tablero.sinCargas", ("actualizar", "<em>" + Texto["comun.actualizar"] + "</em>")))</p>
    }
}
else
{
    <ol class="ruta">
        @{
            List<CargaEnLista> camino = Recientes();
            DateTime mesAbierto = DateTime.MinValue;
        }
        @for (int i = 0; i < camino.Count; i++)
        {
            CargaEnLista parada = camino[i];
            List<FaltanteEnLista> pendientes = FaltantesDe(parada.Transaccion);
            bool detalleAbierto = filasAbiertas.Contains(parada.Transaccion);

            @* AGRUPADO POR MES, con el mismo dato real -parada.Fecha- que ya ordena la
               ruta: nada nuevo que calcular fuera de esta pantalla, solo un rótulo cuando
               el mes cambia respecto de la carga anterior. *@
            DateTime mesDeEsta = new DateTime(parada.Fecha.Year, parada.Fecha.Month, 1);
            if (mesDeEsta != mesAbierto)
            {
                mesAbierto = mesDeEsta;
                <li class="ruta-mes" @key="@($"mes-{mesDeEsta:O}")">@mesDeEsta.ToString("MMMM yyyy", Cultura)</li>
            }

            @* tabindex=-1: la parada recibe el foco por programa cuando la tecla que lo tenía
               desaparece (ver Enfocar), y no entra en el orden de tabulación. *@
            <li class="eslabon parada @(pendientes.Count > 0 ? "parada--pendiente" : "")"
                @key="@($"parada-{parada.Transaccion}")" tabindex="-1"
                @ref="paradas[parada.Transaccion]">
                <div class="eslabon-riel"><span class="parada-punto"></span></div>
                <div class="eslabon-cuerpo">
                    @* EL RESUMEN, SIEMPRE VISIBLE Y SIEMPRE COMPACTO: fecha+monto, litros/tipo/
                       surtidor, y el único chip que hace falta para escanear -tanque, o qué
                       falta-. Todo lo demás -precio/L, kilometraje anotado, cambiar tanque, la
                       foto, y el formulario de lo que falta- vive en el detalle, que se abre al
                       tocar. Con nueve cargas sin aportes, nueve formularios SIEMPRE abiertos
                       hacían que la pantalla entera pareciera un formulario; ahora son nueve
                       resúmenes de tres líneas, y quien quiere trabajar una la abre. *@
                    <button type="button" class="parada-resumen" aria-expanded="@(detalleAbierto ? "true" : "false")"
                            @onclick="() => AlternarDetalle(parada.Transaccion)">
                        <span class="parada-resumen-fila">
                            <span class="parada-fecha">@parada.Fecha.ToString(Texto["comun.formatoDeFechaCorta"], Cultura)</span>
                            <span class="parada-monto">@Simbolo(parada.Moneda)@Plata(parada.Total)</span>
                        </span>
                        @* EL PRECIO/L VIVE ACÁ, chico y de siempre -no como protagonista al
                           abrir la carga-: es la misma jerarquía que litros/tipo/surtidor, ni
                           más ni menos, y así nunca compite con la tarea del detalle. *@
                        <span class="parada-resumen-datos">@parada.Volumen @Texto["ruta.de"] @parada.Tipo &middot; @Texto["ruta.surtidor"] @parada.Surtidor &middot; @Simbolo(parada.Moneda)@Plata(parada.Precio)/L</span>
                        @if (parada.Tanque.Length > 0 || pendientes.Count > 0)
                        {
                            <span class="parada-resumen-chips">
                                @if (parada.Tanque.Length > 0)
                                {
                                    <span class="parada-tanque @(parada.ClaveDelTanque == "lleno" ? "" : "parada-tanque--parcial")">@Texto["ruta.tanque"] @parada.Tanque</span>
                                }
                                @if (pendientes.Count > 0)
                                {
                                    <span class="parada-alerta">@TextoDePendiente(pendientes)</span>
                                }
                            </span>
                        }
                        <span class="faro-icon faro-icon--flecha parada-chevron" aria-hidden="true"></span>
                    </button>

                    @if (detalleAbierto)
                    {
                    @* LA TAREA PRINCIPAL ES LA PRIMERA PENDIENTE, EN EL MISMO ORDEN DEL DOMINIO.
                       Vehiculo.Faltantes() agrega, por carga, primero "el kilometraje" y después
                       "la confirmación del tanque" -es el mismo orden que ya usaba Tablero.razor
                       para elegir el próximo pendiente de Inicio-, así que pendientes[0] YA ES la
                       prioridad real, sin inventar una regla nueva acá. Cuando se resuelve, Releer
                       vuelve a correr (Avisar → Cambio → Releer) y pendientes[0] pasa sola a ser
                       la siguiente: es progressive disclosure sin wizard, el detalle no guarda en
                       qué paso está, solo mira qué falta HOY. *@
                    FaltanteEnLista? tarea = pendientes.Count > 0 ? pendientes[0] : null;
                    <div class="parada-detalle">
                        @* EL RECAP: lo que ya se sabe de esta carga y no es la tarea de hoy -el
                           kilometraje si ya está, el tanque si ya no espera confirmación-. Chico y
                           al principio, nunca compitiendo con la tarea. *@
                        @if (parada.TieneKilometraje || (parada.Tanque.Length > 0 && !EsperaConfirmacion(pendientes)))
                        {
                            <div class="parada-recap">
                                @if (parada.TieneKilometraje)
                                {
                                    @* EN COBRE (turquesa): es el único dato de la fila que puso
                                       ELLA -la otra procedencia del mismo hecho-. *@
                                    <span class="n aporte" title="@Texto.Con("ruta.loAnotasteVos", ("origen", Texto.ComoSeDice(parada.OrigenDelKilometraje)))">@parada.KilometrajeAnotado @unidades.Distancia</span>
                                }
                                @* CORREGIR UN TANQUE YA DICHO. «Confirmar los 28 tanques» confirma
                                   veintiocho suposiciones de un golpe, y una que estaba mal no
                                   tenía vuelta. Ahora es una frase legible -no un link aislado- con
                                   su corrección al lado; no aparece mientras la pregunta de
                                   confirmar sigue abierta, que ya la incluye como tarea. *@
                                @if (parada.Tanque.Length > 0 && !EsperaConfirmacion(pendientes))
                                {
                                    <span class="parada-recap-tanque">
                                        @Texto["ruta.tanque"] @parada.Tanque.
                                        <button type="button" class="parada-corregir"
                                                aria-label="@Texto.Con("ruta.cambiarTanqueAria",
                                                    ("fecha", parada.Fecha.ToString(Texto["comun.formatoDeDiaYMes"], Cultura)),
                                                    ("quedo", Texto.ComoSeDice(parada.ClaveDelTanque)),
                                                    ("pasaA", Texto.ComoSeDice(Contrario(parada.ClaveDelTanque))))"
                                                @onclick="() => CorregirTanque(parada.Transaccion)">@Texto["ruta.cambiar"]</button>
                                    </span>
                                }
                            </div>
                        }

                        @* LA FOTO QUE YA EXISTE se puede volver a mirar desde la parada. NO HAY
                           OCR -el spike lo descartó, 4/6 en el caso más fácil-, así que la foto no
                           reemplaza a la persona, le quita la necesidad de acordarse. Se lee bajo
                           demanda y no al abrir: son varios MB cada una. *@
                        @if (parada.TieneFoto && !fotoPorCarga.ContainsKey(parada.Transaccion))
                        {
                            <button class="tecla tecla--texto tecla--icono parada-ver-foto"
                                    @onclick="() => VerLaFoto(parada.Transaccion, parada.Foto)">
                                <svg class="tecla-icono" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.2 7.4h3.1l1.6-2.2h4.2l1.6 2.2h3.1v8.4H3.2z" /><circle cx="10" cy="11.4" r="2.6" /></svg>
                                @Texto["ruta.verLaFoto"]
                            </button>
                        }

                        @* EL REFUERZO: al cerrar un tramo se muestra lo que se DESBLOQUEÓ, no una
                           insignia. El premio es información sobre su carro. *@
                        @if (desbloqueado.Length > 0 && desbloqueadoEn == parada.Transaccion)
                        {
                            <div class="parte parte--listo parada-logro" role="status"><strong>@Texto["ruta.seDesbloqueo"]</strong> @desbloqueado</div>
                        }

                        @if (Listo.Texto.Length > 0 && listoEn == parada.Transaccion)
                        {
                            <div class="parte parte--listo parte--pasajero parada-logro" role="status">@Listo.Texto</div>
                        }

                        @if (Error.Hay && errorEn == parada.Transaccion)
                        {
                            <div class="parada-logro"><Problema De="Error" /></div>
                        }

                        @if (fotoPorCarga.TryGetValue(parada.Transaccion, out string? laFoto))
                        {
                            <figure class="foto">
                                <img src="@laFoto" alt="@Texto.Con("ruta.fotoAria", ("fecha", parada.Fecha.ToString(Texto["comun.formatoDeFechaCorta"], Cultura)))" />
                                @if (!parada.TieneKilometraje)
                                {
                                    <figcaption>@Texto["ruta.leeElOdometro"]</figcaption>
                                }
                            </figure>
                        }

                        @* LA TAREA: QUÉ FALTA → POR QUÉ → QUÉ HACER → lo secundario, en ese
                           orden y con ese peso. El kilometraje llega PRELLENADO con la proyección
                           -«¿unos 42 900?»- para que confirmar sea más fácil que recordar y
                           teclear: si ella lo acepta tal cual entra confirmado, si lo edita,
                           observado. Nunca se escribe solo. *@
                        @if (tarea is not null)
                        {
                            <div class="parada-tarea" @key="@($"tarea-{tarea.Transaccion}-{tarea.ClaveDeLoQueFalta}")">
                                <span class="parada-tarea-eyebrow">@Texto["ruta.completaEstaCarga"]</span>
                                @if (tarea.ClaveDeLoQueFalta == ElKilometraje)
                                {
                                    <p class="parada-tarea-titulo">@Texto["ruta.faltaElKilometrajeTitulo"]</p>
                                    <p class="parada-tarea-texto">
                                        @Texto["ruta.ingresaElKilometraje"]@(tarea.QueDesbloquea.Length > 0
                                            ? $" para poder calcular {tarea.QueDesbloquea}" : "").
                                    </p>
                                    @* VACÍO ES VACÍO, no «0». El campo sin valor mostraba un cero,
                                       y «Agregar» con cero no hacía nada y no decía nada. Ahora el
                                       valor nulo omite el atributo, el placeholder dice qué va, y
                                       la tecla se apaga hasta que haya un número. Es @oninput y no
                                       @onchange para que la tecla se prenda mientras se teclea, no
                                       al salir del campo. *@
                                    <input class="campo parada-tarea-campo" type="number" inputmode="numeric" min="1"
                                           aria-label="@Texto.Con("ruta.campoAria", ("unidad", unidades.Distancia))"
                                           placeholder="@Texto.Con("ruta.campoPlaceholder", ("unidad", unidades.Distancia))"
                                           value="@KilometrajeOVacio(tarea.Transaccion)"
                                           @oninput="e => AnotarEnElCampo(tarea.Transaccion, e)" />
                                    <button class="tecla parada-tarea-cta"
                                            disabled="@(Kilometraje(tarea.Transaccion) <= 0)"
                                            @onclick="() => AgregarKilometraje(tarea.Transaccion)">
                                        @Texto["ruta.agregarKilometraje"] <span aria-hidden="true">→</span>
                                    </button>
                                    @* La sugerencia SOLO donde se puede proyectar: la carga más
                                       reciente que espera kilometraje. Ver Releer(). Ponerla en
                                       todas sería sugerir el kilometraje de hoy para una carga de
                                       hace ocho meses. *@
                                    @if (propuesta.Hay && tarea.Transaccion == transaccionConPropuesta)
                                    {
                                        <p class="apunte parada-tarea-apunte">@Texto.Con("ruta.sugerencia",
                                            ("odometro", Entero(propuesta.KilometrosComoSeVen) + " " + propuesta.SimboloDeLaDistancia),
                                            ("promedio", Cifra(propuesta.PorDiaComoSeVe) + " " + propuesta.SimboloDeLaDistancia))</p>
                                    }
                                    @* LO QUE DESTRABA. Un mismo kilometraje puede bloquear dos
                                       tramos -el que termina en esta carga y el que arranca en
                                       ella-. Singular y plural explícitos. *@
                                    @if (tramosQueDestraba.TryGetValue(tarea.Transaccion, out int destraba) && destraba > 0)
                                    {
                                        <p class="bache-desbloquea">
                                            @Texto.Con(destraba == 1 ? "ruta.destrabaUnTramo" : "ruta.destrabaTramos",
                                                ("cuantos", Entero(destraba)))
                                        </p>
                                    }
                                    @* LA FOTO, ACCIÓN SECUNDARIA: es la otra forma de traer el
                                       número -sacás la foto en la bomba y lo tecleás después, en
                                       el sillón-, no otra tarea del mismo peso. Solo mientras falta
                                       el kilometraje y hay DESTINO donde guardarla: la carpeta
                                       elegida en el modo suelto, o los archivos de Gnothi
                                       hospedada. HayCarpeta era solo lo primero y hospedada el
                                       botón no existía (medido el 2026-09-11 en un iPhone). El
                                       input NO otorga cámara: el selector es del sistema y en
                                       móvil ya ofrece «tomar foto». *@
                                    @if (!parada.TieneFoto && Estado.HayDestino)
                                    {
                                        @* UN <label> NO LLEGA POR TECLADO: no entra en el orden de
                                           tabulación y Enter no lo activa. tabindex lo mete en el
                                           orden y el onkeydown traduce Enter y Espacio al click del
                                           input escondido, que es lo que hace el mouse. *@
                                        <label class="tecla tecla--contorno tecla--icono parada-tarea-secundaria" tabindex="0" role="button"
                                               onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.querySelector('input').click(); }">
                                            <svg class="tecla-icono" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.2 7.4h3.1l1.6-2.2h4.2l1.6 2.2h3.1v8.4H3.2z" /><circle cx="10" cy="11.4" r="2.6" /></svg>
                                            @Texto["ruta.fotoDelOdometro"]
                                            <InputFile OnChange="e => GuardarFoto(parada.Transaccion, e)"
                                                       accept="image/*" style="display:none" />
                                        </label>
                                    }
                                }
                                else if (tarea.ClaveDeLoQueFalta == LaConfirmacionDelTanque)
                                {
                                    @* ENUNCIAR, Y DESPUÉS PREGUNTAR. La suposición la hace el
                                       dominio (FormaDeCorte), así que la frase viene de ahí; acá
                                       solo se le agrega la pregunta que la sigue. *@
                                    <p class="parada-tarea-titulo">@Mayuscula(tarea.LaSuposicion). ¿Fue así?</p>
                                    @if (tarea.QueDesbloquea.Length > 0)
                                    {
                                        <p class="parada-tarea-texto">@Texto.Con("ruta.siEsAsi", ("desbloqueo", tarea.QueDesbloquea))</p>
                                    }
                                    <div class="parada-tarea-acciones">
                                        <button class="tecla parada-tarea-cta"
                                                @onclick="() => ConfirmarTanque(tarea.Transaccion)">
                                            @Texto[SuponeLleno(tarea) ? "ruta.siQuedoLleno" : "ruta.asiFueUnMonto"]
                                        </button>
                                        <button class="tecla tecla--contorno"
                                                @onclick="() => CorregirTanque(tarea.Transaccion)">
                                            @Texto[SuponeLleno(tarea) ? "ruta.noSoloUnPoco" : "ruta.noLoLlene"]
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    }
                </div>
            </li>

            @* EL TRECHO QUE ESTA PARADA CIERRA, o el BACHE si está bloqueado. Cuelga
               de la carga que lo CIERRA y declara desde dónde viene, porque un tramo
               no siempre une dos paradas vecinas: una carga PARCIAL en el medio no
               cierra tramo, y el que la salta va de un tanque lleno al siguiente. Con
               la pareja adyacente no aparecía ninguno.

               Sin tramo no se dibuja nada: la primera carga de la historia no cierra
               nada, y una parcial tampoco. Eso no es un hueco, es que ahí no hay
               tramo que medir. *@
            TramoEnLista? tramo = TramoQueCierraEn(parada.Fecha);
            if (tramo is not null)
            {
                if (tramo.EstaCalculado)
                {
                    <li class="eslabon trecho @(tramo.EsComparable ? "" : "trecho--reservado")
                               @(tramo.EsSospechoso ? "trecho--atencion" : "")"
                        @key="@($"trecho-{tramo.Desde:O}")">
                        <div class="eslabon-riel"></div>
                        <div class="eslabon-cuerpo">
                            <div class="trecho-cifras">
                                <span class="trecho-rinde">@Cifra(tramo.RendimientoComoSeVe)<span class="unidad">@tramo.SimboloDelRendimiento</span></span>
                                <span class="trecho-dato">@Entero(tramo.KilometrosComoSeVen) @tramo.SimboloDeLaDistancia</span>
                                <span class="trecho-dato">@Cifra(tramo.Litros) L</span>
                                <span>@Texto.Con("ruta.desdeEl", ("fecha", tramo.Desde.ToString(Texto["comun.formatoDeDiaYMes"], Cultura)))</span>
                                @if (tramo.EsSospechoso)
                                {
                                    <span class="sello sello--dudoso">@Texto.ComoSeDice("dato-sospechoso")</span>
                                }
                            </div>

                            @if (rendimiento.Habitual > 0 && tramo.EsComparable)
                            {
                                @* La muesca es el nivel de siempre de ESTE carro, nunca
                                   un promedio nacional: un trecho solo no significa
                                   nada, significa contra su propia línea base. *@
                                <div class="trecho-barra" role="img"
                                     aria-label="@Texto.Con("ruta.barraAria",
                                         ("rinde", Cifra(tramo.RendimientoComoSeVe) + " " + tramo.SimboloDelRendimiento),
                                         ("habitual", Cifra(rendimiento.HabitualComoSeVe) + " " + rendimiento.Simbolo))">
                                    <span class="relleno" style="width:@Ancho(tramo.Rendimiento)%"></span>
                                    <span class="muesca" style="left:60%"></span>
                                </div>
                            }

                            @if (!tramo.EsComparable && tramo.MotivoDeReserva.Length > 0)
                            {
                                @* El motivo viene del dominio como frase nominal —«otro
                                   surtidor»— y pelado no se entiende qué hace ahí. El marco
                                   lo pone la carátula; el literal no se toca. *@
                                <p class="cifra-pie">@Texto.Con("ruta.noSeCompara", ("motivo", tramo.MotivoDeReserva))</p>
                            }
                        </div>
                    </li>
                }
                else
                {
                    @* EL BACHE, a una línea. El riel sigue punteado -ahí el camino no se midió-
                       pero el texto ya no compite con la carga que lo destraba, que es donde
                       vive el formulario y donde se dice cuántos tramos abre. La fecha se
                       compone acá con el mismo «dd MMM» del resto de la ruta: la frase del
                       dominio (tramo.QueFalta) trae «25/07/2026», y en la misma pantalla que
                       «desde el 25 jul» eran dos calendarios. *@
                    <li class="eslabon bache" @key="@($"bache-{tramo.Desde:O}")">
                        <div class="eslabon-riel"></div>
                        <div class="eslabon-cuerpo">
                            <p class="bache-linea">@Texto["ruta.sinCalcular"] &middot; @EsperaDelBache(tramo)</p>
                        </div>
                    </li>
                }
            }
        }
    </ol>
}

@code {
    // LOS DOS CODIGOS CON QUE ESTA PANTALLA DECIDE que formulario dibujar. Son identidad y no
    // prosa: decidir sobre la frase dejaria de decidir en cuanto la frase cambie de idioma.
    private const string ElKilometraje = "kilometraje";
    private const string LaConfirmacionDelTanque = "confirmacion-del-tanque";

    private IReadOnlyList<VehiculoEnLista> vehiculos = new List<VehiculoEnLista>();
    private IReadOnlyList<CargaEnLista> cargas = new List<CargaEnLista>();
    private IReadOnlyList<TramoEnLista> tramos = new List<TramoEnLista>();
    private IReadOnlyList<FaltanteEnLista> faltantes = new List<FaltanteEnLista>();
    private RendimientoDelVehiculo rendimiento = new();
    private AutonomiaDelVehiculo autonomia = new();
    private CompletitudDelVehiculo completitud = new();
    private OdometroPropuesto propuesta = new();
    private UnidadesElegidas unidades = new();

    // QUÉ PARADAS TIENEN EL DETALLE ABIERTO -litros/precio/kilometraje, foto, cambiar
    // tanque, y el formulario de lo que falta-. Cualquier número a la vez, no una sola:
    // a diferencia del viejo acordeón de "la pendiente desplegada", acá quien abre una
    // carga para trabajarla no le cierra la puerta a la que ya tenía abierta. No se
    // reinicia en Releer -sobrevive a que la lectura se actualice, igual que el
    // kilometraje que se está tecleando-.
    private readonly HashSet<string> filasAbiertas = new();

    private void AlternarDetalle(string transaccion)
    {
        if (!filasAbiertas.Add(transaccion)) filasAbiertas.Remove(transaccion);
    }

    // EL CHIP DEL RESUMEN: un estado, no una lista. Con más de un faltante a la vez
    // -pasa: falta el kilometraje Y la confirmación del tanque- decir los dos en un
    // chip de tres palabras es imposible sin mentir por omisión, así que el resumen dice
    // "faltan datos" y el detalle, que ya lista cada FaltanteEnLista por separado, cuenta
    // el resto.
    private static string TextoDePendiente(List<FaltanteEnLista> pendientes) =>
        pendientes.Count > 1 ? "faltan datos"
            : EsperaConfirmacion(pendientes) ? "falta confirmar el tanque" : "falta el kilometraje";

    // El prellenado, UNO POR CARGA (llave: el numero de transaccion). Si ella manda la
    // propuesta tal cual, su origen es "confirmado" -miro el numero y dijo que si-; si la
    // edita, "observado".
    private Dictionary<string, decimal> kilometrajePorAnotar = new();

    private decimal Kilometraje(string transaccion) =>
        kilometrajePorAnotar.TryGetValue(transaccion, out decimal km) ? km : 0m;

    // Lo que ve el campo: el numero si hay, y NADA si no. Blazor omite el atributo con
    // null, y asi el placeholder se ve en vez de un cero que parece un dato.
    private string? KilometrajeOVacio(string transaccion) =>
        kilometrajePorAnotar.TryGetValue(transaccion, out decimal km) && km > 0
            ? km.ToString(CultureInfo.InvariantCulture) : null;

    // La carga a la que se le propuso la proyeccion, si hay alguna. Vacio si no.
    private string transaccionConPropuesta = "";

    private void AnotarEnElCampo(string transaccion, ChangeEventArgs e)
    {
        kilometrajePorAnotar[transaccion] =
            decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture,
                out decimal km) ? km : 0m;
    }

    // El refuerzo del ingreso: lo que aparecio al cerrar un tramo, y EN QUE CARGA se anoto,
    // para mostrarlo ahi y no arriba de todo.
    private string desbloqueado = "";
    private string desbloqueadoEn = "";

    // LAS FOTOS QUE SE ESTAN MIRANDO, por transaccion, ya como data URL. Se cargan bajo
    // demanda y no al abrir: una foto de tablero ronda los pocos MB y esta pantalla puede
    // tener nueve. La que se acaba de sacar entra sin releer nada, porque sus bytes ya
    // pasaron por aca.
    private Dictionary<string, string> fotoPorCarga = new();

    // EL FOCO NO SE PIERDE AL ACTUAR. «Sí, quedó lleno» y «Agregar kilometraje» desaparecen
    // al hacer su trabajo, y el foco caía al body: quien navega por teclado volvía a empezar
    // desde arriba. La parada que se tocó lo recibe en el render siguiente, que es cuando
    // la tecla ya no está y la parada ya existe con su estado nuevo. Con mouse no se ve nada
    // (focus-visible no se aplica al foco programático tras un click); con teclado se ve el
    // anillo de la casa alrededor de la parada, que además dice dónde quedó lo que hizo.
    private readonly Dictionary<string, ElementReference> paradas = new();
    private string porEnfocar = "";

    private void Enfocar(string transaccion) => porEnfocar = transaccion;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (porEnfocar.Length == 0) return;
        string transaccion = porEnfocar;
        porEnfocar = "";
        if (paradas.TryGetValue(transaccion, out ElementReference parada))
            await parada.FocusAsync();
    }

    // EN QUE PARADA nació el último fallo: "" cuando fue arriba (el lote, la lista). Se
    // asigna ANTES de Intentar, que limpia Error; si la acción sale bien no se dibuja nada.
    private string errorEn = "";

    private Task VerLaFoto(string transaccion, string nombreDeArchivo) =>
        Intentar("abrir-la-foto-del-tablero", async () =>
        {
            errorEn = transaccion;
            string base64 = await Estado.LeerFoto(nombreDeArchivo);
            if (base64.Length == 0)
                throw new RechazoDeLaApp("foto-ilegible", ("archivo", nombreDeArchivo));

            fotoPorCarga[transaccion] = $"data:{TipoDeImagen(nombreDeArchivo)};base64,{base64}";
        });

    // El tipo sale de la extension y no de los bytes: el archivo lo guardo esta misma app,
    // con la extension que traia el que ella eligio.
    private static string TipoDeImagen(string nombreDeArchivo) =>
        Path.GetExtension(nombreDeArchivo).ToLowerInvariant() switch
        {
            ".png"  => "image/png",
            ".webp" => "image/webp",
            ".heic" => "image/heic",
            ".heif" => "image/heif",
            _       => "image/jpeg",
        };

    // ------------------------------------------------------------------ el camino

    // EL ANCHO DE LA BARRA DEL TRECHO. El nivel de siempre se planta en el 60% para que un
    // tramo mejor que el habitual tenga hacia donde crecer: con el habitual al 100% toda
    // mejora quedaria clavada contra el borde y se leerian iguales.
    private string Ancho(decimal rinde)
    {
        if (rendimiento.Habitual <= 0m) return "0";
        double proporcion = (double)(rinde / rendimiento.Habitual) * 60.0;
        return Math.Clamp(proporcion, 2, 100).ToString("0.#", CultureInfo.InvariantCulture);
    }

    // EL TRAMO QUE ESTA CARGA CIERRA. Es un emparejamiento de PRESENTACION -el dominio ya
    // dijo cuales son los tramos y entre que fechas-, no una regla.
    //
    // Se busca por la fecha que lo CIERRA y no por la pareja adyacente, porque un tramo va
    // de un tanque lleno al siguiente y en el medio puede haber una carga PARCIAL que no lo
    // cierra. Con adyacencia no aparecia ninguno de los que saltan una parcial, que en el
    // guion de la demo son justo los interesantes.
    //
    // POR DICCIONARIO Y NO RECORRIENDO LA LISTA: esto se llama una vez por parada, asi que
    // un barrido adentro convierte el dibujo de la ruta en cuadratico.
    private Dictionary<DateTime, TramoEnLista> tramoPorCierre = new();
    private Dictionary<string, List<FaltanteEnLista>> faltantesPorCarga = new();

    // QUIEN DESTRABA CADA BACHE. Un tramo bloqueado espera el kilometraje de la carga sin
    // odometro que esta en uno de sus extremos: en SerieDeTramos la trunca es `Hasta` en el
    // tramo fino hacia atras y `Desde` en el fino hacia adelante, y pueden faltar los dos.
    // De aca salen la linea del bache («espera el kilometraje del 25 jul») y la cuenta que se
    // le dice a la carga («con este kilometraje se calculan 2 tramos»). Es emparejamiento
    // de PRESENTACION por fecha, igual que TramoQueCierraEn: el dominio ya dijo cuales son
    // los tramos y entre que fechas.
    private Dictionary<string, int> tramosQueDestraba = new();
    private Dictionary<DateTime, List<DateTime>> fechasQueEsperaElBache = new();

    private string EsperaDelBache(TramoEnLista tramo)
    {
        if (!fechasQueEsperaElBache.TryGetValue(tramo.Desde, out List<DateTime>? fechas) || fechas.Count == 0)
            return Texto["ruta.esperaUnKilometraje"];
        if (fechas.Count == 1)
            return Texto.Con("ruta.esperaElKilometrajeDel",
                ("fecha", fechas[0].ToString(Texto["comun.formatoDeDiaYMes"], Cultura)));
        return Texto.Con("ruta.esperaLosKilometrajesDel",
            ("una", fechas[0].ToString(Texto["comun.formatoDeDiaYMes"], Cultura)),
            ("otra", fechas[1].ToString(Texto["comun.formatoDeDiaYMes"], Cultura)));
    }

    /// <summary>El otro estado del tanque, para la tecla que corrige lo que se supuso.</summary>
    private static string Contrario(string claveDelTanque) =>
        claveDelTanque == "lleno" ? "parcial" : "lleno";

    private static readonly List<FaltanteEnLista> SinPendientes = new();

    private TramoEnLista? TramoQueCierraEn(DateTime hasta) =>
        tramoPorCierre.TryGetValue(hasta, out TramoEnLista? tramo) ? tramo : null;

    private List<FaltanteEnLista> FaltantesDe(string transaccion) =>
        faltantesPorCarga.TryGetValue(transaccion, out List<FaltanteEnLista>? pendientes)
            ? pendientes : SinPendientes;

    private static bool EsperaConfirmacion(List<FaltanteEnLista> pendientes)
    {
        foreach (FaltanteEnLista pendiente in pendientes)
            if (pendiente.ClaveDeLoQueFalta == LaConfirmacionDelTanque) return true;
        return false;
    }

    // Los dos botones salen de lo que el DOMINIO supuso, no de dos rotulos fijos: con
    // corte automatico se supone lleno y con preseteado, parcial, y la pregunta correcta
    // es la contraria en cada caso.
    private static bool SuponeLleno(FaltanteEnLista faltante) =>
        faltante.LoQueSeSupone == "lleno";

    // Lo mas reciente arriba: la ruta desciende hacia el pasado, que es como se mira un
    // historial y como se lee un tablero -lo de ahora primero.
    private List<CargaEnLista> Recientes()
    {
        var recientes = new List<CargaEnLista>(cargas);
        recientes.Sort((una, otra) => otra.Fecha.CompareTo(una.Fecha));
        return recientes;
    }

    // ------------------------------------------------------------------ los aportes

    // EL APORTE DE ELLA. Si mando la propuesta sin tocarla, su origen es confirmado -miro
    // el numero y dijo que si-; si lo edito, observado. Nunca entra solo.
    private Task AgregarKilometraje(string transaccion) => Intentar("anotar-el-kilometraje", async () =>
    {
        errorEn = transaccion;
        decimal kilometraje = Kilometraje(transaccion);
        if (kilometraje <= 0) return;

        desbloqueado = "";
        desbloqueadoEn = transaccion;

        // LOS TRAMOS QUE YA ESTABAN, para saber cuáles nacen con este kilometraje. Antes el
        // parte decía «el rendimiento de ese tramo» y ponía rendimiento.Actual, que es el
        // ÚLTIMO tramo de la serie y no el que esta carga cerró: anotar la carga del 20 jun
        // hacía nacer un tramo de 32.3 y el parte decía 33.7. Un refuerzo que miente por un
        // decimal enseña a no leerlo. Se identifican por Desde, que un tramo no comparte.
        var calculadosAntes = new HashSet<DateTime>();
        foreach (TramoEnLista tramo in tramos)
            if (tramo.EstaCalculado) calculadosAntes.Add(tramo.Desde);
        // La comparacion tiene que ser contra la propuesta COMO SE VE: es el numero que
        // ella tuvo delante. Contra la canonica, aceptar la sugerencia en millas entraria
        // como "observado" en vez de "confirmado".
        string origen = propuesta.Hay && kilometraje == propuesta.KilometrosComoSeVen
            ? "confirmado" : "observado";

        // LA UNIDAD ES LA DEL CAMPO, no "km" clavado: si la persona mira en millas, el
        // numero que acaba de leer son millas, y el dominio necesita saberlo para
        // normalizar. Mandar km sobre una lectura en millas la mete 1.6 veces mas grande.
        string rechazo = await Estado.AnotarOdometro(transaccion, kilometraje,
            unidades.Distancia, origen);
        if (rechazo.Length > 0) throw new RechazoDeLaApp("kilometraje-rechazado");

        Enfocar(transaccion);

        // Releer ya corrió (Avisar → Cambio → Releer, sincrónico), así que `tramos` es la
        // serie de después. Un kilometraje puede cerrar DOS tramos —el que termina en esta
        // carga y el que arranca en ella—, y los dos se nombran.
        var nuevos = new List<TramoEnLista>();
        foreach (TramoEnLista tramo in tramos)
            if (tramo.EstaCalculado && !calculadosAntes.Contains(tramo.Desde)) nuevos.Add(tramo);

        if (nuevos.Count == 1)
            desbloqueado = Texto.Con("ruta.desbloqueoUnTramo",
                ("rinde", Cifra(nuevos[0].RendimientoComoSeVe) + " " + nuevos[0].SimboloDelRendimiento));
        else if (nuevos.Count > 1)
        {
            var cifras = new List<string>();
            foreach (TramoEnLista tramo in nuevos)
                cifras.Add($"{Cifra(tramo.RendimientoComoSeVe)} {tramo.SimboloDelRendimiento}");
            desbloqueado = Texto.Con("ruta.desbloqueoVariosTramos",
                ("cuantos", Entero(nuevos.Count)),
                ("rinden", string.Join(Texto["comun.y"], cifras)));
        }
        if (desbloqueado.Length > 0 && autonomia.Hay)
            desbloqueado += " " + Texto.Con("ruta.desbloqueoAutonomia",
                ("autonomia", Entero(autonomia.Kilometros) + " km"));
    });

    // Las cargas que esperan el visto bueno del tanque, en el orden de los faltantes.
    private List<string> tanquesEstimados = new();

    // 0 = quieto; n = va por la n-esima. Es lo que la tecla cuenta mientras trabaja.
    private int confirmando;

    // N COMANDOS Y NO UNO. No hay comando de lote en el dominio y no se agrega: cada
    // confirmacion lleva su Check, su entrada en el journal y su flush, igual que si ella las
    // hubiera tocado de a una. La lista se copia antes porque cada ConfirmarTanque avisa y
    // Releer la reescribe abajo nuestro. Un rechazo no frena a los demas: se juntan y se
    // dicen al final.
    private Task ConfirmarTodosLosTanques() => Intentar("confirmar-los-tanques-estimados", async () =>
    {
        errorEn = "";
        var porConfirmar = new List<string>(tanquesEstimados);
        var rechazos = new List<string>();
        try
        {
            for (int i = 0; i < porConfirmar.Count; i++)
            {
                confirmando = i + 1;
                string rechazo = await Estado.ConfirmarTanque(porConfirmar[i]);
                if (rechazo.Length > 0) rechazos.Add($"{porConfirmar[i]}: {rechazo}");
            }
        }
        finally
        {
            confirmando = 0;
        }

        if (rechazos.Count > 0)
            throw new RechazoDeLaApp("lote-con-rechazos",
                ("entraron", Entero(porConfirmar.Count - rechazos.Count)),
                ("total", Entero(porConfirmar.Count)),
                ("rechazos", string.Join("; ", rechazos)));

        listoEn = "";
        MostrarListo(porConfirmar.Count == 1
            ? Texto["ruta.listoUnTanque"]
            : Texto.Con("ruta.listoVariosTanques", ("cuantos", Entero(porConfirmar.Count))));
    });

    // EN QUÉ PARADA se dibuja el éxito: la transacción, o "" para el de arriba (el lote).
    private string listoEn = "";

    // El texto dice QUÉ quedó, no solo que quedó: con «lleno» o «parcial» a la vista, la
    // persona que confirmó por costumbre todavía puede darse cuenta de que no era.
    private string QueQuedo(string transaccion)
    {
        foreach (CargaEnLista carga in cargas)
            if (carga.Transaccion == transaccion) return carga.ClaveDelTanque;
        return "";
    }

    private Task ConfirmarTanque(string transaccion) => Intentar("confirmar-el-tanque", async () =>
    {
        errorEn = transaccion;
        string rechazo = await Estado.ConfirmarTanque(transaccion);
        if (rechazo.Length > 0) throw new RechazoDeLaApp(rechazo);

        listoEn = transaccion;
        Enfocar(transaccion);
        string quedo = QueQuedo(transaccion);
        MostrarListo(quedo.Length > 0
            ? Texto.Con("ruta.confirmadoTanque", ("tanque", Texto.ComoSeDice(quedo)))
            : Texto["ruta.confirmado"]);
    });

    // "Era al reves": lo que la inferencia propuso no era. Se declara lo contrario, con la
    // palabra de ella (origen observado).
    private Task CorregirTanque(string transaccion) => Intentar("corregir-el-tanque", async () =>
    {
        errorEn = transaccion;
        CargaEnLista? carga = null;
        foreach (CargaEnLista candidata in cargas)
            if (candidata.Transaccion == transaccion) { carga = candidata; break; }
        if (carga is null) return;

        string contrario = Contrario(carga.ClaveDelTanque);
        string rechazo = await Estado.DeclararTanque(transaccion, contrario);
        if (rechazo.Length > 0) throw new RechazoDeLaApp(rechazo);

        listoEn = transaccion;
        Enfocar(transaccion);
        MostrarListo(Texto.Con("ruta.anotadoTanque", ("tanque", Texto.ComoSeDice(contrario))));
    });

    // La foto entra entera a memoria antes de ir a la carpeta: una foto de tablero ronda
    // los pocos MB y el tope evita que un archivo equivocado tumbe la pestana.
    private Task GuardarFoto(string transaccion, InputFileChangeEventArgs e) =>
        Intentar("guardar-la-foto-del-tablero", async () =>
        {
            errorEn = transaccion;
            const long topeDeBytes = 15 * 1024 * 1024;
            IBrowserFile archivo = e.File;
            if (archivo.Size > topeDeBytes)
                throw new RechazoDeLaApp("foto-muy-grande");

            using var memoria = new MemoryStream();
            await archivo.OpenReadStream(topeDeBytes).CopyToAsync(memoria);

            string extension = Path.GetExtension(archivo.Name);
            if (extension.Length == 0) extension = ".jpg";

            byte[] contenido = memoria.ToArray();
            string rechazo = await Estado.AdjuntarFoto(transaccion, extension, contenido);
            if (rechazo.Length > 0) throw new RechazoDeLaApp(rechazo);

            // Se muestra en el acto y sin volver a leer la carpeta: los bytes ya están
            // acá. Es el momento en que la persona la sacó y el número que busca está en
            // pantalla, así que el campo de abajo es el paso siguiente natural.
            fotoPorCarga[transaccion] = $"data:{TipoDeImagen(extension)};base64,"
                + Convert.ToBase64String(contenido);
        });

    // ------------------------------------------------------------------ la lectura

    protected override void Releer()
    {
        vehiculos = Estado.Vehiculos();
        unidades = Estado.Unidades();

        if (vehiculos.Count == 0)
        {
            cargas = new List<CargaEnLista>();
            tramos = new List<TramoEnLista>();
            faltantes = new List<FaltanteEnLista>();
            rendimiento = new RendimientoDelVehiculo();
            autonomia = new AutonomiaDelVehiculo();
            completitud = new CompletitudDelVehiculo();
            propuesta = new OdometroPropuesto();
            tramoPorCierre = new Dictionary<DateTime, TramoEnLista>();
            faltantesPorCarga = new Dictionary<string, List<FaltanteEnLista>>();
            tramosQueDestraba = new Dictionary<string, int>();
            fechasQueEsperaElBache = new Dictionary<DateTime, List<DateTime>>();
            tanquesEstimados = new List<string>();
            return;
        }

        string placa = Estado.PlacaEnFoco(vehiculos);
        cargas = Estado.Cargas(placa);
        tramos = Estado.Tramos(placa);
        rendimiento = Estado.Rendimiento(placa);
        autonomia = Estado.Autonomia(placa);
        completitud = Estado.Completitud(placa);
        faltantes = Estado.Faltantes(placa);

        // Los indices de la ruta, armados una sola vez por lectura. Un tramo lo cierra una
        // carga y solo una, asi que TryAdd alcanza y ademas deja el primero si el dominio
        // alguna vez devolviera dos con el mismo cierre.
        tramoPorCierre = new Dictionary<DateTime, TramoEnLista>();
        foreach (TramoEnLista tramo in tramos) tramoPorCierre.TryAdd(tramo.Hasta, tramo);

        var sinKilometrajePorFecha = new Dictionary<DateTime, CargaEnLista>();
        foreach (CargaEnLista carga in cargas)
            if (!carga.TieneKilometraje) sinKilometrajePorFecha.TryAdd(carga.Fecha, carga);

        tramosQueDestraba = new Dictionary<string, int>();
        fechasQueEsperaElBache = new Dictionary<DateTime, List<DateTime>>();
        foreach (TramoEnLista tramo in tramos)
        {
            if (tramo.EstaCalculado) continue;
            var espera = new List<DateTime>();
            foreach (DateTime extremo in new[] { tramo.Desde, tramo.Hasta })
                if (sinKilometrajePorFecha.TryGetValue(extremo, out CargaEnLista? trunca))
                {
                    espera.Add(extremo);
                    tramosQueDestraba[trunca.Transaccion] =
                        tramosQueDestraba.GetValueOrDefault(trunca.Transaccion) + 1;
                }
            fechasQueEsperaElBache[tramo.Desde] = espera;
        }

        faltantesPorCarga = new Dictionary<string, List<FaltanteEnLista>>();
        foreach (FaltanteEnLista faltante in faltantes)
        {
            if (!faltantesPorCarga.TryGetValue(faltante.Transaccion, out List<FaltanteEnLista>? pendientes))
                faltantesPorCarga[faltante.Transaccion] = pendientes = new List<FaltanteEnLista>();
            pendientes.Add(faltante);
        }

        tanquesEstimados = new List<string>();
        foreach (FaltanteEnLista faltante in faltantes)
            if (faltante.ClaveDeLoQueFalta == LaConfirmacionDelTanque)
                tanquesEstimados.Add(faltante.Transaccion);

        // El "hoy" del prellenado lo pone ESTA caratula: el dominio no lee el reloj.
        propuesta = Estado.Odometro(placa, DateTime.Now);

        // LA PROYECCION SE PROPONE SOLO EN LA ULTIMA CARGA DE TODAS, y solo si es ella la
        // que espera kilometraje. La proyeccion es "cuanto marca el odometro HOY", asi que
        // a cualquier carga anterior le queda grande: en el guion, la que espera es la de
        // julio y la de agosto ya esta anotada en 43 200, asi que proponia los 43 225 de
        // hoy para una carga anterior. El odometro solo crece -el dominio lo iba a
        // rechazar-, y proponer un numero que uno mismo va a rechazar es peor que nada.
        transaccionConPropuesta = "";
        if (propuesta.Hay && cargas.Count > 0)
        {
            DateTime ultimaFecha = DateTime.MinValue;
            foreach (CargaEnLista carga in cargas)
                if (carga.Fecha > ultimaFecha) ultimaFecha = carga.Fecha;

            foreach (FaltanteEnLista faltante in faltantes)
                if (faltante.ClaveDeLoQueFalta == ElKilometraje && faltante.Fecha == ultimaFecha)
                {
                    transaccionConPropuesta = faltante.Transaccion;
                    if (!kilometrajePorAnotar.ContainsKey(faltante.Transaccion))
                        kilometrajePorAnotar[faltante.Transaccion] = propuesta.KilometrosComoSeVen;
                    break;
                }
        }
    }
}
