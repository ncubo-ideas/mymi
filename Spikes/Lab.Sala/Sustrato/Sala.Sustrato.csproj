<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- EL SUSTRATO DE GNOTHI, COMPILADO PARA EL MOTOR WEB.
       Esto es lo que en la nota 49 se llama la fila I: un solo documento, propiedad de
       Gnothi, con el runtime .NET, el motor y el contrato adentro. El modulo NO se
       referencia: llega despues, como bytes, y se carga en tiempo de ejecucion. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Sala.Sustrato</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.13" PrivateAssets="all" />
    <PackageReference Include="Ncubo.Puppeteer" Version="3.0.0-beta.10044" />

    <!-- LO QUE EL MOTOR NECESITA Y NO ES DEL MODULO. Un paquete del BCL como este viene
         COMPILADO POR PLATAFORMA: el que el modulo trae en su carpeta es el de Android y su IL
         nombra las intrinsecas de ARM, que en el motor web no existen. MEDIDO: cargarlo desde la
         carpeta del modulo revienta con
           TypeLoadException: System.Runtime.Intrinsics.Arm.Crc32
         Asi que lo presta el sustrato, en su build de browser-wasm. Es la misma regla que el
         instalador ya hace cumplir con el motor: un paquete cargo que trae su propio sustrato se
         RECHAZA, justamente para que no pase esto. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.5" />

    <!-- Y MCP, por la misma razon: los modulos instalados hoy en el telefono llevan sus tools
         con los atributos de MCP, asi que su superficie no carga sin esta libreria. Es parte del
         sustrato que el Host ya presta en proceso: PackageInspector la tiene en su lista de
         motor y RECHAZA un paquete cargo que la traiga. La sala presta lo mismo. -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <!-- LO QUE EL HOST PRESTA. Se referencian sin usarse en C#, igual que en la forma cargo:
       el modulo los nombra, este proyecto no. Por proyecto y no por dll suelto, para que el
       sustrato preste exactamente lo que el repo compila hoy. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Gnothi.Contract\Gnothi.Contract.csproj" />
    <ProjectReference Include="..\..\..\Examenes\Mecanismo\Puppets.Portador\Puppets.Portador.csproj" />
  </ItemGroup>

  <!-- Y LA PARTE QUE DECIDE EL SPIKE: si nadie lo usa en C#, el trimmer lo borra. Rootear
       lo prestado no es un truco del laboratorio: es la definicion del sustrato. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Gnothi.Contract" />
    <TrimmerRootAssembly Include="Puppets.Portador" />
    <TrimmerRootAssembly Include="Puppeteer" />
    <TrimmerRootAssembly Include="Choreography" />
    <TrimmerRootAssembly Include="ModelContextProtocol" />
    <TrimmerRootAssembly Include="ModelContextProtocol.Core" />
    <TrimmerRootAssembly Include="System.IO.Hashing" />
  </ItemGroup>

  <!-- MEDIDO 2026-09-16, primera corrida: sin esto el modulo carga y se descubre entero, pero
       instanciarlo revienta con TypeLoadException porque el trimmer borro System.Lazy`1: nadie
       en el sustrato lo usaba. El trimmer recorta por app, y el modulo no es parte de la app.
       Rootear el BCL que el modulo puede tocar ES la definicion del sustrato prestado. -->
  <!-- LOS CINCO MODULOS, TRAIDOS DE bundles/hibrida SIN MODIFICAR. No se copian al repo: el
       paquete de la institucion ya vive ahi, y tener dos copias es el antipatron del manifiesto.
       Que la sala consuma el MISMO bundle que hoy consume la forma hibrida es justamente lo que
       se quiere demostrar. -->
  <Target Name="TraerLosModulosHibridos" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <DllDeModulo Include="$(MSBuildThisFileDirectory)..\..\..\Gnothi.Mobile\bundles\hibrida\**\dominio\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DllDeModulo)"
          DestinationFiles="@(DllDeModulo->'$(MSBuildThisFileDirectory)wwwroot\modulos\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
    <TrimmerRootAssembly Include="System.Linq" />
    <TrimmerRootAssembly Include="System.Collections" />

    <!-- Y EL RESTO DEL BCL QUE EL SUSTRATO PRESTA. Cada uno de estos se agrego porque un modulo
         real lo pidio y el trimmer lo habia borrado: System.Lazy primero, System.ComponentModel
         despues. La lista no es una precaucion, es el contrato: lo que esta aca es lo que un
         modulo va a encontrar, y lo que no esta es lo que no puede usar. -->
    <TrimmerRootAssembly Include="System.ComponentModel" />
    <TrimmerRootAssembly Include="System.ComponentModel.Primitives" />
    <TrimmerRootAssembly Include="System.ComponentModel.TypeConverter" />
    <TrimmerRootAssembly Include="System.ObjectModel" />
    <TrimmerRootAssembly Include="System.Collections.Concurrent" />
    <TrimmerRootAssembly Include="System.Collections.Specialized" />
    <TrimmerRootAssembly Include="System.Linq.Expressions" />
    <TrimmerRootAssembly Include="System.Text.RegularExpressions" />
    <TrimmerRootAssembly Include="System.Text.Json" />
    <TrimmerRootAssembly Include="System.Text.Encoding.Extensions" />
    <TrimmerRootAssembly Include="System.Memory" />
    <TrimmerRootAssembly Include="System.Threading" />
    <TrimmerRootAssembly Include="System.Console" />

    <!-- Y estos dos los pidio el MOTOR, no el dominio: su calculo de hash nombra
         System.Runtime.Intrinsics.Arm.Crc32 aunque en wasm no se use nunca: el typeref existe
         igual y el cargador de tipos lo resuelve antes de mirar si esta soportado. -->
    <TrimmerRootAssembly Include="System.Runtime.Intrinsics" />
    <TrimmerRootAssembly Include="System.Runtime.InteropServices" />
    <TrimmerRootAssembly Include="System.Security.Cryptography" />
  </ItemGroup>

</Project>
