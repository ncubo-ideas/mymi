<?xml version="1.0" encoding="utf-8"?>
<!-- UN AGENTE SIN PRIVILEGIOS. Declara el permiso como lo declararia cualquier agente,
     y deja que la allowlist decida. Ver java/.../AgenteActivity.java -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.ncubo.lab.agente"
          android:versionCode="1" android:versionName="1.0">

    <!-- Segun la R14 de Alvaro este permiso es 'normal' con allowlist de device, o bien
         'internal|privileged'. Declararlo es lo que haria un agente real; si no se puede
         obtener, ESO es el resultado. -->
    <uses-permission android:name="android.permission.EXECUTE_APP_FUNCTIONS" />

    <!-- Para poder ver el paquete objetivo en Android 11+. -->
    <queries>
        <package android:name="com.ncubo.lab.caratula" />
    </queries>

    <application android:label="Agente sin privilegios">
        <activity android:name="com.ncubo.lab.agente.AgenteActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
