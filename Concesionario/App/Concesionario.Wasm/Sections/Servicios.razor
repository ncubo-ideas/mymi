@using Concesionario.Wasm.Parts

<div class="d-sec" style="margin-top:4px">
    <span class="d-sec__note">@Texts.With("services.count", ("count", Texts.Grouped(Nueve.Count)))</span>
</div>

@if (Operations is not null)
{
    <p class="d-note" style="margin-top:0;margin-bottom:10px">
        <Glyph Name="clock" Size="14" Stroke="2" />
        <span>@Texts.With("services.measuredAt", ("instant", Operations.AskedAt))</span>
    </p>
}

<section class="d-card" id="linea-servicios">
    <div class="d-line">
        @foreach (string kind in EnOrden)
        {
            string estado = Board.TryGetValue(kind, out string s) ? s : "";
            string tono = ComoSeLee.Tono(estado);

            <div class="d-step" id="@("servicio-" + kind)">
                <span class="@("d-step__bullet d-step__bullet--" + tono)">
                    <Glyph Name="@ComoSeLee.Dibujo(estado)" Size="11" Stroke="3" />
                </span>
                <div class="@("d-step__when d-step__when--" + tono)">
                    @ComoSeLee.Estado(Texts.ThePhrases, estado)
                </div>
                <div class="d-step__title">@ComoSeLee.Operacion(Texts.ThePhrases, kind)</div>
                <div class="d-step__sub">
                    @if (abierto == kind)
                    {
                        <span>@(Reasons.TryGetValue(kind, out string r) ? r : "")</span>
                    }
                    else
                    {
                        <span>@Texts[Resumen(estado)]</span>
                    }
                </div>
                @if (Operations is not null)
                {
                    HowOneOperationStands parada = Operations.Of(kind);

                    if (parada.CountdownRefused)
                    {
                        <div class="d-says" id="@("rechazo-" + kind)">
                            <span class="d-says__label">@Texts["services.refusedLabel"]</span>
                            @Texts[TheOwnerIsTold.TheDealershipSetTheDateThisOperationCountsFrom]
                        </div>
                    }
                    else
                    {
                        <div class="d-says" id="@("falta-" + kind)">
                            <span class="d-says__label">@Texts["services.remainingLabel"]</span>
                            @parada.Says
                        </div>

                        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">
                            @if (parada.DistanceCanBeSaid)
                            {
                                <span class="d-pill d-pill--info" id="@("resto-km-" + kind)">
                                    @Texts.Grouped(parada.DistanceRemaining) @parada.DistanceUnit
                                </span>
                            }
                            @if (parada.DaysCanBeSaid)
                            {
                                <span class="d-pill d-pill--info" id="@("resto-dias-" + kind)">
                                    @Texts.Days(parada.DaysRemaining)
                                </span>
                            }
                        </div>
                    }
                }

                <div style="margin-top:6px">
                    <button class="d-link" type="button" id="@("por-que-" + kind)"
                            @onclick="@(() => abierto = abierto == kind ? "" : kind)">
                        @(abierto == kind ? Texts["services.hide"] : Texts["services.why"])
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<p class="d-note" style="margin-top:14px">
    <Glyph Name="info" Size="14" Stroke="2" />
    <span>
        @Texts["services.order"]
    </span>
</p>

@code {
    /// <summary>
    /// El catalogo de esta caratula, en el idioma de la persona. Baja desde la pagina y esta seccion
    /// no lo lee por su cuenta.
    /// </summary>
    [CascadingParameter] public Texts Texts { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<string> Nueve { get; set; } = new List<string>();
    [Parameter, EditorRequired] public Dictionary<string, string> Board { get; set; } = new();
    [Parameter, EditorRequired] public Dictionary<string, string> Reasons { get; set; } = new();

    /// <summary>
    /// Donde esta parada cada operacion, leido en un solo momento. La seccion no lee nada por su
    /// cuenta.
    /// </summary>
    [Parameter, EditorRequired]
    public WhereEachOperationStands Operations { get; set; }

    private string abierto = "";

    /// <summary>
    /// El peso de cada tono para ordenar. Lo urgente arriba, y dentro de un mismo tono se conserva
    /// el orden en que el dominio nombra las nueve: dos operaciones igual de urgentes no tienen por
    /// que cambiar de lugar entre dos aperturas de la pantalla.
    /// </summary>
    private static int Peso(string tono) => tono switch
    {
        "danger" => 0,
        "warn" => 1,
        "ok" => 3,
        _ => 2,
    };

    private IEnumerable<string> EnOrden =>
        Nueve
            .Select((kind, position) => (kind, position))
            .OrderBy(x => Peso(ComoSeLee.Tono(Board.TryGetValue(x.kind, out string s) ? s : "")))
            .ThenBy(x => x.position)
            .Select(x => x.kind);

    /// <summary>
    /// La CLAVE de la linea corta que va bajo el nombre cuando el detalle esta cerrado. NO resume la
    /// frase del dominio -- la reemplaza por lo unico que se puede decir sin leerla: que estado tiene
    /// y quien lo decidio. Recortar la frase con puntos suspensivos cortaria justo donde estan los
    /// numeros.
    /// </summary>
    private static string Resumen(string estado) => estado switch
    {
        "Overdue" => "services.summaryOverdue",
        "Due" => "services.summaryDue",
        "DueSoon" => "services.summaryDueSoon",
        "Deferred" => "services.summaryDeferred",
        "Missed" => "services.summaryMissed",
        "NotDue" => "services.summaryNotDue",
        _ => "services.summaryUnknown",
    };
}
