@using Concesionario.Wasm.Parts

<div class="d-sec" style="margin-top:4px">
    <span class="d-sec__note" style="font-size:11.5px;line-height:1.4;color:var(--d-ink-2)">@Nueve.Count operaciones · primero lo urgente</span>
</div>

@if (Operations is not null)
{
    <p class="d-note d-note--home" style="margin-top:2px;margin-bottom:14px;line-height:1.4">
        <Glyph Name="clock" Size="13" Stroke="2" />
        <span>Datos actualizados al @Operations.AskedAt</span>
    </p>
}

<section class="d-card" id="linea-servicios">
    <div class="d-svc-list">
        @foreach (string kind in EnOrden)
        {
            string estado = Board.TryGetValue(kind, out string s) ? s : "";
            string tono = ComoSeLee.Tono(estado);
            HowOneOperationStands parada = Operations?.Of(kind);
            bool abiertoAqui = abierto == kind;

            <div class="d-svc" id="@("servicio-" + kind)">
                <div class="@("d-svc__badge d-svc__badge--" + tono)">
                    <Glyph Name="@ComoSeLee.Dibujo(estado)" Size="11" Stroke="3" />
                    @ComoSeLee.Estado(estado)
                </div>

                <div class="d-svc__title">@ComoSeLee.Operacion(kind)</div>

                <div class="d-svc__sub">
                    @if (abiertoAqui)
                    {
                        <span>@(Reasons.TryGetValue(kind, out string r) ? r : "")</span>
                        @if (parada is not null && !parada.CountdownRefused && parada.Says.Length > 0)
                        {
                            <span class="d-svc__detail-extra">@parada.Says</span>
                        }
                    }
                    else
                    {
                        <span>@Resumen(kind, estado, parada)</span>
                    }
                </div>

                @if (parada is not null)
                {
                    if (parada.CountdownRefused)
                    {
                        <div class="d-svc__falta" id="@("rechazo-" + kind)">
                            <span class="d-svc__falta-label">No se pudo medir</span>
                            <p class="d-svc__falta-note">@TheOwnerIsTold.TheDealershipSetTheDateThisOperationCountsFrom</p>
                        </div>
                    }
                    else if (!parada.DistanceCanBeSaid && !parada.DaysCanBeSaid)
                    {
                        @if (tono == "warn" || tono == "danger")
                        {
                            <div class="d-svc__falta" id="@("falta-" + kind)">
                                <span class="d-svc__falta-label">Lo que falta</span>
                                <div class="@("d-svc__now d-svc__now--" + tono)">
                                    <Glyph Name="@ComoSeLee.DibujoOperacion(kind)" Size="17" Stroke="2.2" />
                                    @(tono == "danger" ? "VENCIDO" : "AHORA")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-svc__falta" id="@("falta-" + kind)">
                            <span class="d-svc__falta-label">Lo que falta</span>
                            <div class="d-svc__cols">
                                @if (parada.DistanceCanBeSaid)
                                {
                                    <div class="d-svc__col" id="@("resto-km-" + kind)">
                                        <span class="d-svc__col-value">@ComoSeLee.Miles(parada.DistanceRemaining) @parada.DistanceUnit</span>
                                        <span class="d-svc__col-label">por distancia</span>
                                    </div>
                                }
                                @if (parada.DaysCanBeSaid)
                                {
                                    <div class="d-svc__col" id="@("resto-dias-" + kind)">
                                        <span class="d-svc__col-value">@ComoSeLee.Miles(parada.DaysRemaining) días</span>
                                        <span class="d-svc__col-label">por tiempo</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                <button class="d-link d-svc__why" type="button" id="@("por-que-" + kind)"
                        @onclick="@(() => abierto = abiertoAqui ? "" : kind)">
                    @(abiertoAqui ? "Ocultar" : "¿Por qué?")
                    @if (!abiertoAqui)
                    {
                        <Glyph Name="chevron" Size="13" Stroke="2.6" />
                    }
                </button>
            </div>
        }
    </div>
</section>

<p class="d-note" style="margin-top:14px">
    <Glyph Name="info" Size="14" Stroke="2" />
    <span>
        El orden lo pone la urgencia, no el calendario: primero lo vencido, después lo que toca, y
        de último lo que está al día. Las fechas de lo ya hecho todavía no vienen en el registro.
    </span>
</p>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Nueve { get; set; } = new List<string>();
    [Parameter, EditorRequired] public Dictionary<string, string> Board { get; set; } = new();
    [Parameter, EditorRequired] public Dictionary<string, string> Reasons { get; set; } = new();

    /// <summary>
    /// Donde esta parada cada operacion, leido en un solo momento. La seccion no lee nada por su
    /// cuenta.
    /// </summary>
    [Parameter, EditorRequired]
    public WhereEachOperationStands Operations { get; set; }

    private string abierto = "";

    /// <summary>
    /// El peso de cada tono para ordenar. Lo urgente arriba, y dentro de un mismo tono se conserva
    /// el orden en que el dominio nombra las nueve: dos operaciones igual de urgentes no tienen por
    /// que cambiar de lugar entre dos aperturas de la pantalla.
    /// </summary>
    private static int Peso(string tono) => tono switch
    {
        "danger" => 0,
        "warn" => 1,
        "ok" => 3,
        _ => 2,
    };

    private IEnumerable<string> EnOrden =>
        Nueve
            .Select((kind, position) => (kind, position))
            .OrderBy(x => Peso(ComoSeLee.Tono(Board.TryGetValue(x.kind, out string s) ? s : "")))
            .ThenBy(x => x.position)
            .Select(x => x.kind);

    /// <summary>
    /// La linea corta que va bajo el nombre cuando el detalle esta cerrado. NO resume la frase del
    /// dominio -- la reemplaza por lo unico que se puede decir sin leerla: que estado tiene y quien
    /// lo decidio. Recortar la frase con puntos suspensivos cortaria justo donde estan los numeros.
    ///
    /// "NotDue" tiene DOS lecturas distintas segun si el registro programo un intervalo para esta
    /// clase o no -- exactamente lo que ya dicen DistanceCanBeSaid/DaysCanBeSaid -- y decir una sola
    /// frase para las dos volveria falsa a la mitad de los casos.
    /// </summary>
    private static string Resumen(string kind, string estado, HowOneOperationStands parada) => estado switch
    {
        "Overdue" => "Se pasó del intervalo programado.",
        "Due" => "Llegó al intervalo programado.",
        "DueSoon" => "Está cerca del intervalo programado.",
        "Deferred" => "Vos pediste posponerla.",
        "Missed" => "Pasó su momento sin registrarse.",
        "NotDue" => parada is not null && !parada.DistanceCanBeSaid && !parada.DaysCanBeSaid
            ? "Sin intervalo programado para este carro."
            : "Dentro del intervalo programado.",
        _ => "Tu registro no le puso un estado a esta operación.",
    };
}
