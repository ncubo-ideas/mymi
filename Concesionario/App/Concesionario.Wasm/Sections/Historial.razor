@using Concesionario.Wasm.Parts

@if (Operations is not null)
{
    <div class="d-sec" style="margin-top:4px">
        <span class="d-sec__title">Lo que le han hecho a tu carro</span>
    </div>

    @if (Operations.WhatHasBeenDone.Count == 0)
    {
        <div class="d-state d-state--mute" id="sin-historial">
            <span class="d-state__icon d-state__icon--mute">
                <Glyph Name="history" Size="26" Stroke="2" />
            </span>
            <div class="d-state__title">Todavía no hay operaciones registradas</div>
            <p class="d-state__body">Cuando tu taller registre servicios, aparecerán aquí.</p>
        </div>
    }
    else
    {
        <section class="d-card" id="linea-completaciones">
            <div class="d-hist-done-list">
                @foreach (AThingThatWasDone hecho in Operations.WhatHasBeenDone)
                {
                    <div class="d-hist-done" id="@("hecho-" + hecho.CompletedAt)">
                        <span class="d-hist-done__check">
                            <Glyph Name="check" Size="13" Stroke="3" />
                        </span>
                        <div class="d-hist-done__body">
                            <div class="d-hist-done__date">@ComoSeLee.DiaCorto(hecho.CompletedAt)</div>
                            <div class="d-hist-done__title">@ComoSeLee.Operacion(hecho.Kind)</div>
                            <span class="d-hist-done__km">@hecho.Reading</span>
                            <p class="d-hist-done__desc">@hecho.Says</p>
                        </div>
                    </div>
                }
            </div>
        </section>

        @if (Operations.Operations.Any(parada => !parada.HasBeenCompleted))
        {
            <div class="d-sec">
                <span class="d-sec__title">Operaciones sin registro</span>
                <span class="d-pill d-pill--mute">@Operations.Operations.Count(parada => !parada.HasBeenCompleted)</span>
            </div>

            <section class="d-card" id="operaciones-sin-registro">
                <div class="d-hist-empty-list">
                    @foreach (HowOneOperationStands parada in Operations.Operations)
                    {
                        @if (!parada.HasBeenCompleted)
                        {
                            <div class="d-hist-empty-row" id="@("nada-de-" + parada.Kind)" title="@parada.CompletionsSays">
                                <span class="d-hist-empty-row__icon">
                                    <Glyph Name="@ComoSeLee.DibujoOperacion(parada.Kind)" Size="17" Stroke="2.1" />
                                </span>
                                <div>
                                    <div class="d-hist-empty-row__title">@ComoSeLee.Operacion(parada.Kind)</div>
                                    <div class="d-hist-empty-row__value">Sin registros</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>

            <p class="d-note" style="margin-top:10px">
                <Glyph Name="info" Size="14" Stroke="2" />
                <span>Que no aparezca un registro no significa que el trabajo nunca se haya hecho; solo que no está registrado aquí.</span>
            </p>
        }
    }
}

@if (Stays is null)
{
    <p class="note">Este registro todavía no se ha leído.</p>
}
else
{
    <div class="d-sec">
        <span class="d-sec__title">Días en el taller</span>
    </div>

    <section class="d-card" id="dias-en-el-taller">
        <div class="d-hist-days">
            <span class="d-hist-days__icon">
                <Glyph Name="calendar" Size="19" Stroke="2" />
            </span>
            <div>
                <div class="d-hist-days__count">@Stays.DayCount día@(Stays.DayCount == 1 ? "" : "s")</div>
                <div class="d-hist-days__period">
                    Entre el @ComoSeLee.DiaCorto(Stays.FromDay) y el @ComoSeLee.DiaCorto(Stays.ToDay)
                </div>
            </div>
        </div>

        @if (Stays.InsideRightNow)
        {
            <div class="d-says" id="adentro-ahora" style="margin-top:14px">
                <span class="d-says__label">Ahora mismo, al @Stays.AskedAt</span>
                @Stays.TheStayRightNowSays
            </div>

            <p class="d-note" style="margin-top:10px">
                <Glyph Name="info" Size="14" Stroke="2" />
                <span>@TheOwnerIsTold.TheDaysOfAStayArriveWhenTheCarIsCollected</span>
            </p>
        }
    </section>

    <p class="d-note" style="margin-top:10px">
        <Glyph Name="info" Size="14" Stroke="2" />
        <span>Las estadías cuentan los días que tu vehículo estuvo registrado en el taller.</span>
    </p>

    @if (Stays.AnyStayInThePeriod)
    {
        <div class="d-sec">
            <span class="d-sec__title">Cada estadía</span>
        </div>

        <section class="d-card" id="linea-estadias">
            <div class="d-line">
                @foreach (AStayOnTheRecord estadia in Stays.Rows)
                {
                    <div class="d-step" id="@("estadia-" + estadia.EnteredAt)">
                        <span class="d-step__bullet">
                            <Glyph Name="calendar" Size="11" Stroke="3" />
                        </span>
                        <div class="d-step__when">@estadia.EnteredAt</div>
                        <div class="d-step__title">@estadia.Subject</div>
                        <div class="d-step__sub">@estadia.Branch</div>

                        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">
                            @foreach (string dia in estadia.CoveredDays)
                            {
                                <span class="d-pill d-pill--info">@dia</span>
                            }
                        </div>

                        <div class="d-says">@estadia.Says</div>
                    </div>
                }
            </div>
        </section>
    }
}

@if (Use is not null)
{
    <div class="d-sec">
        <span class="d-sec__title">Cuánto se maneja</span>
        <span class="d-sec__note">los últimos doce meses</span>
    </div>

    <section class="d-card" id="cuanto-se-maneja">
        <p class="d-note" style="margin-top:0;margin-bottom:10px">
            <Glyph Name="clock" Size="14" Stroke="2" />
            <span>Del @Use.From al @Use.To</span>
        </p>

        <div class="d-cover d-cover--mute" style="padding:0;background:none;grid-template-columns:1fr">
            <div class="d-cover__body" style="margin:0" id="ritmo-dice">@Use.Says</div>
        </div>
    </section>

    <div class="d-sec">
        <span class="d-sec__title">Contra los doce meses anteriores</span>
    </div>

    <section class="d-card" id="ritmo-comparado">
        <p class="d-note" style="margin-top:0;margin-bottom:10px">
            <Glyph Name="history" Size="14" Stroke="2" />
            <span>Del @Use.EarlierFrom al @Use.EarlierTo</span>
        </p>

        <div class="d-says" id="comparacion-dice">
            <span class="d-says__label">Los dos periodos</span>
            @Use.BothPeriodsSay
        </div>
    </section>

    @if (Use.ReadingCount > 0)
    {
        <div class="d-sec">
            <span class="d-sec__title">Cada lectura del odómetro</span>
            <span class="d-sec__note">@Use.ReadingCount en el periodo</span>
        </div>

        <section class="d-card" id="linea-lecturas">
            <div class="d-line">
                @foreach (AReadingOnTheRecord lectura in Use.Rows)
                {
                    <div class="d-step" id="@("lectura-" + lectura.ObservedAt)">
                        <span class="d-step__bullet">
                            <Glyph Name="gauge" Size="11" Stroke="3" />
                        </span>
                        <div class="d-step__when">@lectura.ObservedAt</div>

                        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:2px">
                            <span class="d-pill d-pill--info">
                                @ComoSeLee.Miles(lectura.Value) @lectura.Unit
                            </span>
                        </div>

                        <div class="d-says">@lectura.Says</div>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <div class="d-empty" id="sin-lecturas">
            <span class="d-empty__title">Ninguna lectura del odómetro en este periodo</span>
            @TheOwnerIsTold.TheOdometerReadingsAreSentByTheDealershipAndTheVehicle
        </div>
    }
}

@if (Spend is not null)
{
    <div class="d-sec">
        <span class="d-sec__title">En qué se fue la plata</span>
        <span class="d-sec__note">los últimos doce meses</span>
    </div>

    <section class="d-card" id="en-que-se-fue-la-plata">
        <p class="d-note" style="margin-top:0;margin-bottom:10px">
            <Glyph Name="clock" Size="14" Stroke="2" />
            <span>Del @Spend.From al @Spend.To</span>
        </p>

        <div class="d-says" id="gasto-dice">
            <span class="d-says__label">Lo que salió del banco y lo que el período consumió</span>
            @Spend.PerCurrencySays
        </div>

        <div class="d-says" id="costo-por-distancia-dice">
            <span class="d-says__label">Lo que costó la distancia</span>
            @Spend.CostPerDistanceSays
        </div>
    </section>

    <div class="d-sec">
        <span class="d-sec__title">Contra los doce meses anteriores</span>
    </div>

    <section class="d-card" id="gasto-comparado">
        <p class="d-note" style="margin-top:0;margin-bottom:10px">
            <Glyph Name="history" Size="14" Stroke="2" />
            <span>Del @Spend.EarlierFrom al @Spend.EarlierTo</span>
        </p>

        <div class="d-says" id="gasto-comparacion-dice">
            <span class="d-says__label">Los dos períodos</span>
            @Spend.BothPeriodsSay
        </div>
    </section>

    @if (Spend.EntryCount > 0)
    {
        <div class="d-sec">
            <span class="d-sec__title">Cada gasto</span>
            <span class="d-sec__note">@Spend.EntryCount en el periodo</span>
        </div>

        <section class="d-card" id="linea-gastos">
            <div class="d-line">
                @foreach (ACostOnTheRecord gasto in Spend.Rows)
                {
                    <div class="d-step" id="@("gasto-" + gasto.IncurredAt)">
                        <span class="d-step__bullet">
                            <Glyph Name="sheet" Size="11" Stroke="3" />
                        </span>
                        <div class="d-step__when">@gasto.IncurredAt</div>
                        <div class="d-step__title">@gasto.Subject</div>

                        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">
                            <span class="d-pill d-pill--info">@gasto.Money</span>
                            @if (gasto.ExpectedLife.Length > 0)
                            {
                                <span class="d-pill">@gasto.ExpectedLife</span>
                            }
                        </div>

                        <div class="d-says">@gasto.Says</div>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <div class="d-empty" id="sin-gastos">
            <span class="d-empty__title">Ningún gasto registrado en este periodo</span>
            @TheOwnerIsTold.TheCostsAreRecordedByTheBranchThatDoesTheWork
        </div>
    }
}

@code {
    /// <summary>
    /// Las estadias en el taller, leidas en un solo momento. La seccion no lee nada por su cuenta.
    /// </summary>
    [Parameter, EditorRequired]
    public TheStaysOfThisVehicle Stays { get; set; }

    /// <summary>
    /// Cuanto se maneja este vehiculo, leido en el mismo momento. De aca sale el ritmo de la ventana,
    /// la comparacion con la anterior y las lecturas del periodo como filas.
    /// </summary>
    [Parameter, EditorRequired]
    public HowThisVehicleIsDriven Use { get; set; }

    /// <summary>
    /// Donde esta parada cada operacion, leido en el mismo momento. De aca sale el historial entero y
    /// la ausencia por clase, que es lo que el historial entero no puede decir.
    /// </summary>
    [Parameter, EditorRequired]
    public WhereEachOperationStands Operations { get; set; }

    /// <summary>
    /// En que se le fue la plata a este vehiculo, leido en el mismo momento. De aca sale el gasto de
    /// la ventana con sus dos vistas, la comparacion con la anterior, lo que costo la distancia y los
    /// gastos del periodo como filas.
    /// </summary>
    [Parameter, EditorRequired]
    public WhatThisVehicleHasCost Spend { get; set; }
}
