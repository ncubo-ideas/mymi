@using Concesionario.Wasm.Parts

<div class="d-top">
    <img class="d-top__photo" src="img/vehiculo.png" alt="" aria-hidden="true" />
    <div class="d-top__scrim" aria-hidden="true"></div>

    <div class="d-top__bar">
        <div class="d-top__brand">
            <span class="d-top__mark"><SotaventoMark /></span>
            <span>
                <span class="d-top__name">@Agencia</span>
                <span class="d-top__kicker">Servicio al propietario</span>
            </span>
        </div>
        <AppearanceToggle OnNight="true" />
    </div>

    <div class="d-top__content">
        <p class="d-top__hello-kicker">@HeroVehiculo</p>
        <h1 class="d-top__hello">@HeroEstado</h1>
    </div>
</div>

<div class="d__pad d__gap">

    <section class="d-estado d-estado--after-hero" id="estado">
        <div class="d-estado__deco" aria-hidden="true"></div>

        <div class="d-estado__head">
            <span class="d-sec__title">Estado de tu vehículo</span>
            <span class="@("d-pill d-pill--" + Tono + " d-pill--chip")">@Titular</span>
        </div>

        <div class="d-health">
            <div class="d-ring" id="anillo-estado">
                <svg class="d-ring__svg" viewBox="0 0 100 100" aria-hidden="true">
                    <circle class="d-ring__track" cx="50" cy="50" r="42" />
                    <circle class="@("d-ring__fill d-ring__fill--" + Tono)" cx="50" cy="50" r="42"
                            style="stroke-dasharray:@RingLargo;stroke-dashoffset:@RingRestante" />
                </svg>
                <div class="d-ring__label">
                    <span class="d-ring__unit">
                        <span class="d-ring__n">@AlDia</span>
                        <span class="d-ring__of">/@Programadas</span>
                    </span>
                </div>
            </div>
            <div class="d-health__body">
                <p class="d-health__what">@ResumenEstado</p>

                <div class="d-health__counts">
                    @if (Overdue > 0)
                    {
                        <span class="d-pill d-pill--danger d-pill--chip" id="cuenta-vencidos">@Overdue vencid@(Overdue == 1 ? "o" : "os")</span>
                    }
                    @if (Due > 0)
                    {
                        <span class="d-pill d-pill--warn d-pill--chip" id="cuenta-tocan">@Due pendiente@(Due == 1 ? "" : "s")</span>
                    }
                    @if (Missed > 0)
                    {
                        <span class="d-pill d-pill--mute d-pill--chip" id="cuenta-no-hechos">@Missed sin hacer</span>
                    }
                    @if (AlDia > 0)
                    {
                        <span class="d-pill d-pill--ok d-pill--chip" id="cuenta-al-dia">@AlDia al día</span>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="@("d-next d-next--" + Tono + " d-next--after-estado")" id="lo-que-sigue">
        <span class="d-next__icon">
            <Glyph Name="@(HayAlgo ? ComoSeLee.Dibujo(Board[Siguiente]) : "check")" Size="19" Stroke="2.4" />
        </span>
        <div>
            <div class="d-next__kicker">
                <span class="d-next__dot" aria-hidden="true"></span>
                @(HayAlgo ? "Lo que sigue" : "Nada pendiente")
            </div>
            <div class="d-next__title">
                @(HayAlgo ? ComoSeLee.Operacion(Siguiente) : "Tu carro está al día")
            </div>

            @if (HayAlgo)
            {
                <div class="d-next__more">
                    <button class="d-link" type="button" id="ver-por-que"
                            @onclick="@(() => porQue = !porQue)">
                        @(porQue ? "Ocultar el detalle" : "¿Por qué?")
                    </button>
                </div>

                @if (porQue)
                {
                    <div class="d-says" id="por-que-detalle">
                        <span class="d-says__label">Lo que dice tu registro</span>
                        @Reasons[Siguiente]
                    </div>
                }

                @if (Contacto.Whatsapp.Length > 0)
                {
                    <a class="d-cta" id="agendar-whatsapp" href="@EnlaceParaAgendar"
                       target="_blank" rel="noopener noreferrer">
                        <Glyph Name="calendar" Size="17" Stroke="2.2" />
                        <span class="d-cta__label">Agendar por WhatsApp</span>
                        <span class="d-cta__chevron"><Glyph Name="chevron" Size="16" Stroke="2.4" /></span>
                    </a>
                }
            }
            else
            {
                <div class="d-next__more">
                    <span class="d-note">
                        Ninguna de las @Programadas operaciones que tu concesionario programó está
                        vencida ni te toca ahora.
                    </span>
                </div>
            }
        </div>
    </section>

    <div class="d-tiles d-tiles--next" id="numeros">
        <div class="d-tile" id="tile-odometro">
            <span class="d-tile__icon"><Glyph Name="gauge" Size="14" Stroke="2.2" /></span>
            <div>
                <span class="d-tile__v">@Odometro</span><span class="d-tile__u">@OdometroUnidad</span>
            </div>
            <div class="d-tile__k">han recorrido juntos</div>
        </div>
        <div class="d-tile" id="tile-lectura">
            <span class="d-tile__icon"><Glyph Name="calendar" Size="14" Stroke="2.2" /></span>
            <div class="d-tile__v" style="font-size:18px;letter-spacing:-.3px">
                @(ObservadoEl.Length > 0 ? ComoSeLee.DiaCorto(ObservadoEl) : "sin lectura")
            </div>
            <div class="d-tile__k">última lectura que envió tu concesionario</div>
        </div>
    </div>

    <div class="d-sec d-sec--home">
        <span class="d-sec__title">Un vistazo a tu carro</span>
        <button class="d-link" type="button" id="ir-a-servicios" @onclick="VerServicios">Ver todas</button>
    </div>

    <div class="d-dots" id="vistazo">
        @foreach (string kind in Nueve)
        {
            string estado = Board.TryGetValue(kind, out string s) ? s : "";
            string tono = ComoSeLee.Tono(estado);

            <div class="d-dot" id="@("punto-" + kind)" title="@ComoSeLee.Estado(estado)">
                <span class="@("d-dot__ring d-dot__ring--" + tono)">
                    <Glyph Name="@ComoSeLee.DibujoOperacion(kind)" Size="19" Stroke="2.2" />
                    @if (tono == "ok")
                    {
                        <span class="d-dot__badge" aria-hidden="true">
                            <Glyph Name="check" Size="10" Stroke="3" />
                        </span>
                    }
                </span>
                <span class="d-dot__k">@ComoSeLee.OperacionCorta(kind)</span>
            </div>
        }
    </div>

    @if (HayContacto)
    {
        <div class="d-sec d-sec--home">
            <span class="d-sec__title">¿Necesitás hablar con el taller?</span>
        </div>

        <div class="d-tiles" id="contacto">
            @if (Contacto.Whatsapp.Length > 0)
            {
                <a class="d-contact" id="wa" href="@("https://wa.me/" + Contacto.Whatsapp)"
                   target="_blank" rel="noopener noreferrer">
                    <span class="d-contact__icon d-contact__icon--wa">
                        <img class="d-contact__icon-img" src="img/whatsapp.webp" alt="" aria-hidden="true" />
                    </span>
                    <span class="d-contact__body">
                        <span class="d-contact__label">WhatsApp</span>
                        <span class="d-contact__value">@Agencia</span>
                    </span>
                </a>
            }
            @if (Contacto.Phone.Length > 0)
            {
                <a class="d-contact" id="tel" href="@("tel:" + Contacto.Phone)">
                    <span class="d-contact__icon d-contact__icon--tel">
                        <Glyph Name="phone" Size="16" Stroke="2.2" />
                    </span>
                    <span class="d-contact__body">
                        <span class="d-contact__label">Llamar</span>
                        <span class="d-contact__value">@Contacto.Phone</span>
                    </span>
                </a>
            }
        </div>
    }

    <div class="d-footer-group">
        <p class="d-note d-note--home" id="de-donde-sale">
            <Glyph Name="info" Size="14" Stroke="2" />
            <span>
                Esta app no le pregunta nada a nadie: lee el registro que tu concesionario ya te envió y
                que vive en @DondeVive. @(EvaluadoHasta.Length > 0
                    ? "Evaluado al " + EvaluadoHasta + "."
                    : "Todavía sin evaluar.")
            </span>
        </p>

        <button class="btn btn--ghost btn--subtle" type="button" id="traer-novedades" @onclick="Actualizar"
                disabled="@Trayendo">
            <Glyph Name="sync" Size="16" />
            @(Trayendo ? "Trayendo…" : "Traer lo que haya nuevo")
        </button>
    </div>
</div>

@code {
    /// <summary>Las nueve operaciones, en el orden en que la duena las ve.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Nueve { get; set; } = new List<string>();

    /// <summary>El estado de cada una, dicho por el dominio.</summary>
    [Parameter, EditorRequired] public Dictionary<string, string> Board { get; set; } = new();

    /// <summary>La frase con que el dominio explica cada estado.</summary>
    [Parameter, EditorRequired] public Dictionary<string, string> Reasons { get; set; } = new();

    [Parameter] public int Overdue { get; set; }
    [Parameter] public int Due { get; set; }
    [Parameter] public int Missed { get; set; }

    /// <summary>Cuantas no tienen nada pendiente. La compone el dominio; aca no se cuenta nada.</summary>
    [Parameter] public int AlDia { get; set; }

    /// <summary>
    /// Cuantas le programo la agencia a este carro. Es el otro numero de la tarjeta, y tambien lo
    /// compone el dominio: dividir uno entre otro seria una cuenta, y armar el denominador con las
    /// nueve clases del canon diria algo que el registro no dice.
    /// </summary>
    [Parameter] public int Programadas { get; set; }

    /// <summary>La operacion que el calendario pone de primera, o vacio si no hay ninguna.</summary>
    [Parameter] public string Siguiente { get; set; } = "";

    [Parameter] public string Modelo { get; set; } = "";
    [Parameter] public string Odometro { get; set; } = "--";
    [Parameter] public string OdometroUnidad { get; set; } = "";
    [Parameter] public string ObservadoEl { get; set; } = "";
    [Parameter] public string EvaluadoHasta { get; set; } = "";
    [Parameter] public string DondeVive { get; set; } = "esta máquina";
    [Parameter] public string Agencia { get; set; } = "Sotavento Motors";
    [Parameter] public DealershipContact Contacto { get; set; } = new();

    /// <summary>Lo que hay que hacer cuando la duena toca "ver todas".</summary>
    [Parameter] public EventCallback VerServicios { get; set; }

    /// <summary>Si la pagina esta trayendo el bloque del concesionario en este momento.</summary>
    [Parameter] public bool Trayendo { get; set; }

    /// <summary>Lo que hay que hacer cuando la duena pide traer lo que haya nuevo.</summary>
    [Parameter] public EventCallback Actualizar { get; set; }

    private bool porQue;

    private bool HayAlgo => Siguiente.Length > 0 && Board.ContainsKey(Siguiente);

    private bool HayContacto => Contacto.Whatsapp.Length > 0 || Contacto.Phone.Length > 0;

    /// <summary>
    /// El enlace de WhatsApp con el mensaje ya escrito. Lo que va en el texto es lo que el registro
    /// ya sabe -- la operacion, el modelo y el odometro -- y nada mas. El nombre no va porque la app
    /// no lo tiene y no lo va a inventar; la placa SI la tiene y aun asi no va, que es otra cosa: el
    /// mensaje lo escribe una persona sobre su propio carro y ahi la placa no identifica nada que el
    /// modelo y el odometro no digan ya. Sonia lo lee antes de enviarlo y lo cambia si quiere; el
    /// navegador es quien abre WhatsApp, esta app no manda nada.
    /// </summary>
    private string EnlaceParaAgendar
    {
        get
        {
            string carro = Modelo.Length > 0 ? Modelo : "carro";
            string texto =
                "Hola, quiero agendar " + ComoSeLee.Operacion(Siguiente).ToLowerInvariant()
                + " para mi " + carro
                + " (odómetro " + Odometro + " " + OdometroUnidad + ").";

            return "https://wa.me/" + Contacto.Whatsapp + "?text=" + System.Uri.EscapeDataString(texto);
        }
    }

    /// <summary>
    /// El tono de la pantalla entera. Lo decide lo PEOR que haya, no el promedio: un carro con un
    /// mantenimiento vencido no esta "83% bien", esta con algo vencido.
    /// </summary>
    private string Tono => Overdue > 0 ? "danger" : Due > 0 ? "warn" : "ok";

    private string Titular => Overdue > 0 ? "Necesita atención" : Due > 0 ? "Algo por hacer" : "Al día";

    /// <summary>
    /// La frase junto al aro. Dice los mismos dos numeros que el aro ya dibuja -- AlDia y
    /// Programadas -- porque el aro es la lectura rapida y esta frase es la que confirma con
    /// palabras lo que el aro muestra con color.
    /// </summary>
    private string ResumenEstado =>
        AlDia + " operacion" + (AlDia == 1 ? "" : "es") + " " + (AlDia == 1 ? "está" : "están")
        + " al día de las " + Programadas + " programadas";

    /// <summary>La primera linea del encabezado: de que carro se habla.</summary>
    private string HeroVehiculo => Modelo.Length > 0 ? "Tu " + Modelo : "Tu carro";

    /// <summary>
    /// La segunda linea, la que de verdad importa: el mismo estado que decide Tono y Titular, dicho
    /// como una frase que sigue a HeroVehiculo.
    /// </summary>
    private string HeroEstado =>
        Overdue > 0 ? "necesita atención" : Due > 0 ? "tiene algo por hacer" : "está al día";

    /// <summary>
    /// El anillo de "Estado de tu vehiculo" es SVG, no una imagen: un circulo de radio 42 mide
    /// 2*pi*42 de contorno, y ese mismo numero es el stroke-dasharray completo.
    /// </summary>
    private const double RingRadio = 42;

    private static readonly double RingContorno = 2 * System.Math.PI * RingRadio;

    private double RingFraccion =>
        Programadas > 0 ? System.Math.Clamp((double)AlDia / Programadas, 0, 1) : 0;

    private string RingLargo =>
        RingContorno.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string RingRestante =>
        (RingContorno * (1 - RingFraccion)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
