@using Concesionario.Wasm.Parts

<div class="d-top">
    <div class="d-top__bar">
        <div class="d-top__brand">
            <span class="d-top__mark"><SotaventosMark /></span>
            <span>
                <span class="d-top__name">@Agencia</span>
                <span class="d-top__kicker">@Texts["home.kicker"]</span>
            </span>
        </div>
        <AppearanceToggle />
    </div>

    <h1 class="d-top__hello">@Saludo</h1>
    <p class="d-top__sub">
        @Texts["home.sub"]
    </p>
</div>

<div class="d-lift d__pad d__gap">

    <section class="d-card" id="estado">
        <div class="d-card__head">
            <span class="d-card__title">@Texts["home.stateTitle"]</span>
            <span class="@("d-pill d-pill--" + Tono)">@Titular</span>
        </div>

        <div class="d-health">
            <div class="d-health__score">
                <span class="d-health__n">@AlDia</span>
                <span class="d-health__of">/@Programadas</span>
            </div>
            <div class="d-health__body">
                <p class="d-health__what">
                    @Texts["home.healthWhat"]
                </p>
            </div>
        </div>

        <div class="d-health__counts">
            @if (Overdue > 0)
            {
                <span class="d-pill d-pill--danger" id="cuenta-vencidos">
                    @Texts.With(Overdue == 1 ? "home.overdueOne" : "home.overdueMany",
                        ("count", Texts.Grouped(Overdue)))
                </span>
            }
            @if (Due > 0)
            {
                <span class="d-pill d-pill--warn" id="cuenta-tocan">
                    @Texts.With(Due == 1 ? "home.dueOne" : "home.dueMany", ("count", Texts.Grouped(Due)))
                </span>
            }
            @if (Missed > 0)
            {
                <span class="d-pill d-pill--mute" id="cuenta-no-hechos">
                    @Texts.With("home.missed", ("count", Texts.Grouped(Missed)))
                </span>
            }
            @if (AlDia > 0)
            {
                <span class="d-pill d-pill--ok" id="cuenta-al-dia">
                    @Texts.With("home.upToDate", ("count", Texts.Grouped(AlDia)))
                </span>
            }
        </div>
    </section>

    <section class="@("d-next d-next--" + Tono)" id="lo-que-sigue">
        <span class="d-next__icon">
            <Glyph Name="@(HayAlgo ? ComoSeLee.Dibujo(Board[Siguiente]) : "check")" Size="22" Stroke="2.4" />
        </span>
        <div>
            <div class="d-next__kicker">@(HayAlgo ? Texts["home.nextKicker"] : Texts["home.nothingPending"])</div>
            <div class="d-next__title">
                @(HayAlgo ? ComoSeLee.Operacion(Texts.ThePhrases, Siguiente) : Texts["home.allGood"])
            </div>

            @if (HayAlgo)
            {
                <div class="d-next__more">
                    <button class="d-link" type="button" id="ver-por-que"
                            @onclick="@(() => porQue = !porQue)">
                        @(porQue ? Texts["home.hideWhy"] : Texts["home.why"])
                    </button>
                </div>

                @if (porQue)
                {
                    <div class="d-says" id="por-que-detalle">
                        <span class="d-says__label">@Texts["home.saysLabel"]</span>
                        @Reasons[Siguiente]
                    </div>
                }

                @if (Contacto.Whatsapp.Length > 0)
                {
                    <a class="d-cta" id="agendar-whatsapp" href="@EnlaceParaAgendar"
                       target="_blank" rel="noopener noreferrer">
                        <Glyph Name="calendar" Size="18" Stroke="2.2" />
                        @Texts["home.schedule"]
                    </a>
                }
            }
            else
            {
                <div class="d-next__more">
                    <span class="d-note">
                        @Texts.With("home.nothingDue", ("count", Texts.Grouped(Programadas)))
                    </span>
                </div>
            }
        </div>
    </section>

    <div class="d-tiles" id="numeros">
        <div class="d-tile" id="tile-odometro">
            <div>
                <span class="d-tile__v">@Odometro</span><span class="d-tile__u">@OdometroUnidad</span>
            </div>
            <div class="d-tile__k">@Texts["home.odometerTile"]</div>
        </div>
        <div class="d-tile" id="tile-lectura">
            <div class="d-tile__v" style="font-size:15px;letter-spacing:-.2px">
                @(ObservadoEl.Length > 0
                    ? ComoSeLee.DiaCorto(Texts.ThePhrases, ObservadoEl)
                    : Texts["home.noReading"])
            </div>
            <div class="d-tile__k">@Texts["home.readingTile"]</div>
        </div>
    </div>

    <div class="d-sec">
        <span class="d-sec__title">@Texts["home.glance"]</span>
        <button class="d-link" type="button" id="ir-a-servicios" @onclick="VerServicios">@Texts["home.seeAll"]</button>
    </div>

    <section class="d-card" id="vistazo">
        <div class="d-dots">
            @foreach (string kind in Nueve)
            {
                string estado = Board.TryGetValue(kind, out string s) ? s : "";
                string tono = ComoSeLee.Tono(estado);

                <div class="d-dot" id="@("punto-" + kind)" title="@ComoSeLee.Estado(Texts.ThePhrases, estado)">
                    <span class="@("d-dot__ring d-dot__ring--" + tono)">
                        <Glyph Name="@ComoSeLee.Dibujo(estado)" Size="18" Stroke="2.6" />
                    </span>
                    <span class="d-dot__k">@ComoSeLee.OperacionCorta(Texts.ThePhrases, kind)</span>
                </div>
            }
        </div>
    </section>

    @if (HayContacto)
    {
        <div class="d-sec">
            <span class="d-sec__title">@Texts["home.contactTitle"]</span>
        </div>

        <div class="d-tiles" id="contacto">
            @if (Contacto.Whatsapp.Length > 0)
            {
                <a class="d-tile" id="wa" href="@("https://wa.me/" + Contacto.Whatsapp)"
                   target="_blank" rel="noopener noreferrer"
                   style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit">
                    <span class="d-cover__icon" style="width:38px;height:38px;border-radius:12px">
                        <Glyph Name="chat" Size="18" Stroke="2.2" />
                    </span>
                    <span>
                        <span style="display:block;font-weight:800;font-size:14px">WhatsApp</span>
                        <span class="d-tile__k" style="margin:0">@Agencia</span>
                    </span>
                </a>
            }
            @if (Contacto.Phone.Length > 0)
            {
                <a class="d-tile" id="tel" href="@("tel:" + Contacto.Phone)"
                   style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit">
                    <span class="d-cover__icon" style="width:38px;height:38px;border-radius:12px">
                        <Glyph Name="phone" Size="18" Stroke="2.2" />
                    </span>
                    <span>
                        <span style="display:block;font-weight:800;font-size:14px">@Texts["home.call"]</span>
                        <span class="d-tile__k" style="margin:0">@Contacto.Phone</span>
                    </span>
                </a>
            }
        </div>
    }

    <p class="d-note" id="de-donde-sale" style="margin-top:6px">
        <Glyph Name="info" Size="14" Stroke="2" />
        <span>
            @Texts.With("home.source",
                ("where", DondeVive),
                ("evaluated", EvaluadoHasta.Length > 0
                    ? Texts.With("home.evaluated", ("day", EvaluadoHasta))
                    : Texts["home.notEvaluated"]))
        </span>
    </p>

    <div style="margin-top:10px">
        <button class="btn btn--ghost" type="button" id="traer-novedades" @onclick="Actualizar"
                disabled="@(Trayendo || Migrada)">
            <Glyph Name="sync" Size="18" />
            @(Migrada
                ? Texts["home.refreshMigrated"]
                : Trayendo ? Texts["home.refreshFetching"] : Texts["home.refresh"])
        </button>
    </div>
</div>

@code {
    /// <summary>
    /// El catalogo de esta caratula, en el idioma de la persona. Baja desde la pagina y esta seccion
    /// no lo lee por su cuenta: lo unico que hace con el es decir sus propias palabras.
    /// </summary>
    [CascadingParameter] public Texts Texts { get; set; }

    /// <summary>Las nueve operaciones, en el orden en que la duena las ve.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Nueve { get; set; } = new List<string>();

    /// <summary>El estado de cada una, dicho por el dominio.</summary>
    [Parameter, EditorRequired] public Dictionary<string, string> Board { get; set; } = new();

    /// <summary>La frase con que el dominio explica cada estado.</summary>
    [Parameter, EditorRequired] public Dictionary<string, string> Reasons { get; set; } = new();

    [Parameter] public int Overdue { get; set; }
    [Parameter] public int Due { get; set; }
    [Parameter] public int Missed { get; set; }

    /// <summary>Cuantas no tienen nada pendiente. La compone el dominio; aca no se cuenta nada.</summary>
    [Parameter] public int AlDia { get; set; }

    /// <summary>
    /// Cuantas le programo la agencia a este carro. Es el otro numero de la tarjeta, y tambien lo
    /// compone el dominio: dividir uno entre otro seria una cuenta, y armar el denominador con las
    /// nueve clases del canon diria algo que el registro no dice.
    /// </summary>
    [Parameter] public int Programadas { get; set; }

    /// <summary>La operacion que el calendario pone de primera, o vacio si no hay ninguna.</summary>
    [Parameter] public string Siguiente { get; set; } = "";

    [Parameter] public string Modelo { get; set; } = "";
    [Parameter] public string Odometro { get; set; } = "--";
    [Parameter] public string OdometroUnidad { get; set; } = "";
    [Parameter] public string ObservadoEl { get; set; } = "";
    [Parameter] public string EvaluadoHasta { get; set; } = "";
    [Parameter] public string DondeVive { get; set; } = "";
    [Parameter] public string Agencia { get; set; } = "Sotaventos Motors";
    [Parameter] public DealershipContact Contacto { get; set; } = new();

    /// <summary>Lo que hay que hacer cuando la duena toca "ver todas".</summary>
    [Parameter] public EventCallback VerServicios { get; set; }

    /// <summary>Si la pagina esta trayendo el bloque del concesionario en este momento.</summary>
    [Parameter] public bool Trayendo { get; set; }

    /// <summary>Lo que hay que hacer cuando la duena pide traer lo que haya nuevo.</summary>
    [Parameter] public EventCallback Actualizar { get; set; }

    /// <summary>Si el proveedor ya marco que los hechos nuevos entran por Gnothi. Cuando es
    /// true esta app deja de SINCRONIZAR -no de mostrar-, asi que traer novedades no haria
    /// nada: la tecla se apaga y lo DICE -"Ya no se actualiza"- en vez de quedarse gris, que
    /// se leeria como que la app se rompio. El aviso de MyCar.razor dice por que.</summary>
    [Parameter] public bool Migrada { get; set; }

    private bool porQue;

    private bool HayAlgo => Siguiente.Length > 0 && Board.ContainsKey(Siguiente);

    private bool HayContacto => Contacto.Whatsapp.Length > 0 || Contacto.Phone.Length > 0;

    /// <summary>
    /// El enlace de WhatsApp con el mensaje ya escrito. Lo que va en el texto es lo que el registro
    /// ya sabe -- la operacion, el modelo y el odometro -- y nada mas. El nombre no va porque la app
    /// no lo tiene y no lo va a inventar; la placa SI la tiene y aun asi no va, que es otra cosa: el
    /// mensaje lo escribe una persona sobre su propio carro y ahi la placa no identifica nada que el
    /// modelo y el odometro no digan ya. Sonia lo lee antes de enviarlo y lo cambia si quiere; el
    /// navegador es quien abre WhatsApp, esta app no manda nada.
    /// </summary>
    private string EnlaceParaAgendar
    {
        get
        {
            string carro = Modelo.Length > 0 ? Modelo : Texts["home.whatsappCar"];
            string texto = Texts.With("home.whatsappText",
                ("operation", ComoSeLee.Operacion(Texts.ThePhrases, Siguiente).ToLowerInvariant()),
                ("car", carro),
                ("odometer", Odometro),
                ("unit", OdometroUnidad));

            return "https://wa.me/" + Contacto.Whatsapp + "?text=" + System.Uri.EscapeDataString(texto);
        }
    }

    /// <summary>
    /// El tono de la pantalla entera. Lo decide lo PEOR que haya, no el promedio: un carro con un
    /// mantenimiento vencido no esta "83% bien", esta con algo vencido.
    /// </summary>
    private string Tono => Overdue > 0 ? "danger" : Due > 0 ? "warn" : "ok";

    private string Titular => Overdue > 0
        ? Texts["home.headlineAttention"]
        : Due > 0 ? Texts["home.headlineSomething"] : Texts["home.headlineOk"];

    private string Saludo
    {
        get
        {
            string carro = Modelo.Length > 0
                ? Texts.With("home.yourModel", ("model", Modelo))
                : Texts["home.yourCar"];

            return Overdue > 0
                ? Texts.With("home.greetingAttention", ("car", carro))
                : Due > 0
                    ? Texts.With("home.greetingSomething", ("car", carro))
                    : Texts.With("home.greetingOk", ("car", carro));
        }
    }
}
