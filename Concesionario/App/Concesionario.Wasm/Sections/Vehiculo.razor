@using Concesionario.Wasm.Parts

<section class="d-hero" id="hero-vehiculo">
    <img class="d-hero__img" src="img/vehiculo.png"
         alt="@Texts.With("vehicle.photoAlt", ("what", Modelo.Length > 0 ? Modelo : Texts["vehicle.photoAltFallback"]))" />
    <div class="d-hero__cap">
        <div class="d-hero__model">
            <span class="d-hero__name">@(Modelo.Length > 0 ? Modelo : Texts["vehicle.yourVehicle"])</span>
            @if (Revision.Length > 0)
            {
                <span class="d-hero__tag">@Texts.With("vehicle.sheetTag", ("revision", Revision))</span>
            }
        </div>
        <div class="d-hero__odo">@Odometro @OdometroUnidad</div>
        @if (Placa is not null && Placa.PlatePublished)
        {
            <div class="d-hero__placa">@Placa.AsPublished</div>
        }
    </div>
</section>

<div class="d-subtabs" id="hojas-vehiculo">
    <button type="button" id="hoja-informacion"
            class="@(hoja == "informacion" ? "d-subtab d-subtab--on" : "d-subtab")"
            @onclick="@(() => hoja = "informacion")">
        <Glyph Name="car" Size="18" Stroke="2" />
        @Texts["vehicle.tabInfo"]
    </button>
    <button type="button" id="hoja-garantia"
            class="@(hoja == "garantia" ? "d-subtab d-subtab--on" : "d-subtab")"
            @onclick="@(() => hoja = "garantia")">
        <Glyph Name="shield" Size="18" Stroke="2" />
        @Texts["vehicle.tabWarranty"]
    </button>
    <button type="button" id="hoja-manual"
            class="@(hoja == "manual" ? "d-subtab d-subtab--on" : "d-subtab")"
            @onclick="@(() => hoja = "manual")">
        <Glyph Name="sheet" Size="18" Stroke="2" />
        @Texts["vehicle.tabManual"]
    </button>
</div>

@if (hoja == "informacion")
{
    <section class="d-card" id="informacion">
        <div class="d-rows">
            <div class="d-row">
                <span class="d-row__k">@Texts["vehicle.rowModel"]</span>
                <span class="d-row__v">@(Modelo.Length > 0 ? Modelo : Texts["vehicle.none"])</span>
            </div>
            <div class="d-row">
                <span class="d-row__k">@Texts["vehicle.rowVin"]</span>
                <span class="d-row__v d-row__v--mono">@Vin</span>
            </div>
            <div class="d-row d-row--stack" id="placa">
                <span class="d-row__k">@Texts["vehicle.rowPlate"]</span>
                <span class="d-row__v" style="font-weight:600;font-size:13px">
                    @(Placa is not null ? Placa.Says : Texts["vehicle.none"])
                </span>
            </div>
            <div class="d-row">
                <span class="d-row__k">@Texts["vehicle.rowOdometer"]</span>
                <span class="d-row__v">@Odometro @OdometroUnidad</span>
            </div>
            <div class="d-row">
                <span class="d-row__k">@Texts["vehicle.rowLastReading"]</span>
                <span class="d-row__v">
                    @(Stands is not null && Stands.OdometerObservedAt.Length > 0
                        ? ComoSeLee.Dia(Texts.ThePhrases, Stands.OdometerObservedAt)
                        : Texts["vehicle.none"])
                </span>
            </div>
            <div class="d-row">
                <span class="d-row__k">@Texts["vehicle.rowDelivered"]</span>
                <span class="d-row__v">
                    @(Stands is not null && Stands.DeliveryRecorded
                        ? ComoSeLee.Dia(Texts.ThePhrases, Stands.DeliveredAt)
                        : Texts["vehicle.unrecorded"])
                </span>
            </div>
            @if (Stands is not null && Stands.DeliveryRecorded)
            {
                <div class="d-row">
                    <span class="d-row__k">@Texts["vehicle.rowOdometerThatDay"]</span>
                    <span class="d-row__v">
                        @Texts.Grouped(Stands.DeliveryReading) @Stands.DeliveryUnit
                    </span>
                </div>
            }
            <div class="d-row">
                <span class="d-row__k">@Texts["vehicle.rowSheet"]</span>
                <span class="d-row__v">
                    @(Revision.Length > 0 ? Revision : Texts["vehicle.unpublished"])
                </span>
            </div>
        </div>
    </section>

    <p class="d-note" style="margin-top:12px">
        <Glyph Name="info" Size="14" Stroke="2" />
        <span>
            @Texts["vehicle.note"]
        </span>
    </p>
}
else if (hoja == "garantia")
{
    <section class="@("d-cover d-cover--" + TonoGarantia)" id="garantia-resumen">
        <span class="d-cover__icon"><Glyph Name="shield" Size="20" Stroke="2.2" /></span>
        <div>
            <div class="d-cover__title">@TitularGarantia</div>
            <div class="d-cover__body">@CuerpoGarantia</div>
        </div>
    </section>

    <div style="margin-top:12px">
        <button class="d-link" type="button" id="ver-cobertura"
                @onclick="@(() => detalleGarantia = !detalleGarantia)">
            @(detalleGarantia ? Texts["vehicle.hideCover"] : Texts["vehicle.seeCover"])
        </button>
    </div>

    @if (detalleGarantia)
    {
        <div class="stack stack--page" id="garantia-detalle" style="margin-top:10px">
            @if (Sheet is null || Stands is null)
            {
                <p class="note">@Texts["vehicle.notReadYet"]</p>
            }
            else
            {
                <Warranty Sheet="@Sheet" Stands="@Stands" />
            }
        </div>
    }
}
else
{
    <section class="d-card" id="manual-resumen">
        <div class="d-card__head">
            <span class="d-card__title">@Texts["vehicle.manualTitle"]</span>
            @if (Revision.Length > 0)
            {
                <span class="d-pill d-pill--info">@Revision</span>
            }
        </div>

        @if (Sheet is null || !Sheet.HasASealedRevision)
        {
            <div class="d-empty">
                <span class="d-empty__title">@Texts["vehicle.manualNoneTitle"]</span>
                @Texts["vehicle.manualNoneBody"]
            </div>
        }
        else
        {
            <div class="d-rows">
                @foreach (var fluid in Sheet.Fluids.Where(f => f.Published))
                {
                    <div class="d-row d-row--stack">
                        <span class="d-row__k">@ComoSeLee.Fluido(Texts.ThePhrases, fluid.Kind)</span>
                        <span class="d-row__v" style="font-weight:600;font-size:13px">@fluid.Says</span>
                    </div>
                }
                @foreach (var tyre in Sheet.Tyres.Where(t => t.Published))
                {
                    <div class="d-row d-row--stack">
                        <span class="d-row__k">
                            @Texts.With("vehicle.manualTyres",
                                ("position", ComoSeLee.Llanta(Texts.ThePhrases, tyre.Position).ToLowerInvariant()))
                        </span>
                        <span class="d-row__v" style="font-weight:600;font-size:13px">@tyre.Says</span>
                    </div>
                }
                @if (Sheet.Fuel.Published)
                {
                    <div class="d-row d-row--stack">
                        <span class="d-row__k">@Texts["vehicle.manualFuel"]</span>
                        <span class="d-row__v" style="font-weight:600;font-size:13px">@Sheet.Fuel.Says</span>
                    </div>
                }
            </div>

            @if (!Sheet.Fluids.Any(f => f.Published) && !Sheet.Tyres.Any(t => t.Published) && !Sheet.Fuel.Published)
            {
                <div class="d-empty">
                    <span class="d-empty__title">@Texts["vehicle.manualEmptyTitle"]</span>
                    @Texts.With("vehicle.manualEmptyBody", ("revision", Revision))
                </div>
            }
        }
    </section>

    @if (Costs is not null)
    {
        <section class="d-card" id="precios-publicados" style="margin-top:12px">
            <div class="d-card__head">
                <span class="d-card__title">@Texts["vehicle.pricesTitle"]</span>
                @if (Costs.AnyPriceOnRecord)
                {
                    <span class="d-pill d-pill--info">
                        @Texts.Grouped(Costs.PriceCountOnRecord)
                    </span>
                }
            </div>

            @if (Costs.Rows.Count > 0)
            {
                <div class="d-rows">
                    @foreach (APublishedPriceOnTheSheet precio in Costs.Rows)
                    {
                        <div class="d-row d-row--stack" id="@("precio-" + precio.Operation)">
                            <span class="d-row__k">
                                @ComoSeLee.Operacion(Texts.ThePhrases, precio.Operation)
                                <span class="d-pill">@precio.Milestone</span>
                                <span class="d-pill d-pill--info">@precio.Revision</span>
                            </span>
                            <span class="d-row__v" style="font-weight:600;font-size:13px">@precio.Says</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="d-empty" id="sin-precios">
                    <span class="d-empty__title">@Texts["vehicle.pricesNoneTitle"]</span>
                    @Texts["vehicle.pricesNoneBody"]
                </div>
            }
        </section>
    }

    <div style="margin-top:12px">
        <button class="d-link" type="button" id="ver-ficha"
                @onclick="@(() => detalleFicha = !detalleFicha)">
            @(detalleFicha ? Texts["vehicle.hideSheet"] : Texts["vehicle.seeSheet"])
        </button>
    </div>

    @if (detalleFicha)
    {
        <div class="stack stack--page" id="ficha-detalle" style="margin-top:10px">
            @if (Sheet is null)
            {
                <p class="note">@Texts["vehicle.notReadYet"]</p>
            }
            else
            {
                <MyVehicle Sheet="@Sheet" />
            }
        </div>
    }
}

@code {
    /// <summary>
    /// El catalogo de esta caratula, en el idioma de la persona. Baja desde la pagina y esta seccion
    /// no lo lee por su cuenta.
    /// </summary>
    [CascadingParameter] public Texts Texts { get; set; }

    [Parameter] public WhatTheManufacturerPublished Sheet { get; set; }
    [Parameter] public WhereThisVehicleStands Stands { get; set; }

    /// <summary>
    /// Lo que el fabricante publico que cuestan los servicios, leido en el mismo momento que la ficha.
    /// Va aparte de la ficha porque la vigencia de un precio se juzga contra un instante.
    /// </summary>
    [Parameter] public WhatTheServicesCost Costs { get; set; }

    /// <summary>
    /// La placa de este vehiculo, leida en el mismo momento que la ficha. Va aparte de la mitad del
    /// vehiculo porque aquella mide este carro contra su sobre y la placa es el nombre publico del
    /// carro. La caratula pinta el texto publicado y el renglon de la hoja la frase del dominio, que
    /// dice desde cuando rige y contesta cuando no hay ninguna; la llave de cruce no llega hasta aca.
    /// </summary>
    [Parameter] public ThePlateOfThisVehicle Placa { get; set; }

    [Parameter] public string Modelo { get; set; } = "";
    [Parameter] public string Vin { get; set; } = "";
    [Parameter] public string Odometro { get; set; } = "--";
    [Parameter] public string OdometroUnidad { get; set; } = "";

    private string hoja = "informacion";
    private bool detalleGarantia;
    private bool detalleFicha;

    private string Revision => Sheet is not null && Sheet.HasASealedRevision ? Sheet.CurrentRevision : "";

    /// <summary>
    /// El color de la garantia. Sale de la POSTURA que el dominio nombro, no de una cuenta nuestra:
    /// "Within" es verde, cualquier salida del sobre es ambar, y no poder medir es gris -- que no
    /// es lo mismo que estar fuera, y por eso no es rojo.
    /// </summary>
    private string TonoGarantia
    {
        get
        {
            if (Stands is null || Stands.RecordContradictsItself) return "mute";
            if (!Stands.CanBeEvaluated) return "mute";

            return ComoSeLee.TonoDeLaPostura(Stands.Standing);
        }
    }

    private string TitularGarantia
    {
        get
        {
            if (Stands is null) return Texts["vehicle.warrantyTitle"];
            if (Stands.RecordContradictsItself) return Texts["vehicle.warrantyCannotMeasure"];
            if (!Stands.EnvelopePublished) return Texts["vehicle.warrantyNotPublished"];
            if (!Stands.CanBeEvaluated) return Texts["vehicle.warrantyPartlyMeasured"];

            return Texts.With("vehicle.warrantyStanding",
                ("standing", ComoSeLee.Postura(Texts.ThePhrases, Stands.Standing).ToLowerInvariant()));
        }
    }

    /// <summary>
    /// El cuerpo es la frase del dominio, literal. Es larga, y por eso vive aca abajo y no en el
    /// titular: quien quiera el numero exacto lo tiene, y quien solo quiera saber si esta cubierto
    /// ya lo leyo arriba en una palabra y un color.
    /// </summary>
    private string CuerpoGarantia
    {
        get
        {
            if (Stands is null) return Texts["vehicle.notReadYet"];
            if (Stands.RecordContradictsItself) return Texts[TheOwnerIsTold.TheRecordSaysTwoThingsThatCannotBothBeTrue];
            if (Stands.Says.Length > 0) return Stands.Says;

            return Texts[TheOwnerIsTold.TheDealershipHasNotSentTheseFactsYet];
        }
    }
}
