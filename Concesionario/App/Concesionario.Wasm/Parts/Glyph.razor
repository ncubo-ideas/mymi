<svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">@((MarkupString)Drawing(Name))</svg>

@code {
    /// <summary>El nombre del dibujo. Uno que no este en la lista sale como un circulo vacio.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    /// <summary>El lado del cuadro en pixeles. El dibujo escala con el.</summary>
    [Parameter]
    public int Size { get; set; } = 18;

    /// <summary>El grosor del trazo, para que un mismo dibujo pueda pesar distinto.</summary>
    [Parameter]
    public double Stroke { get; set; } = 1.9;

    private static string Drawing(string name) => name switch
    {
        "home" => "<path d='M4 11l8-7 8 7v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z'/>",

        "car" => "<path d='M5 17h14'/><path d='M6 17l-1.2-5.4L7 7h10l2.2 4.6L18 17'/>"
            + "<circle cx='8' cy='17' r='1.6'/><circle cx='16' cy='17' r='1.6'/>",

        "chevron" => "<path d='M9 6l6 6-6 6'/>",

        "arrow" => "<path d='M5 12h13M13 6l6 6-6 6'/>",

        "check" => "<path d='M5 13l4 4L19 7'/>",

        "clock" => "<circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/>",

        "alert" => "<path d='M21.7 18l-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3z'/>"
            + "<path d='M12 9v4M12 17h.01'/>",

        "info" => "<circle cx='12' cy='12' r='9'/><path d='M12 11v5M12 8h.01'/>",

        "cross" => "<circle cx='12' cy='12' r='9'/><path d='M15 9l-6 6M9 9l6 6'/>",

        "sync" => "<path d='M20 11a8 8 0 1 0-2.3 6.3'/><path d='M20 5v6h-6'/>",

        "folder" => "<path d='M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/>",

        "storage" => "<path d='M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z'/>"
            + "<path d='M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7'/><path d='M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'/>",

        "lock" => "<path d='M7.5 11V8a4.5 4.5 0 0 1 9 0v3'/>"
            + "<path d='M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z'/>",

        "moon" => "<path d='M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z'/>",

        "sun" => "<circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M2 12h2M20 12h2"
            + "M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4'/>",

        "shield" => "<path d='M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67 0C7.5 20.5 4 18 4 13V6a1 1 0"
            + " 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z'/>",

        "gauge" => "<path d='M12 14l4-4'/><path d='M3.34 19a10 10 0 1 1 17.32 0'/>",

        "calendar" => "<path d='M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z'/>"
            + "<path d='M8 3v4M16 3v4M3 11h18'/>",

        "block" => "<circle cx='12' cy='12' r='9'/><path d='M5.6 5.6l12.8 12.8'/>",

        "drop" => "<path d='M12 3s6 6.2 6 10a6 6 0 0 1-12 0c0-3.8 6-10 6-10z'/>",

        "fuel" => "<path d='M14 21V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v15'/><path d='M3 21h13'/>"
            + "<path d='M14 10h3l3 3v5a2 2 0 0 1-4 0v-1'/>",

        "tyre" => "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='3.4'/>",

        "sheet" => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/>"
            + "<path d='M14 3v5h5'/><path d='M9 13h6M9 17h4'/>",

        "history" => "<path d='M3.5 12a8.5 8.5 0 1 0 2.6-6.1'/><path d='M3 4v4h4'/>"
            + "<path d='M12 8v4.5l3 1.8'/>",

        "phone" => "<path d='M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z'/>",

        "chat" => "<path d='M21 12a8 8 0 0 1-11.6 7.2L4 21l1.8-4.6A8 8 0 1 1 21 12z'/>",

        "wrench" => "<path d='M14.7 6.3a4 4 0 0 0-5.4 4.6L3 17.3 6.7 21l6.4-6.3a4 4 0 0 0 4.6-5.4l-3 3-2.4-2.4z'/>",

        "filter" => "<path d='M4 5h16l-6 7.5V19l-4 2v-8.5z'/>",

        "chip" => "<rect x='7' y='7' width='10' height='10' rx='1.6'/>"
            + "<path d='M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3'/>",

        "pulse" => "<path d='M3 12h4l2.2-6.5L13 18l2.4-6H21'/>",

        "plate" => "<rect x='3' y='6' width='18' height='12' rx='2.2'/><path d='M7 12h10'/>",

        "tag" => "<path d='M20.6 13.4L13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z'/>"
            + "<line x1='7' y1='7' x2='7.01' y2='7'/>",

        _ => "<circle cx='12' cy='12' r='8'/>",
    };
}
