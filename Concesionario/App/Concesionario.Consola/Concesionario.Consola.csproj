<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Concesionario.Consola</RootNamespace>
    <AssemblyName>Concesionario.Consola</AssemblyName>
    <AssemblyTitle>Maintenance schedule measuring console</AssemblyTitle>
    <Description>Scaffold shell: the same actor and the same performs as the browser, against a real disk, for measuring.</Description>

    <NoWarn>$(NoWarn);VSTHRD103;VSTHRD200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concesionario.App\Concesionario.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Concesionario.Cara\texto\es-CR.js"
          Link="cara.es-CR.js.dato"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Concesionario.Cara\texto\en.js"
          Link="cara.en.js.dato"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Concesionario.Cara\index.html"
          Link="cara.index.html.dato"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
