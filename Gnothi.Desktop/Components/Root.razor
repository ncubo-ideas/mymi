@inject HostState State
@inject IJSRuntime JS

@*
    THE ROOT. Three faces now: the modules (list or one module's screen), the assistant, and
    settings. The visible face is `view`; inside Modules, the open module's name is the whole
    sub-navigation -a string, not the Module object, because the catalog can be reloaded and the
    object replaced underneath.

    AND A FOURTH, THE MODULE'S OWN SCREEN (Cara): while it is open it takes the whole window,
    without Gnothi's header and tabs, like the phone. It is put on screen by the frame host
    (FrameWebModuleHost) through the delegates wired in OnInitialized, so a face can be opened
    from a button here, from the module's desktop icon (--modulo) or from a test (--abrir), and
    all three end up in the same place.
*@

@if (view != View.Cara)
{
    <header>
        @* LA MARCA. «Mymi» es el nombre del producto de cara a la persona desde 051beb6; en el
           codigo, los ensamblados y el protocolo sigue siendo Gnothi. No sale del catalogo de textos
           -- un nombre propio no se traduce. *@
        <img class="cara" src="mymi.png" alt="" />
        <span class="brand">Mymi</span>
    </header>
    <nav class="tabs">
        <button class="@Cls(View.Modules)" @onclick="() => Go(View.Modules)">@T("nav.instituciones")</button>
        <button class="@Cls(View.Assistant)" @onclick="() => Go(View.Assistant)">@T("nav.asistente")</button>
        <button class="@Cls(View.Settings)" @onclick="() => Go(View.Settings)">@T("nav.ajustes")</button>
    </nav>
}
@switch (view)
{
    case View.Cara:
        <Cara Module="@caraModule" Url="@caraUrl" Back="CloseFace" />
        break;
    case View.Modules:
        <main>
            @if (open is null)
            {
                <ModuleList Open="@(name => open = name)" />
            }
            else
            {
                <p class="crumb">
                    <button @onclick="() => open = null">&larr; @T("nav.volver")</button>
                </p>
                <ModuleScreen Name="@open" />
            }
        </main>
        break;
    case View.Assistant:
        <main><Assistant GoToSettings="() => view = View.Settings" /></main>
        break;
    case View.Settings:
        <main><Settings /></main>
        break;
}

@code {
    // EL lang DEL DOCUMENTO, desde el idioma que ya resolvio C#. No se cablea en index.html:
    // estaba en "en" mientras tres de las cinco pantallas hablaban espanol, y un lang mentido lo
    // paga quien usa lector de pantalla, no quien lo escribio.
    //
    // Entra por un modulo propio y NO por eval, igual que en Municipalidad.Wasm: la politica de
    // contenido con que se sirve un modulo hospedado no admite eval, y un patron que anda en esta
    // ventana es un patron que alguien copia donde no anda.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await using IJSObjectReference langModule =
            await JS.InvokeAsync<IJSObjectReference>("import", "./language-interop.js");
        await langModule.InvokeVoidAsync("setLanguage", Texts.Language);
    }

    private enum View { Modules, Assistant, Settings, Cara }

    private View view = View.Modules;
    private View before = View.Modules;
    private string? open;
    private string caraModule = "";
    private string caraUrl = "";

    private string Cls(View v) => v == view ? "active" : "";

    private void Go(View v) => view = v;

    protected override void OnInitialized()
    {
        if (State.Frames is not { } frames) return;

        // The page's side of the frame bridge. Every delegate hops onto Blazor's dispatcher:
        // the host calls from wherever the courier or the dispatcher happen to be.
        frames.Show = (module, url) => InvokeAsync(() =>
        {
            if (view != View.Cara) before = view;
            caraModule = module;
            caraUrl = url;
            view = View.Cara;
            StateHasChanged();
        });
        frames.Hide = module => InvokeAsync(() =>
        {
            if (view != View.Cara || caraModule != module) return;
            view = before;
            open = module;   // back lands on the module's own screen, where "Abrir la pantalla" is
            StateHasChanged();
        });
        frames.RunJs = (module, js) => InvokeAsync(() => JS.InvokeVoidAsync("gnothiFrames.toFrame", module, js).AsTask());

        // Y EL LADO DE LA PAGINA PARA LA SALA, si esta ventana la tiene. Son los mismos tres verbos
        // que los de arriba -- montar, pasarle un mensaje, tirarla -- sobre un iframe OCULTO que no
        // es la cara de nadie: adentro corre el sustrato de Gnothi. Ver PhotinoRoom.
        if (RoomBridge.Current is { } room)
        {
            room.WireTo(
                url => InvokeAsync(() => JS.InvokeVoidAsync("gnothiFrames.openRoom", url).AsTask()),
                (id, verb, module, a, b) =>
                    InvokeAsync(() => JS.InvokeVoidAsync("gnothiFrames.toRoom", id, verb, module, a, b).AsTask()),
                () => InvokeAsync(() => JS.InvokeVoidAsync("gnothiFrames.dropRoom").AsTask()));
        }
        frames.EvalIn = (module, id, js) => InvokeAsync(() => JS.InvokeVoidAsync("gnothiFrames.evalIn", module, id, js).AsTask());
    }

    // "Volver a Gnothi": the face goes (the module is evicted, as when the phone's back closes
    // it), and the frame host's Hide brings the previous view back.
    private void CloseFace()
    {
        string module = caraModule;
        _ = Task.Run(() => State.Faces.Close(module));
    }
}
