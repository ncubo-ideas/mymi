@inject HostState State
@inject IJSRuntime JS

@*
    THE ROOT. Three faces now: the modules (list or one module's screen), the assistant, and
    settings. The visible face is `view`; inside Modules, the open module's name is the whole
    sub-navigation -a string, not the Module object, because the catalog can be reloaded and the
    object replaced underneath.
*@

<header>
    <span class="brand">Gnothi</span>
    <span class="path">@State.Root</span>
</header>

<nav class="tabs">
    <button class="@Cls(View.Modules)" @onclick="() => view = View.Modules">@T("nav.instituciones")</button>
    <button class="@Cls(View.Asistente)" @onclick="() => view = View.Asistente">@T("nav.asistente")</button>
    <button class="@Cls(View.Ajustes)" @onclick="() => view = View.Ajustes">@T("nav.ajustes")</button>
</nav>

<main>
    @switch (view)
    {
        case View.Modules:
            @if (open is null)
            {
                <ModuleList Open="@(name => open = name)" />
            }
            else
            {
                <p class="crumb">
                    <button @onclick="() => open = null">&larr; @T("nav.volver")</button>
                </p>
                <ModuleScreen Name="@open" />
            }
            break;

        case View.Asistente:
            <Asistente GoToSettings="() => view = View.Ajustes" />
            break;

        case View.Ajustes:
            <Ajustes />
            break;
    }
</main>

@code {
    // EL lang DEL DOCUMENTO, desde el idioma que ya resolvio C#. No se cablea en index.html:
    // estaba en "en" mientras tres de las cinco pantallas hablaban espanol, y un lang mentido lo
    // paga quien usa lector de pantalla, no quien lo escribio.
    //
    // Entra por un modulo propio y NO por eval, igual que en Municipalidad.Wasm: la politica de
    // contenido con que se sirve un modulo hospedado no admite eval, y un patron que anda en esta
    // ventana es un patron que alguien copia donde no anda.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await using IJSObjectReference modulo =
            await JS.InvokeAsync<IJSObjectReference>("import", "./idioma-interop.js");
        await modulo.InvokeVoidAsync("fijarIdioma", Textos.Idioma);
    }

    private enum View { Modules, Asistente, Ajustes }

    private View view = View.Modules;
    private string? open;

    private string Cls(View v) => v == view ? "active" : "";
}
