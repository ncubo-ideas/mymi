<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- THE GNOTHI DESKTOP WINDOW. The same face the Android app (Gnothi.Mobile) already has,
       on the desktop: the installed modules as cards, whose they are, on/off state, and one
       button per query. Plus the assistant (Gate 2) and its settings.

       ═══ WHY A SEPARATE PROJECT, NOT A MODE OF THE HOST ═══

       Because Gnothi.Host must stay a headless net9.0 library-plus-CLI. The Host is the core;
       this window is one more face, like the MCP front end or the phone.

       ═══ PHOTINO, NOT WINFORMS (decision of 2026-09-08) ═══

       The first version was net9.0-windows + WinForms + BlazorWebView, and for that reason it
       was left out of Gnothi.slnx: it only built on Windows. The team then made the Mac window
       an objective, and chose Photino.Blazor over MAUI/MacCatalyst: ONE project that builds and
       runs on Windows, macOS and Linux, with no extra workload, over the OS WebView (WebView2,
       WKWebView, WebKitGTK). The five Razor components and HostState did not change: they never
       knew about WinForms. Only the host of the window did -Program.cs- and the file picker.

       ═══ BLAZOR HYBRID, NOT BLAZOR WASM ═══

       The C# runs NATIVE, in this process. The WebView only paints the DOM. So: no second
       runtime, no open port, no HTTP -the components call the Dispatcher in C# directly- and
       no wasm payload. Photino serves wwwroot through a custom scheme, not a socket.

       ═══ IT USES ONLY THE HOST'S PUBLIC SURFACE ═══

       ProjectReference, not <Compile Include>, and it names only public types: ModuleCatalog,
       Dispatcher, Module, Request, Response, Meter, ModuleInstaller. Exactly like
       Gnothi.Assistant. If this ever needs an internal type, that is the signal the public seam
       is missing something - the fix is to widen the seam in the Host, never to reach through it.

       ═══ NOW IN Gnothi.slnx ═══

       Because it builds everywhere, `dotnet build Gnothi.slnx` compiles it on every machine and
       in CI. Breaking the window is now something the build catches, not something somebody
       notices on a Windows box a week later. -->

  <PropertyGroup>
    <!-- WinExe: on Windows no console pops up behind the window; on macOS and Linux the SDK
         treats it as a plain Exe, which is what we want. -->
    <OutputType>WinExe</OutputType>
    <!-- ONE target framework, chosen by the OS that builds: net9.0-windows on Windows, so the
         optional WebView2 face (WebView2WebModule.cs, the "cara ventana" flag) gets WinForms + WebView2;
         plain net9.0 everywhere else, where that file is not compiled and the face is the frame
         inside the window. One framework and not two because "dotnet run" on this project
         -what PRUEBA-MANUAL-DESKTOP.md and every script use- refuses to run a multi-targeted
         project without an explicit framework. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net9.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gnothi.Desktop</RootNamespace>
    <AssemblyName>Gnothi.Desktop</AssemblyName>
  </PropertyGroup>

  <!-- Per-monitor DPI on Windows (see app.manifest). The manifest is a Win32 resource, so it
       is only embedded when the apphost being produced is a Windows one. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- PINNED EXACTLY, LIKE THE ENGINE, AND ALL THREE - not just the top one.

         Photino.Blazor is the only package this project uses by name, but the thing that actually
         paints the window is Photino.Native, and it arrives two hops down: Blazor 4.0.13 asks for
         Photino.NET >= 4.0.16, which asks for Photino.Native >= 4.0.22.

         BE HONEST ABOUT WHAT THIS BUYS. NuGet already resolves a ">=" to the LOWEST version that
         satisfies it, transitive ones included, so the graph was landing on 4.0.16/4.0.22 on its
         own. These lines do not fix a version that was drifting. What they do:

           - they make the native lib VISIBLE. Whoever debugs "it works on my machine and not on
             Edgar's" reads the version here instead of digging it out of project.assets.json.
           - they make a future bump ARGUE instead of happen. The day something else in the graph
             asks for a higher Photino.Native, the direct reference wins and NuGet says so
             (NU1605) rather than quietly handing the window a native lib nobody chose.

         So this changes NOTHING in today's restore - verified: same three versions before and
         after. To move Photino, bump Blazor, restore, and copy the other two off the resolved
         graph so the three keep telling the same story.

         Photino.Native ships win/linux/osx, x64 and arm64, and a plain framework-dependent build
         drops ALL of them under bin/.../runtimes/ - that is what the MSI harvests. On Windows it
         brings WebView2Loader.dll but NOT the WebView2 Runtime, which has to be on the machine. -->
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Photino.Native" Version="4.0.22" />
  </ItemGroup>

  <!-- The WebView2 face, only in the Windows build. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

  <!-- Photino serves wwwroot FROM THE OUTPUT FOLDER (a PhysicalFileProvider over
       bin/.../wwwroot), unlike the WinForms BlazorWebView, which read it from the project via
       static web assets. Without this the process dies at startup with
       DirectoryNotFoundException on .../bin/Debug/net9.0/wwwroot/ -paid for once. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- THE HYBRID FORM ON THE DESKTOP. The neutral layer of the hosted form -the bridge protocol,
       the CSP, the journal, the courier, `consultar`- lives in Gnothi.MobileShared as shared
       source, and the phones compile it in. The same is done here with the six files it takes,
       with the precedent of the suite (Gnothi.Assistant.Tests compiles ModuleEnrollment.cs against
       the Host through InternalsVisibleTo). What the window writes of its own is the adapter to
       the web engine -FrameWebModule.cs, and WebView2WebModule.cs on Windows- and the enrollment
       screen, Alta.razor.

       HybridShell.cs Y WebViewShell.cs YA NO ESTAN EN ESTA LISTA - 2026-10-09. Vienen del Host,
       por ProjectReference y el InternalsVisibleTo que ya estaba.

       Y LO QUE LOS SACO DE ACA ES UN DEFECTO QUE EL COMPILADOR VENIA AVISANDO. Esta misma linea
       decia: «CS0436: WebViewShell and HybridShell also exist as stubs in the Host; the compiler
       prefers this project's copy, which is the real one», y debajo iba un <NoWarn>CS0436</NoWarn>.
       Era cierto Y era el problema: habia DOS clases con el mismo nombre, esta real y una que tiraba
       PlatformNotSupportedException en el Host. La ventana se quedaba con la buena -por eso andaba-
       y CUALQUIER OTRO CONSUMIDOR DEL HOST se quedaba con la que tira. El frente MCP es ese otro
       consumidor, y por eso todo modulo hibrido le fallaba.

       El aviso describia la duplicacion con precision y se silencio en vez de resolverla. Ahora hay
       una sola clase, el NoWarn se fue, y si alguien vuelve a duplicarla el compilador lo dira otra
       vez, que es para lo que servia. -->
  <ItemGroup>
    <Compile Include="..\Gnothi.MobileShared\WebModule.cs" Link="Movil\WebModule.cs" />
    <Compile Include="..\Gnothi.MobileShared\BundleServer.cs" Link="Movil\BundleServer.cs" />
    <Compile Include="..\Gnothi.MobileShared\GnothiCourier.cs" Link="Movil\GnothiCourier.cs" />
    <Compile Include="..\Gnothi.MobileShared\GnothiCredential.cs" Link="Movil\GnothiCredential.cs" />
    <!-- EL ALTA, la misma del telefono: bajar o leer el paquete, inspeccionarlo, firma, respaldo de
         origen, propuesta, y solo despues installation.json, con las tres formas. Reemplaza a
         ModuleInstaller como puerta de la ventana porque aquel toma solo cargo. -->
    <Compile Include="..\Gnothi.MobileShared\ModuleEnrollment.cs" Link="Movil\ModuleEnrollment.cs" />
  </ItemGroup>

  <!-- LA CAJA DE WASM, Y ACA NO ES POR LA TIENDA.
       ===============================================================================================
       En el telefono la caja resuelve DOS cosas: que el modulo pese lo que de verdad pesa, y que
       nadie tenga que confiar en que se porta bien. La primera se paga con el texto de Google Play;
       la segunda no depende de ninguna tienda.

       ACA APLICA LA SEGUNDA, Y APLICA IGUAL. Hoy en escritorio el dll de la institucion corre CON LOS
       PERMISOS DE GNOTHI: puede abrir la carpeta de otro modulo, salir a la red, leer el journal del
       laboratorio. Nada en el sistema se lo impide — lo unico que lo impide es que no lo hace.
       Medido en el telefono: de nueve intentos de fuga, SIETE funcionan en proceso y OCHO DE OCHO
       cierran en la caja. Ese numero no es de Android: es de wasm, que no tiene syscalls.

       El stub que esto reemplaza decia que en escritorio la contencion se resuelve "con el proceso
       hijo y el confinamiento del sistema operativo". Eso vale para la forma `stdio`; NO vale para
       `in-process` ni para la superficie de la hibrida, que son las que corren adentro de este
       proceso. Ahi el agujero es el mismo que en un telefono.

       CORRE EN WINDOWS DESDE EL 2026-09-25, y hasta ese dia no: arrancaba entero —motor, sustrato,
       canario 8 de 8— y moria al primer modulo con DllNotFoundException libc. El borde le hablaba
       al invitado por un FIFO de POSIX (mkfifo(3)); ahora BorderPipe tiene las dos formas, FIFO y
       named pipe, y las dos se abren POR RUTA, que es lo unico que set_stdin_file acepta.

       ACA DECIA "LOS SEIS ARCHIVOS SON NEUTRALES DE PLATAFORMA, cero referencias a Android,
       verificado" Y ESTABA MAL. Se busco una cosa —Android—, no se encontro, y se concluyo otra:
       que no habia ninguna dependencia de plataforma. POSIX no es Android.

       Y VALEN CS0436 IGUAL QUE LOS DE ARRIBA: `BoxShell` tambien existe como stub en el Host, y el
       compilador prefiere esta copia, que es la de verdad. -->
  <ItemGroup>
    <Compile Include="..\Gnothi.MobileShared\BorderPipe.cs" Link="Caja\BorderPipe.cs" />
    <Compile Include="..\Gnothi.MobileShared\Wasmtime.cs" Link="Caja\Wasmtime.cs" />
    <Compile Include="..\Gnothi.MobileShared\WasmBox.cs" Link="Caja\WasmBox.cs" />
    <Compile Include="..\Gnothi.MobileShared\BoxedInstance.cs" Link="Caja\BoxedInstance.cs" />
    <Compile Include="..\Gnothi.MobileShared\Cage.cs" Link="Caja\Cage.cs" />
    <Compile Include="..\Gnothi.MobileShared\Canary.cs" Link="Caja\Canary.cs" />
    <Compile Include="..\Gnothi.MobileShared\BoxShell.cs" Link="Caja\BoxShell.cs" />

    <!-- EL SUSTRATO, Y ES EL MISMO ARCHIVO QUE LLEVA EL TELEFONO, no una copia ni un build propio:
         es wasm, no tiene nada de plataforma adentro. Son 11 MB en la salida del build.

         Se referencia desde Gnothi.Mobile/Assets/ a proposito, para que no haya dos. El dia que el
         sustrato cambie, cambia en un lugar; si esto fuera una copia, el escritorio se quedaria
         corriendo el anterior y nadie lo notaria — que es exactamente el modo de falla que la huella
         del .cwasm existe para atrapar. -->
    <None Include="..\Gnothi.Mobile\Assets\sustrato.wasm" Link="sustrato.wasm"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- LA SALA. La cascara es EL MISMO ARCHIVO que compilan los dos telefonos, no una copia: lo que
       decide -una llamada en vuelo, un modulo cargado por vez, y la identidad sacada del marco de la
       llamada y nunca del mensaje- vive ahi y no puede divergir por plataforma. Lo unico que cambia
       es quien implementa `IRoomHost`, y aca es DesktopRoom sobre WebView2.

       Reemplaza a RoomShellStub del Host por el mismo CS0436 que los de arriba. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Include="..\Gnothi.MobileShared\RoomShell.cs" Link="Sala\RoomShell.cs" />

    <!-- EL SUSTRATO DE LA SALA, publicado y POR REFERENCIA: igual que en los dos telefonos, no se
         copia al repo. Van a `sala/` en la salida, que es de donde DesktopRoom los sirve por
         https://sala.gnothi.local/.

         Se excluyen .gz y .br porque aca los bytes salen de disco local y solo pesarian.

         SI LA CARPETA NO ESTA, el build no falla y la sala dice por que al arrancar. Se regenera:
           dotnet publish Spikes/Lab.Sala/Sustrato -c Release -o Spikes/Lab.Sala/Sustrato/publicado -->
    <None Include="..\Spikes\Lab.Sala\Sustrato\publicado\wwwroot\**\*"
          Exclude="..\Spikes\Lab.Sala\Sustrato\publicado\wwwroot\**\*.gz;..\Spikes\Lab.Sala\Sustrato\publicado\wwwroot\**\*.br"
          Link="sala\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- APPLE INTELLIGENCE. El IModel del telefono es EL MISMO ARCHIVO que compila Gnothi.iOS, no
       una copia (mismo precedente que Gnothi.Assistant.Tests con Snapshot.cs). Sus DllImport
       apuntan a "__Internal"; AppleModel.Wire() los resuelve a la dylib. La dylib la deja
       armar-modelo.sh en native/ y solo existe en una Mac con Xcode: sin ella el proyecto compila
       igual y el preset no aparece. -->
  <ItemGroup>
    <Compile Include="..\Gnothi.iOS\ModelFoundation.cs" Link="ModelFoundation.cs" />
    <None Include="native\libGnothiModelo.dylib" Condition="Exists('native\libGnothiModelo.dylib')"
          CopyToOutputDirectory="PreserveNewest" Link="libGnothiModelo.dylib" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdown -> HTML para la burbuja del asistente. Los modelos devuelven markdown aunque el
         encuadre pida prosa sin markdown -la instruccion es tendencia, no compuerta, medido en
         Lab.Cruce-, asi que la ventana lo pinta en vez de mostrar los asteriscos. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gnothi.Host\Gnothi.Host.csproj" />
    <!-- The assistant brain -the SAME AgentLoop the phone runs- reused, not reimplemented. -->
    <ProjectReference Include="..\Gnothi.Assistant\Gnothi.Assistant.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- EL ICONO DEL EJECUTABLE. `SetIconFile` le pone cara a la VENTANA; esto se la pone al
         archivo, que es de donde Windows saca el icono de la barra de tareas, el del
         explorador y el de alt-tab. Sin los dos, Mymi tiene cara abierta y no la tiene
         anclada.

         EN LA MAC NINGUNO DE LOS DOS SIRVE: ahi el nombre y el icono de una app se declaran en
         un Info.plist, que es el de al lado, y lo pone adentro de Mymi.app empaquetar-mac.sh.
         El icono de la Mac no es este .ico: se genera del mismo png que pintan los telefonos. -->
    <ApplicationIcon>mymi.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="mymi.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- LA CARA DE MYMI, Y ES EL MISMO ARCHIVO que pintan los dos telefonos: se enlaza, no se
         copia. Si la marca cambia, cambia en las tres caras a la vez; dos copias divergen. -->
    <Content Include="..\Gnothi.Mobile\Assets\img\mymi-hub.png" Link="wwwroot\mymi.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- wasmtime: la libreria nativa de la caja, bajada con la version fijada y el hash comprobado en
       vez de versionada. El porque esta en ese archivo. -->
  <Import Project="wasmtime.targets" />
</Project>
