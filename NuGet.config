<?xml version="1.0" encoding="utf-8"?>
<!-- De donde sale el motor.

     El paquete Ncubo.Puppeteer NO esta en nuget.org: vive en el feed privado de la
     organizacion. Sin este archivo un `dotnet build` en una maquina limpia falla con

         error NU1101: Unable to find package Ncubo.Puppeteer.
         No packages exist with this id in source(s): nuget.org

     y el error no dice que falta un feed, asi que se pierde tiempo buscandolo en el
     csproj. COMO-INTEGRARLO.md dice "el motor viene por NuGet, asi que no hay que clonar
     nada ni ajustar rutas", lo cual es cierto, pero omite que el feed hay que declararlo.

     La autenticacion no va aca: la resuelve el Azure Artifacts Credential Provider
     (~/.nuget/plugins). Si el restore pide credenciales, es que falta ese plugin o que el
     token cacheado expiro.

     El packageSourceMapping manda todo lo que empiece con Ncubo.* al feed privado y el
     resto a nuget.org: asi un paquete publico no se busca en el feed privado ni al
     revés. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="ncubo-puppeteer" value="https://pkgs.dev.azure.com/ncubo/_packaging/Puppeteer/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="ncubo-puppeteer">
      <package pattern="Ncubo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
