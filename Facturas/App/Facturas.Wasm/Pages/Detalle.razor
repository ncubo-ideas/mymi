@page "/factura/{Numero}"
@using System.Globalization
@using Facturas.App.Vistas
@inject EstadoDeLaApp estado
@inject NavigationManager navegacion

<PageTitle>Factura @Numero</PageTitle>

<button class="btn btn-outline-secondary mb-3" @onclick="Volver">&larr; Volver a la lista</button>

@if (!estado.EstaArriba)
{
    <div class="alert alert-warning">
        La app no está abierta. <a href="">Volvé a la lista</a> para abrirla.
    </div>
}
else if (error.Length > 0)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <h1>Factura @detalle.Numero</h1>
    <p class="text-muted">
        @detalle.Fecha.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)
    </p>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>SKU</th><th>Descripción</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Costo unitario</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (LineaDeFactura linea in detalle.Lineas)
            {
                <tr>
                    <td><code>@linea.Sku</code></td>
                    <td>@linea.Descripcion</td>
                    <td class="text-end">@linea.Cantidad</td>
                    <td class="text-end">@Plata(linea.CostoUnitario)</td>
                    <td class="text-end">@Plata(linea.TotalDeLinea)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4" class="text-end">Total</td>
                <td class="text-end">@Plata(detalle.Total)</td>
            </tr>
        </tfoot>
    </table>
}

@code {
    [Parameter] public string Numero { get; set; } = "";

    private FacturaDetallada detalle = new();
    private string error = "";

    protected override void OnParametersSet()
    {
        error = "";
        if (!estado.EstaArriba) return;

        // El dominio tira KeyNotFoundException si el numero no existe; la pantalla lo
        // traduce a un mensaje en vez de dejar reventar la UI.
        try { detalle = estado.Detalle(Numero); }
        catch (Exception ex) { error = $"No se pudo abrir la factura {Numero}: {ex.Message}"; }
    }

    private void Volver() => navegacion.NavigateTo("");

    private static string Plata(decimal monto) => monto.ToString("N2", CultureInfo.InvariantCulture);
}
