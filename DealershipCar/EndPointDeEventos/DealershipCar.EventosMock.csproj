<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Mock del servidor del concesionario (URL2). Happy path, estado en memoria, cero
       dependencias externas.

       No pretende ser el server de verdad. Su unico trabajo es hacer FALSABLES los
       invariantes: que la app solo pueda leer su propia narrativa y que su token no le
       sirva para nada mas. De ahi el endpoint SENUELO — un recurso que exige un scope que
       ningun token de device lleva, asi que devuelve 403 ESTRUCTURALMENTE y no por cortesia.

       El concesionario sirve EVENTOS; la interpretacion es del modulo. No hay endpoint de
       vistas, ni de reportes, ni de consultas.

       Se llena en T8. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DealershipCar.EventosMock</RootNamespace>
    <AssemblyName>DealershipCar.EventosMock</AssemblyName>
  </PropertyGroup>

</Project>
