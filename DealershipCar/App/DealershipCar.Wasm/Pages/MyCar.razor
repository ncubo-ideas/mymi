@page "/"
@inject AppState state
@inject DealershipSettings dealership
@inject NavigationManager nav

@{
    RenderFragment<string> Moving = kind =>
        @<div class="row" id="@("row-" + kind)">
            <span class="@("row__when row__when--" + HowADueStateLooks.ToneOf(board[kind]))">
                @AppState.Spaced(board[kind])
            </span>
            <span class="row__main">
                <span class="row__titleline">
                    <span class="row__title">@AppState.Spaced(kind)</span>
                    @if (deferrals[kind] > 0)
                    {
                        <span class="chip chip--ghost">put off @deferrals[kind]&times;</span>
                    }
                </span>
                <span class="row__sub">@reasons[kind]</span>
            </span>
        </div>;

    RenderFragment<string> Settled = kind =>
        @<div class="item" id="@("row-" + kind)">
            <span class="@("bullet bullet--sm bullet--" + HowADueStateLooks.ToneOf(board[kind]))">
                <Glyph Name="@HowADueStateLooks.GlyphOf(board[kind])" Size="13" Stroke="2.6" />
            </span>
            <span class="item__body">
                <span class="item__head">
                    <span class="item__name">@AppState.Spaced(kind)</span>
                    <span class="prov">@AppState.Spaced(board[kind])</span>
                </span>
                <span class="item__says">@reasons[kind]</span>
            </span>
        </div>;
}

@if (error.Length > 0 || destinationProblem.Length > 0)
{
    <div class="stack stack--top">
        @if (error.Length > 0)
        {
            <Notice Tone="danger" Id="error"
                    Title="@(state.IsUp ? "The operation could not be completed." : "The app could not be opened.")">
                This is a fault in the app, not something you did. The details name the step that failed.
                <button class="linkbtn" type="button" id="show-error-detail"
                        @onclick="@(() => errorDetail = !errorDetail)">
                    @(errorDetail ? "hide details" : "details")
                </button>
                @if (errorDetail || showInstrument)
                {
                    <span class="detail">@error</span>
                }
            </Notice>
        }

        @if (destinationProblem.Length > 0)
        {
            <Notice Tone="danger" Id="destination-problem" Title="The browser said no.">
                @destinationProblem
            </Notice>
        }
    </div>
}

@if (!state.IsUp)
{
    <div class="page-head page-head--row">
        <div>
            <h1 class="page-title">@(state.NeedsRegrant ? "Welcome back" : "My maintenance schedule")</h1>
            <p class="page-sub">
                @if (state.NeedsRegrant)
                {
                    <span>
                        Your folder is <strong>&laquo;@state.FolderName&raquo;</strong>. The browser asks
                        you to confirm write permission every time you reopen the app.
                    </span>
                }
                else
                {
                    <span>This app keeps <strong>your</strong> maintenance record. Choose where.</span>
                }
            </p>
        </div>
        <AppearanceToggle />
    </div>

    <div class="stack stack--page">
        @if (state.NeedsRegrant)
        {
            <div class="notice__stack">
                <button class="btn" type="button" id="regrant" @onclick="RequestPermission">
                    <Glyph Name="lock" Size="18" />
                    Grant permission to &laquo;@state.FolderName&raquo;
                </button>
                <button class="btn btn--ghost" type="button" id="choose-folder" @onclick="ConnectFolder"
                        disabled="@(pickerSupported == false)">
                    <Glyph Name="folder" Size="18" />
                    Choose a different folder
                </button>
                <button class="btn btn--quiet" type="button" id="forget-folder" @onclick="ForgetFolder">
                    Forget this folder
                </button>
            </div>
        }
        else
        {
            @if (noStorage == "insecure")
            {
                <Notice Tone="warn" Id="no-storage-insecure"
                        Title="This page is not on a secure connection">
                    The browser will not let it save anything &mdash; any browser would do the same.
                    Open it over <span class="mono">https</span>, or over
                    <span class="mono">localhost</span>.
                </Notice>
            }
            else if (noStorage == "browser")
            {
                <Notice Tone="warn" Id="no-storage-browser"
                        Title="This browser cannot save anything for this app.">
                    It has neither a folder picker nor private storage. Opening the app in another
                    browser is the way out.
                </Notice>
            }

            @if (pickerSupported == true)
            {
                <div class="card card--pad">
                    <button class="btn" type="button" id="choose-folder" @onclick="ConnectFolder">
                        <Glyph Name="folder" Size="18" />
                        Choose a folder
                    </button>
                    <p class="note note--tight">
                        The record lives in a folder of yours, and <strong>your assistant can read
                        it</strong> &mdash; that is what the MCP server reads. This is the one that
                        makes the app worth having.
                    </p>
                </div>
            }

            @if (browserStorageSupported == true)
            {
                <div class="card card--pad">
                    <button class="btn btn--ghost" type="button" id="use-browser-storage"
                            @onclick="UseBrowserStorage">
                        <Glyph Name="storage" Size="18" />
                        @(installedApp ? "Save inside this app" : "Save in this browser")
                    </button>
                    <p class="note note--tight">
                        It survives closing, but it is <strong>not a folder of yours</strong> and your
                        assistant <strong>cannot read it</strong>. The folder picker is desktop Chromium
                        only, so this is the fallback, not an equal choice.
                    </p>
                </div>
            }
        }

        <button class="btn btn--quiet" type="button" id="open-without-saving" @onclick="Open">
            Open without saving anything
        </button>
    </div>
}
else
{
    @* ------------------------------------------------------------------
       La app abierta: la piel del dueno. Cinco pestanas, una columna, y
       el registro leido una sola vez por apertura (LoadAsync) para que las
       cinco hablen del mismo instante.
       ------------------------------------------------------------------ *@
    <div class="d">
        <div class="d__col">

            @if (tab == "inicio")
            {
                <Inicio Nueve="@AppState.TheNineKinds"
                        Board="@board"
                        Reasons="@reasons"
                        Overdue="@overdue"
                        Due="@due"
                        Missed="@missed"
                        Siguiente="@nextDue"
                        Modelo="@(sheet is not null ? sheet.Model : "")"
                        Odometro="@(stands is not null && stands.OdometerKnown ? ComoSeLee.Miles(stands.Odometer) : "--")"
                        OdometroUnidad="@(stands is not null && stands.OdometerKnown ? stands.OdometerUnit : "")"
                        ObservadoEl="@(stands is not null ? stands.OdometerObservedAt : "")"
                        EvaluadoHasta="@evaluatedUpTo"
                        DondeVive="@(state.InOwnFolder ? "la carpeta «" + state.FolderName + "»" : "este navegador")"
                        Agencia="@dealership.Name"
                        Contacto="@dealership.Contact"
                        VerServicios="@(() => tab = "servicios")" />

                <div class="d__pad d__gap" style="margin-top:14px">
                    @if (state.DealershipUnreachable.Length > 0)
                    {
                        <Notice Tone="warn" Id="dealership-unreachable"
                                Title="Esto es tu registro, no las novedades de hoy.">
                            La app no pudo llegar al concesionario al abrir, así que lo que haya enviado
                            desde la última vez todavía no está aquí. Todo lo de arriba es lo que tu
                            registro ya tenía.
                            <span class="detail">@state.DealershipUnreachable</span>
                            <span class="notice__actions">
                                <button class="btn btn--sm" type="button" id="retry-dealership" @onclick="Refresh">
                                    <Glyph Name="sync" Size="16" />
                                    Intentar de nuevo
                                </button>
                            </span>
                        </Notice>
                    }

                    @if (state.SavingIsFailing.Length > 0)
                    {
                        <Notice Tone="danger" Id="saving-failing" Title="La carpeta rechazó la escritura.">
                            Lo que ves <strong>no</strong> quedó guardado en «@state.FolderName». Suele ser
                            el permiso, que vence cada vez que reabrís la app.
                            <span class="detail">@state.SavingIsFailing</span>
                            <span class="notice__actions">
                                <button class="btn btn--sm" type="button" id="regrant" @onclick="RequestPermission">
                                    <Glyph Name="lock" Size="16" />
                                    Dar permiso otra vez
                                </button>
                            </span>
                        </Notice>
                    }

                    @if (state.EvaluationSkipped.Length > 0)
                    {
                        <Notice Tone="warn" Id="evaluation-skipped" Title="Esta no es la lectura de hoy.">
                            @state.EvaluationSkipped
                        </Notice>
                    }
                </div>
            }
            else if (tab == "vehiculo")
            {
                <div class="d__pad" style="padding-top:16px">
                    <div class="page-head page-head--row" style="margin-bottom:12px">
                        <h1 class="page-title">Mi vehículo</h1>
                        <AppearanceToggle />
                    </div>

                    <Vehiculo Sheet="@sheet"
                              Stands="@stands"
                              Modelo="@(sheet is not null ? sheet.Model : "")"
                              Vin="@vin"
                              Odometro="@(stands is not null && stands.OdometerKnown ? ComoSeLee.Miles(stands.Odometer) : "--")"
                              OdometroUnidad="@(stands is not null && stands.OdometerKnown ? stands.OdometerUnit : "")" />
                </div>
            }
            else if (tab == "servicios")
            {
                <div class="d__pad" style="padding-top:16px">
                    <div class="page-head page-head--row" style="margin-bottom:4px">
                        <h1 class="page-title">Servicios</h1>
                        <AppearanceToggle />
                    </div>

                    <Servicios Nueve="@AppState.TheNineKinds" Board="@board" Reasons="@reasons" />
                </div>
            }
            else if (tab == "cobertura")
            {
                <div class="d__pad" style="padding-top:16px">
                    <div class="page-head page-head--row" style="margin-bottom:4px">
                        <h1 class="page-title">Cobertura</h1>
                        <AppearanceToggle />
                    </div>

                    <Cobertura Sheet="@sheet" Stands="@stands" />
                </div>
            }
            else
            {
                <div class="d__pad" style="padding-top:16px">
                    <div class="page-head page-head--row" style="margin-bottom:4px">
                        <h1 class="page-title">Mi registro</h1>
                        <AppearanceToggle />
                    </div>

                    <MiRegistro EnCarpeta="@state.InOwnFolder"
                                Carpeta="@state.FolderName"
                                Vin="@vin"
                                Entradas="@entries"
                                UltimoEvento="@lastEvent"
                                EvaluadoHasta="@evaluatedUpTo"
                                Origen="@state.WhereTheDealershipIs"
                                Trayendo="@refreshing"
                                Actualizar="@Refresh" />
                </div>
            }
        </div>
    </div>
}

@if (state.IsUp)
{
    <nav class="d-tabbar" id="tabbar">
        <button type="button" id="go-inicio" @onclick="@(() => tab = "inicio")"
                class="@(tab == "inicio" ? "d-tabbar__item d-tabbar__item--on" : "d-tabbar__item")">
            <Glyph Name="home" Size="22" Stroke="2" />
            <span>Inicio</span>
        </button>
        <button type="button" id="go-vehiculo" @onclick="@(() => tab = "vehiculo")"
                class="@(tab == "vehiculo" ? "d-tabbar__item d-tabbar__item--on" : "d-tabbar__item")">
            <Glyph Name="car" Size="22" Stroke="2" />
            <span>Mi vehículo</span>
        </button>
        <button type="button" id="go-servicios" @onclick="@(() => tab = "servicios")"
                class="@(tab == "servicios" ? "d-tabbar__item d-tabbar__item--on" : "d-tabbar__item")">
            <Glyph Name="clock" Size="22" Stroke="2" />
            <span>Servicios</span>
        </button>
        <button type="button" id="go-cobertura" @onclick="@(() => tab = "cobertura")"
                class="@(tab == "cobertura" ? "d-tabbar__item d-tabbar__item--on" : "d-tabbar__item")">
            <Glyph Name="shield" Size="22" Stroke="2" />
            <span>Cobertura</span>
        </button>
        <button type="button" id="go-registro" @onclick="@(() => tab = "registro")"
                class="@(tab == "registro" ? "d-tabbar__item d-tabbar__item--on" : "d-tabbar__item")">
            <Glyph Name="folder" Size="22" Stroke="2" />
            <span>Mi registro</span>
        </button>
    </nav>
}

@code {
    private bool? pickerSupported;
    private bool? browserStorageSupported;
    private string noStorage = "";
    private bool installedApp;
    private bool refreshing;

    private bool showInstrument;

    private bool errorDetail;

    /// <summary>Cual de las cinco pestanas se esta viendo: inicio, vehiculo, servicios, cobertura o registro.</summary>
    private string tab = "inicio";


    private string vin = "";
    private string evaluatedUpTo = "";
    private string nextDue = "";
    private int due;
    private int overdue;
    private int missed;
    private long lastEvent;
    private long entries;
    private int memfsFiles;
    private long memfsBytes;
    private string permission = "";
    private bool hasCredential;

    private string heroTone = "";
    private string heroPill = "";
    private string heroTitle = "";
    private string heroLine = "";
    private string heroReading = "--";
    private string heroReadingUnit = "";
    private string heroReadingNote = "";

    private Dictionary<string, string> board = Empty();
    private Dictionary<string, string> reasons = Empty();
    private Dictionary<string, int> deferrals = NoDeferralsYet();

    /// <summary>
    /// Los estados que piden algo, en el orden en que se leen. Un estado fuera de esta lista esta
    /// resuelto y va al grupo plegado, asi que agregar un estado al dominio sin agregarlo aca lo
    /// esconde en vez de romper.
    /// </summary>
    private static readonly string[] TheStatesThatAskForSomething =
    {
        "Overdue", "Due", "DueSoon", "Deferred"
    };

    /// <summary>Lo que la pantalla dice cuando ninguna de las nueve pide nada.</summary>
    private const string NothingIsMoving =
        "Nothing is due right now.";

    private List<string> moving = new List<string>();
    private List<string> settled = new List<string>(AppState.TheNineKinds);

    private WhatTheManufacturerPublished sheet;
    private WhereThisVehicleStands stands;

    private string error = "";
    private string destinationProblem = "";

    protected override async Task OnInitializedAsync()
    {
        pickerSupported = await state.PickerIsSupportedAsync();
        browserStorageSupported = await state.BrowserStorageIsSupportedAsync();
        installedApp = await state.RunsAsInstalledAppAsync();

        showInstrument = new Uri(nav.Uri).Query.Contains("instrument", StringComparison.OrdinalIgnoreCase);

        noStorage = await state.WhyThereIsNoStorageAsync() switch
        {
            "inseguro" => "insecure",
            "navegador" => "browser",
            _ => "",
        };

        if (state.IsUp) { await Reread(); return; }

        if (await state.RememberedModeAsync() == "opfs" && browserStorageSupported == true)
        {
            if ((await state.UseBrowserStorageAsync()).Ok) { await Open(); return; }
        }

        if (pickerSupported != true) return;

        FolderResult recovered = await state.RecoverFolderAsync();

        if (recovered.Ok) await Open();
    }

    private Task ConnectFolder() => Try("choose a folder", async () =>
        await OpenOrSay(await state.ConnectFolderAsync(), "choose that folder"));

    private Task RequestPermission() => Try("grant permission to the folder", async () =>
        await OpenOrSay(await state.RequestPermissionAsync(), "get write permission on that folder"));

    private Task UseBrowserStorage() => Try("save in this browser", async () =>
        await OpenOrSay(await state.UseBrowserStorageAsync(), "use this browser's storage"));

    private async Task OpenOrSay(FolderResult result, string whatItWasTrying)
    {
        if (result.Ok)
        {
            destinationProblem = "";
            await state.StartAsync();
            await Reread();
            return;
        }

        destinationProblem = result.Permission == "denied"
            ? $"The browser refused to {whatItWasTrying}, without asking you. Two things do that, and "
              + "they are fixed in different places. Either this site's file-editing permission is "
              + "blocked — open the padlock next to the address, reset this site's permissions, reload, "
              + "and pick the folder again — or this browser does not grant file editing at all, which "
              + "is normal for an in-app or embedded browser. If there is no padlock to open, it is the "
              + "second one: open this app in Chrome or Edge directly and the folder will work there."
            : $"Could not {whatItWasTrying}. The browser said: "
              + (result.Reason.Length > 0 ? result.Reason : result.Permission);
    }

    private Task ForgetFolder() => Try("forget the saved folder", async () =>
    {
        await state.ForgetTheFolderAsync();
        destinationProblem = "";
    });

    private Task Open() => Try("open the app", async () =>
    {
        await state.StartAsync();
        await Reread();
    });

    private Task Refresh() => Try("refresh against the dealership", async () =>
    {
        refreshing = true;
        try { await state.RefreshAsync(); }
        finally { refreshing = false; await Reread(); }
    });

    private async Task Try(string step, Func<Task> action)
    {
        error = "";

        errorDetail = false;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            var detail = new System.Text.StringBuilder($"Step: {step}\n{ex.GetType().FullName}: {ex.Message}");
            for (Exception inner = ex.InnerException; inner is not null; inner = inner.InnerException)
                detail.Append($"\n  cause: {inner.GetType().FullName}: {inner.Message}");
            error = detail.ToString();
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task Reread()
    {
        vin = state.ReadVin();
        due = state.CountDue();
        overdue = state.CountOverdue();
        missed = state.MissedCount();
        lastEvent = state.LastEventApplied();
        evaluatedUpTo = state.EvaluatedUpTo();
        nextDue = state.NextDueKind();
        entries = state.JournalEntries();
        hasCredential = state.HasCredential();

        var states = new Dictionary<string, string>();
        var why = new Dictionary<string, string>();
        var used = new Dictionary<string, int>();
        foreach (string kind in AppState.TheNineKinds)
        {
            states[kind] = state.ReadDueState(kind);
            why[kind] = state.ReadDueReason(kind);
            used[kind] = state.DeferralsUsed(kind);
        }
        board = states;
        reasons = why;
        deferrals = used;

        var asking = new List<string>();
        foreach (string asked in TheStatesThatAskForSomething)
            foreach (string kind in AppState.TheNineKinds)
                if (states[kind] == asked) asking.Add(kind);

        var resolved = new List<string>();
        foreach (string kind in AppState.TheNineKinds)
            if (Array.IndexOf(TheStatesThatAskForSomething, states[kind]) < 0) resolved.Add(kind);

        moving = asking;
        settled = resolved;

        sheet = state.ReadTheSpecification();
        stands = state.ReadWhereThisVehicleStands();

        ComposeTheHero();

        (memfsFiles, memfsBytes) = state.MemfsState();
        permission = await state.CurrentPermissionAsync();
    }

    /// <summary>
    /// Arma el encabezado con lo que el registro ya contesto. Ninguna frase se compone aca: la linea
    /// larga es la razon que escribio el calendario, y las cortas son etiquetas de la pantalla.
    /// </summary>
    private void ComposeTheHero()
    {
        string subject = nextDue.Length > 0 ? nextDue : moving.Count > 0 ? moving[0] : "";

        heroTone = overdue > 0 ? "hero--attention" : moving.Count > 0 ? "" : "hero--settled";

        heroPill = overdue > 0 ? "Needs attention" : moving.Count > 0 ? "Coming up" : "Up to date";

        heroTitle = subject.Length > 0 ? AppState.Spaced(subject) : NothingIsMoving;

        heroLine = subject.Length > 0
            ? reasons[subject]
            : "None of the nine is due, due soon, overdue or put off. Every one of them is under "
              + "«All in order» below, with the schedule's own reason.";

        heroReading = stands is not null && stands.OdometerKnown
            ? HowANumberReads.Grouped(stands.Odometer)
            : "--";

        heroReadingUnit = stands is not null && stands.OdometerKnown ? stands.OdometerUnit : "";

        heroReadingNote = stands is not null && stands.OdometerKnown
            ? $"observed on {stands.OdometerObservedAt}"
            : "your dealership has not sent one yet";
    }

    private string Destination() => state.Mode switch
    {
        "carpeta" => $"your folder ({state.FolderName})",
        "opfs" => "this browser's storage",
        _ => "none",
    };

    private static Dictionary<string, string> Empty() => EveryKindStartsAt("");

    private static Dictionary<string, int> NoDeferralsYet()
    {
        var start = new Dictionary<string, int>();
        foreach (string kind in AppState.TheNineKinds) start[kind] = 0;
        return start;
    }

    private static Dictionary<string, string> EveryKindStartsAt(string value)
    {
        var start = new Dictionary<string, string>();
        foreach (string kind in AppState.TheNineKinds) start[kind] = value;
        return start;
    }
}
