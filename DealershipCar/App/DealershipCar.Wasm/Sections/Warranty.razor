<div class="stack stack--inner" id="warranty">
    <section class="block">
        <div class="sect-head" id="envelope-head">
            <h2>Where your car stands</h2>
            <span class="prov" id="envelope-asked-at">as of @Stands.AskedAt</span>
        </div>

        @if (Stands.RecordContradictsItself)
        {
            <Notice Tone="danger" Id="record-contradicts-itself">
                @TheOwnerIsTold.TheRecordSaysTwoThingsThatCannotBothBeTrue
            </Notice>

            <p class="says says--absent" id="published-envelope-says">@Stands.PublishedSays</p>
        }
        else
        {
            @if (Stands.Standing.Length > 0)
            {
                <div id="envelope-standing">
                    <span class="chip chip--info">
                        <Glyph Name="shield" Size="13" Stroke="2.2" />
                        @AppState.Spaced(Stands.Standing)
                    </span>
                </div>
            }

            <p class="says" id="envelope-says">@Stands.Says</p>

            @if (Stands.TheRecordIsMissingAFact)
            {
                <Notice Tone="info" Id="envelope-incomplete">
                    @TheOwnerIsTold.TheDealershipHasNotSentTheseFactsYet
                </Notice>
            }

            @if (Stands.EnvelopePublished || Stands.DeliveryRecorded || Stands.OdometerKnown)
            {
                <div class="block__label" id="measured-against-head">What that was measured against</div>

                <div class="card cardlist" id="measured-against">
                    @if (Stands.EnvelopePublished)
                    {
                        <div class="item" id="measured-envelope">
                            <span class="bullet bullet--sm bullet--info">
                                <Glyph Name="shield" Size="13" Stroke="2.2" />
                            </span>
                            <span class="item__body">
                                <span class="item__head">
                                    <span class="item__name">Envelope published</span>
                                    <span class="prov">@Stands.PublishedAt</span>
                                </span>
                            </span>
                        </div>
                    }

                    @if (Stands.DeliveryRecorded)
                    {
                        <div class="item" id="measured-delivery">
                            <span class="bullet bullet--sm bullet--info">
                                <Glyph Name="calendar" Size="13" Stroke="2.2" />
                            </span>
                            <span class="item__body">
                                <span class="item__head">
                                    <span class="item__name">Handed over</span>
                                    <span class="prov">@Stands.DeliveredAt</span>
                                </span>
                                <span class="item__says">
                                    odometer that day
                                    @HowANumberReads.Grouped(Stands.DeliveryReading) @Stands.DeliveryUnit
                                </span>
                            </span>
                        </div>
                    }

                    @if (Stands.OdometerKnown)
                    {
                        <div class="item" id="measured-odometer">
                            <span class="bullet bullet--sm bullet--info">
                                <Glyph Name="gauge" Size="13" Stroke="2.2" />
                            </span>
                            <span class="item__body">
                                <span class="item__head">
                                    <span class="item__name">Latest odometer reading</span>
                                    <span class="prov">
                                        @HowANumberReads.Grouped(Stands.Odometer) @Stands.OdometerUnit
                                    </span>
                                </span>
                                <span class="item__says">observed on @Stands.OdometerObservedAt</span>
                            </span>
                        </div>
                    }
                </div>
            }
        }
    </section>

    <section class="block">
        <div class="sect-head">
            <h2>What the scope says</h2>
            <span class="prov" id="warranty-provenance">
                @(Sheet.Coverage.Published ? "scope · " + Provenance(Sheet.Coverage.Revision) : "no scope published")
            </span>
        </div>

        <p class="note note--tight" id="warranty-scope-note">
            Below is the scope the manufacturer published for model
            <span class="mono">@Sheet.Model</span>. It says what is inside the scope; it never says a
            repair will be paid for.
        </p>

        @if (!Sheet.Coverage.Published)
        {
            <Notice Tone="info" Id="no-scope">@Sheet.Coverage.Says</Notice>
        }
        else
        {
            <div class="card card--pad">
                <p class="says" id="scope-says">@Sheet.Coverage.Says</p>

                <div class="chiprow" id="covered-systems">
                    <span class="chiprow__label">Declared inside</span>
                    @if (Sheet.Coverage.CoveredSystems.Length == 0)
                    {
                        <span class="chiprow__none">
                            no system was published as being inside the scope
                        </span>
                    }
                    else
                    {
                        @foreach (string system in Sheet.Coverage.CoveredSystems)
                        {
                            <span class="chip chip--info">@system</span>
                        }
                    }
                </div>

                <p class="note note--tight" id="silence-is-not-a-denial">
                    @TheOwnerIsTold.ASystemThatIsNotListedWasNotRuledOut
                </p>
            </div>

            @if (Stands.Systems.Count > 0)
            {
                <div class="block__label" id="coverage-standings-head">
                    Where your car stands on each
                </div>

                <div class="card cardlist" id="coverage-standings">
                    @foreach (CoverageStandingForThisVehicle system in Stands.Systems)
                    {
                        <div class="item" id="@("coverage-" + system.SystemCode)">
                            <span class="bullet bullet--sm bullet--info">
                                <Glyph Name="shield" Size="13" Stroke="2.2" />
                            </span>
                            <span class="item__body">
                                <span class="item__head">
                                    <span class="item__name">@system.SystemCode</span>
                                    @if (system.Standing.Length > 0)
                                    {
                                        <span class="prov">@AppState.Spaced(system.Standing)</span>
                                    }
                                </span>
                                <span class="item__says">@system.Says</span>
                            </span>
                        </div>
                    }
                </div>
            }

            <div id="exclusions">
                <div class="block__title">What it leaves out</div>
                @if (Sheet.Coverage.Exclusions.Length == 0)
                {
                    <p class="note">No exclusion was published with this scope.</p>
                }
                else
                {
                    <ul class="exclusions">
                        @foreach (string exclusion in Sheet.Coverage.Exclusions)
                        {
                            <li>@exclusion</li>
                        }
                    </ul>
                }
            </div>
        }
    </section>

    <section class="block" id="servicing-rule">
        <div class="sect-head">
            <h2>Servicing elsewhere</h2>
            <span class="prov">@Provenance(Sheet.ServicingRule.Revision)</span>
        </div>

        <div class="card card--pad">
            <p class="@(Sheet.ServicingRule.Published ? "says" : "says says--absent")"
               id="servicing-rule-says">
                @Sheet.ServicingRule.Says
            </p>

            @if (Sheet.ServicingRule.Published)
            {
                <p class="note note--tight" id="servicing-rule-standing">
                    @TheOwnerIsTold.TheServicingRuleStandingIsNotInThisRecord
                </p>
            }
        </div>
    </section>
</div>

@code {
    /// <summary>La ficha del fabricante, leida en un solo momento. La seccion no lee nada por su cuenta.</summary>
    [Parameter, EditorRequired]
    public WhatTheManufacturerPublished Sheet { get; set; }

    /// <summary>
    /// Donde esta parado ESTE vehiculo, leido en el mismo momento. Va aparte de la ficha porque la
    /// ficha es de un modelo y esto es de un carro.
    /// </summary>
    [Parameter, EditorRequired]
    public WhereThisVehicleStands Stands { get; set; }

    private static string Provenance(string revision) => revision.Length > 0 ? revision : "--";
}
