<div class="board-head mt-8" id="my-vehicle">
    <MudText Typo="Typo.h6">My vehicle</MudText>
    <MudText Typo="Typo.caption" HtmlTag="p" Class="muted" id="my-vehicle-provenance">
        What the manufacturer published for model <span class="mono">@Sheet.Model</span>.
        @if (Sheet.HasASealedRevision)
        {
            <span>
                The current sheet is revision <span class="mono">@Sheet.CurrentRevision</span>,
                published @Sheet.CurrentRevisionPublishedAt. Each line below names the revision it
                came from, which is not always this one.
            </span>
        }
    </MudText>
</div>

@if (!Sheet.HasASealedRevision)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" id="nothing-published">
        @TheOwnerIsTold.NothingHasBeenPublishedYet
    </MudAlert>
}
else
{
    <MudTable T="PublishedFluid" Items="@Sheet.Fluids" Hover="true" Elevation="0" Outlined="true"
              Breakpoint="Breakpoint.Sm" Class="board mb-6" id="fluids">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle2">Fluids</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Fluid</MudTh>
            <MudTh>What it takes</MudTh>
            <MudTh Style="width:130px">Revision</MudTh>
        </HeaderContent>
        <RowTemplate Context="fluid">
            <MudTd DataLabel="Fluid" id="@("fluid-" + fluid.Kind)">
                <span class="op-name">@AppState.Spaced(fluid.Kind)</span>
            </MudTd>
            <MudTd DataLabel="What it takes" Class="@Sentence(fluid.Published)">@fluid.Says</MudTd>
            <MudTd DataLabel="Revision">
                <span class="mono">@Provenance(fluid.Revision)</span>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudTable T="PublishedTyre" Items="@Sheet.Tyres" Hover="true" Elevation="0" Outlined="true"
              Breakpoint="Breakpoint.Sm" Class="board mb-6" id="tyres">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle2">Tyres</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Position</MudTh>
            <MudTh>Size and cold pressure</MudTh>
            <MudTh Style="width:130px">Revision</MudTh>
        </HeaderContent>
        <RowTemplate Context="tyre">
            <MudTd DataLabel="Position" id="@("tyre-" + tyre.Position)">
                <span class="op-name">@AppState.Spaced(tyre.Position)</span>
            </MudTd>
            <MudTd DataLabel="Size and cold pressure" Class="@Sentence(tyre.Published)">
                @tyre.Says
            </MudTd>
            <MudTd DataLabel="Revision">
                <span class="mono">@Provenance(tyre.Revision)</span>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-6" id="fuel">
        <div class="sheet-head">
            <MudText Typo="Typo.subtitle2">Fuel</MudText>
            <span class="mono muted">@Provenance(Sheet.Fuel.Revision)</span>
        </div>

        <MudText Typo="Typo.body2" Class="@Sentence(Sheet.Fuel.Published)" id="fuel-says">
            @Sheet.Fuel.Says
        </MudText>

        @if (Sheet.Fuel.Published)
        {
            <div class="grades" id="fuel-prohibited">
                <span class="grades__label">Never put in</span>
                @if (Sheet.Fuel.ProhibitedGrades.Length == 0)
                {
                    <span class="muted">nothing was published as prohibited</span>
                }
                else
                {
                    @foreach (string grade in Sheet.Fuel.ProhibitedGrades)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="Color.Error" Icon="@Icons.Material.Rounded.Block">
                            @grade
                        </MudChip>
                    }
                }
            </div>

            <div class="grades" id="fuel-minimum">
                <span class="grades__label">At least</span>
                @if (Sheet.Fuel.MinimumGrade.Length == 0)
                {
                    <span class="muted">no minimum grade was published</span>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                        @Sheet.Fuel.MinimumGrade
                    </MudChip>
                }
            </div>

            <div class="grades" id="fuel-permitted">
                <span class="grades__label">Also allowed</span>
                @if (Sheet.Fuel.PermittedGrades.Length == 0)
                {
                    <span class="muted">nothing else was published as permitted</span>
                }
                else
                {
                    @foreach (string grade in Sheet.Fuel.PermittedGrades)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="Color.Default">
                            @grade
                        </MudChip>
                    }
                }
            </div>
        }
    </MudPaper>
}

@code {
    /// <summary>La ficha leida en un solo momento. La seccion no lee nada por su cuenta.</summary>
    [Parameter, EditorRequired]
    public WhatTheManufacturerPublished Sheet { get; set; }

    private static string Sentence(bool published) => published ? "sheet-says" : "sheet-says muted";

    private static string Provenance(string revision) => revision.Length > 0 ? revision : "--";
}
